{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List available models with optional pagination and filtering.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "all": {
    "description": "Return all models including inactive (default false)",
    "type": "boolean"
   },
   "collId": {
    "description": "Filter by collection ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "filter": {
    "description": "Filter string",
    "type": "string"
   },
   "index": {
    "description": "Start index (0-based)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "nValues": {
    "description": "Number of results (-1 for all)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "onlyActive": {
    "description": "Only return active models (default true)",
    "type": "boolean"
   },
   "prov": {
    "description": "Filter by model provider",
    "type": "string"
   },
   "releaseLevel": {
    "description": "Filter by release level",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "sortColumn": {
    "description": "Column to sort by",
    "type": "string"
   },
   "sortDirection": {
    "description": "Sort direction: asc or desc",
    "type": "string"
   },
   "type": {
    "description": "Filter by model type",
    "type": "string"
   },
   "userid": {
    "description": "Filter by user ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "transkribus_model_list",
 "title": "List Models"
}
