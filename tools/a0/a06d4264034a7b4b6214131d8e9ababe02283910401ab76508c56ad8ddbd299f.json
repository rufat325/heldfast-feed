{
 "description": "Create and emit a CTe (conhecimento de transporte eletronico) for cargo transport",
 "inputSchema": {
  "properties": {
   "cnpj_emitente": {
    "description": "Transport carrier CNPJ",
    "type": "string"
   },
   "destinatario": {
    "description": "Recipient info (cnpj/cpf, razao_social, endereco)",
    "type": "object"
   },
   "modal": {
    "description": "Transport modal (01=Rodoviario, 02=Aereo, 03=Aquaviario, 04=Ferroviario, 05=Dutoviario, 06=Multimodal)",
    "type": "string"
   },
   "natureza_operacao": {
    "description": "Operation nature (e.g. 'Prestacao de servico de transporte')",
    "type": "string"
   },
   "ref": {
    "description": "Unique reference ID for this CTe",
    "type": "string"
   },
   "remetente": {
    "description": "Sender info (cnpj/cpf, razao_social, endereco)",
    "type": "object"
   },
   "tipo_servico": {
    "description": "Service type (0=Normal, 1=Subcontratacao, 2=Redespacho, 3=Redespacho Intermediario, 4=Servico Vinculado Multimodal)",
    "type": "number"
   },
   "valor_total": {
    "description": "Total transport service value",
    "type": "number"
   }
  },
  "required": [
   "ref",
   "cnpj_emitente",
   "modal"
  ],
  "type": "object"
 },
 "name": "create_cte"
}
