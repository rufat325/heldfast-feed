{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true
 },
 "description": "Create an item (question) in a New Quiz (LTI). Supports 5 types: choice (MCQ), true-false, essay, matching, numeric. Canvas may rate-limit rapid sequential creates. Call serially (not in parallel). For >50 items, chunk and pause between batches.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assignment_id": {
    "description": "The assignment ID of the New Quiz",
    "type": "number"
   },
   "course_id": {
    "description": "The Canvas course ID",
    "type": "number"
   },
   "item": {
    "oneOf": [
     {
      "properties": {
       "choices": {
        "items": {
         "properties": {
          "id": {
           "description": "Stable choice identifier (caller-generated, e.g. \"a\")",
           "type": "string"
          },
          "item_body": {
           "description": "HTML choice text",
           "type": "string"
          }
         },
         "required": [
          "id",
          "item_body"
         ],
         "type": "object"
        },
        "minItems": 2,
        "type": "array"
       },
       "correct_choice_id": {
        "description": "id of the correct choice",
        "type": "string"
       },
       "interaction_type_slug": {
        "const": "choice",
        "type": "string"
       },
       "item_body": {
        "description": "HTML question stem",
        "type": "string"
       },
       "title": {
        "type": "string"
       }
      },
      "required": [
       "interaction_type_slug",
       "item_body",
       "choices",
       "correct_choice_id"
      ],
      "type": "object"
     },
     {
      "properties": {
       "correct_answer": {
        "type": "boolean"
       },
       "interaction_type_slug": {
        "const": "true-false",
        "type": "string"
       },
       "item_body": {
        "type": "string"
       }
      },
      "required": [
       "interaction_type_slug",
       "item_body",
       "correct_answer"
      ],
      "type": "object"
     },
     {
      "properties": {
       "interaction_type_slug": {
        "const": "essay",
        "type": "string"
       },
       "item_body": {
        "type": "string"
       },
       "rich_text": {
        "default": true,
        "description": "Allow rich text editor",
        "type": "boolean"
       },
       "word_count_max": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "word_count_min": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       }
      },
      "required": [
       "interaction_type_slug",
       "item_body"
      ],
      "type": "object"
     },
     {
      "properties": {
       "distractors": {
        "description": "Wrong-answer distractor pool",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "interaction_type_slug": {
        "const": "matching",
        "type": "string"
       },
       "item_body": {
        "type": "string"
       },
       "matches": {
        "items": {
         "properties": {
          "answer": {
           "type": "string"
          },
          "question": {
           "type": "string"
          }
         },
         "required": [
          "question",
          "answer"
         ],
         "type": "object"
        },
        "minItems": 2,
        "type": "array"
       }
      },
      "required": [
       "interaction_type_slug",
       "item_body",
       "matches"
      ],
      "type": "object"
     },
     {
      "properties": {
       "answers": {
        "items": {
         "oneOf": [
          {
           "properties": {
            "kind": {
             "const": "exact",
             "type": "string"
            },
            "margin": {
             "default": 0,
             "type": "number"
            },
            "value": {
             "type": "number"
            }
           },
           "required": [
            "kind",
            "value"
           ],
           "type": "object"
          },
          {
           "properties": {
            "kind": {
             "const": "range",
             "type": "string"
            },
            "max": {
             "type": "number"
            },
            "min": {
             "type": "number"
            }
           },
           "required": [
            "kind",
            "min",
            "max"
           ],
           "type": "object"
          },
          {
           "properties": {
            "kind": {
             "const": "precision",
             "type": "string"
            },
            "precision": {
             "maximum": 9007199254740991,
             "minimum": -9007199254740991,
             "type": "integer"
            },
            "value": {
             "type": "number"
            }
           },
           "required": [
            "kind",
            "value",
            "precision"
           ],
           "type": "object"
          }
         ]
        },
        "minItems": 1,
        "type": "array"
       },
       "interaction_type_slug": {
        "const": "numeric",
        "type": "string"
       },
       "item_body": {
        "type": "string"
       }
      },
      "required": [
       "interaction_type_slug",
       "item_body",
       "answers"
      ],
      "type": "object"
     }
    ]
   },
   "points_possible": {
    "description": "Points awarded for a fully correct answer",
    "type": "number"
   },
   "position": {
    "description": "1-based position in the quiz; appended if omitted",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "course_id",
   "assignment_id",
   "points_possible",
   "item"
  ],
  "type": "object"
 },
 "name": "create_new_quiz_item",
 "title": "Create New Quiz Item"
}
