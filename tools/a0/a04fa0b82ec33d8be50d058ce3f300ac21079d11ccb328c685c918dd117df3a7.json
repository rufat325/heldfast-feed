{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "List this merchant's deployed vault contract sets on a network, including archived source sites. Paginated; excludeVault hides the current vault. Accepts JWT or sk_*.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chainId": {
    "exclusiveMinimum": 0,
    "maximum": 2147483647,
    "type": "integer"
   },
   "excludeVault": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "exclusiveMinimum": 0,
    "maximum": 1000000,
    "type": "integer"
   }
  },
  "required": [
   "chainId"
  ],
  "type": "object"
 },
 "name": "yield_deployments_contract_sets",
 "title": "List existing yield contract sets"
}
