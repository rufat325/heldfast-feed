{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Bulk-exports every member of a site \u2014 profile, entitlement history, and their full per-member storage (everything synced from their app's localStorage) \u2014 as one JSON document. The same shape a single member gets from their own account-page export, for every member of the site at once.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "site_id": {
    "description": "The site's id, from list_sites or create_site.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "site_id"
  ],
  "type": "object"
 },
 "name": "export_members",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "members": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "entitlements": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "currentPeriodEnd": {
          "type": [
           "number",
           "null"
          ]
         },
         "graceUntil": {
          "type": [
           "number",
           "null"
          ]
         },
         "id": {
          "type": "string"
         },
         "planId": {
          "type": "string"
         },
         "planName": {
          "type": "string"
         },
         "status": {
          "enum": [
           "active",
           "past_due",
           "canceled"
          ],
          "type": "string"
         }
        },
        "required": [
         "id",
         "planId",
         "planName",
         "status",
         "currentPeriodEnd",
         "graceUntil"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "member": {
       "additionalProperties": false,
       "properties": {
        "email": {
         "type": "string"
        },
        "id": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "email"
       ],
       "type": "object"
      },
      "storage": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "key": {
          "type": "string"
         },
         "updatedAt": {
          "type": "number"
         },
         "value": {
          "type": "string"
         },
         "version": {
          "type": "number"
         }
        },
        "required": [
         "key",
         "value",
         "version",
         "updatedAt"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "member",
      "entitlements",
      "storage"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "site": {
    "additionalProperties": false,
    "properties": {
     "hostname": {
      "type": "string"
     },
     "id": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "hostname"
    ],
    "type": "object"
   }
  },
  "required": [
   "site",
   "members"
  ],
  "type": "object"
 },
 "title": "Export all members"
}
