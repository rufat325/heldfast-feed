{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List project task dependencies"
 },
 "description": "List task dependencies. Filter by task_id or depends_on_task_id to see dependency chains.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "dependency_type": {
    "description": "Filter by dependency type",
    "enum": [
     "finish_to_start",
     "start_to_start",
     "finish_to_finish",
     "start_to_finish"
    ],
    "type": "string"
   },
   "depends_on_task_id": {
    "description": "Filter by depended-on task ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "page": {
    "description": "Page number (default: all pages fetched automatically)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Items per page (default: 1000, max: 1000). All pages are fetched automatically.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "task_id": {
    "description": "Filter by task ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_project_task_dependencies",
 "title": "List project task dependencies"
}
