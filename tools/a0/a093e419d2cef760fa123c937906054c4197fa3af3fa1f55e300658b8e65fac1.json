{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch a signed Tollbooth receipt by id and verify its signature.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Receipt id returned by build_swap",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_receipt",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "description": "Present when the receipt was not found",
    "type": "string"
   },
   "id": {
    "description": "Receipt id",
    "type": "string"
   },
   "receipt": {
    "additionalProperties": {},
    "description": "Receipt payload",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "signature": {
    "description": "Server signature over the receipt",
    "type": "string"
   },
   "valid": {
    "description": "Whether the signature verified",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "title": "Get signed receipt"
}
