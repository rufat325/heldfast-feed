{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Documents"
 },
 "description": "Search public IARCCUM documents by title, description, and indexed full text. Embargoed records are never returned.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "author_id": {
    "description": "Optional author/name authority ID.",
    "minimum": 1,
    "type": "integer"
   },
   "date_from": {
    "description": "Optional lower date bound (YYYY, YYYY-MM, or YYYY-MM-DD).",
    "maxLength": 10,
    "minLength": 4,
    "type": "string"
   },
   "date_to": {
    "description": "Optional upper date bound (YYYY, YYYY-MM, or YYYY-MM-DD).",
    "maxLength": 10,
    "minLength": 4,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Number of results (maximum 50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Zero-based result offset.",
    "maximum": 5000,
    "minimum": 0,
    "type": "integer"
   },
   "organisation_id": {
    "description": "Optional fonds/organisation authority ID.",
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search words or phrase.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_documents",
 "title": "Search Documents"
}
