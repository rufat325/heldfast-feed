     "5m",
     "15m",
     "30m",
     "1h",
     "2h",
     "4h",
     "8h",
     "12h",
     "1d",
     "3d",
     "1w",
     "1M"
    ],
    "type": "string"
   },
   "market": {
    "description": "Market symbol: BTC or ETH.",
    "enum": [
     "BTC",
     "ETH"
    ],
    "type": "string"
   }
  },
  "required": [
