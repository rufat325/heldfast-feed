    "description": "CRM access token",
    "type": "string"
   },
   "calendarId": {
    "description": "Filter by calendar ID",
    "type": "string"
   },
   "endTime": {
    "description": "End time filter (epoch ms or ISO string)",
    "type": "string"
   },
