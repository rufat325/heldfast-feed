{
 "description": "Generate 1\u20134 formats for one article, replacing prior results; returns IDs to poll and can send completion webhooks.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "content_id": {
    "description": "Article to repurpose",
    "format": "uuid",
    "type": "string"
   },
   "types": {
    "items": {
     "enum": [
      "linkedin_carousel",
      "twitter_thread",
      "newsletter",
      "instagram_carousel"
     ],
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [
   "content_id",
   "types"
  ],
  "type": "object"
 },
 "name": "batch_atomize"
}
