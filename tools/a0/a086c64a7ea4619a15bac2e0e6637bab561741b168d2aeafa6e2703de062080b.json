 },
 "description": "The monthly Tabflows price for a practice's number of locations and monthly paying patients, with a breakdown and the pricing rule, plus the optional Practice X-ray: a $500 one-time diagnostic, separate from the monthly price. Prices come from the same pricing rule tabflows.com/pricing shows.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "locations": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "monthlyPayingPatients": {
    "maximum": 250000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "locations",
   "monthlyPayingPatients"
  ],
  "type": "object"
 },
 "name": "quote_tabflows_price",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "bookDemoUrl": {
    "type": "string"
   },
   "breakdown": {
    "additionalProperties": false,
    "properties": {
     "baseUsd": {
      "type": "number"
     },
     "extraLocationsUsd": {
      "type": "number"
     },
     "extraPatientBandsUsd": {
      "type": "number"
     }
    },
    "required": [
     "baseUsd",
     "extraLocationsUsd",
     "extraPatientBandsUsd"
    ],
    "type": "object"
   },
   "monthlyUsd": {
    "type": "number"
   },
   "practiceXray": {
    "additionalProperties": false,
    "properties": {
     "oneTimeUsd": {
      "type": "number"
     },
     "summary": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "oneTimeUsd",
     "summary",
     "url"
    ],
    "type": "object"
   },
   "pricingUrl": {
    "type": "string"
   },
   "rule": {
    "type": "string"
   },
   "signUpUrl": {
    "type": "string"
   }
  },
  "required": [
   "monthlyUsd",
   "breakdown",
   "rule",
   "practiceXray",
   "pricingUrl",
   "signUpUrl",
   "bookDemoUrl"
  ],
  "type": "object"
 },
 "title": "Quote a Tabflows price"
}
