{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Template"
 },
 "description": "Edit a template in place. Only the fields you pass change; tasks replace the whole list.",
 "inputSchema": {
  "properties": {
   "description": {
    "type": "string"
   },
   "id": {
    "description": "Template ID",
    "type": "integer"
   },
   "name": {
    "type": "string"
   },
   "tasks": {
    "description": "Replaces every task. Omit to leave them alone. {variable} works in title and description.",
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "estimated_hours": {
       "type": "number"
      },
      "priority": {
       "default": "medium",
       "enum": [
        "low",
        "medium",
        "high",
        "critical"
       ],
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "template_update"
}
