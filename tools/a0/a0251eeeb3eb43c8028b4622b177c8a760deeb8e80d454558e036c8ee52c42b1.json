{
 "description": "Weight of lumber by species, dimensions, quantity and moisture (dry/fresh), using species density tables. Optional custom density in kg/m3.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "custom_density_kg_m3": {
    "description": "Overrides species density",
    "minimum": 0,
    "type": "number"
   },
   "length_m": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "moisture": {
    "default": "dry",
    "description": "fresh (green) wood uses 1.5x density (+50% weight)",
    "enum": [
     "dry",
     "fresh"
    ],
    "type": "string"
   },
   "qty": {
    "default": 1,
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "species": {
    "description": "Wood species key",
    "enum": [
     "pine",
     "spruce",
     "fir",
     "cedar",
     "poplar",
     "oak-red",
     "oak-white",
     "maple-hard",
     "birch",
     "ash",
     "beech",
     "walnut",
     "cherry",
     "mahogany",
     "teak",
     "mdf",
     "plywood",
     "oak-engineered"
    ],
    "type": "string"
   },
   "thickness_mm": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "width_mm": {
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "species",
   "thickness_mm",
   "width_mm",
   "length_m"
  ],
  "type": "object"
 },
 "name": "lumber_weight_calculator"
}
