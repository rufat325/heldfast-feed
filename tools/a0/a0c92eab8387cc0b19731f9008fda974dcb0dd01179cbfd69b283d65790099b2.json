{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "multilocale:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add a string and translate it"
 },
 "description": "Use this when someone asks to add a new string or key to their app's translations. Returns the created key with one machine translation per configured locale, made from the source text in the default locale. A key that already exists returns already-exists and is left unchanged. Not for changing an existing translation.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context": {
    "description": "Note for the translator that disambiguates the string, up to 600 characters",
    "maxLength": 600,
    "type": "string"
   },
   "key": {
    "description": "New key, 1 to 256 characters",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "model": {
    "description": "Translation model id; defaults to gpt-6-luna",
    "maxLength": 64,
    "type": "string"
   },
   "project": {
    "description": "Project id or name",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "value": {
    "description": "Source text in the default locale, up to 2,000 characters; defaults to the key itself",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "project",
   "key"
  ],
  "type": "object"
 },
 "name": "add_phrase",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "defaultLocale": {
    "anyOf": [
     {
      "maxLength": 35,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "key": {
    "maxLength": 256,
    "type": "string"
   },
   "locales": {
    "items": {
     "maxLength": 35,
     "type": "string"
    },
    "maxItems": 200,
    "type": "array"
   },
   "project": {
    "anyOf": [
     {
      "maxLength": 128,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "created",
     "not-found",
     "already-exists"
    ],
    "type": "string"
   },
   "translationCount": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "status",
   "project",
   "key",
   "defaultLocale",
   "translationCount",
   "locales"
  ],
  "type": "object"
 },
 "title": "Add a string and translate it"
}
