{
 "annotations": {},
 "description": "List agent memories in the active project. v2.3.0: scope default is 'project' (was implicit session); scope=operator now requires the explicit operator parameter; scope=agent is new (Mem0 agent_id).",
 "inputSchema": {
  "properties": {
   "agent_id": {
    "description": "Required for scope=agent (Mem0 agent_id). v2.3.0.",
    "type": "string"
   },
   "include_archived": {
    "default": false,
    "type": "boolean"
   },
   "kind": {
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 200,
    "type": "integer"
   },
   "memory_type": {
    "description": "Mem0 three-class taxonomy filter. v2.3.0.",
    "enum": [
     "episodic",
     "semantic",
     "procedural"
    ],
    "type": "string"
   },
   "operator": {
    "description": "Caller identity for scope=operator resolution. v2.3.0.",
    "type": "string"
   },
   "pinned_only": {
    "default": false,
    "type": "boolean"
   },
   "scope": {
    "enum": [
     "current",
     "session",
     "project",
     "operator",
     "agent",
     "all"
    ],
    "type": "string"
   },
   "tag": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "dark_memory_agent_memory_list"
}
