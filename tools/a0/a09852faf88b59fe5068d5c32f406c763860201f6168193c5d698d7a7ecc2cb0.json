     "NO_BUDGET",
     "CRAWLER_ONLY",
     "RETRY_LATER",
     "NEED_MORE_SPECIFIC_RESULTS",
     "OTHER"
    ],
    "type": "string"
   },
   "task": {
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
