{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Process specific Gmail receipts"
 },
 "description": "Process specific Gmail emails as receipts. Pass Gmail message IDs and they'll be converted to PDF, extracted by AI, and added to the user's expense spreadsheet. Max 25 emails per request. Requires Gmail to be connected in ExpenseBot settings.",
 "inputSchema": {
  "properties": {
   "accountEmail": {
    "description": "Optional: which Gmail account to use (for users with multiple linked accounts)",
    "type": "string"
   },
   "emailIds": {
    "description": "Gmail message IDs to process as receipts",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "emailIds"
  ],
  "type": "object"
 },
 "name": "process_gmail_receipts",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "data": {
    "additionalProperties": true,
    "type": "object"
   },
   "emailCount": {
    "minimum": 0,
    "type": "integer"
   },
   "error": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "processInfo": {
    "additionalProperties": true,
    "properties": {
     "processingCompleted": {
      "type": "boolean"
     },
     "sessionId": {
      "type": "string"
     },
     "status": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "processedItems": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "reviewExpensesUrl": {
    "type": "string"
   },
   "spreadsheetUrl": {
    "type": [
     "string",
     "null"
    ]
   },
   "submissionId": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "message"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "gmail.scan"
   ],
   "type": "oauth2"
  }
 ]
}
