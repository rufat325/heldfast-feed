{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update asset condition assessment"
 },
 "description": "Update an existing asset condition assessment by ID. Requires asset_condition_assessments:write scope. Note: the purchase-cost writeback is create-only and cannot be triggered by an update.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assessed_on": {
    "description": "Assessment date (YYYY-MM-DD, today or earlier)",
    "type": "string"
   },
   "assessor_id": {
    "description": "Assessor user ID",
    "type": "string"
   },
   "condition_score": {
    "description": "Condition score (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "defects": {
    "additionalProperties": {},
    "description": "Structured defect findings (JSON)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "id": {
    "description": "Assessment ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "method": {
    "description": "Assessment method",
    "enum": [
     "visual",
     "detailed",
     "vendor"
    ],
    "type": "string"
   },
   "notes": {
    "description": "Free-form notes",
    "type": "string"
   },
   "replacement_cost": {
    "description": "Current replacement value / CRV",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_asset_condition_assessment",
 "title": "Update asset condition assessment"
}
