{
 "description": "Execute a command as root via su. Requires rooted device.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "command": {
    "description": "Command to run as root",
    "type": "string"
   },
   "device": {
    "description": "Device serial",
    "type": "string"
   }
  },
  "required": [
   "command"
  ],
  "type": "object"
 },
 "name": "adb_root_shell"
}
