{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Send a traveller's enquiry to one outfitter through MyOutfitters' anonymised relay. Requires the traveller's own name and e-mail, given with their consent. The outfitter replies by e-mail; neither side sees the other's raw contact details.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "maxLength": 200,
    "type": "string"
   },
   "arrival": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "departure": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "email": {
    "format": "email",
    "maxLength": 255,
    "type": "string"
   },
   "full_name": {
    "maxLength": 120,
    "minLength": 2,
    "type": "string"
   },
   "locale": {
    "enum": [
     "fr",
     "en"
    ],
    "type": "string"
   },
   "message": {
    "maxLength": 2000,
    "minLength": 5,
    "type": "string"
   },
   "outfitter_id": {
    "maxLength": 160,
    "type": "string"
   },
   "package_id": {
    "format": "uuid",
    "type": "string"
   },
   "party_size": {
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   },
   "phone": {
    "maxLength": 40,
    "type": "string"
   }
  },
  "required": [
   "outfitter_id",
   "full_name",
   "email",
   "message"
  ],
  "type": "object"
 },
 "name": "create_price_request",
 "title": "Request a price or dates"
}
