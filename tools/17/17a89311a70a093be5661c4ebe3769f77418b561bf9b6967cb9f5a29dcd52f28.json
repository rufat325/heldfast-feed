{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Compare locations"
 },
 "description": "Compare forecast variables across multiple locations side-by-side in one batched call. Returns a distilled per-location series matrix for direct comparison -- prefer this over N sequential forecast calls. Locations accept place names directly. Example: {\"locations\": [{\"location\": \"Denver\"}, {\"location\": \"Boulder, CO\"}], \"variables\": [\"temperature_2m\", \"precipitation_probability\"], \"hours\": 48}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dataset_id": {
    "description": "Dataset override. Default: auto-resolved NBM per location.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "hours": {
    "default": 24,
    "description": "Forecast hours. Default 24.",
    "maximum": 168,
    "minimum": 1,
    "type": "integer"
   },
   "locations": {
    "description": "Locations to compare (2-10). Each takes location OR lat/lon, optional label.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "label": {
       "description": "Optional display label (e.g. \"Denver warehouse\").",
       "type": "string"
      },
      "lat": {
       "maximum": 90,
       "minimum": -90,
       "type": "number"
      },
      "location": {
       "description": "Place name, ZIP, or \"lat,lon\" (e.g. \"Denver\", \"Boulder, CO\").",
       "type": "string"
      },
      "lon": {
       "maximum": 180,
       "minimum": -180,
       "type": "number"
      }
     },
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   },
   "variables": {
    "description": "Standard variable names (e.g. temperature_2m, precipitation).",
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "locations",
   "variables"
  ],
  "type": "object"
 },
 "name": "compare_locations",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "comparisons": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "data": {
       "additionalProperties": {
        "items": {
         "type": [
          "number",
          "null"
         ]
        },
        "type": "array"
       },
       "type": "object"
      },
      "location": {
       "additionalProperties": false,
       "properties": {
        "label": {
         "type": "string"
        },
        "lat": {
         "type": "number"
        },
        "lon": {
         "type": "number"
        },
        "name": {
         "type": "string"
        }
       },
       "required": [
        "lat",
        "lon"
       ],
       "type": "object"
      },
      "valid_times": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "location"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "hours": {
    "type": "number"
   },
   "variables": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "variables",
   "hours",
   "comparisons"
  ],
  "type": "object"
 },
 "title": "Compare locations"
}
