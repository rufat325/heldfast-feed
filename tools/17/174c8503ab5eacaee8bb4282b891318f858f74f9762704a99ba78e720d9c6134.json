 "description": "Which products in the Japan MHLW supply status list changed status, or were added, removed or modified, since a date? From this service's own record of list versions (MHLW publishes only the current list). Each change has the YJ code, product, status before and after (as published, with English labels as our translation) and the versions compared. History starts at tracking_since; nothing earlier was observed. Free: last 30 days (see history_window). Relay only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "change_type": {
    "description": "Optional filter: status_changed, added, removed or modified (other fields only)",
    "enum": [
     "status_changed",
     "added",
     "removed",
     "modified"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of changes, 1-200 (default 100)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "since": {
    "description": "ISO 8601 date or date-time with time zone, e.g. 2026-10-01 or 2026-10-01T00:00:00Z",
    "maxLength": 40,
    "type": "string"
   },
   "yj_code": {
    "description": "Optional filter: YJ code, e.g. 4419002B1033",
    "maxLength": 20,
    "type": "string"
   }
  },
  "required": [
   "since"
  ],
  "type": "object"
 },
