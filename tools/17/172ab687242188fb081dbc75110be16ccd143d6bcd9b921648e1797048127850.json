{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Summarise Martin Loop run records from a saved loop file or run-store directory.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "file": {
    "description": "Optional path under the Martin runs root to a loop-record.json file, a legacy .jsonl file, or a run-store directory.",
    "type": "string"
   },
   "runsDir": {
    "description": "Optional runs-root override resolved under the default Martin runs root.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "martin_inspect",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "inspection": {
    "additionalProperties": false,
    "properties": {
     "sourceKind": {
      "enum": [
       "file",
       "runs_root"
      ],
      "type": "string"
     }
    },
    "required": [
     "sourceKind"
    ],
    "type": "object"
   },
   "latestRun": {
    "additionalProperties": true,
    "properties": {
     "activeAttemptId": {
      "description": "ID of the currently active attempt, when a run is in progress.",
      "type": "string"
     },
     "attempts": {
      "type": "integer"
     },
     "avoidedUsd": {
      "type": "number"
     },
     "costUsd": {
      "type": "number"
     },
     "createdAt": {
      "type": "string"
     },
     "lastAttempt": {
      "additionalProperties": true,
      "type": "object"
     },
     "lifecycleState": {
      "type": "string"
     },
     "loopId": {
      "type": "string"
     },
     "objective": {
      "type": "string"
     },
     "pressure": {
      "type": "string"
     },
     "remainingBudgetUsd": {
      "type": "number"
     },
     "remainingIterations": {
      "type": "integer"
     },
     "remainingTokens": {
      "type": "integer"
     },
     "shouldStop": {
      "type": "boolean"
     },
     "status": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "required": [
     "loopId",
     "title",
     "objective",
     "status",
     "lifecycleState",
     "attempts",
     "costUsd",
     "avoidedUsd",
     "pressure",
     "shouldStop",
     "remainingBudgetUsd",
     "remainingIterations"
    ],
    "type": "object"
   },
   "lifecycleBreakdown": {
    "additionalProperties": {
     "type": "integer"
    },
    "type": "object"
   },
   "loopCount": {
    "type": "integer"
   },
   "portfolio": {
    "additionalProperties": true,
    "type": "object"
   },
   "recentRuns": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "activeAttemptId": {
       "description": "ID of the currently active attempt, when a run is in progress.",
       "type": "string"
      },
      "attempts": {
       "type": "integer"
      },
      "avoidedUsd": {
       "type": "number"
      },
      "costUsd": {
       "type": "number"
      },
      "createdAt": {
       "type": "string"
      },
      "lastAttempt": {
       "additionalProperties": true,
       "type": "object"
      },
      "lifecycleState": {
       "type": "string"
      },
      "loopId": {
       "type": "string"
      },
      "objective": {
       "type": "string"
      },
      "pressure": {
       "type": "string"
      },
      "remainingBudgetUsd": {
       "type": "number"
      },
      "remainingIterations": {
       "type": "integer"
      },
      "remainingTokens": {
       "type": "integer"
      },
      "shouldStop": {
       "type": "boolean"
      },
      "status": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "updatedAt": {
       "type": "string"
      }
     },
     "required": [
      "loopId",
      "title",
      "objective",
      "status",
      "lifecycleState",
      "attempts",
      "costUsd",
      "avoidedUsd",
      "pressure",
      "shouldStop",
      "remainingBudgetUsd",
      "remainingIterations"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "type": "string"
   },
   "statusBreakdown": {
    "additionalProperties": {
     "type": "integer"
    },
    "type": "object"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "source",
   "loopCount",
   "portfolio",
   "recentRuns",
   "statusBreakdown",
   "lifecycleBreakdown",
   "inspection",
   "warnings"
  ],
  "type": "object"
 }
}
