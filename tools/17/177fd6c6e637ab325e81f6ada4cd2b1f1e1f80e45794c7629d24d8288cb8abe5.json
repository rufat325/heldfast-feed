   "limit": {
    "default": 10,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "What the user needs an AI tool for.",
    "type": "string"
   },
   "sort": {
    "default": "default",
    "enum": [
     "default",
     "latest",
     "most-saved",
     "top-rated",
     "popular",
     "price",
     "sota"
    ],
    "type": "string"
   },
   "type": {
    "enum": [
     "gpt",
     "ios",
     "android",
     "chrome",
     "ai",
     "tool",
     "agents",
     "apis",
     "telegram",
     "mini-tools"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_tools",
