    "type": "string"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "outcome": {
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   },
   "problem": {
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
