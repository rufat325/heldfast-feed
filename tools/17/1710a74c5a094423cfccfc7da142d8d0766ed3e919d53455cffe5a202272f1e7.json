{
 "description": "ABAP Unit test run. object_type: not used. Required: tests[]{container_class*, test_class*}. Optional: title, context, scope, risk_level, duration. Response: JSON.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "context": {
    "description": "Run context label.",
    "type": "string"
   },
   "duration": {
    "description": "Allowed duration classes.",
    "properties": {
     "long": {
      "description": "Allow long tests.",
      "type": "boolean"
     },
     "medium": {
      "description": "Allow medium tests.",
      "type": "boolean"
     },
     "short": {
      "description": "Allow short tests.",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "risk_level": {
    "description": "Allowed risk levels.",
    "properties": {
     "critical": {
      "description": "Allow critical tests.",
      "type": "boolean"
     },
     "dangerous": {
      "description": "Allow dangerous tests.",
      "type": "boolean"
     },
     "harmless": {
      "description": "Allow harmless tests.",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "scope": {
    "description": "ABAP Unit test scope flags.",
    "properties": {
     "add_foreign_tests_as_preview": {
      "description": "Preview foreign tests without full inclusion.",
      "type": "boolean"
     },
     "foreign_tests": {
      "description": "Include foreign tests.",
      "type": "boolean"
     },
     "own_tests": {
      "description": "Include own tests.",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "tests": {
    "description": "List of test classes to run.",
    "items": {
     "properties": {
      "container_class": {
       "description": "Productive class containing tests.",
       "type": "string"
      },
      "test_class": {
       "description": "Local/unit test class.",
       "type": "string"
      }
     },
     "required": [
      "container_class",
      "test_class"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "Run title shown in ABAP Unit test logs.",
    "type": "string"
   }
  },
  "required": [
   "tests"
  ],
  "type": "object"
 },
 "name": "HandlerUnitTestRun"
}
