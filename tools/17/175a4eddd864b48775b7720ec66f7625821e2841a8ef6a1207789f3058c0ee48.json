{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Suggests 2-4 movie-night options on one board from a window and a taste profile \u2014 film + specific showtime + theater + why it fits \u2014 plus one wildcard: the highest-ranked film outside the stated genres, or the next film down when no genre is stated. time_after/time_before are hard bounds; genres and formats only tilt the ranking, and when one matches nothing in the window the answer opens with a warning (also in warnings[]) saying so. It books, reserves and saves nothing; each option carries ticket and calendar links for the person to follow. Ranking uses only the stated preferences; no theater or film pays for placement. Read-only: the call itself records nothing. SceneF does not sell, hold or book tickets. Ticket links are https://scenef.com/go/{id} redirects to the theater's own site or the ticket seller it uses (a link to a showtime that is gone lands back on SceneF); whoever follows one, a person or a client, is logged once anonymously (time, the screening with its film and theater, client type, browser family, referring site, link source tag, and whether the showtime was gone; no IP address, cookie or account) and forwarded. Every emitted showtime carries confidence, source tier, reporting sources and verified_at.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "party_size": {
    "description": "How many people are going (1-20). It labels the plan; it does not change which shows are picked.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "preferences": {
    "description": "Bring-your-own taste profile. Everything here tilts the ranking and degrades gracefully EXCEPT time_after/time_before, which are hard bounds.",
    "properties": {
     "avoids": {
      "description": "Genres to steer away from.",
      "items": {
       "maxLength": 80,
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "discounts_only": {
      "description": "Only screenings at theaters with a discount active that night.",
      "type": "boolean"
     },
     "formats": {
      "description": "Formats to favor, e.g. [\"35mm\", \"70mm\"]. If none in the window matches, the plan says so in warnings.",
      "items": {
       "maxLength": 80,
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "home_venues": {
      "description": "Home-theater venue ids to nudge upward, e.g. [\"roxie\"].",
      "items": {
       "maxLength": 80,
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "likes": {
      "description": "Genres to favor, e.g. [\"horror\", \"comedy\"]. If no film in the window matches, the plan says so in warnings.",
      "items": {
       "maxLength": 80,
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "no_matinee": {
      "description": "Penalize daytime shows.",
      "type": "boolean"
     },
     "time_after": {
      "description": "HARD earliest start, \"HH:MM\" local 24h, e.g. \"20:00\" for \"nothing before 8\". Unlike the other preferences this does NOT degrade: if nothing starts that late the tool says so rather than ranking a show you cannot get to.",
      "maxLength": 120,
      "type": "string"
     },
     "time_before": {
      "description": "HARD latest start, \"HH:MM\" local 24h. Same no-fallback rule.",
      "maxLength": 120,
      "type": "string"
     },
     "window": {
      "description": "Preferred start-time window \u2014 a soft tilt. For a time you genuinely cannot make, use time_after/time_before instead.",
      "enum": [
       "matinee",
       "early",
       "evening",
       "late"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "region": {
    "description": "Which regional board to read: a board id such as \"sf\", \"oahu\" or \"miami\", not a city name (\"Honolulu\" or \"Chicago\" is rejected). Omitted means \"sf\" (San Francisco); it is never inferred from where you are. For a city, ZIP or neighborhood call scenef_resolve_board first; scenef_now with no region lists every id. An unknown region is an error, not a fallback.",
    "maxLength": 120,
    "type": "string"
   },
   "response_format": {
    "description": "Output size. \"concise\" (default) is tight text plus a structured summary. In whats_playing, each film has the total showtime_count, next_showtime, and a showtimes array containing only that next screening; \"detailed\" adds showtime rows with ids, ticket urls and accuracy metadata, about 200 across the answer. film_details and search_showtimes return the 40 nearest showtimes in \"concise\" and up to 200 in \"detailed\". showtime_count is always the total and showtimes_complete says whether the array is all of it; narrow by date or theater for the rest.",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   },
   "when": {
    "description": "When to look: \"tonight\" (default), \"tomorrow\", \"weekend\" (Fri/Sat/Sun of the current week), or a YYYY-MM-DD date.",
    "maxLength": 120,
    "type": "string"
   }
  },
  "type": "object"
 },
