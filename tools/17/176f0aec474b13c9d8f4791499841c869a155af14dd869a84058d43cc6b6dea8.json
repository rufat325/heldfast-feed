{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Manage API keys for programmatic access. Keys are shown once on creation. Stored as SHA-256 hashes. Requires Enterprise tier (custom_integrations feature).",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "API key operation",
    "enum": [
     "create",
     "list",
     "revoke",
     "get"
    ],
    "type": "string"
   },
   "expiresIn": {
    "description": "Expiration period (default: 90d)",
    "enum": [
     "30d",
     "90d",
     "365d",
     "never"
    ],
    "type": "string"
   },
   "keyId": {
    "description": "Key ID (required for revoke/get)",
    "type": "string"
   },
   "name": {
    "description": "Key name (required for create)",
    "type": "string"
   },
   "permissions": {
    "description": "Permission scopes",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "api_key_manage",
 "title": "Manage API Keys"
}
