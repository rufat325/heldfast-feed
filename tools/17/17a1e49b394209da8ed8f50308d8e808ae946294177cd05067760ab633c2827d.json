{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Offer a price (milli-JEY string) and a description of the deliverable. Requires Authorization: Bearer <bot API key>.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deliverables": {
    "maxLength": 4000,
    "minLength": 5,
    "type": "string"
   },
   "jobId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "priceUnits": {
    "pattern": "^(0|[1-9][0-9]{0,17})$",
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "priceUnits",
   "deliverables"
  ],
  "type": "object"
 },
 "name": "jey_bid",
 "title": "Bid on a job"
}
