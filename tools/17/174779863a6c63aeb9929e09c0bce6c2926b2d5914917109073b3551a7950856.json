  "title": "Booking fee check"
 },
 "description": "Works out what a US restaurant's reservation app costs it, as the free booking fee check on restaurantdoctorai.com does: a month, a year, per guest who booked through it and as a share of the average spend, from the plan's published price (dated, sourced) or the owner's invoice, plus fees per guest and the percentage on deposits. Of the apps checked, only OpenTable charges per guest: for guests from its own app and website, possibly from Google and partners, and on Basic from the restaurant's own website. Returns a one-sentence headline first, the month line by line, what isn't counted, what the owner can do (book direct, mark no-shows, the contract's notice date), other apps' published prices as information, not a recommendation, the caveats and sources. Use it when an owner asks what OpenTable, Resy, Tock, Yelp, Toast Tables, SpotOn or SevenRooms costs them per reservation or per guest. Ask which app and plan (on the invoice) and, for OpenTable, last month's guests from its covers report by where they booked; the rest is optional. A figure that isn't sent is never counted as 0. Not affiliated with any app; it reads no account. The figures aren't stored; only an anonymous daily count of calculator runs is kept.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "averageSpend": {
    "anyOf": [
     {
      "description": "The average spend per guest: net sales \u00f7 guests, from the POS.",
      "maximum": 1000000000,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "firstMonth": {
    "anyOf": [
     {
      "description": "OpenTable Basic only: true if last month was the first 30 days (network guests free).",
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ]
   },
   "monthlyFee": {
    "anyOf": [
     {
      "description": "The invoice's monthly fee: plan plus add-ons, before fees per guest. Left out: the published price. Needed for sevenrooms and other.",
      "maximum": 1000000000,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "networkCoverFee": {
    "anyOf": [
     {
      "description": "OpenTable or other only: the fee per guest on the invoice, only if it isn't the published one.",
      "maximum": 1000000000,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "networkCovers": {
    "anyOf": [
     {
      "description": "Guests seated last month who booked through the app itself (its own app or site). OpenTable: the Network line of its covers report; needed for OpenTable. Other apps: every guest booked through it, wherever they booked.",
      "maximum": 1000000000,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "partnerCoverFee": {
    "anyOf": [
     {
      "description": "OpenTable only: the fee per partner guest, from its Billing History tab. Left out: a range.",
      "maximum": 1000000000,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "partnerCovers": {
    "anyOf": [
     {
      "description": "OpenTable only: guests who booked through Google and other partners, the report's Partner or Affiliate line. Left out: not counted.",
      "maximum": 1000000000,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "platform": {
    "description": "The app and plan, on the invoice. tock_ = Tock, now sold by Resy; other = any app not listed, with monthlyFee.",
    "enum": [
     "opentable_basic",
     "opentable_core",
     "opentable_pro",
     "resy_platform",
     "resy_platform_360",
     "tock_essential",
     "tock_premium",
     "yelp_basic",
     "yelp_plus",
     "toast_tables_plus",
     "spoton_reserve",
     "sevenrooms",
     "other"
    ],
    "type": "string"
   },
   "prepaidAmount": {
    "anyOf": [
     {
      "description": "Money the app collected last month, from its statement: deposits, prepayments, no-show charges. tock_: prepayments only.",
      "maximum": 1000000000,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "prepaidFeePercent": {
    "anyOf": [
     {
      "description": "The app's percentage of that money, as a percent (2 for 2%, not 0.02), only if it isn't the published one.",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "renewalDate": {
    "anyOf": [
     {
      "description": "Not on opentable_basic or spoton_reserve: the contract's renewal date, YYYY-MM-DD, from the contract; month-to-month plans have none.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "websiteCovers": {
    "anyOf": [
     {
      "description": "OpenTable only: guests who booked through the restaurant's own website (a fee each on Basic).",
      "maximum": 1000000000,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "websiteFlatAddOn": {
    "anyOf": [
     {
      "description": "OpenTable Basic only: true if the invoice shows the monthly flat fee for website bookings.",
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "platform"
  ],
  "type": "object"
 },
