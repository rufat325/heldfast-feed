{
 "_meta": {
  "ui": {
   "resourceUri": "ui://rds/widget.html"
  },
  "ui/resourceUri": "ui://rds/widget.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Count how many of 8 common conversion-flow friction points are present and turn that into a flow health score. See the full version at https://rahuldsarker.co/calculators/friction-point-identifier",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "accountRequiredBeforeValue": {
    "description": "Account required before purchase / value",
    "type": "boolean"
   },
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "forcedUpsells": {
    "description": "Forced upsells or interstitials mid-flow",
    "type": "boolean"
   },
   "limitedPaymentOptions": {
    "description": "Limited payment / wallet options",
    "type": "boolean"
   },
   "noProgressIndicator": {
    "description": "No progress indicator on multi-step flows",
    "type": "boolean"
   },
   "noTrustSignals": {
    "description": "No trust/security signals at the point of entry",
    "type": "boolean"
   },
   "slowOrLaggySteps": {
    "description": "Slow steps or laggy interactions",
    "type": "boolean"
   },
   "tooManyFormFields": {
    "description": "Too many form fields",
    "type": "boolean"
   },
   "unclearOrLateErrors": {
    "description": "Unclear or late error messages",
    "type": "boolean"
   }
  },
  "required": [
   "accountRequiredBeforeValue",
   "tooManyFormFields",
   "unclearOrLateErrors",
   "forcedUpsells",
   "noProgressIndicator",
   "limitedPaymentOptions",
   "slowOrLaggySteps",
   "noTrustSignals"
  ],
  "type": "object"
 },
 "name": "friction_point_identifier",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "benchmarks": {
    "description": "Rule-of-thumb verdicts for the headline numbers",
    "items": {
     "additionalProperties": false,
     "properties": {
      "band": {
       "type": "string"
      },
      "display": {
       "type": "string"
      },
      "metric": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "read": {
       "type": "string"
      },
      "segment": {
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "tone": {
       "enum": [
        "good",
        "ok",
        "warn",
        "bad"
       ],
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "metric",
      "name",
      "value",
      "display",
      "band",
      "tone",
      "read",
      "target",
      "segment",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "bookingUrl": {
    "type": "string"
   },
   "calculator": {
    "description": "Slug of the interactive calculator on rahuldsarker.co",
    "type": "string"
   },
   "compact": {
    "type": "boolean"
   },
   "currency": {
    "type": [
     "string",
     "null"
    ]
   },
   "inputs": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "kind": {
    "const": "calculator",
    "type": "string"
   },
   "metrics": {
    "description": "Every \"Label: value\" line of the result; value is the first number on the line",
    "items": {
     "additionalProperties": false,
     "properties": {
      "display": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "unit": {
       "anyOf": [
        {
         "enum": [
          "currency",
          "x",
          "%",
          "months"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "value": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "label",
      "value",
      "unit",
      "display"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "tool": {
    "description": "The calculator tool that produced this result",
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "kind",
   "tool",
   "title",
   "calculator",
   "url",
   "bookingUrl",
   "currency",
   "compact",
   "inputs",
   "metrics",
   "notes",
   "benchmarks"
  ],
  "type": "object"
 },
 "title": "Friction Point Identifier"
}
