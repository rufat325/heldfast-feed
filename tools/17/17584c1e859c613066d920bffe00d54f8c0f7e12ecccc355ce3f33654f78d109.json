{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List every relation in a project in one call. Returns source/target IDs, titles, and relation type. Use instead of calling relation_list per ticket.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max number of entries to return (default: all)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "description": "Number of entries to skip, to page through a list too large for one result",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "relation_list_all",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "relation_type": {
       "type": "string"
      },
      "source_id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "source_title": {
       "type": "string"
      },
      "target_id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "target_title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "source_id",
      "source_title",
      "target_id",
      "target_title",
      "relation_type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
