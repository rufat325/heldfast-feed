{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "supovia:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List help-center articles"
 },
 "description": "Use this when someone asks which help articles or support docs exist, optionally for one website, language or article. Returns each article's id, title, slug, language, website and published flag, most recently edited first, 20 per page by default, without the article text. Not for finding articles about a topic.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The page.nextCursor of the previous page with the same filters; absent for the first page",
    "maxLength": 4096,
    "type": "string"
   },
   "limit": {
    "description": "Articles per page, from 1 to 50; defaults to 20",
    "exclusiveMinimum": 0,
    "maximum": 50,
    "type": "integer"
   },
   "locale": {
    "description": "Only articles in this language code, e.g. en, it or fr; every language when absent",
    "maxLength": 20,
    "minLength": 1,
    "type": "string"
   },
   "slugOriginal": {
    "description": "Only the language versions of one article: its original slug before translation",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "websiteId": {
    "description": "Only articles on this website; every website when absent",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_documents",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "documents": {
    "description": "Article metadata, most recently edited first. Document content, embeddings, prompts, organization ids and arbitrary metadata are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "lastEditTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "locale": {
       "anyOf": [
        {
         "maxLength": 20,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "published": {
       "type": "boolean"
      },
      "slug": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "websiteId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "title",
      "slug",
      "locale",
      "websiteId",
      "published",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "page": {
    "additionalProperties": false,
    "description": "hasMore is true when more articles follow; pass nextCursor as cursor to get them",
    "properties": {
     "count": {
      "maximum": 50,
      "minimum": 0,
      "type": "integer"
     },
     "hasMore": {
      "type": "boolean"
     },
     "nextCursor": {
      "anyOf": [
       {
        "maxLength": 4096,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "count",
     "hasMore",
     "nextCursor"
    ],
    "type": "object"
   }
  },
  "required": [
   "documents",
   "page"
  ],
  "type": "object"
 },
 "title": "List help-center articles"
}
