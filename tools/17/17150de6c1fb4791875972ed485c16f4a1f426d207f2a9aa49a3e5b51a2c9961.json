{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "List documents built with Elementor (paginated).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "type": "string"
   },
   "fields": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "post_type": {
    "type": "string"
   },
   "status": {
    "default": "any",
    "enum": [
     "any",
     "publish",
     "draft",
     "pending",
     "private",
     "trash"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "elementor.pages.list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "integer"
      },
      "status": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "total": {
    "type": "integer"
   }
  },
  "required": [
   "items",
   "next_cursor",
   "total"
  ],
  "type": "object"
 },
 "title": "List Elementor pages"
}
