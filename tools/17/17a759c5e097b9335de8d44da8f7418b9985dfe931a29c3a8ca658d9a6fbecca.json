{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Read a transaction's outcome"
 },
 "description": "Reports what a sent Base transaction did: pending, succeeded, reverted or not found; its block and confirmations; the fee paid; the net token movements for the sender (GBLIN shares minted or redeemed, USDC, basket tokens); and, when it reverted, the decoded reason.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "hash": {
    "description": "The transaction hash.",
    "pattern": "^0x[0-9a-fA-F]{64}$",
    "type": "string"
   }
  },
  "required": [
   "hash"
  ],
  "type": "object"
 },
 "name": "actions.status",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "balance_changes": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "block": {
    "type": "number"
   },
   "confirmations": {
    "type": [
     "number",
     "null"
    ]
   },
   "explorer": {
    "type": "string"
   },
   "fee_eth": {
    "type": "string"
   },
   "from": {
    "type": "string"
   },
   "gas_limit": {
    "type": [
     "number",
     "null"
    ]
   },
   "gas_used": {
    "type": "number"
   },
   "hash": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "revert": {
    "type": "object"
   },
   "status": {
    "enum": [
     "pending",
     "not_found",
     "success",
     "reverted"
    ],
    "type": "string"
   },
   "to": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "hash",
   "status"
  ],
  "type": "object"
 }
}
