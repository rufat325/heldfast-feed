     },
     "question": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Market question",
      "title": "Question"
     },
     "score": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "X sentiment: -100 very bearish .. +100 very bullish",
      "title": "Score"
     },
     "score_before": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Previous daily score, if any",
      "title": "Score Before"
     },
     "scored_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "ISO-8601 UTC time of the score",
      "title": "Scored At"
     },
     "shift": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "score minus score_before",
      "title": "Shift"
     },
     "stale": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "True when the score is more than 36 hours old",
      "title": "Stale"
     },
     "volume_signal": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "rising, falling or flat",
      "title": "Volume Signal"
     }
    },
    "title": "ScoredMarket",
    "type": "object"
   }
