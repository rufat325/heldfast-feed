{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Daily market scores (free)"
 },
 "description": "Free. Latest daily X (Twitter) sentiment score for each prediction market we track\n(Polymarket), with the change since the previous day, the catalyst and the market's Yes\nprice. For a fresh score on any other question use get_market_sentiment.",
 "inputSchema": {
  "properties": {},
  "title": "get_daily_scoresArguments",
  "type": "object"
 },
 "name": "get_daily_scores",
 "outputSchema": {
  "$defs": {
   "ScoredMarket": {
    "additionalProperties": true,
    "properties": {
     "catalyst": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "One-sentence driver of the chatter",
      "title": "Catalyst"
     },
     "label": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Short market label",
      "title": "Label"
     },
     "market_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Polymarket market id",
      "title": "Market Id"
     },
     "polymarket_yes_price": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Polymarket Yes price (0..1) at scoring time",
      "title": "Polymarket Yes Price"
     },
     "prior_scored_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
