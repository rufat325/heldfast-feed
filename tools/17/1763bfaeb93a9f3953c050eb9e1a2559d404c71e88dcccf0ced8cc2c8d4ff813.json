    "title": "As Of"
   },
   "count": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Count"
   },
   "markets": {
    "items": {
     "$ref": "#/$defs/ScoredMarket"
    },
    "title": "Markets",
    "type": "array"
   },
   "note": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Note"
   }
  },
  "title": "DailyScores",
  "type": "object"
 },
 "title": "Daily market scores (free)"
}
