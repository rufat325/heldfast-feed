{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update fields on an existing catalog product by id \u2014 including status, to publish a draft or archive a product. Provide a patch with at least one field; use get_product first to see the current values. A changed stock number is applied as a relative movement and recorded in the product stock history; prefer adjust_stock when the intent is a correction with a reason. A change to price, stock, tracking or status is pushed to every connected sales channel. For a product that belongs to a model, a changed shared field (name, description, category, brand, unit, keywords, videos, material, pattern, gender, age group, size type, condition) is applied to the whole model and every article of it; productGroupId null detaches the product from its model, and the code of another model moves it there. The result echoes the operating workspace.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "The product id returned by search_products.",
    "minLength": 1,
    "type": "string"
   },
   "patch": {
    "additionalProperties": false,
    "description": "The product fields to update; include at least one changed field.",
    "properties": {
     "ageGroup": {
      "anyOf": [
       {
        "enum": [
         "newborn",
         "infant",
         "toddler",
         "kids",
         "adult"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "brandId": {
      "anyOf": [
       {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "bundleItems": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "productId": {
         "maxLength": 160,
         "minLength": 1,
         "type": "string"
        },
        "quantity": {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        }
       },
       "required": [
        "productId",
        "quantity"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "categoryId": {
      "anyOf": [
       {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "color": {
      "anyOf": [
       {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "compareAtPrice": {
      "anyOf": [
       {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "minLength": 1,
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "condition": {
      "anyOf": [
       {
        "enum": [
         "new",
         "used",
         "refurbished"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "costCurrency": {
      "anyOf": [
       {
        "pattern": "^[A-Z]{3}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "costPrice": {
      "anyOf": [
       {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "minLength": 1,
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "depth": {
      "anyOf": [
       {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "minLength": 1,
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "description": {
      "anyOf": [
       {
        "maxLength": 2000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "dimensionUnit": {
      "anyOf": [
       {
        "enum": [
         "cm",
         "mm",
