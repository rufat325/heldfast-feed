        "type": "null"
       }
      ]
     },
     "ean": {
      "anyOf": [
       {
        "pattern": "^[0-9]{8,14}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "GTIN/EAN-8/12/13/14 barcode. Presence-and-shape validation only, no checksum.",
      "example": "4006381333931"
     },
     "gender": {
      "anyOf": [
       {
        "enum": [
         "male",
         "female",
         "unisex"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "height": {
      "anyOf": [
       {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "minLength": 1,
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "images": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "contentType": {
         "enum": [
          "image/jpeg",
          "image/png",
          "image/webp"
         ],
         "type": "string"
        },
        "name": {
         "maxLength": 255,
         "minLength": 1,
         "type": "string"
        },
        "pathname": {
         "minLength": 1,
         "type": "string"
        },
        "size": {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        },
        "uploadedAt": {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
         "type": "string"
        },
        "url": {
         "format": "uri",
         "type": "string"
        }
       },
       "required": [
        "url"
       ],
       "type": "object"
      },
      "maxItems": 10,
      "type": "array"
     },
     "material": {
      "anyOf": [
       {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "name": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     },
     "pattern": {
      "anyOf": [
       {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "price": {
      "anyOf": [
       {
        "anyOf": [
         {
          "type": "number"
         },
