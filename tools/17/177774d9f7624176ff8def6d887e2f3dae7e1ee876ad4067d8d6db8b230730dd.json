         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "productGroupId": {
      "anyOf": [
       {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "size": {
      "anyOf": [
       {
        "maxLength": 60,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "sizeSystem": {
      "anyOf": [
       {
        "enum": [
         "AU",
         "BR",
         "CN",
         "DE",
         "EU",
         "FR",
         "IT",
         "JP",
         "MEX",
         "UK",
         "US"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "sizeType": {
      "anyOf": [
       {
        "maxLength": 40,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "sku": {
      "anyOf": [
       {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "status": {
      "default": "draft",
      "enum": [
       "draft",
       "active",
       "archived"
      ],
      "type": "string"
     },
     "stock": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "supplierId": {
      "anyOf": [
       {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "tags": {
      "default": [],
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     },
     "trackInventory": {
      "default": false,
      "type": "boolean"
     },
     "type": {
      "default": "simple",
      "enum": [
       "simple",
       "bundle"
      ],
      "type": "string"
     },
     "unit": {
      "anyOf": [
       {
        "maxLength": 40,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "videos": {
      "default": [],
      "description": "Video links for the product page (YouTube, Vimeo or a direct file), https only, at most 5. Links, not uploads. On update, sending the field replaces the whole list.",
      "example": [
       {
        "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
       }
      ],
      "items": {
       "properties": {
        "url": {
         "format": "uri",
         "type": "string"
        }
       },
       "required": [
        "url"
       ],
       "type": "object"
      },
      "maxItems": 5,
      "type": "array"
     },
     "warehouseId": {
      "anyOf": [
       {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
