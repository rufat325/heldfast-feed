{
 "description": "Search skills in the ClawHub.ai catalog. Required: q (search query). Optional: limit, highlightedOnly, nonSuspiciousOnly.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "highlightedOnly": {
    "type": "boolean"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "nonSuspiciousOnly": {
    "type": "boolean"
   },
   "q": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "clawhub_search"
}
