{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Account"
 },
 "description": "Update CRM account/customer profile fields such as name, phone, email, life stage, owner, notes, or member code.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The account ID to update",
    "type": "string"
   },
   "assignedTo": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Assigned team member user ID, or null to clear"
   },
   "dateOfBirth": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "YYYY-MM-DD date of birth, or null to clear"
   },
   "email": {
    "description": "Email address",
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "firstName": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "First name for individual accounts"
   },
   "gender": {
    "description": "Gender",
    "type": "string"
   },
   "lastName": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Last name for individual accounts"
   },
   "lifeStage": {
    "description": "CRM life stage",
    "enum": [
     "lead",
     "active",
     "churned",
     "vip"
    ],
    "type": "string"
   },
   "memberCode": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Merchant member code, or null to clear"
   },
   "name": {
    "description": "Account/customer display name",
    "type": "string"
   },
   "notes": {
    "description": "Internal notes",
    "type": "string"
   },
   "phone": {
    "description": "Phone number",
    "type": "string"
   },
   "referredByAccountId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Referrer account ID, or null to clear"
   },
   "source": {
    "description": "Acquisition source",
    "enum": [
     "walk_in",
     "online",
     "pos",
     "whatsapp",
     "referral",
     "import",
     "api",
     "shopify",
     "woocommerce",
     "email"
    ],
    "type": "string"
   },
   "type": {
    "description": "Account type",
    "enum": [
     "individual",
     "business",
     "household"
    ],
    "type": "string"
   }
  },
  "required": [
   "accountId"
  ],
  "type": "object"
 },
 "name": "update_account",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
