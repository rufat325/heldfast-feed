{
 "annotations": {
  "readOnlyHint": true,
  "title": "List jobs"
 },
 "description": "List jobs (work orders that pull stock out), most recently updated first, filterable by name prefix and status. Paginated via meta.pagination.has_next. Sortly: GET /api/v1/jobs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "name": {
    "description": "Jobs whose name starts with this (case-insensitive).",
    "type": "string"
   },
   "page": {
    "description": "Page number, starting at 1.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Page size, 1-100 (default 20).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "sort_by": {
    "description": "Sort field. Default updated_at.",
    "enum": [
     "name",
     "status",
     "start_date",
     "end_date",
     "created_by_name",
     "updated_at"
    ],
    "type": "string"
   },
   "sort_direction": {
    "description": "Default desc.",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "status": {
    "description": "Only these statuses. Default all.",
    "items": {
     "enum": [
      "not_started",
      "in_progress",
      "completed"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "sortly_list_jobs",
 "title": "List jobs"
}
