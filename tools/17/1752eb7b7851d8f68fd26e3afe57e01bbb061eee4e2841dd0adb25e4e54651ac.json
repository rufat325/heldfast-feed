{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Ask for content in plain English; automatically selects the best sources from all 152 libraries, generates optimized per-source queries, and searches in parallel. Use this as the default entry point for any natural-language request. Use library_search instead when you already know which source to query. Requires OPENAI_API_KEY (already set for embeddings). Set response_format: \"detailed\" for routing reasons and per-stage diagnostics.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "max_sources": {
    "default": 5,
    "description": "Max number of sources to search (default 5)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Natural language description of what you want to find",
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "response_format": {
    "default": "concise",
    "description": "concise (default) trims results/citations to high-signal fields; detailed returns the full payload, including routing reasons, scores, and stage diagnostics.",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   },
   "results_per_source": {
    "default": 5,
    "description": "Results to fetch per source (default 5)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "library_ask",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "errors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "error": {
       "type": "string"
      },
      "source": {
       "type": "string"
      }
     },
     "required": [
      "source",
      "error"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "intent": {
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "authors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "cluster": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "downloadUrl": {
       "type": "string"
      },
      "hasFullText": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      },
      "language": {
       "type": "string"
      },
      "previewUrl": {
       "type": "string"
      },
      "published": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "subjects": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "year": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "source",
      "title",
      "hasFullText"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "routing": {
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "query": {
         "type": "string"
        },
        "reason": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "source",
        "query",
        "reason"
       ],
       "type": "object"
      },
      {
       "type": "string"
      }
     ]
    },
    "type": "array"
   },
   "sources_searched": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "stage1": {
    "enum": [
     "embeddings",
     "bm25"
    ],
    "type": "string"
   },
   "stage2": {
    "enum": [
     "llm",
     "skipped"
    ],
    "type": "string"
   },
   "total_results": {
    "type": "number"
   }
  },
  "required": [
   "query",
   "intent",
   "sources_searched",
   "total_results",
   "results",
   "routing",
   "errors"
  ],
  "type": "object"
 },
 "title": "Natural Language Library Search"
}
