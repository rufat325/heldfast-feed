{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Returns a summary of all Infomaniak organizations and products you have access to. Best called first in a session.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "account_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "infomaniak_overview",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "accounts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "account_id": {
       "type": "number"
      },
      "account_name": {
       "type": "string"
      },
      "by_service": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "count": {
          "type": "number"
         },
         "service_name": {
          "type": "string"
         }
        },
        "required": [
         "service_name",
         "count"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "total_products": {
       "type": "number"
      }
     },
     "required": [
      "account_id",
      "account_name",
      "total_products",
      "by_service"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary_markdown": {
    "type": "string"
   },
   "total_accounts": {
    "type": "number"
   },
   "total_products": {
    "type": "number"
   }
  },
  "required": [
   "total_accounts",
   "total_products",
   "accounts",
   "summary_markdown"
  ],
  "type": "object"
 }
}
