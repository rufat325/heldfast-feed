{
 "description": "Create a webhook subscription for message events",
 "inputSchema": {
  "properties": {
   "channel": {
    "description": "Channel to subscribe to",
    "enum": [
     "sms",
     "whatsapp",
     "rcs",
     "email",
     "voice",
     "facebook"
    ],
    "type": "string"
   },
   "eventType": {
    "description": "Event type",
    "enum": [
     "MESSAGE",
     "MESSAGE_STATUS"
    ],
    "type": "string"
   },
   "url": {
    "description": "Webhook URL to receive events",
    "type": "string"
   }
  },
  "required": [
   "url",
   "channel",
   "eventType"
  ],
  "type": "object"
 },
 "name": "create_subscription"
}
