{
 "description": "Get JSON metadata for one blob (GET /v1/blobs/{blob_id}/meta). Requires LITHTRIX_API_KEY.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blob_id": {
    "description": "Content-addressed blob id (b_ + 16 hex chars)",
    "maxLength": 19,
    "minLength": 19,
    "pattern": "^b_[0-9a-f]{16}$",
    "type": "string"
   }
  },
  "required": [
   "blob_id"
  ],
  "type": "object"
 },
 "name": "lithtrix_blob_meta"
}
