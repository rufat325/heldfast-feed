{
 "description": "Show current mcp-gmail user identity. Returns email, alias (if set), and session expiry information.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {},
  "type": "object"
 },
 "name": "account-me",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "alias": {
        "type": "string"
       },
       "email": {
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "service": {
        "type": "string"
       },
       "sessionExpiresIn": {
        "type": [
         "string",
         "null"
        ]
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "service",
       "email",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
