  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new warehouse in Holded.\n\nArgs:\n  - name (string): Warehouse name (required)\n  - address (object): Warehouse address\n  - default (boolean): Whether this is the default warehouse\n  - email (string): Warehouse email\n  - phone (string): Warehouse phone number\n  - mobile (string): Warehouse mobile number\n\nReturns:\n  The created warehouse with its assigned ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "additionalProperties": false,
    "description": "Warehouse address",
    "properties": {
     "address": {
      "description": "Street address",
      "type": "string"
     },
     "city": {
      "description": "City name",
      "type": "string"
     },
     "country": {
      "description": "Country name",
      "type": "string"
     },
     "countryCode": {
      "description": "Country code (ISO 3166-1 alpha-2)",
      "type": "string"
     },
     "postalCode": {
      "description": "Postal/ZIP code",
      "type": "string"
     },
     "province": {
      "description": "Province/State",
      "type": "string"
     }
    },
    "type": "object"
   },
   "default": {
    "description": "Whether this is the default warehouse",
    "type": "boolean"
   },
   "email": {
    "description": "Warehouse email",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "mobile": {
    "description": "Warehouse mobile number",
    "type": "string"
   },
   "name": {
    "description": "Warehouse name (required)",
    "minLength": 1,
    "type": "string"
   },
   "phone": {
    "description": "Warehouse phone number",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "holded_invoicing_create_warehouse",
 "title": "Create Holded Warehouse"
}
