{
 "description": "Check a persistent watch or URL for changes, with noise filtering, conditional HTTP and a compact deterministic diff. $0.005 USDC.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "ignore_json_paths": {
    "items": {
     "maxLength": 256,
     "minLength": 1,
     "pattern": "^\\/",
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "ignore_selectors": {
    "items": {
     "maxLength": 256,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "include_diff": {
    "type": "boolean"
   },
   "max_age_seconds": {
    "maximum": 86400,
    "minimum": 0,
    "type": "integer"
   },
   "previous_hash": {
    "pattern": "^[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "selector": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "format": "uri",
    "maxLength": 4096,
    "type": "string"
   },
   "watch_id": {
    "pattern": "^w_[a-f0-9]{32}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "fresh402_check"
}
