{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search MyAnimeList characters by name. Returns compact summaries and the mal_id needed by get_character. Use get_anime_characters instead if you already have an anime's mal_id and want its full cast.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "letter": {
    "description": "Restrict results to entries whose title starts with this single letter.",
    "maxLength": 1,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Max results per page (1-50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "order_by": {
    "description": "Field to order by.",
    "enum": [
     "mal_id",
     "name",
     "favorites"
    ],
    "type": "string"
   },
   "page": {
    "description": "1-based page number for pagination (1-1000).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Character name.",
    "minLength": 1,
    "type": "string"
   },
   "sort": {
    "description": "Sort direction.",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search_characters",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "page": {
    "additionalProperties": false,
    "properties": {
     "current_page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "has_next_page": {
      "type": "boolean"
     },
     "last_visible_page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "about": {
       "type": "string"
      },
      "anime": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "mal_id": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
         },
         "position": {
          "type": "string"
         },
         "role": {
          "type": "string"
         },
         "title": {
          "type": "string"
         }
        },
        "required": [
         "mal_id"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "favorites": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "image_url": {
       "type": "string"
      },
      "mal_id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "manga": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "mal_id": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
         },
         "position": {
          "type": "string"
         },
         "role": {
          "type": "string"
         },
         "title": {
          "type": "string"
         }
        },
        "required": [
         "mal_id"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "name_kanji": {
       "type": "string"
      },
      "nicknames": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "url": {
       "type": "string"
      },
      "voice_actors": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "language": {
          "type": "string"
         },
         "mal_id": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
         },
         "name": {
          "type": "string"
         }
        },
        "required": [
         "mal_id"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "mal_id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results",
   "page"
  ],
  "type": "object"
 },
 "title": "Search characters"
}
