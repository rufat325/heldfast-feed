{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Decision Add"
 },
 "description": "Add an active decision to the local Decision Graph.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alternatives_rejected": {
    "description": "Alternatives considered and rejected.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "author": {
    "description": "Agent or person authoring the decision. Defaults to RAVEN_AGENT_ID or unknown.",
    "type": [
     "string",
     "null"
    ]
   },
   "component_ref": {
    "description": "Component or surface the decision refers to.",
    "minLength": 1,
    "type": "string"
   },
   "rationale": {
    "description": "Reason for the decision. Omit when no rationale was recorded.",
    "type": "string"
   },
   "scope": {
    "description": "Scope where the decision applies.",
    "minLength": 1,
    "type": "string"
   },
   "statement": {
    "description": "Decision statement.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "statement",
   "scope",
   "component_ref"
  ],
  "type": "object"
 },
 "name": "decision_add"
}
