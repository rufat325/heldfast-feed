{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Edit strategy"
 },
 "description": "Applies an atomic batch of section edits using the revision returned by get_strategy. Replacements apply directly, without redlines, and preserve unchanged text and comment anchors. Ambiguous matches and edits touching pending review changes made in the application editor are rejected. The response includes orphaned_discussion_ids for retained threads whose anchored text was removed. Conflicting revisions are rejected without applying changes. Requires strategy management rights.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "operations": {
    "items": {
     "oneOf": [
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "insert_section",
         "type": "string"
        },
        "index": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "section": {
         "additionalProperties": false,
         "properties": {
          "content": {
           "description": "Section body as Markdown",
           "maxLength": 500000,
           "type": "string"
          },
          "title": {
           "maxLength": 500,
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "title",
          "content"
         ],
         "type": "object"
        }
       },
       "required": [
        "action",
        "section"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "replace_section",
         "type": "string"
        },
        "content": {
         "maxLength": 500000,
         "type": "string"
        },
        "section_id": {
         "maxLength": 128,
         "pattern": "^[a-zA-Z0-9_-]+$",
         "type": "string"
        },
        "title": {
         "maxLength": 500,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "action",
        "section_id"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "delete_section",
         "type": "string"
        },
        "section_id": {
         "maxLength": 128,
         "pattern": "^[a-zA-Z0-9_-]+$",
         "type": "string"
        }
       },
       "required": [
        "action",
        "section_id"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "reorder_sections",
         "type": "string"
        },
        "section_ids": {
         "items": {
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "type": "string"
         },
         "maxItems": 50,
         "minItems": 1,
         "type": "array"
        }
       },
       "required": [
        "action",
        "section_ids"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "rename",
         "type": "string"
        },
        "title": {
         "maxLength": 500,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "action",
        "title"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "revision": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "strategy_id": {
    "description": "Strategy identifier",
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "strategy_id",
   "revision",
   "operations"
  ],
  "type": "object"
 },
 "name": "edit_strategy",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "id": {
    "type": "string"
   },
   "kind": {
    "const": "STRATEGY",
    "type": "string"
   },
   "orphaned_discussion_ids": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "refNum": {
    "type": [
     "string",
     "null"
    ]
   },
   "revision": {
    "type": "string"
   },
   "sections": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "anyOf": [
     {
      "enum": [
       "DRAFT",
       "PUBLISHED"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "title": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "title",
   "kind",
   "revision",
   "sections",
   "url"
  ],
  "type": "object"
 },
 "title": "Edit strategy"
}
