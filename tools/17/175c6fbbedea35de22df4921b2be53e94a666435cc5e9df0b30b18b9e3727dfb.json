{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Triage digest"
 },
 "description": "Structured overview of a mailbox slice for triage DECISIONS \u2014 sender / label / age buckets, unread and attachment counts, and header-derived signals (newsletter / automated / calendar / replyToMismatch \u2014 thread counts overall, and per sender the set of signals its threads carry), instead of a raw thread list. USE WHEN: deciding what to bulk-archive/snooze/label, or summarizing inbox state ('what's in my inbox?'). DO NOT USE: to read a specific thread (use search/get_thread). Samples up to `max` most-recent matches; hasMore flags that more matched than were sampled. byAge buckets by each thread's FIRST message date (thread age, not last activity). SIDE EFFECTS: none.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "max": {
    "default": 100,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "default": "in:inbox",
    "minLength": 1,
    "type": "string"
   },
   "topN": {
    "default": 10,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "triage_digest",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "byAge": {
    "additionalProperties": false,
    "properties": {
     "last24h": {
      "type": "number"
     },
     "last30d": {
      "type": "number"
     },
     "last7d": {
      "type": "number"
     },
     "older": {
      "type": "number"
     },
     "undated": {
      "type": "number"
     }
    },
    "required": [
     "last24h",
     "last7d",
     "last30d",
     "older",
     "undated"
    ],
    "type": "object"
   },
   "hasMore": {
    "type": "boolean"
   },
   "query": {
    "type": "string"
   },
   "sampled": {
    "type": "number"
   },
   "signals": {
    "additionalProperties": false,
    "properties": {
     "automated": {
      "type": "number"
     },
     "calendar": {
      "type": "number"
     },
     "newsletter": {
      "type": "number"
     },
     "replyToMismatch": {
      "type": "number"
     }
    },
    "required": [
     "newsletter",
     "automated",
     "calendar",
     "replyToMismatch"
    ],
    "type": "object"
   },
   "topLabels": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "type": "number"
      },
      "label": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "count"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "topSenders": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "sender": {
       "type": "string"
      },
      "signals": {
       "items": {
        "enum": [
         "newsletter",
         "automated",
         "calendar",
         "replyToMismatch"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "unread": {
       "type": "number"
      }
     },
     "required": [
      "sender",
      "name",
      "count",
      "unread",
      "signals"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "unread": {
    "type": "number"
   },
   "withAttachments": {
    "type": "number"
   }
  },
  "required": [
   "query",
   "sampled",
   "hasMore",
   "unread",
   "withAttachments",
   "byAge",
   "signals",
   "topSenders",
   "topLabels"
  ],
  "type": "object"
 }
}
