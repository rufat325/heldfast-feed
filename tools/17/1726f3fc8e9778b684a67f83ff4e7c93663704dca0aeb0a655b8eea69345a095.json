{
 "_meta": {
  "openai/outputTemplate": "ui://ponito/widget-v1.html",
  "openai/toolInvocation/invoked": "Found products on Ponito",
  "openai/toolInvocation/invoking": "Searching Ponito",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://ponito/widget-v1.html",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search Ponito's product catalogue. Call this for any shopping query \u2014 finding products, comparing options, or checking who sells something in a given country. Returns GTIN-anchored products with their best offer (lowest price, integer minor units) and shop count.",
 "inputSchema": {
  "properties": {
   "country": {
    "description": "The shopper's country (offers and prices are country-specific).",
    "enum": [
     "CH",
     "DE",
     "FR",
     "GB",
     "AT",
     "ES",
     "NL"
    ],
    "type": "string"
   },
   "language": {
    "default": "en",
    "description": "Language to search and label results in.",
    "enum": [
     "de",
     "fr",
     "en",
     "it",
     "es",
     "pt",
     "nl"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Max results, 1-25.",
    "type": "integer"
   },
   "query": {
    "description": "What the shopper is looking for, e.g. \"quiet robot vacuum\" or \"Bosch dishwasher 60cm\".",
    "type": "string"
   },
   "sort": {
    "default": "relevance",
    "description": "\"relevance\" (popularity-weighted, default) or \"cheapest\" (lowest price first).",
    "enum": [
     "relevance",
     "cheapest"
    ],
    "type": "string"
   }
  },
  "required": [
   "query",
   "country"
  ],
  "type": "object"
 },
 "name": "search_products",
 "outputSchema": {
  "properties": {
   "products": {
    "description": "Matching products, most relevant (or cheapest) first.",
    "items": {
     "properties": {
      "best_offer": {
       "properties": {
        "currency": {
         "type": "string"
        },
        "price": {
         "description": "Lowest current price in minor units (cents/rappen).",
         "type": "integer"
        },
        "shops_count": {
         "description": "Number of shops currently offering the product.",
         "type": "integer"
        }
       },
       "required": [
        "price",
        "currency",
        "shops_count"
       ],
       "type": [
        "object",
        "null"
       ]
      },
      "brand": {
       "type": [
        "string",
        "null"
       ]
      },
      "gtins": {
       "description": "GTIN (EAN/UPC) barcodes.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "description": "Ponito product id.",
       "type": "string"
      },
      "image": {
       "description": "Product photo, served from Ponito.",
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": [
        "string",
        "null"
       ]
      },
      "rating": {
       "description": "Average user rating, 0-5.",
       "type": [
        "number",
        "null"
       ]
      },
      "url": {
       "description": "Ponito product page listing all offers in the country.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "brand",
      "gtins",
      "rating",
      "image",
      "best_offer",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "products"
  ],
  "type": "object"
 },
 "title": "Search Products Tool"
}
