{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return published catalogue facts for one exact listing id, including price, location and markers when published.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Exact listing id returned by match_listings.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_listing",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "catalogueNotice": {
    "additionalProperties": false,
    "properties": {
     "clinicalSuitability": {
      "const": "not-assessed",
      "type": "string"
     },
     "exhaustiveCoverage": {
      "const": false,
      "type": "boolean"
     },
     "pricesLiveVerified": {
      "const": false,
      "type": "boolean"
     },
     "source": {
      "const": "compiled-public-catalogue",
      "type": "string"
     }
    },
    "required": [
     "source",
     "exhaustiveCoverage",
     "pricesLiveVerified",
     "clinicalSuitability"
    ],
    "type": "object"
   },
   "disclaimer": {
    "type": "string"
   },
   "found": {
    "type": "boolean"
   },
   "id": {
    "type": "string"
   },
   "listing": {
    "additionalProperties": false,
    "properties": {
     "catalogueStatus": {
      "const": "published-example",
      "type": "string"
     },
     "category": {
      "type": "string"
     },
     "clinicName": {
      "type": "string"
     },
     "county": {
      "type": "string"
     },
     "eircode": {
      "type": "string"
     },
     "eircodeRoutingKey": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "markers": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "name"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "markersPublished": {
      "type": "boolean"
     },
     "national": {
      "type": "boolean"
     },
     "panelId": {
      "type": "string"
     },
     "panelName": {
      "type": "string"
     },
     "priceEur": {
      "type": [
       "number",
       "null"
      ]
     },
     "priceNote": {
      "type": [
       "string",
       "null"
      ]
     },
     "provider": {
      "type": "string"
     },
     "providerRelationship": {
      "const": "no-partnership",
      "type": "string"
     },
     "serviceMode": {
      "enum": [
       "home-kit",
       "clinic"
      ],
      "type": "string"
     },
     "serviceTowns": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "town": {
      "type": "string"
     },
     "venueNote": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "id",
     "catalogueStatus",
     "providerRelationship",
     "provider",
     "clinicName",
     "town",
     "county",
     "eircode",
     "eircodeRoutingKey",
     "serviceTowns",
     "national",
     "serviceMode",
     "venueNote",
     "panelName",
     "panelId",
     "priceEur",
     "priceNote",
     "category",
     "markersPublished",
     "markers"
    ],
    "type": "object"
   }
  },
  "required": [
   "found",
   "id",
   "catalogueNotice",
   "disclaimer"
  ],
  "type": "object"
 },
 "title": "View blood-test details"
}
