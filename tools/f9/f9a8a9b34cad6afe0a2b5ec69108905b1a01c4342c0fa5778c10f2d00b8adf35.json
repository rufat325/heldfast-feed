{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List RedTrack campaigns with optional filtering by title, status, source, tags, and date range. Returns campaign config and optionally embedded stats when total_stat is true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "date_from": {
    "description": "Stats date from (YYYY-MM-DD)",
    "type": "string"
   },
   "date_to": {
    "description": "Stats date to (YYYY-MM-DD)",
    "type": "string"
   },
   "ids": {
    "description": "Filter by campaign IDs (comma-separated)",
    "type": "string"
   },
   "page": {
    "description": "Page number",
    "type": "number"
   },
   "per": {
    "description": "Items per page",
    "type": "number"
   },
   "sources": {
    "description": "Filter by source IDs (comma-separated)",
    "type": "string"
   },
   "status": {
    "description": "Filter by status (comma-separated). 1=active, 2=paused, 3=deleted",
    "type": "string"
   },
   "tags": {
    "description": "Filter by tags (comma-separated)",
    "type": "string"
   },
   "timezone": {
    "description": "Timezone for stats",
    "type": "string"
   },
   "title": {
    "description": "Filter by campaign title (substring match)",
    "type": "string"
   },
   "total_stat": {
    "description": "Include total statistics (changes response to {total, items})",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "get_campaigns"
}
