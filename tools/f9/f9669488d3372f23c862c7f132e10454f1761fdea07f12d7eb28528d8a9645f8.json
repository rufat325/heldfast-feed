{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get the forward-looking 10-K / 10-Q SEC filing-deadline calendar within a date window. Optionally restrict to a universe (sp500/ndx/dji/all) and/or a list of form types (default both 10-K and 10-Q).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "formTypes": {
    "description": "Optional SEC form types subset, e.g. [\"10-Q\"]",
    "items": {
     "enum": [
      "10-K",
      "10-Q"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "from": {
    "description": "Start date inclusive (YYYY-MM-DD, default today)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "to": {
    "description": "End date inclusive (YYYY-MM-DD, default today + 45d)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "universe": {
    "description": "Optional index-universe filter (default \"all\")",
    "enum": [
     "sp500",
     "ndx",
     "dji",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_filing_calendar",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "Get SEC Filing Calendar"
}
