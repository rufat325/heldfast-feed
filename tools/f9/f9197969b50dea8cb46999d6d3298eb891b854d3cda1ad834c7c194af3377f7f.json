{
 "description": "Create a new standard campaign",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "advertiser": {
    "description": "Advertiser ID",
    "type": "number"
   },
   "budget": {
    "additionalProperties": false,
    "description": "Budget limits (daily/weekly/monthly/lifetime)",
    "properties": {
     "daily": {
      "type": "number"
     },
     "lifetime": {
      "type": "number"
     },
     "monthly": {
      "type": "number"
     },
     "weekly": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "contract": {
    "description": "Contract ID (requires Contract Management add-on)",
    "type": "number"
   },
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Custom metadata key-value pairs",
    "type": "object"
   },
   "name": {
    "description": "Campaign name",
    "type": "string"
   },
   "roadblock_tags": {
    "description": "Tag to link campaign to a roadblock",
    "type": "string"
   },
   "scheduling_source": {
    "description": "Whether scheduling is set at campaign or ad item level",
    "enum": [
     "CAMPAIGN",
     "AD_ITEM"
    ],
    "type": "string"
   },
   "targeting_source": {
    "description": "Whether targeting is set at campaign or ad item level",
    "enum": [
     "CAMPAIGN",
     "AD_ITEM"
    ],
    "type": "string"
   },
   "trusted_redirect_domains": {
    "description": "Array of trusted redirect domains",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_campaign"
}
