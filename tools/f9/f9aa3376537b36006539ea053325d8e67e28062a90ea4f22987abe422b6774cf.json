  "readOnlyHint": true
 },
 "description": "Use this when a user asks about their SLO error budget, remaining error budget, or burn rate. Given SLO percentage and window, returns budget minutes remaining, burn rate multiplier, and status (Under budget / Elevated / ALERTING).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "consumed_minutes": {
    "description": "consumed in minutes.",
    "examples": [
     1
    ],
    "minimum": 0,
    "type": "number"
   },
   "slo_pct": {
    "description": "Service-level objective target expressed as a percentage.",
    "examples": [
     0.001
    ],
    "maximum": 99.9999,
    "minimum": 0.001,
    "type": "number"
   },
   "window_days": {
    "description": "Length of the service-level objective window in days.",
    "examples": [
     1
    ],
    "minimum": 1,
    "type": "number"
   },
   "window_elapsed_days": {
    "description": "window elapsed days used by this deterministic tool.",
    "examples": [
     1
    ],
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "slo_pct"
  ],
  "type": "object"
 },
