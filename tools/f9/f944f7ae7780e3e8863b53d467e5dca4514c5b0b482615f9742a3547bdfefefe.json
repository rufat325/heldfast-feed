{"_meta":{"securitySchemes":[{"type":"noauth"}],"ui":{"resourceUri":"ui://celestio/chart-wheel.html"},"ui/resourceUri":"ui://celestio/chart-wheel.html"},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Calculates a birth chart (planets, signs, houses, rising sign, aspects) for anyone from their name, birth date, place and, if known, time. No account needed and nothing is saved. Returns the positions, a short summary and readingUrl, a link that opens the free written reading on celestio.ai with the details filled in. For a written reading inside the chat use get_birth_reading.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"date":{"description":"Birth date, YYYY-MM-DD, between 1900-01-01 and 2100-12-31","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"latitude":{"description":"Optional: exact latitude; with longitude and timeZone it overrides the place search","maximum":90,"minimum":-90,"type":"number"},"longitude":{"maximum":180,"minimum":-180,"type":"number"},"name":{"description":"Name of the person, e.g. \"Maya\"","maxLength":100,"minLength":1,"type":"string"},"place":{"description":"Birth place as \"City, Country\" or \"City, Region, Country\", e.g. \"Sofia, Bulgaria\"","maxLength":200,"minLength":2,"type":"string"},"time":{"description":"Local birth time, 24-hour (\"14:30\") or 12-hour (\"2:30 PM\", \"2:30 p.m.\", \"2pm\"). Leave out when unknown: the chart then has no rising sign or houses","maxLength":20,"type":"string"},"timeZone":{"description":"Optional IANA zone, e.g. \"Europe/Sofia\"","maxLength":64,"minLength":1,"type":"string"}},"required":["name","date","place"],"type":"object"},"name":"compute_birth_chart","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"angles":{"items":{"additionalProperties":false,"properties":{"angle":{"type":"string"},"position":{"type":"string"},"sign":{"type":"string"}},"required":["angle","sign","position"],"type":"object"},"type":"array"},"aspects":{"items":{"type":"string"},"type":"array"},"houseSystem":{"type":["string","null"]},"name":{"type":"string"},"notes":{"items":{"type":"string"},"type":"array"},"place":{"type":"string"},"planets":{"items":{"additionalProperties":false,"properties":{"body":{"type":"string"},"house":{"type":"number"},"position":{"type":"string"},"retrograde":{"type":"boolean"},"sign":{"type":"string"}},"required":["body","sign","position","retrograde"],"type":"object"},"type":"array"},"readingUrl":{"type":"string"},"summary":{"type":"string"},"timeKnown":{"type":"boolean"}},"required":["name","timeKnown","houseSystem","place","summary","planets","angles","aspects","notes","readingUrl"],"type":"object"},"title":"Compute a birth chart"}
