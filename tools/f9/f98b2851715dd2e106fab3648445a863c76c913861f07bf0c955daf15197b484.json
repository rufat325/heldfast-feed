{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new email filter",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "addLabelIds": {
    "description": "Label IDs to add",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "excludeChats": {
    "description": "Exclude chat messages",
    "type": "boolean"
   },
   "forward": {
    "description": "Email address to forward to",
    "type": "string"
   },
   "from": {
    "description": "Match emails from this sender",
    "type": "string"
   },
   "hasAttachment": {
    "description": "Match emails with attachments",
    "type": "boolean"
   },
   "negatedQuery": {
    "description": "Exclude emails matching this query",
    "type": "string"
   },
   "query": {
    "description": "Match emails matching this query (same as Gmail search)",
    "type": "string"
   },
   "removeLabelIds": {
    "description": "Label IDs to remove",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "size": {
    "description": "Match emails larger/smaller than this size (bytes)",
    "type": "number"
   },
   "sizeComparison": {
    "description": "Size comparison operator",
    "enum": [
     "larger",
     "smaller"
    ],
    "type": "string"
   },
   "subject": {
    "description": "Match emails with this subject",
    "type": "string"
   },
   "to": {
    "description": "Match emails to this recipient",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "filter_create",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "additionalProperties": false,
    "properties": {
     "addLabelIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "forward": {
      "type": "string"
     },
     "removeLabelIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "criteria": {
    "additionalProperties": false,
    "properties": {
     "excludeChats": {
      "type": "boolean"
     },
     "from": {
      "type": "string"
     },
     "hasAttachment": {
      "type": "boolean"
     },
     "negatedQuery": {
      "type": "string"
     },
     "query": {
      "type": "string"
     },
     "size": {
      "type": "number"
     },
     "sizeComparison": {
      "type": "string"
     },
     "subject": {
      "type": "string"
     },
     "to": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "id": {
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "title": "Create filter"
}
