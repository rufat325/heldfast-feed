{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Posts, rails and pickets for a straight run of wood privacy or picket fence. Formula: Sections = \u2308length \u00f7 spacing\u2309; posts = sections + 1 + gates; pickets = \u2308length(in) \u00f7 (picket width + gap)\u2309.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "gates": {
    "description": "Gates (extra posts); default 1",
    "type": "number"
   },
   "length_ft": {
    "description": "Fence length (ft); default 100",
    "type": "number"
   },
   "picket_gap_in": {
    "description": "Gap between pickets (in); default 0",
    "type": "number"
   },
   "picket_width_in": {
    "description": "Picket width (in); default 5.5",
    "type": "number"
   },
   "post_spacing_ft": {
    "description": "Post spacing (ft); default 8",
    "type": "number"
   },
   "rails_per_section": {
    "description": "Rails per section; default 2",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "calc_fence",
 "title": "Fence Calculator (Posts, Rails & Pickets)"
}
