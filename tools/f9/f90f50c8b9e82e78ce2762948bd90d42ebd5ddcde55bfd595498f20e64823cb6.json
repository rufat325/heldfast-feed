{
 "_meta": {
  "openai/toolInvocation/invoked": "Listings ready",
  "openai/toolInvocation/invoking": "Reading the event"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get event details"
 },
 "description": "Use this when you have an event's slug from a search result and need that event's current details: date, local time, venue, sale state, cancellation and any published price range. Returns the newest available snapshot; older details are returned explicitly marked stale.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "slug": {
    "description": "Exact event slug from a search result; not an artist or venue slug.",
    "pattern": "^[a-z0-9-]{1,240}$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_event",
 "outputSchema": {
  "properties": {
   "city": {
    "type": "string"
   },
   "country": {
    "type": "string"
   },
   "date": {
    "description": "Venue-local date; may be blank if unknown.",
    "type": "string"
   },
   "dateTime": {
    "description": "Provider absolute start timestamp when supplied.",
    "type": [
     "string",
     "null"
    ]
   },
   "inventoryVerified": {
    "const": false,
    "type": "boolean"
   },
   "listingUpdatedAt": {
    "description": "Original listing retrieval timestamp; not a stock check.",
    "type": "string"
   },
   "localTime": {
    "description": "Venue-local time; may be blank if unknown.",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "onSale": {
    "properties": {
     "endAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "startAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "tbd": {
      "type": "boolean"
     }
    },
    "required": [
     "startAt",
     "endAt",
     "tbd"
    ],
    "type": "object"
   },
   "pricing": {
    "description": "Informational published ranges, not current available offers. Prices may change moment to moment and are not guaranteed. Fees and taxes may be additional. When ranges is empty, omit the price line. Never combine primary/resale sellers or currencies.",
    "properties": {
     "inventoryVerified": {
      "const": false,
      "type": "boolean"
     },
     "label": {
      "type": "string"
     },
     "notice": {
      "type": "string"
     },
     "ranges": {
      "items": {
       "properties": {
        "checkedAt": {
         "type": "string"
        },
        "currency": {
         "type": "string"
        },
        "feeInclusion": {
         "const": "unknown",
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "maxMinor": {
         "minimum": 1,
         "type": "integer"
        },
        "minMinor": {
         "minimum": 1,
         "type": "integer"
        },
        "minorUnit": {
         "maximum": 3,
         "minimum": 0,
         "type": "integer"
        },
        "provider": {
         "type": "string"
        },
        "sourceType": {
         "type": "string"
        },
        "validUntil": {
         "description": "Expiry in Unix milliseconds. Discard at this time even if cached.",
         "type": "integer"
        }
       },
       "required": [
        "provider",
        "sourceType",
        "currency",
        "minMinor",
        "maxMinor",
        "minorUnit",
        "checkedAt",
        "validUntil",
        "label",
        "feeInclusion"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "label",
     "ranges",
     "notice",
     "inventoryVerified"
    ],
    "type": "object"
   },
   "publicSaleState": {
    "description": "Schedule state, not inventory. registration means restricted registration access, not an open general sale.",
    "type": "string"
   },
   "region": {
    "type": "string"
   },
   "slug": {
    "pattern": "^[a-z0-9-]{1,240}$",
    "type": "string"
   },
   "stale": {
    "type": "boolean"
   },
   "status": {
    "type": "string"
   },
   "tickets": {
    "description": "The first exact-event seller link for this performance, present only for a fresh, upcoming listing with a known seller page. The link opens the seller's page for this event through ticketsea.com/go/. It is not an availability check, and the event can have other sellers.",
    "properties": {
     "affiliate": {
      "description": "TicketSea may earn a commission from this seller.",
      "type": "boolean"
     },
     "official": {
      "type": "boolean"
     },
     "seller": {
      "type": "string"
     },
     "type": {
      "description": "primary or resale.",
      "type": "string"
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "url",
     "seller",
     "type",
     "official",
     "affiliate"
    ],
    "type": "object"
   },
   "timezone": {
    "description": "Provider timezone; may be blank if unknown. Do not invent one.",
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   },
   "venue": {
    "type": "string"
   }
  },
  "required": [
   "slug",
   "url",
   "name",
   "date",
   "dateTime",
   "localTime",
   "timezone",
   "venue",
   "city",
   "region",
   "country",
   "status",
   "publicSaleState",
   "onSale",
   "listingUpdatedAt",
   "stale",
   "inventoryVerified",
   "notice"
  ],
  "type": "object"
 },
 "title": "Get event details"
}
