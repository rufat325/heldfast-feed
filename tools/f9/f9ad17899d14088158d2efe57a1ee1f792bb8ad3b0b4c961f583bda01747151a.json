{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Khi app c\u1ea7n nh\u1eadn s\u1ef1 ki\u1ec7n g\u1eedi ho\u1eb7c bounce, \u0111\u0103ng k\u00fd HTTPS webhook; l\u01b0u secret m\u1ed9t l\u1ea7n v\u00e0o .env, kh\u00f4ng log. / Use to subscribe an app to email events.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "events": {
    "items": {
     "enum": [
      "email.sent",
      "email.delivered",
      "email.deferred",
      "email.bounced",
      "email.complained",
      "email.suppressed",
      "email.failed",
      "domain.verified",
      "inbox.message"
     ],
     "type": "string"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "idempotency_key": {
    "description": "Gi\u1eef c\u00f9ng key khi th\u1eed l\u1ea1i c\u00f9ng y\u00eau c\u1ea7u trong 24 gi\u1edd. / Reuse for retries.",
    "maxLength": 255,
    "minLength": 1,
    "pattern": "^[\\x21-\\x7e]+$",
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url",
   "events"
  ],
  "type": "object"
 },
 "name": "mail_webhook_create",
 "title": "T\u1ea1o webhook email"
}
