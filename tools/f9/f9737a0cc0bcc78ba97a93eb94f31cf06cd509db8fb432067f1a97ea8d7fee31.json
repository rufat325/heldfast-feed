{
 "description": "Generate a concise professional profile bio for an AI agent. Invoke the paid REST endpoint POST /service/profile-bio; the call costs $1.00 USDC on Base through x402 and returns HTTP 402 before settlement.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agentName": {
    "description": "Name of the AI agent.",
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   },
   "audience": {
    "description": "Optional intended audience.",
    "maxLength": 120,
    "type": "string"
   },
   "capabilities": {
    "description": "Two to six concise capabilities.",
    "items": {
     "type": "string"
    },
    "maxItems": 6,
    "minItems": 2,
    "type": "array"
   },
   "tone": {
    "description": "Optional writing tone.",
    "enum": [
     "direct",
     "warm",
     "technical"
    ],
    "type": "string"
   }
  },
  "required": [
   "agentName",
   "capabilities"
  ],
  "type": "object"
 },
 "name": "signal_sprint_profile_bio"
}
