  "title": "Create site pixel"
 },
 "description": "Create a pixel for a domain.\n\n        Does not create an API key. The account must already be active.\n        Next: call configure_consent(pixel_id, controller_name, purposes) and install the snippet it returns.\n        Do not install a snippet before consent is configured. install_status starts as not_checked until check_install runs.\n        ",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Public hostname of the site, without scheme, port, path or IP address. Example: shop.example.com",
    "maxLength": 253,
    "minLength": 3,
    "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$",
    "title": "Domain",
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "title": "create_pixelArguments",
  "type": "object"
 },
 "name": "create_pixel",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "check_error": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Check Error"
   },
   "checked_at": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Checked At"
   },
   "consent_enabled": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Consent Enabled"
   },
   "data_kind": {
    "enum": [
