{
 "description": "Ask Edgar (POPS4) to email a person the day a company files with the SEC. Needs the person's email and the company name as it files (or its CIK). Each note carries a one-click stop link.",
 "inputSchema": {
  "properties": {
   "board": {
    "enum": [
     "breaches",
     "charter-amendments",
     "mergers",
     "agreements",
     "restructuring",
     "cmo-moves",
     "ipo-watch",
     "annual-meetings",
     "auditor-watch"
    ],
    "type": "string"
   },
   "cik": {
    "description": "optional SEC CIK, exact match",
    "type": "string"
   },
   "company": {
    "type": "string"
   },
   "email": {
    "type": "string"
   }
  },
  "required": [
   "company",
   "email"
  ],
  "type": "object"
 },
 "name": "watch_company"
}
