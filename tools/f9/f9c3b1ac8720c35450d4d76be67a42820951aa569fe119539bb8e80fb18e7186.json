          "string",
          "null"
         ]
        },
        "status": {
         "type": "string"
        },
        "threshold": {
         "type": [
          "integer",
          "null"
         ]
        }
       },
       "required": [
        "alert_id",
        "metric",
        "status",
        "threshold",
        "duration_minutes",
        "opened_at",
        "resolved_at",
