      "type": "string"
     },
     "rules": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "created_at": {
         "type": "string"
        },
        "deployment_id": {
         "type": "string"
        },
        "duration_minutes": {
         "type": "integer"
        },
        "enabled": {
         "type": "integer"
        },
        "metric": {
         "type": "string"
        },
        "rule_id": {
         "type": "string"
        },
