{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Ramp Settlement"
 },
 "description": "Execute a DPX stablecoin settlement funded by a Ramp Agent Card \u2014 combines card creation and settlement in one call. Ramp handles the fiat conversion leg; DPX settles USDC or EURC on Base mainnet in ~30 seconds. Returns pacs.002 confirmation + SFDR PAI indicators. No crypto wallet pre-funding required. Requires Ramp account connected via ramp.connect.",
 "inputSchema": {
  "properties": {
   "amount": {
    "description": "Payment amount (e.g. \"50000.00\").",
    "type": "string"
   },
   "callback_url": {
    "description": "Webhook URL for pacs.002 delivery.",
    "type": "string"
   },
   "creditor_lei": {
    "description": "Recipient LEI for GLEIF VoP (optional).",
    "type": "string"
   },
   "creditor_name": {
    "description": "Recipient name.",
    "type": "string"
   },
   "creditor_wallet": {
    "description": "Recipient on-chain wallet address (0x...).",
    "type": "string"
   },
   "currency": {
    "description": "Source currency: USD or EUR.",
    "type": "string"
   },
   "merchant_scope": {
    "description": "Merchant name for Agent Card scope.",
    "type": "string"
   },
   "reference": {
    "description": "Your internal payment reference.",
    "type": "string"
   },
   "settlement_asset": {
    "description": "Settlement asset: USDC (default) or EURC.",
    "type": "string"
   },
   "tenant_id": {
    "description": "Tenant ID of the connected Ramp account.",
    "type": "string"
   }
  },
  "required": [
   "tenant_id",
   "amount",
   "currency",
   "creditor_wallet",
   "creditor_name"
  ],
  "type": "object"
 },
 "name": "ramp.settle",
 "outputSchema": {
  "properties": {
   "agentCard": {
    "type": "object"
   },
   "compliance": {
    "description": "FATF R16 + SFDR PAI indicators.",
    "type": "object"
   },
   "dpxPaymentId": {
    "type": "string"
   },
   "iso20022": {
    "description": "pacs.002 status object.",
    "type": "object"
   },
   "settlement": {
    "type": "object"
   },
   "status": {
    "enum": [
     "SETTLED",
     "PENDING",
     "BLOCKED",
     "FAILED"
    ],
    "type": "string"
   }
  },
  "type": "object"
 }
}
