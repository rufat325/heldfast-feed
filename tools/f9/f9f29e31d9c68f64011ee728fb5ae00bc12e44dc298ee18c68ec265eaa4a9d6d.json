{
 "description": "Hardware Escrow deposits (EC-6a/6b): create the captured-deposit record for a kit loan (funding model WORKER_CASH|EARNINGS_HOLDBACK|PROGRAM_POOL; the 20% managed service fee is RECORDED), accrue holdback collateral (action=accrue_holdback + amountCents), or read the deposit (no body). Record-only until money-go.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "create",
     "accrue_holdback",
     "get"
    ],
    "type": "string"
   },
   "amountCents": {
    "type": "integer"
   },
   "assignmentId": {
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "fundingModel": {
    "enum": [
     "WORKER_CASH",
     "EARNINGS_HOLDBACK",
     "PROGRAM_POOL"
    ],
    "type": "string"
   }
  },
  "required": [
   "assignmentId"
  ],
  "type": "object"
 },
 "name": "opentrain_escrow_deposit",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
