{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Atomic expense + optional inventory item creation. ($0.10; API key required)",
 "destructiveHint": false,
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "amount": {
    "type": "number"
   },
   "category": {
    "description": "Expense category (default purchase); also the item category when inventory_details has none.",
    "type": "string"
   },
   "create_inventory": {
    "description": "false = the expense only, no Inventory item (default true).",
    "type": "boolean"
   },
   "currency": {
    "description": "ISO 4217; default USD.",
    "type": "string"
   },
   "date": {
    "description": "YYYY-MM-DD; default today.",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Alias for request_id.",
    "type": "string"
   },
   "inventory_details": {
    "additionalProperties": false,
    "description": "The Inventory item: category, brand, model, condition, notes.",
    "properties": {
     "brand": {
      "type": "string"
     },
     "category": {
      "type": "string"
     },
     "condition": {
      "enum": [
       "new",
       "excellent",
       "good",
       "worn",
       "needs_repair",
       "retired"
      ],
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "notes": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "merchant": {
    "description": "Where it was bought; stands in for name when name is missing.",
    "type": "string"
   },
   "name": {
    "description": "What was bought (also the Inventory item name). Alias: merchant.",
    "type": "string"
   },
   "request_id": {
    "description": "Client idempotency key (retries return original result).",
    "type": "string"
   }
  },
  "required": [
   "name",
   "amount"
  ],
  "type": "object"
 },
 "name": "record_purchase",
 "openWorldHint": false,
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "expense_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "inventory_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "message": {
    "type": [
     "string",
     "null"
    ]
   },
   "transaction": {
    "additionalProperties": true,
    "description": "Expense/income transaction row.",
    "type": "object"
   }
  },
  "type": "object"
 },
 "readOnlyHint": false,
 "securitySchemes": [
  {
   "scopes": [
    "context.write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Record Purchase"
}
