{
 "annotations": {
  "destructiveHint": true,
  "title": "Create or update a supplier"
 },
 "description": "Create a supplier, or update one by passing its `id`. Loyverse does not document whether omitted fields survive an update, so on update send the full record. Loyverse: POST /suppliers/.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address_1": {
    "description": "Address line 1.",
    "maxLength": 192,
    "type": "string"
   },
   "address_2": {
    "description": "Address line 2.",
    "maxLength": 192,
    "type": "string"
   },
   "city": {
    "description": "City, town or village.",
    "maxLength": 64,
    "type": "string"
   },
   "contact": {
    "description": "Contact person's name.",
    "maxLength": 64,
    "type": "string"
   },
   "country_code": {
    "description": "Two-letter ISO 3166-1 alpha-2 country code, e.g. US.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "email": {
    "description": "Email address.",
    "maxLength": 100,
    "type": "string"
   },
   "id": {
    "description": "Existing supplier id to update. Omit to create.",
    "type": "string"
   },
   "name": {
    "description": "The supplier company name (required).",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "note": {
    "description": "A note about the supplier.",
    "maxLength": 500,
    "type": "string"
   },
   "phone_number": {
    "description": "Phone number.",
    "maxLength": 15,
    "type": "string"
   },
   "postal_code": {
    "description": "Postal / ZIP code.",
    "maxLength": 20,
    "type": "string"
   },
   "region": {
    "description": "Province, state or prefecture.",
    "maxLength": 64,
    "type": "string"
   },
   "website": {
    "description": "Website URL.",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "loyverse_upsert_supplier",
 "title": "Create or update a supplier"
}
