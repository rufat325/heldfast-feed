{
 "annotations": {
  "destructiveHint": true,
  "title": "Update customer"
 },
 "description": "Updates an existing customer's details (reversible). Only provided fields are changed. Orb API: PUT /customers/{customer_id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "currency": {
    "description": "New ISO-4217 currency code.",
    "type": "string"
   },
   "customer_id": {
    "description": "Orb customer id (required).",
    "type": "string"
   },
   "email": {
    "description": "New billing email (must be a valid email).",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "external_customer_id": {
    "description": "New external id.",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "User-defined key/value metadata (string\u2192string).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "description": "New display name.",
    "type": "string"
   },
   "payment_provider": {
    "description": "External payment/invoicing provider.",
    "enum": [
     "quickbooks",
     "bill.com",
     "stripe_charge",
     "stripe_invoice",
     "netsuite",
     "adyen"
    ],
    "type": "string"
   },
   "payment_provider_id": {
    "description": "New id in the external payment provider.",
    "type": "string"
   },
   "timezone": {
    "description": "New IANA timezone.",
    "type": "string"
   }
  },
  "required": [
   "customer_id"
  ],
  "type": "object"
 },
 "name": "orb_update_customer",
 "title": "Update customer"
}
