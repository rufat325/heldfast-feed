{
 "description": "Medication safety gate: deterministic unit-confusion, overdose, and drug-drug interaction checks for a list of medications. Returns PASS/FLAG/BLOCK findings with a signed certificate. Informational only \u2014 not medical advice. Call before an agent finalizes any medication list, prescription, or dosing instruction.",
 "inputSchema": {
  "properties": {
   "medications": {
    "description": "Medications to evaluate.",
    "items": {
     "properties": {
      "dose": {
       "description": "Dose per administration.",
       "type": "number"
      },
      "frequencyPerDay": {
       "description": "Administrations per day.",
       "type": "number"
      },
      "name": {
       "description": "Drug name (generic or brand).",
       "type": "string"
      },
      "route": {
       "description": "Route of administration (informational).",
       "type": "string"
      },
      "unit": {
       "description": "Dose unit (e.g. 'mg', 'mcg', 'ml').",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "patient": {
    "properties": {
     "ageYears": {
      "description": "Patient age in years.",
      "type": "number"
     },
     "weightKg": {
      "description": "Patient weight in kg (weight-based dosing).",
      "type": "number"
     }
    },
    "type": "object"
   },
   "policy": {
    "properties": {
     "blockSeverityAtOrAbove": {
      "description": "Minimum severity that yields BLOCK (default: major).",
      "enum": [
       "moderate",
       "major",
       "contraindicated"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "medications"
  ],
  "type": "object"
 },
 "name": "rx_check"
}
