   "customer_id": {
    "description": "The Amberflo customerId.",
    "type": "string"
   },
   "from_cache": {
    "description": "Use cached invoices (faster). Default true.",
    "type": "boolean"
   },
   "product_id": {
    "description": "Product id. Default \"1\".",
    "type": "string"
   },
   "with_payment_status": {
    "description": "Include payment status. Default true.",
    "type": "boolean"
   }
  },
  "required": [
   "customer_id"
  ],
  "type": "object"
 },
 "name": "amberflo_list_customer_invoices",
