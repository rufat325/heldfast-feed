{
 "description": "Respond to an introduction request. Approve to share your disclosed information, or decline.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "approved": {
    "description": "Whether to approve the introduction",
    "type": "boolean"
   },
   "disclose_fields": {
    "description": "Fields you're willing to share back",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "intro_id": {
    "description": "Intro request ID",
    "type": "string"
   },
   "message": {
    "description": "Optional response message",
    "type": "string"
   }
  },
  "required": [
   "intro_id",
   "approved"
  ],
  "type": "object"
 },
 "name": "respond_to_intro"
}
