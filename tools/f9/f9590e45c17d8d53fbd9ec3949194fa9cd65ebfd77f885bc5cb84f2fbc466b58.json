{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get institutional buying/selling activity trend for a stock over multiple quarters. Shows how many institutions are buying vs selling, net share changes, and value flows \u2014 useful for detecting accumulation or distribution patterns. Plan limits: Free/keyless access covers the latest 13F quarter only; the multi-quarter trend requires Pro. Omit `quarters` to get the most your plan allows. structuredContent carries the exact net shares/values. Each quarter carries ko.io's comparability state (comparable / split_adjusted with its split factor / not_comparable / first_reported): a null share or value flow means UNKNOWN (withheld), never zero.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "quarters": {
    "description": "Number of quarters to return. Omit for the plan default (Pro: 8 = 2 years; Free/keyless: the latest quarter only). An explicit value above what your plan allows returns a plan-limit error.",
    "maximum": 40,
    "minimum": 1,
    "type": "integer"
   },
   "ticker": {
    "description": "Stock ticker symbol",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },
 "name": "get_stock_activity",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "latest": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "changes": {
        "anyOf": [
         {
          "additionalProperties": false,
          "properties": {
           "added": {
            "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
           },
           "basis": {
            "description": "\"equity_filer_baseline\"",
            "type": [
             "string",
             "null"
            ]
           },
           "comparability": {
            "$ref": "#/properties/latest/anyOf/0/properties/comparability"
           },
           "comparability_reason": {
            "$ref": "#/properties/latest/anyOf/0/properties/quarter",
            "description": "ko.io's prose for the comparability state; null when comparable"
           },
           "exited": {
            "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
           },
           "flow_excluded_filers": {
            "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased",
            "description": "Classified filers left out of share/value flows (implausible row); still counted as holders"
           },
           "holders": {
            "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
           },
           "net_shares": {
            "$ref": "#/properties/latest/anyOf/0/properties/changes/anyOf/0/properties/split_factor"
           },
           "net_value": {
            "$ref": "#/properties/latest/anyOf/0/properties/changes/anyOf/0/properties/split_factor"
           },
           "new": {
            "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
           },
           "no_baseline": {
            "anyOf": [
             {
              "$ref": "#/properties/quarters_requested/anyOf/0"
             },
             {
              "type": "null"
             }
            ],
            "description": "Filers with no usable prior-quarter baseline: not classified as new/added/..."
           },
           "null_reason": {
            "$ref": "#/properties/latest/anyOf/0/properties/null_reason"
           },
           "price_corrected": {
            "description": "true when values use the holders' median implied price instead of a quarter-end close that was off by > 50%",
            "type": [
             "boolean",
             "null"
            ]
           },
           "shares_added": {
            "$ref": "#/properties/latest/anyOf/0/properties/changes/anyOf/0/properties/split_factor"
           },
           "shares_removed": {
            "$ref": "#/properties/latest/anyOf/0/properties/changes/anyOf/0/properties/split_factor"
           },
           "split_factor": {
            "description": "split_adjusted only: last quarter's shares were multiplied by this factor before classifying (e.g. 10 = 10-for-1); null otherwise",
            "type": [
             "number",
             "null"
            ]
           },
           "trimmed": {
            "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
           },
           "unchanged": {
            "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
           },
           "value_added": {
            "$ref": "#/properties/latest/anyOf/0/properties/changes/anyOf/0/properties/split_factor"
           },
           "value_removed": {
            "$ref": "#/properties/latest/anyOf/0/properties/changes/anyOf/0/properties/split_factor"
           }
          },
          "required": [
           "basis",
           "new",
           "added",
           "trimmed",
           "exited",
           "unchanged",
           "no_baseline",
           "holders",
           "shares_added",
           "shares_removed",
           "net_shares",
           "value_added",
           "value_removed",
           "net_value"
          ],
          "type": "object"
         },
         {
          "type": "null"
         }
        ],
        "description": "equity_filer_baseline: common stock only (option legs excluded); one holder per filer CIK; only filers with a usable prior-quarter baseline are classified. Same names/values as ko.io REST `changes`. A null share/value flow means UNKNOWN (withheld), never zero. null = ko.io could not compute `changes` for this quarter; absent when ko.io did not send it."
       },
       "comparability": {
        "$ref": "#/properties/latest/anyOf/0/properties/quarter",
        "description": "comparable | split_adjusted (last quarter's shares x split_factor before classifying) | not_comparable (share and value flows withheld -> null) | first_reported (no 13F filer held it last quarter: no prior-quarter baseline, every holder is new) | unknown (flows could not be recomputed -> null)"
       },
       "institutions_decreased": {
        "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
       },
       "institutions_exited": {
        "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
       },
       "institutions_increased": {
        "anyOf": [
         {
          "$ref": "#/properties/quarters_requested/anyOf/0"
         },
         {
          "type": "null"
         }
        ]
       },
       "institutions_new": {
        "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
       },
       "institutions_total": {
        "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
       },
       "net_shares": {
        "anyOf": [
         {
          "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "description": "null = unknown (withheld, see null_reason), never zero"
       },
       "net_value": {
        "anyOf": [
         {
          "$ref": "#/properties/latest/anyOf/0/properties/net_shares/anyOf/0"
         },
         {
          "type": "null"
         }
        ],
        "description": "null = unknown (withheld, see null_reason), never zero"
       },
       "null_reason": {
        "$ref": "#/properties/latest/anyOf/0/properties/quarter",
        "description": "Why the share/value flows are null (e.g. share_ratio_not_a_split_factor, price_conflict_insufficient_samples, value_above_sanity_cap, not_recomputable); null when they are not"
       },
       "quarter": {
        "type": [
         "string",
         "null"
        ]
       },
       "shares_added": {
        "anyOf": [
         {
          "$ref": "#/properties/latest/anyOf/0/properties/net_shares/anyOf/0"
         },
         {
          "type": "null"
         }
        ],
        "description": "Exact decimal string as served by ko.io (not rounded); null = unknown"
       },
       "shares_removed": {
        "$ref": "#/properties/latest/anyOf/0/properties/shares_added"
       },
       "value_added": {
        "$ref": "#/properties/latest/anyOf/0/properties/shares_added"
       },
       "value_removed": {
        "$ref": "#/properties/latest/anyOf/0/properties/shares_added"
       }
      },
      "required": [
       "quarter",
       "institutions_increased",
       "institutions_decreased",
       "institutions_new",
       "institutions_exited",
       "net_shares",
       "net_value",
       "institutions_total",
       "shares_added",
       "shares_removed",
       "value_added",
       "value_removed"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "plan_limit": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "continuation": {
        "$ref": "#/properties/latest/anyOf/0/properties/quarter"
       },
       "date_basis": {
        "$ref": "#/properties/latest/anyOf/0/properties/quarter"
       },
       "effective_period": {
        "$ref": "#/properties/latest/anyOf/0/properties/quarter"
       },
       "policy_version": {
        "$ref": "#/properties/latest/anyOf/0/properties/quarter"
       },
       "row_cap": {
        "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
       },
       "truncated": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "window_end": {
        "$ref": "#/properties/latest/anyOf/0/properties/quarter"
       },
       "window_start": {
        "$ref": "#/properties/latest/anyOf/0/properties/quarter"
       }
      },
      "required": [
       "policy_version",
       "window_start",
       "window_end",
       "effective_period",
       "date_basis",
       "row_cap",
       "truncated",
       "continuation"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "The Free/keyless plan limits ko.io applied to this answer (null for paid callers)"
   },
   "plan_note": {
    "description": "Set when the plan limited how many quarters were returned",
    "type": [
     "string",
     "null"
    ]
   },
   "quarters_requested": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "null = the plan default was used"
   },
   "quarters_returned": {
    "type": "integer"
   },
   "ticker": {
    "type": "string"
   },
   "trend": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "changes": {
       "$ref": "#/properties/latest/anyOf/0/properties/changes"
      },
      "comparability": {
       "$ref": "#/properties/latest/anyOf/0/properties/comparability"
      },
      "institutions_decreased": {
       "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
      },
      "institutions_exited": {
       "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
      },
      "institutions_increased": {
       "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
      },
      "institutions_new": {
       "$ref": "#/properties/latest/anyOf/0/properties/institutions_increased"
      },
      "net_shares": {
       "$ref": "#/properties/latest/anyOf/0/properties/net_shares"
      },
      "net_value": {
       "$ref": "#/properties/latest/anyOf/0/properties/net_value"
      },
      "null_reason": {
       "$ref": "#/properties/latest/anyOf/0/properties/null_reason"
      },
      "quarter": {
       "$ref": "#/properties/latest/anyOf/0/properties/quarter"
      }
     },
     "required": [
      "quarter",
      "institutions_increased",
      "institutions_decreased",
      "institutions_new",
      "institutions_exited",
      "net_shares",
      "net_value"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "ticker",
   "quarters_requested",
   "quarters_returned",
   "latest",
   "trend",
   "plan_note",
   "plan_limit"
  ],
  "type": "object"
 }
}
