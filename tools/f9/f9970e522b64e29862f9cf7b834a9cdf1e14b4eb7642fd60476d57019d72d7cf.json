{"description":"Ask for a sign-off on a finished checklist and get the signing link. Every required item must be ticked. The signer (the customer by default, or a shop member) signs the checklist exactly as it stands; items lock while the sign-off waits (signatures.cancel unlocks).","inputSchema":{"properties":{"checklist_id":{"format":"uuid","type":"string"},"link_days":{"description":"Days the signing link works (default 14).","maximum":90,"minimum":1,"type":"integer"},"signer_email":{"description":"Only this signed-in email may sign.","maxLength":320,"type":"string"},"signer_role":{"enum":["customer","member"],"type":"string"}},"required":["checklist_id"],"type":"object"},"name":"checklists_requestSignOff","outputSchema":{"anyOf":[{"properties":{"checklist_id":{"format":"uuid","type":"string"},"document_sha256":{"type":"string"},"link_expires_at":{"format":"date-time","type":"string"},"sign_url":{"type":"string"},"signature_request_id":{"format":"uuid","type":"string"}},"required":["checklist_id","signature_request_id","document_sha256","sign_url","link_expires_at"],"type":"object"},{"properties":{"approval_id":{"format":"uuid","type":"string"},"approval_required":{"enum":[true],"type":"boolean"},"expires_at":{"format":"date-time","type":"string"},"message":{"type":"string"},"status":{"enum":["pending"],"type":"string"}},"required":["approval_required","approval_id","status","expires_at","message"],"type":"object"}],"type":"object"}}
