{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Redeploys an existing site's files from a local directory, replacing everything currently live.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dist_dir": {
    "description": "Absolute path to the local directory to deploy.",
    "minLength": 1,
    "type": "string"
   },
   "site_id": {
    "description": "The site's id, from list_sites or create_site.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "site_id",
   "dist_dir"
  ],
  "type": "object"
 },
 "name": "deploy",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fileCount": {
    "type": "number"
   },
   "ok": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "ok",
   "fileCount"
  ],
  "type": "object"
 },
 "title": "Deploy"
}
