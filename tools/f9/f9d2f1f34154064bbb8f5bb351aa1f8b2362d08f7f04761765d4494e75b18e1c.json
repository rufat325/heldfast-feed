{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get time-series flow metrics"
 },
 "description": "Time-series flow (automation) metrics for a Klaviyo account. Buckets by interval. Rate limited: 2/min.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account": {
    "description": "Account name",
    "type": "string"
   },
   "conversion_metric_id": {
    "description": "Placed Order metric ID.",
    "type": "string"
   },
   "end": {
    "description": "Custom range end, YYYY-MM-DD. Defaults to today.",
    "type": "string"
   },
   "interval": {
    "enum": [
     "hourly",
     "daily",
     "weekly",
     "monthly"
    ],
    "type": "string"
   },
   "quarter": {
    "description": "Quarter 1-4 (with year) - convenience for a full quarter.",
    "maximum": 4,
    "minimum": 1,
    "type": "integer"
   },
   "start": {
    "description": "Custom range start, YYYY-MM-DD. Overrides timeframe. Data floor: 2023-06-01 (earlier is clamped).",
    "type": "string"
   },
   "timeframe": {
    "enum": [
     "last_7_days",
     "last_30_days",
     "last_90_days",
     "last_12_months",
     "last_365_days"
    ],
    "type": "string"
   },
   "year": {
    "description": "Year for quarter, e.g. 2024.",
    "maximum": 2100,
    "minimum": 2023,
    "type": "integer"
   }
  },
  "required": [
   "account",
   "conversion_metric_id"
  ],
  "type": "object"
 },
 "name": "flow_series_report"
}
