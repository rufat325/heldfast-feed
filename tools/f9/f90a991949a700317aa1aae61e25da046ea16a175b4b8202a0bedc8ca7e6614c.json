{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Change the number of Secondary (Member/Arbiter) servers in a MongoDB instance",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "arbiterProductCode": {
    "description": "Arbiter server product code",
    "type": "string"
   },
   "arbiterServerCount": {
    "description": "Number of arbiter servers (0-1)",
    "type": "number"
   },
   "cloudMongoDbInstanceNo": {
    "description": "Cloud MongoDB instance number",
    "type": "string"
   },
   "memberServerCount": {
    "description": "Number of member servers (2-7)",
    "type": "number"
   }
  },
  "required": [
   "cloudMongoDbInstanceNo",
   "memberServerCount",
   "arbiterServerCount"
  ],
  "type": "object"
 },
 "name": "ncloud_change_mongodb_secondary_count"
}
