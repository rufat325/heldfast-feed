{
 "_meta": {
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a draft freight RFP in the user's FreightFA account with up to 50 lanes, and benchmark each lane against the market. Returns the RFP id, a link to finish and send it in the RFP Builder, and each lane's benchmark. Free accounts can have one RFP.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "lanes": {
    "description": "The lanes to bid.",
    "items": {
     "properties": {
      "destination": {
       "description": "Destination city and state, or ZIP.",
       "minLength": 2,
       "type": "string"
      },
      "equipment_type": {
       "description": "e.g. 'Dry Van', 'Reefer', 'Flatbed', or null.",
       "type": [
        "string",
        "null"
       ]
      },
      "frequency": {
       "description": "Volume, e.g. '3 loads/week', or null.",
       "type": [
        "string",
        "null"
       ]
      },
      "mode": {
       "description": "TL, LTL, Intermodal, Rail, Air, or Ocean.",
       "enum": [
        "TL",
        "LTL",
        "Intermodal",
        "Rail",
        "Air",
        "Ocean"
       ],
       "type": "string"
      },
      "origin": {
       "description": "Origin city and state, or ZIP.",
       "minLength": 2,
       "type": "string"
      },
      "target_rate": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Target all-in rate in dollars per load, or null."
      },
      "weight_lbs": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Typical shipment weight in pounds, or null."
      }
     },
     "required": [
      "origin",
      "destination",
      "mode",
      "equipment_type",
      "weight_lbs",
      "frequency",
      "target_rate"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "title": {
    "description": "RFP title, e.g. 'Q1 2027 Southeast truckload bid'.",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "title",
   "lanes"
  ],
  "type": "object"
 },
 "name": "create_rfp",
 "securitySchemes": [
  {
   "type": "oauth2"
  }
 ],
 "title": "Create a freight RFP"
}
