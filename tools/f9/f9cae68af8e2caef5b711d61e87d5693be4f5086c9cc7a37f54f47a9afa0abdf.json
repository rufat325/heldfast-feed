{"_meta":{"securitySchemes":[{"scopes":["ringkit.manage"],"type":"oauth2"}]},"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Set call routing"},"description":"Step 4: Decide who answers. Set the routing policy: transfer targets (your own team numbers the receptionist can transfer to) and handoff preferences, recording, spend cap. Full replace; omitted fields take defaults. Every call is answered by the AI (mode ai_only): ai_first/human_first are accepted but RingKit's live-rep pool is not offered, so they act as ai_only. Reuse an idempotencyKey when retrying; without one, each call executes again.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"afterHoursMode":{"enum":["ai_only","ai_first","human_first"],"type":"string"},"alwaysHumanIntents":{"items":{"type":"string"},"type":"array"},"businessId":{"description":"Defaults to the business of the API key in the Authorization header.","pattern":"^biz_[0-9a-z]{8,32}$","type":"string"},"dailySpendCapUsd":{"exclusiveMinimum":0,"type":"number"},"discloseAi":{"type":"boolean"},"escalateOn":{"items":{"enum":["caller_requests_human","always_human_intent","low_confidence","repeated_failure"],"type":"string"},"type":"array"},"handoff":{"properties":{"requested":{"enum":["message","transfer"],"type":"string"},"targetId":{"type":"string"},"unsure":{"enum":["message","transfer"],"type":"string"},"urgent":{"enum":["message","transfer"],"type":"string"}},"required":["unsure","requested","urgent"],"type":"object"},"humanRingTimeoutS":{"maximum":30,"minimum":3,"type":"integer"},"idempotencyKey":{"description":"Optional. Retries of the same call should reuse it (the stored result comes back); a new value deliberately repeats an identical call. The MCP POST's Idempotency-Key header takes precedence.","maxLength":255,"minLength":1,"type":"string"},"maxHumanOffers":{"maximum":5,"minimum":1,"type":"integer"},"mode":{"enum":["ai_only","ai_first","human_first"],"type":"string"},"neverHumanIntents":{"items":{"type":"string"},"type":"array"},"recordCalls":{"type":"boolean"},"requiredAgentSkills":{"items":{"type":"string"},"type":"array"},"schedule":{"items":{"properties":{"days":{"items":{"enum":["mon","tue","wed","thu","fri","sat","sun"],"type":"string"},"minItems":1,"type":"array"},"from":{"pattern":"^([01]\\d|2[0-3]):[0-5]\\d$","type":"string"},"mode":{"enum":["ai_only","ai_first","human_first"],"type":"string"},"to":{"pattern":"^([01]\\d|2[0-3]):[0-5]\\d$","type":"string"}},"required":["days","from","to","mode"],"type":"object"},"type":"array"},"transferTargets":{"items":{"properties":{"id":{"type":"string"},"label":{"type":"string"},"number":{"pattern":"^\\+[1-9]\\d{6,14}$","type":"string"},"whenToUse":{"maxLength":300,"type":"string"}},"required":["id","label","number"],"type":"object"},"type":"array"},"vettedAgentsOnly":{"type":"boolean"}},"type":"object"},"name":"ringkit_put_routing","title":"Set call routing"}
