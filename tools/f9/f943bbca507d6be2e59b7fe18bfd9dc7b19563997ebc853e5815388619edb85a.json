{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Checks live pages: exactly one og:image, served by getwowlink, and whether crawlers already fetch the images. Meant for after the tags from get_install_instructions are deployed. Checks the home page unless you pass paths (up to 5, each starting with \"/\").",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "paths": {
    "description": "Pages to check, e.g. [\"/\", \"/blog/hello\"]; up to 5, default the home page",
    "items": {
     "maxLength": 500,
     "type": "string"
    },
    "type": "array"
   },
   "site_url": {
    "description": "The site, e.g. example.com",
    "maxLength": 2000,
    "type": "string"
   }
  },
  "required": [
   "site_url"
  ],
  "type": "object"
 },
 "name": "verify_install",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "connection": {
    "enum": [
     "not_set_up",
     "waiting",
     "live",
     "attention"
    ],
    "type": "string"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "ok": {
       "type": "boolean"
      },
      "path": {
       "type": "string"
      },
      "why": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "ok"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "pages",
   "connection"
  ],
  "type": "object"
 },
 "title": "Verify the installed tags"
}
