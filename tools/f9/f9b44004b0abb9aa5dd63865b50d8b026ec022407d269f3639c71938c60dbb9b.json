{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Checks if a Muslim obligatory prayer (Fajr, Dhuhr, Asr, Maghrib, Isha) is currently due for the user location and returns active reminder details. MANDATORY: The LLM must always explicitly disclose to the user which calculation authority method was used and why it was selected (see authorityNotice in response).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "calculationMethod": {
    "description": "Optional calculation authority override (auto-resolved from location by default)",
    "enum": [
     "UmmAlQura",
     "MuslimWorldLeague",
     "Egyptian",
     "Karachi",
     "NorthAmerica",
     "Dubai",
     "Qatar",
     "Kuwait",
     "MoonsightingCommittee",
     "Singapore",
     "Turkey",
     "Tehran"
    ],
    "type": "string"
   },
   "latitude": {
    "description": "Optional explicit latitude override",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "description": "Optional explicit longitude override",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "madhab": {
    "description": "Optional Asr shadow jurisprudence override (Shafi or Hanafi)",
    "enum": [
     "Shafi",
     "Hanafi"
    ],
    "type": "string"
   },
   "timezone": {
    "description": "Optional IANA timezone override (e.g. Asia/Riyadh)",
    "type": "string"
   },
   "userId": {
    "description": "Optional unique user identifier to load stored preferences. If omitted, pure geographic auto-resolution is applied.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_prayer_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "authorityDescription": {
    "description": "Description of the calculation authority",
    "type": "string"
   },
   "authorityNotice": {
    "additionalProperties": false,
    "description": "Mandatory theological transparency notice",
    "properties": {
     "authorityDescription": {
      "description": "Full descriptive name of the calculation authority",
      "type": "string"
     },
     "madhab": {
      "description": "The Asr jurisprudence school",
      "enum": [
       "Shafi",
       "Hanafi"
      ],
      "type": "string"
     },
     "method": {
      "description": "The calculation authority method",
      "enum": [
       "UmmAlQura",
       "MuslimWorldLeague",
       "Egyptian",
       "Karachi",
       "NorthAmerica",
       "Dubai",
       "Qatar",
       "Kuwait",
       "MoonsightingCommittee",
       "Singapore",
       "Turkey",
       "Tehran"
      ],
      "type": "string"
     },
     "requiredDisplayInstruction": {
      "description": "Mandatory theological notice for AI presentation",
      "type": "string"
     },
     "selectionReason": {
      "description": "Rationale for selecting this authority",
      "type": "string"
     }
    },
    "required": [
     "method",
     "madhab",
     "authorityDescription",
     "selectionReason",
     "requiredDisplayInstruction"
    ],
    "type": "object"
   },
   "calculationMethod": {
    "description": "Active calculation authority",
    "enum": [
     "UmmAlQura",
     "MuslimWorldLeague",
     "Egyptian",
     "Karachi",
     "NorthAmerica",
     "Dubai",
     "Qatar",
     "Kuwait",
     "MoonsightingCommittee",
     "Singapore",
     "Turkey",
     "Tehran"
    ],
    "type": "string"
   },
   "expiresAtUtc": {
    "description": "UTC expiration time of the active prayer window",
    "type": "string"
   },
   "localDate": {
    "description": "Current local date in YYYY-MM-DD",
    "type": "string"
   },
   "madhab": {
    "description": "Active Asr jurisprudence",
    "enum": [
     "Shafi",
     "Hanafi"
    ],
    "type": "string"
   },
   "minuteAdjustments": {
    "additionalProperties": false,
    "description": "Applied minute adjustments",
    "properties": {
     "asr": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "dhuhr": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "fajr": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "isha": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "maghrib": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "sunrise": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "nextPrayer": {
    "description": "The name of the next upcoming prayer",
    "type": "string"
   },
   "nextPrayerAtUtc": {
    "description": "UTC timestamp of the next upcoming prayer",
    "type": "string"
   },
   "prayer": {
    "description": "The name of the currently due prayer if applicable",
    "type": "string"
   },
   "reminderDue": {
    "description": "Whether a prayer is currently due for reminder",
    "type": "boolean"
   },
   "reminderText": {
    "description": "Localized reminder message",
    "type": "string"
   },
   "selectionReason": {
    "description": "Reason for authority selection",
    "type": "string"
   },
   "startedAtUtc": {
    "description": "UTC start time of the active prayer window",
    "type": "string"
   },
   "timezone": {
    "description": "Resolved IANA timezone",
    "type": "string"
   }
  },
  "required": [
   "reminderDue",
   "localDate",
   "nextPrayer",
   "nextPrayerAtUtc",
   "timezone",
   "calculationMethod",
   "madhab"
  ],
  "type": "object"
 },
 "title": "Check Muslim Prayer Due Status"
}
