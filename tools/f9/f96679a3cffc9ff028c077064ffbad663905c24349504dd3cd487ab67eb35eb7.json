{
 "description": "Get stock status report (stock-managed products, lowest stock first)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Number of products (default 20)",
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "description": "lowstock (default: in stock at or below the low-stock threshold), outofstock, onbackorder",
    "enum": [
     "lowstock",
     "outofstock",
     "onbackorder"
    ],
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "woo_stock_report"
}
