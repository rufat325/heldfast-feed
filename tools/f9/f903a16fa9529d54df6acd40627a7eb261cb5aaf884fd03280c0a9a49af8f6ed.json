{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add or remove a container environment variable. Idempotent by name+key. add returns already_exists if the entry exists with the same value; throws CONFLICT if the value differs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "add",
     "remove"
    ],
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Preview changes without applying.",
    "type": "boolean"
   },
   "key": {
    "description": "Environment variable name \u2014 part of idempotency key",
    "type": "string"
   },
   "name": {
    "description": "Container name",
    "type": "string"
   },
   "routerId": {
    "description": "Router ID; omit to use the default router.",
    "type": "string"
   },
   "value": {
    "description": "Environment variable value (required for add)",
    "type": "string"
   }
  },
  "required": [
   "action",
   "name",
   "key"
  ],
  "type": "object"
 },
 "name": "manage_container_env",
 "title": "Manage Container Env"
}
