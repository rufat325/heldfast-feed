{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new SharePoint list in a site, optionally with a column schema. Requires a write permission (e.g. Sites.ReadWrite.All) \u2014 an admin may need to approve it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "columns": {
    "description": "Optional column definitions for the new list",
    "items": {
     "additionalProperties": false,
     "properties": {
      "choices": {
       "description": "Allowed values \u2014 required when type is \"choice\"",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "description": "Column name (e.g., \"Status\")",
       "type": "string"
      },
      "required": {
       "description": "Whether the column is required",
       "type": "boolean"
      },
      "type": {
       "description": "Column type",
       "enum": [
        "text",
        "number",
        "dateTime",
        "boolean",
        "choice"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "description": "Optional description for the list",
    "type": "string"
   },
   "displayName": {
    "description": "Display name for the new list (e.g., \"Project Tracker\")",
    "type": "string"
   },
   "siteId": {
    "description": "SharePoint site ID",
    "type": "string"
   },
   "template": {
    "description": "List template (default: \"genericList\")",
    "enum": [
     "genericList",
     "tasks",
     "announcements",
     "contacts",
     "events",
     "links",
     "issueTracking"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_site_list"
}
