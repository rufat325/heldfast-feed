{
 "description": "Update an existing email by its ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "emailId": {
    "description": "The email ID to update",
    "type": "string"
   },
   "html": {
    "description": "Full HTML content of the email",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "name": {
    "description": "Internal name for the email",
    "type": "string"
   },
   "preheaderText": {
    "description": "Preview text shown in inbox before opening the email",
    "type": "string"
   },
   "source": {
    "description": "Source identifier for the email template",
    "type": "string"
   },
   "subject": {
    "description": "Email subject line",
    "type": "string"
   },
   "templateData": {
    "additionalProperties": {},
    "description": "Structured template data for the drag-and-drop email builder",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "type": {
    "description": "Email type (e.g. html, template)",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "emailId"
  ],
  "type": "object"
 },
 "name": "crm_update_email"
}
