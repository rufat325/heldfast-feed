{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new node pool in an NKS cluster. Use dryRun=true to preview. On a Regional cluster, zoneCode is required and must match the zone of the subnets the pool uses (400 on mismatch since 2026-09-17).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autoscale": {
    "additionalProperties": false,
    "description": "Autoscale configuration",
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "max": {
      "type": "number"
     },
     "min": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "clusterUuid": {
    "description": "UUID of the cluster",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, preview only",
    "type": "boolean"
   },
   "labels": {
    "description": "Node labels",
    "items": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Node pool name",
    "type": "string"
   },
   "nodeCount": {
    "description": "Number of nodes (required if autoscale not set)",
    "type": "number"
   },
   "serverRoleId": {
    "description": "IAM server role ID",
    "type": "string"
   },
   "serverSpecCode": {
    "description": "Server spec code (KVM)",
    "type": "string"
   },
   "softwareCode": {
    "description": "Server image code",
    "type": "string"
   },
   "storageSize": {
    "description": "Storage size in GB (KVM, 100-2000)",
    "type": "number"
   },
   "taints": {
    "description": "Node taints",
    "items": {
     "additionalProperties": false,
     "properties": {
      "effect": {
       "type": "string"
      },
      "key": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "key",
      "effect"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "zoneCode": {
    "description": "Zone code (e.g., KR-1). Required for Regional clusters and, since 2026-09-17, must match the zone of the subnets assigned to this node pool \u2014 a mismatch is rejected with 400",
    "type": "string"
   }
  },
  "required": [
   "clusterUuid",
   "name"
  ],
  "type": "object"
 },
 "name": "ncloud_nks_create_node_pool"
}
