{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/security.jwt-inspect",
  "agent-utilities/priceMicroUsd": 300
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Decode untrusted JWT claims and optionally compare timestamps; never verifies a signature. PAID: 300 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "atUnixSeconds": {
      "minimum": 0,
      "type": "integer"
     },
     "token": {
      "maxLength": 20000,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "token"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "security_jwt_inspect",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "claims": {
    "type": "object"
   },
   "expired": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "header": {
    "type": "object"
   },
   "notYetValid": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "scope": {
    "type": "string"
   },
   "signatureVerified": {
    "const": false
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "header",
   "claims",
   "signatureVerified",
   "expired",
   "notYetValid",
   "warnings",
   "scope"
  ],
  "type": "object"
 }
}
