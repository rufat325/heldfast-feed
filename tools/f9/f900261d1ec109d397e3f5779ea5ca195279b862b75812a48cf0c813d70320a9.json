{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Read a government dataset file as JSON rows"
 },
 "description": "Turn one dataset file into JSON rows: a CSV, TSV, XLSX or JSON link from any portal, an e-Stat (Japan) file-download link, or a data.go.kr (Korea) dataset page, which is resolved to its keyless file first. Encoding is detected (Korean CP949, Japanese Shift_JIS, Chinese Big5/GB18030, UTF-8/16, Western code pages), the header row found, numbers typed, XLSX sheets selectable, large files capped and disclosed. Input: url; optional max_rows, sheet, encoding, delimiter. $0.10 per call. Returns: source_url, resolved_from, file_url, final_url, filename, content_type, bytes, format, encoding, sheet, sheets[], columns[], column_count, rows[{...}], row_count, total_rows, truncated, notes[], checked_at.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "delimiter": {
    "description": "Force a CSV delimiter. Default: sniffed.",
    "maxLength": 1,
    "minLength": 1,
    "type": "string"
   },
   "encoding": {
    "description": "Force a codec (cp949, shift_jis, big5). Default: detected.",
    "maxLength": 30,
    "type": "string"
   },
   "language": {
    "description": "Optional BCP-47 language tag (en, ja, ko, pt-BR): the human-readable strings of the result (notes, details, reasons) are translated into this language; data, codes, numbers and URLs are untouched. Default: as produced.",
    "maxLength": 35,
    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
    "type": "string"
   },
   "max_rows": {
    "description": "Rows to return, default 200.",
    "maximum": 2000,
    "minimum": 1,
    "type": "integer"
   },
   "sheet": {
    "description": "XLSX sheet name or 0-based index. Default: first sheet.",
    "type": [
     "string",
     "integer"
    ]
   },
   "url": {
    "description": "File link, e-Stat file-download link, or a data.go.kr dataset page.",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "hubvibe_opendata_table",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The 200 body of every paid /work call. `result` is the worker's own output (its schema is per route); everything else is the same on every /work route. A receipt for the job is at `receipt_url`.",
  "properties": {
   "billing_warning": {
    "description": "Present only when the charge was recorded with a caveat.",
    "examples": [
     "settlement pending"
    ],
    "type": "string"
   },
   "price_usd": {
    "description": "What this call cost, in USD.",
    "examples": [
     0.02
    ],
    "type": "number"
   },
   "provenance": {
    "description": "How the result was produced: which providers ran and how long each took.",
    "properties": {
     "attempts": {
      "description": "Provider attempts made, including retries and failovers.",
      "examples": [
       1
      ],
      "type": "integer"
     },
     "elapsed_ms": {
      "description": "Wall-clock milliseconds for the whole job.",
      "examples": [
       340
      ],
      "type": "integer"
     },
     "providers_used": {
      "description": "Providers that served the job.",
      "examples": [
       [
        "coinbase-advanced-trade-public"
       ]
      ],
      "items": {
       "description": "Provider name.",
       "examples": [
        "coinbase-advanced-trade-public"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "steps": {
      "description": "Every step the job ran, in order.",
      "items": {
       "description": "One step of the job.",
       "properties": {
        "ms": {
         "description": "Milliseconds the step took.",
         "examples": [
          312
         ],
         "type": "integer"
        },
        "ok": {
         "description": "Whether the step succeeded.",
         "examples": [
          true
         ],
         "type": "boolean"
        },
        "provider": {
         "description": "Provider that served the step.",
         "examples": [
          "coinbase-advanced-trade-public"
         ],
         "type": "string"
        },
        "reason": {
         "description": "Failure reason, on a failed step.",
         "examples": [
          "provider_timeout"
         ],
         "type": "string"
        },
        "step": {
         "description": "Step name inside the worker.",
         "examples": [
          "quote"
         ],
         "type": "string"
        }
       },
       "required": [
        "step",
        "ok",
        "ms"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "steps",
     "providers_used",
     "attempts",
     "elapsed_ms"
    ],
    "type": "object"
   },
   "receipt_id": {
    "description": "Receipt id for this job.",
    "examples": [
     "rcpt_9f1c2b3a4d5e6f70"
    ],
    "type": "string"
   },
   "receipt_url": {
    "description": "Where to fetch the machine-readable receipt (free, no payment).",
    "examples": [
     "/work/receipts/rcpt_9f1c2b3a4d5e6f70"
    ],
    "type": "string"
   },
   "result": {
    "properties": {
     "bytes": {
      "description": "File size in bytes.",
      "examples": [
       12331
      ],
      "type": "integer"
     },
     "checked_at": {
      "description": "When this node read the source (UTC). Nothing here is cached.",
      "examples": [
       "2026-09-26T18:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
     },
     "column_count": {
      "description": "Number of columns.",
      "examples": [
       14
      ],
      "type": "integer"
     },
     "columns": {
      "description": "Columns in file order.",
      "examples": [
       [
        "\ud589\uc815\uad6c\uc5ed\ucf54\ub4dc",
        "\ud589\uc815\uad6c\uc5ed\uba85",
        "\uc131\ubcc4",
        "\ub0b4\uad6d\uc778"
       ]
      ],
      "items": {
       "description": "Column name from the header row.",
       "examples": [
        "\ud589\uc815\uad6c\uc5ed\uba85"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "content_type": {
      "description": "Server content type.",
      "examples": [
       "application/octet-stream"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "encoding": {
      "description": "Text encoding used; null for XLSX.",
      "examples": [
       "cp949"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "file_url": {
      "description": "The file actually fetched.",
      "examples": [
       "https://www.data.go.kr/cmm/cmm/fileDownload.do?atchFileId=FILE_000000003522968&fileDetailSn=1&insertDataPrcus=N"
      ],
      "type": "string"
     },
     "filename": {
      "description": "File name from the server or the URL.",
      "examples": [
       "\uc6b8\uc0b0\uad11\uc5ed\uc2dc_\uc778\uad6c \ud604\ud669(20251112).csv"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "final_url": {
      "description": "After redirects.",
      "examples": [
       "https://www.data.go.kr/cmm/cmm/fileDownload.do?atchFileId=FILE_000000003522968&fileDetailSn=1&insertDataPrcus=N"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "format": {
      "description": "Parsed format.",
      "enum": [
       "csv",
       "tsv",
       "xlsx",
       "json"
      ],
      "examples": [
       "csv"
      ],
      "type": "string"
     },
     "notes": {
      "description": "Caveats; empty when none.",
      "examples": [
       []
      ],
      "items": {
       "description": "A caveat.",
       "examples": [
        "45 data rows in the file; the first 5 are returned (max_rows)."
       ],
       "type": "string"
      },
      "type": "array"
     },
     "resolved_from": {
      "description": "The dataset page that was resolved to a file link; null when a file link was given.",
      "examples": [
       "https://www.data.go.kr/data/15005995/fileData.do"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "row_count": {
      "description": "Rows returned.",
      "examples": [
       5
      ],
      "type": "integer"
     },
     "rows": {
      "description": "Rows in file order, up to max_rows.",
      "items": {
       "additionalProperties": true,
       "description": "One row keyed by column; numbers typed, blanks null.",
       "examples": [
        {
         "\ub0b4\uad6d\uc778": 564888,
         "\uc131\ubcc4": "\ub0a8\uc790",
         "\ud589\uc815\uad6c\uc5ed\uba85": "\uc6b8\uc0b0\uad11\uc5ed\uc2dc",
         "\ud589\uc815\uad6c\uc5ed\ucf54\ub4dc": 31
        }
       ],
       "properties": {},
       "required": [],
       "type": "object"
      },
      "type": "array"
     },
     "sheet": {
      "description": "XLSX sheet read; null otherwise.",
      "examples": [
       "Sheet1"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "sheets": {
      "description": "All sheet names for an XLSX; empty otherwise.",
      "examples": [
       []
      ],
      "items": {
       "description": "Sheet name.",
       "examples": [
        "Sheet1"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "source_url": {
      "description": "The URL as given.",
      "examples": [
       "https://www.data.go.kr/data/15005995/fileData.do"
      ],
      "type": "string"
     },
     "total_rows": {
      "description": "Data rows in the file (excluding the header).",
      "examples": [
       45
      ],
      "type": "integer"
     },
     "truncated": {
      "description": "True when total_rows exceeds max_rows.",
      "examples": [
       true
      ],
      "type": "boolean"
     }
    },
    "required": [
     "source_url",
     "resolved_from",
     "file_url",
     "final_url",
     "filename",
     "content_type",
     "bytes",
     "format",
     "encoding",
     "sheet",
     "sheets",
     "columns",
     "column_count",
     "rows",
     "row_count",
     "total_rows",
     "truncated",
     "notes",
     "checked_at"
    ],
    "type": "object"
   },
   "status": {
    "const": "ok",
    "description": "Present only on a delivered result.",
    "type": "string"
   },
   "worker": {
    "description": "Catalog name of the worker that ran.",
    "examples": [
     "market.quote"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "worker",
   "price_usd",
   "result",
   "provenance",
   "receipt_id",
   "receipt_url"
  ],
  "title": "opendata.table response",
  "type": "object"
 },
 "title": "Read a government dataset file as JSON rows"
}
