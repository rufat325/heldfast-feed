{
 "description": "Deterministic position-limit and kill-switch gate \u2014 no external calls, pure arithmetic. Enforces max position size %, daily-loss limits, leverage caps, open-position count, and an asset allowlist. The final non-overridable gate before executing a trade.",
 "inputSchema": {
  "properties": {
   "portfolio": {
    "properties": {
     "assetAllocation": {
      "type": "object"
     },
     "cashUsd": {
      "type": "number"
     },
     "dailyPnlUsd": {
      "type": "number"
     },
     "openPositions": {
      "type": "number"
     },
     "totalValueUsd": {
      "type": "number"
     }
    },
    "required": [
     "totalValueUsd",
     "cashUsd"
    ],
    "type": "object"
   },
   "rules": {
    "properties": {
     "allowedAssets": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "killSwitch": {
      "type": "boolean"
     },
     "maxDailyLossPct": {
      "type": "number"
     },
     "maxLeverage": {
      "type": "number"
     },
     "maxOpenPositions": {
      "type": "number"
     },
     "maxPositionPct": {
      "type": "number"
     },
     "maxSingleTradeUsd": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "trade": {
    "properties": {
     "assetType": {
      "enum": [
       "crypto",
       "stock",
       "forex"
      ],
      "type": "string"
     },
     "leverage": {
      "type": "number"
     },
     "side": {
      "enum": [
       "buy",
       "sell",
       "long",
       "short"
      ],
      "type": "string"
     },
     "symbol": {
      "type": "string"
     },
     "tradeUsd": {
      "type": "number"
     }
    },
    "required": [
     "symbol",
     "side",
     "tradeUsd",
     "assetType"
    ],
    "type": "object"
   }
  },
  "required": [
   "trade",
   "portfolio"
  ],
  "type": "object"
 },
 "name": "finance_position_check"
}
