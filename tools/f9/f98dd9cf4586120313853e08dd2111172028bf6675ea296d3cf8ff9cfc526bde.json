 },
 "description": "Enumerate curated external ESG resources (standards bodies, regulators, tools, databases) with their source URLs, optionally filtered by exact source `domain` or a title substring (`query` \u2014 an exact substring, not fuzzy). Use it to assemble authoritative references; for ESG Hub's own articles use list_esg_pages. Results are ordered by title and paged: pass `next_offset` back as `offset`, advancing it by `limit` (a raw row count). `domain` must be a host from get_esg_metadata's domain list; `limit` caps at 100 (default 20). A filter that matches nothing, or an `offset` past the end, returns an empty item list with `has_more=false`. Cached ~5 minutes; rate-limited per IP; retry on 5xx.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "domain": {
    "description": "Filter by source domain (e.g., 'ghgprotocol.org')",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Results per page",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset \u2014 pass the previous next_offset",
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Filter by title substring",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_esg_resources",
