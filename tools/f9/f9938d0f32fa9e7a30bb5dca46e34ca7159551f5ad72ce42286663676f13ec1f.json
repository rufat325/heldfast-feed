{"description":"Inspect a local media file (absolute path under the configured media dir) and return its duration, video/audio codecs, audio sample rate, byte size and footage traits (hdr: pq/hlg/dolby-vision, colorPrimaries/colorTransfer, bitDepth, vfr, rotation). Probes via ffprobe directly so it never writes to stdout.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"path":{"type":"string"}},"required":["path"],"type":"object"},"name":"probe_media","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"audioCodec":{"type":["string","null"]},"bitDepth":{"type":["number","null"]},"colorPrimaries":{"type":["string","null"]},"colorTransfer":{"type":["string","null"]},"durationSeconds":{"type":["number","null"]},"hdr":{"anyOf":[{"enum":["pq","hlg","dolby-vision"],"type":"string"},{"type":"null"}]},"rotation":{"type":"number"},"sampleRate":{"type":["number","null"]},"sizeBytes":{"type":"number"},"vfr":{"type":"boolean"},"videoCodec":{"type":["string","null"]}},"required":["durationSeconds","videoCodec","audioCodec","sampleRate","sizeBytes","hdr","colorPrimaries","colorTransfer","bitDepth","vfr","rotation"],"type":"object"},"title":"Probe Media"}
