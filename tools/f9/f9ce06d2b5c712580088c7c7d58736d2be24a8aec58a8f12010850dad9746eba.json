 },
 "description": "Use when the user wants the news feed bucketed by category. Returns the same data shape as `list_news_movers` but pre-grouped into the canonical 14-category vocabulary, with cluster grouping inside each bucket. Useful for 'what's moving in politics?' style queries.",
 "inputSchema": {
  "properties": {
   "include_crypto": {
    "default": false,
    "description": "Include crypto price-derivative markets (default: excluded).",
    "title": "Include Crypto",
    "type": "boolean"
   },
   "include_entertainment": {
    "default": false,
    "description": "Include entertainment markets (default: excluded for signal-to-noise).",
    "title": "Include Entertainment",
    "type": "boolean"
   },
   "include_microprediction": {
    "default": false,
    "description": "Include microprediction / hyperlocal markets (default: excluded).",
    "title": "Include Microprediction",
    "type": "boolean"
   },
   "include_resolved": {
    "default": false,
    "description": "Include resolved (closed) markets (default: excluded \u2014 news movers focus on live markets).",
    "title": "Include Resolved",
    "type": "boolean"
   },
   "include_sports": {
    "default": false,
    "description": "Include sports markets (default: excluded).",
    "title": "Include Sports",
    "type": "boolean"
   },
   "include_weather": {
    "default": false,
    "description": "Include weather markets (default: excluded).",
    "title": "Include Weather",
    "type": "boolean"
   },
   "min_score": {
    "anyOf": [
     {
      "minimum": 0.0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Minimum spike score. Higher = more notable spikes only.",
    "title": "Min Score"
   },
   "per_category": {
    "default": 11,
    "description": "Max items per category bucket (1-50; default 11).",
    "maximum": 50.0,
    "minimum": 1.0,
    "title": "Per Category",
    "type": "integer"
   },
   "q": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Full-text search across market title and event title. Case-insensitive substring match.",
    "title": "Q"
   },
   "source": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Platform ID(s); single value or comma-separated list. Allowed: polymarket, kalshi, manifold, myriad, limitless, predict, opinion, gemini.",
    "title": "Source"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "news_movers_by_category",
 "outputSchema": {
  "$defs": {
   "NewsByCategoryResponse": {
    "description": "Response for GET /api/v1/news/movers/by-category.\n\nThe same event/cluster can appear in multiple buckets when its\ncategories list contains more than one entry. Bucket keys match\nv2's `KNOWN_CATEGORIES`; bucket values are sorted by score desc\nand capped at the per-category limit (`?per_category=`, default 11).",
    "properties": {
     "_meta": {
      "anyOf": [
       {
        "$ref": "#/$defs/ResponseMetaList"
       },
       {
        "type": "null"
       }
      ]
     },
     "by_category": {
      "additionalProperties": {
       "items": {
        "anyOf": [
         {
          "$ref": "#/$defs/NewsCluster"
         },
         {
          "$ref": "#/$defs/NewsEventOut"
         }
        ]
       },
       "type": "array"
      },
      "title": "By Category",
      "type": "object"
     },
     "last_refreshed_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Last Refreshed At"
     }
    },
    "required": [
     "last_refreshed_at",
     "by_category"
    ],
    "title": "NewsByCategoryResponse",
    "type": "object"
   },
   "NewsCluster": {
    "description": "A cluster of news events that share a specific topical tag.\n\nBuilt per-source from the parent event's `tags` array (currently\nPolymarket-only \u2014 other sources don't reliably populate tags).\nPicked tag is the rarest globally that's also shared by at least\ntwo events in the news feed; the cluster's `cluster_label` is\nthat tag's `label` field as published by Polymarket.\n\n`events` is the member event list sorted by score desc. The\nFE renders the cluster as a 3-level structure:\n  cluster header \u2192 up to N events \u2192 each event's gainer/loser.",
    "properties": {
     "cluster_key": {
      "title": "Cluster Key",
      "type": "string"
     },
     "cluster_label": {
      "title": "Cluster Label",
      "type": "string"
     },
     "cluster_slug": {
      "title": "Cluster Slug",
      "type": "string"
     },
     "events": {
      "items": {
       "$ref": "#/$defs/NewsEventOut"
      },
      "title": "Events",
      "type": "array"
     },
     "image": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Image"
     },
     "kind": {
      "const": "cluster",
      "default": "cluster",
      "title": "Kind",
      "type": "string"
     },
     "score": {
      "title": "Score",
      "type": "number"
     },
     "source": {
      "title": "Source",
      "type": "string"
     },
     "src": {
      "enum": [
       "pm",
       "ka",
       "ma",
       "li",
       "op",
       "pr",
       "my",
       "gm"
      ],
      "title": "Src",
      "type": "string"
     },
     "total_vol_24hr": {
      "title": "Total Vol 24Hr",
      "type": "number"
     }
    },
    "required": [
     "cluster_key",
     "cluster_label",
     "cluster_slug",
     "source",
     "src",
     "total_vol_24hr",
     "score",
     "events"
    ],
    "title": "NewsCluster",
    "type": "object"
   },
   "NewsEventOut": {
    "description": "One news row, shaped to the wireframe's `NewsEvent` type.",
    "properties": {
     "cat": {
