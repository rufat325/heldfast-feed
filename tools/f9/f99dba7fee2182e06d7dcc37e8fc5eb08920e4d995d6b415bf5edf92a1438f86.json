{
 "description": "Ranked list of Solana tokens worth paying attention to right now. Composes DexScreener trending + risk scoring + whale-flow into a composite signal with reasoning.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "include_whale_watch": {
    "default": true,
    "description": "Include whale flow signal",
    "type": "boolean"
   },
   "limit": {
    "default": 10,
    "description": "Number of tokens to return",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "max_risk_score": {
    "default": 0.7,
    "description": "Maximum risk score (0-1)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "min_liquidity_usd": {
    "default": 10000,
    "description": "Minimum liquidity in USD",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "trending_signals",
 "title": "Trending Signals"
}
