{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search Tabflows' DPC Finder directory of direct primary care practices in the US by free text (name, city, doctor, specialty), state, city and practice model. Returns full listings including address, phone and doctor as on file, with the total match count for paging.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "city": {
    "description": "Exact city name, case-insensitive",
    "maxLength": 100,
    "type": "string"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "model": {
    "enum": [
     "Pure DPC",
     "Hybrid",
     "Onsite",
     "Unknown/other"
    ],
    "type": "string"
   },
   "offset": {
    "default": 0,
    "maximum": 2663,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Free text matched against name, city, doctor and specialty",
    "maxLength": 100,
    "type": "string"
   },
   "state": {
    "description": "Two-letter state code, e.g. \"TX\"",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_dpc_practices",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "type": "string"
      },
      "caseStudyUrl": {
       "type": "string"
      },
      "city": {
       "type": "string"
      },
      "dataCaveat": {
       "type": "string"
      },
      "doctor": {
       "type": "string"
      },
      "lat": {
       "type": "number"
      },
      "lng": {
       "type": "number"
      },
      "model": {
       "enum": [
        "Pure DPC",
        "Hybrid",
        "Onsite",
        "Unknown/other"
       ],
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "openDate": {
       "type": "string"
      },
      "phone": {
       "type": "string"
      },
      "precision": {
       "enum": [
        "city",
        "address"
       ],
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "specialty": {
       "type": "string"
      },
      "state": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "website": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "name",
      "city",
      "state",
      "model",
      "lat",
      "lng",
      "precision",
      "url",
      "dataCaveat"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "stateDirectoryUrl": {
    "type": "string"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "total",
   "results",
   "stateDirectoryUrl"
  ],
  "type": "object"
 },
 "title": "Search the DPC Finder"
}
