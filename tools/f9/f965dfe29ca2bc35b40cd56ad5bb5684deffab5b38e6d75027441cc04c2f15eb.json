{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Create a group post (announcement). Does not notify members unless sendNotification is true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "groupId": {
    "description": "Exact group ID. Provide groupId or shortCode.",
    "type": "string"
   },
   "imageId": {
    "description": "Existing VRChat file ID to attach as the post image.",
    "type": "string"
   },
   "roleIds": {
    "description": "Restrict the post to these group roles. Omit to show it to everyone who can see the post.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sendNotification": {
    "default": false,
    "description": "Notify group members. Defaults to false; set true only when the post warrants a ping.",
    "type": "boolean"
   },
   "shortCode": {
    "description": "Exact group short code. Provide groupId or shortCode.",
    "type": "string"
   },
   "text": {
    "description": "Post body text.",
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "description": "Post title.",
    "minLength": 1,
    "type": "string"
   },
   "visibility": {
    "description": "group restricts the post to members; public shows it on the group page.",
    "enum": [
     "group",
     "public"
    ],
    "type": "string"
   }
  },
  "required": [
   "title",
   "text",
   "visibility"
  ],
  "type": "object"
 },
 "name": "vrchat_group_post_create",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "groupId": {
    "type": "string"
   },
   "mergedFromExisting": {
    "type": "boolean"
   },
   "post": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "authorId": {
        "type": "string"
       },
       "createdAt": {
        "type": "string"
       },
       "id": {
        "type": "string"
       },
       "imageId": {
        "type": "string"
       },
       "roleIds": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "text": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "updatedAt": {
        "type": "string"
       },
       "visibility": {
        "type": "string"
       }
      },
      "required": [
       "id"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "postId": {
    "type": "string"
   },
   "status": {
    "enum": [
     "created",
     "updated",
     "deleted"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "groupId"
  ],
  "type": "object"
 }
}
