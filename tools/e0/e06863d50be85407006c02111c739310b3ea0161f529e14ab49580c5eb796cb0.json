{
 "description": "Write design tokens back to Figma as Variables via the Figma REST API. Creates or updates variable collections.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "file_key": {
    "description": "Figma file key to push variables to",
    "type": "string"
   },
   "variables": {
    "description": "Array of variables to create or update",
    "items": {
     "properties": {
      "collection": {
       "description": "Variable collection name",
       "type": "string"
      },
      "name": {
       "description": "Variable name (e.g., \"colors/primary\", \"spacing/md\")",
       "type": "string"
      },
      "type": {
       "description": "Variable type",
       "enum": [
        "COLOR",
        "FLOAT",
        "STRING"
       ],
       "type": "string"
      },
      "value": {
       "description": "Variable value (hex color string, number, or string)",
       "type": [
        "string",
        "number"
       ]
      }
     },
     "required": [
      "name",
      "type",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "file_key",
   "variables"
  ],
  "type": "object"
 },
 "name": "figma_push_variables"
}
