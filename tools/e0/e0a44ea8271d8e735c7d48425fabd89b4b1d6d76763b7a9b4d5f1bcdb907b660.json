{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Read the current budget, cost, remaining limits, and stop pressure for one MartinLoop run. Provide exactly one selector: loopJson for an inline record, file for a saved record, loopId for a run-store ID, or latest for the newest run; runsDir only changes the run-store root. Use for a compact budget check. Do not use for full events or artifacts; use martin_get_run or martin_run_dossier instead.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "file": {
    "description": "Path under the Martin runs root to a loop-record.json file, a legacy .jsonl file, or a run-store directory. Mutually exclusive with loopJson, loopId, and latest.",
    "type": "string"
   },
   "latest": {
    "const": true,
    "description": "When true, loads the most recently updated loop record. Mutually exclusive with loopJson, file, and loopId."
   },
   "loopId": {
    "description": "Loop ID resolved as <runsDir>/<loopId>/loop-record.json. Mutually exclusive with loopJson, file, and latest.",
    "type": "string"
   },
   "loopJson": {
    "description": "JSON-serialized LoopRecord.",
    "type": "string"
   },
   "runsDir": {
    "description": "Optional runs-root override resolved under the default Martin runs root.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "martin_status",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "attempts": {
    "type": "integer"
   },
   "avoidedUsd": {
    "type": "number"
   },
   "budget": {
    "additionalProperties": false,
    "properties": {
     "maxIterations": {
      "type": "integer"
     },
     "maxTokens": {
      "type": "integer"
     },
     "maxUsd": {
      "type": "number"
     },
     "softLimitUsd": {
      "type": "number"
     }
    },
    "required": [
     "maxUsd",
     "softLimitUsd",
     "maxIterations"
    ],
    "type": "object"
   },
   "costUsd": {
    "type": "number"
   },
   "inspection": {
    "additionalProperties": false,
    "properties": {
     "loop": {
      "additionalProperties": true,
      "properties": {
       "activeAttemptId": {
        "description": "ID of the currently active attempt, when a run is in progress.",
        "type": "string"
       },
       "attempts": {
        "type": "integer"
       },
       "avoidedUsd": {
        "type": "number"
       },
       "costUsd": {
        "type": "number"
       },
       "createdAt": {
        "type": "string"
       },
       "lastAttempt": {
        "additionalProperties": true,
        "type": "object"
       },
       "lifecycleState": {
        "type": "string"
       },
       "loopId": {
        "type": "string"
       },
       "objective": {
        "type": "string"
       },
       "pressure": {
        "type": "string"
       },
       "remainingBudgetUsd": {
        "type": "number"
       },
       "remainingIterations": {
        "type": "integer"
       },
       "remainingTokens": {
        "type": "integer"
       },
       "shouldStop": {
        "type": "boolean"
       },
       "status": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "updatedAt": {
        "type": "string"
       }
      },
      "required": [
       "loopId",
       "title",
       "objective",
       "status",
       "lifecycleState",
       "attempts",
       "costUsd",
       "avoidedUsd",
       "pressure",
       "shouldStop",
       "remainingBudgetUsd",
       "remainingIterations"
      ],
      "type": "object"
     }
    },
    "required": [
     "loop"
    ],
    "type": "object"
   },
   "lifecycleState": {
    "type": "string"
   },
   "loopId": {
    "type": "string"
   },
   "pressure": {
    "type": "string"
   },
   "remainingBudgetUsd": {
    "type": "number"
   },
   "remainingIterations": {
    "type": "integer"
   },
   "remainingTokens": {
    "type": "integer"
   },
   "shouldStop": {
    "type": "boolean"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "source",
   "loopId",
   "status",
   "lifecycleState",
   "attempts",
   "costUsd",
   "avoidedUsd",
   "pressure",
   "shouldStop",
   "remainingBudgetUsd",
   "remainingIterations",
   "budget",
   "inspection"
  ],
  "type": "object"
 }
}
