{
 "description": "Compile and apply ONE unified spending policy across every backend (fail-closed). Amounts are base units (USDC has 6 decimals: 100 USDC = 100000000). Omit agentId to apply to all agents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agentId": {
    "type": "string"
   },
   "allowlist": {
    "description": "permitted counterparties; [] = deny all",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "approvalThreshold": {
    "description": "spends strictly above this need human approval",
    "type": "string"
   },
   "asset": {
    "description": "e.g. USDC",
    "type": "string"
   },
   "dailyCap": {
    "description": "max per rolling day, base units",
    "type": "string"
   },
   "denylist": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "frozen": {
    "description": "hard kill \u2014 deny everything",
    "type": "boolean"
   },
   "perTxCap": {
    "description": "max per transaction, base units",
    "type": "string"
   },
   "venues": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "asset"
  ],
  "type": "object"
 },
 "name": "countersign_apply_policy"
}
