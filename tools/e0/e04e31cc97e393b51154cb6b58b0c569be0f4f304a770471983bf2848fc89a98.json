    "maximum": 1000000,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Entries per page (1-100, default 25)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_zones",
