{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search THE COOP"
 },
 "description": "Semantic + keyword search across published THE COOP articles, supplier and media profiles and industry events. Returns one passage per record with canonical URLs, dates and a text-relevance band, not an answer-confidence score. Use get_article / get_supplier / get_event for the full record.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 8,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Natural-language question or keywords, e.g. \"payment orchestration for UK operators\"",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "review_status": {
    "description": "Restrict supplier results by editorial review status",
    "enum": [
     "desk-reviewed",
     "research-candidate"
    ],
    "type": "string"
   },
   "supplier_category": {
    "enum": [
     "payment-service-provider",
     "payment-orchestration",
     "payment-method",
     "crypto-payments",
     "platform",
     "identity-and-compliance",
     "banking",
     "legal-and-licensing",
     "media",
     "other",
     "unclassified"
    ],
    "type": "string"
   },
   "topic": {
    "description": "Article topic filter",
    "enum": [
     "payments",
     "platforms",
     "technology",
     "people"
    ],
    "type": "string"
   },
   "types": {
    "description": "Restrict to record types",
    "items": {
     "enum": [
      "article",
      "supplier",
      "event"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "title": "Search THE COOP"
}
