{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Split costs"
 },
 "description": "Split one total cost across players (equally or by relative weights) and show who owes what plus the fewest settle-up payments.",
 "inputSchema": {
  "properties": {
   "currency": {
    "description": "Currency code for display, default USD",
    "type": "string"
   },
   "participants": {
    "description": "Players in the split",
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "paid": {
       "type": "number"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "shares": {
    "description": "Optional relative weights, one per participant",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "total_cost": {
    "description": "Total court/venue cost",
    "type": "number"
   }
  },
  "required": [
   "total_cost",
   "participants"
  ],
  "type": "object"
 },
 "name": "split_costs"
}
