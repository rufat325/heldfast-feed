{
 "description": "Cheap bulk page text: fetch 1-20 URLs and get clean markdown, truncated to a per-page cap. $0.0015 per URL. Price: $0.0015 per URL (1-20); an x402 payment is at least $0.004",
 "inputSchema": {
  "properties": {
   "maxChars": {
    "default": 20000,
    "description": "Per-page content character cap",
    "example": 20000,
    "maximum": 50000,
    "minimum": 500,
    "type": "number"
   },
   "timeout": {
    "default": 10000,
    "description": "Request timeout in milliseconds",
    "maximum": 30000,
    "minimum": 5000,
    "type": "number"
   },
   "urls": {
    "description": "Pages to fetch",
    "example": [
     "https://example.com"
    ],
    "items": {
     "description": "The URL to process",
     "format": "uri",
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "urls"
  ],
  "type": "object"
 },
 "name": "get_contents"
}
