{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "rag",
 "description": "Rank an array of text chunks by relevance to a query using TF-IDF scoring. Simulates retrieval ranking for RAG testing without needing embeddings or an API.",
 "inputSchema": {
  "properties": {
   "chunks": {
    "description": "Array of text chunks to rank",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "query": {
    "description": "The user query",
    "type": "string"
   },
   "top_k": {
    "description": "Return top K results (default: all)",
    "type": "number"
   }
  },
  "required": [
   "query",
   "chunks"
  ],
  "type": "object"
 },
 "name": "rag_relevance_rank",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "chunk_preview": {},
   "index": {},
   "keyword_overlap": {},
   "query": {},
   "rank": {
    "type": "number"
   },
   "results": {},
   "returned": {
    "type": "number"
   },
   "score": {
    "type": "string"
   },
   "total_chunks": {
    "type": "number"
   }
  },
  "type": "object"
 }
}
