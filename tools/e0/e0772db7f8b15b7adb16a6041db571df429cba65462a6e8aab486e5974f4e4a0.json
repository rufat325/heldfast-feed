{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Extract selected product fields from a public product page. Never invents missing fields. Production payment: use x402 v2 PAYMENT-SIGNATURE for exact Base mainnet USDC, or X-Found17-Billing-Mode: stripe with X-Found17-Account-Id and X-Found17-Stripe-Customer-Id.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "max_age_ms": {
    "maximum": 300000,
    "minimum": 0,
    "type": "integer"
   },
   "response_mode": {
    "enum": [
     "minimal",
     "standard",
     "evidence"
    ],
    "type": "string"
   },
   "select": {
    "items": {
     "enum": [
      "name",
      "brand",
      "description",
      "price",
      "currency",
      "sku",
      "availability",
      "images",
      "attributes"
     ],
     "type": "string"
    },
    "maxItems": 9,
    "type": "array"
   },
   "url": {
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "web_to_product",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "billing": {
    "additionalProperties": false,
    "properties": {
     "carry_forward_usd_micros": {
      "type": "number"
     },
     "channel": {
      "type": "string"
     },
     "charged_usd_micros": {
      "type": "number"
     },
     "mode": {
      "type": "string"
     },
     "quoted_usd_micros": {
      "type": "number"
     },
     "settlement_status": {
      "type": "string"
     },
     "settlement_transaction": {
      "type": "string"
     }
    },
    "required": [
     "mode",
     "quoted_usd_micros",
     "charged_usd_micros"
    ],
    "type": "object"
   },
   "confidence": {
    "type": "number"
   },
   "evidence": {
    "items": {},
    "type": "array"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "executed_at": {
      "type": "string"
     },
     "input_hash": {
      "type": "string"
     },
     "output_hash": {
      "type": "string"
     }
    },
    "required": [
     "executed_at",
     "input_hash",
     "output_hash"
    ],
    "type": "object"
   },
   "request_id": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "service": {
    "type": "string"
   },
   "success": {
    "const": true,
    "type": "boolean"
   },
   "version": {
    "type": "string"
   }
  },
  "required": [
   "success",
   "service",
   "version",
   "result",
   "evidence",
   "confidence",
   "limitations",
   "provenance",
   "billing",
   "request_id"
  ],
  "type": "object"
 }
}
