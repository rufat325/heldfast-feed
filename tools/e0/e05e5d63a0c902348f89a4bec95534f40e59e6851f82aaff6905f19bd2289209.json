{
 "description": "Show the full resolved dependency tree for a package version, including all transitive dependencies with their depth and relation type.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ecosystem": {
    "default": "npm",
    "description": "Package ecosystem (default: npm)",
    "enum": [
     "npm",
     "pypi",
     "go",
     "maven",
     "cargo",
     "nuget",
     "rubygems",
     "pub"
    ],
    "type": "string"
   },
   "maxDepth": {
    "default": 3,
    "description": "Maximum depth to display (default: 3, max: 10)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Package name",
    "type": "string"
   },
   "version": {
    "description": "Package version",
    "type": "string"
   }
  },
  "required": [
   "name",
   "version"
  ],
  "type": "object"
 },
 "name": "hound_tree"
}
