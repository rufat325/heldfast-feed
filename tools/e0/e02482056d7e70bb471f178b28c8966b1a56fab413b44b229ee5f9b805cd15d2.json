    "description": "Product handle: 'the-legacy-print', 'the-cinematic-print', or 'the-address-sign'. Omit for store-wide stats.",
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_reviews_summary",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
