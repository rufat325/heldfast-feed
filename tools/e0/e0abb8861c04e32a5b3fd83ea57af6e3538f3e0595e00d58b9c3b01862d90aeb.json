{"description":"Create a new subscription on Google Play (monetization API). Pass the full subscription body \u2014 including listings and at least one base plan with billing details and per-region pricing. Base plans are created in DRAFT state; call google_activate_subscription_base_plan to make them purchasable.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"basePlans":{"description":"At least one auto-renewing, prepaid, or installments base plan is required","items":{"additionalProperties":false,"properties":{"autoRenewing":{"additionalProperties":false,"properties":{"accountHoldDuration":{"type":"string"},"billingPeriodDuration":{"minLength":1,"type":"string"},"gracePeriodDuration":{"type":"string"},"legacyCompatible":{"type":"boolean"},"prorationMode":{"minLength":1,"type":"string"},"resubscribeState":{"minLength":1,"type":"string"}},"required":["billingPeriodDuration"],"type":"object"},"basePlanId":{"pattern":"^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$","type":"string"},"installments":{"additionalProperties":false,"properties":{"accountHoldDuration":{"type":"string"},"billingPeriodDuration":{"minLength":1,"type":"string"},"committedPaymentsCount":{"exclusiveMinimum":0,"type":"integer"},"gracePeriodDuration":{"type":"string"},"prorationMode":{"minLength":1,"type":"string"},"renewalType":{"enum":["RENEWAL_TYPE_RENEWS_WITHOUT_COMMITMENT","RENEWAL_TYPE_RENEWS_WITH_COMMITMENT"],"type":"string"},"resubscribeState":{"minLength":1,"type":"string"}},"required":["billingPeriodDuration","committedPaymentsCount","renewalType"],"type":"object"},"offerTags":{"items":{"pattern":"^[a-z0-9](?:[a-z0-9-]{0,18}[a-z0-9])?$","type":"string"},"maxItems":20,"type":"array"},"otherRegionsConfig":{"additionalProperties":false,"properties":{"eurPriceMicros":{"$ref":"#/properties/basePlans/items/properties/regionalConfigs/items/properties/priceMicros"},"newSubscriberAvailability":{"default":false,"type":"boolean"},"usdPriceMicros":{"$ref":"#/properties/basePlans/items/properties/regionalConfigs/items/properties/priceMicros"}},"required":["usdPriceMicros","eurPriceMicros"],"type":"object"},"prepaid":{"additionalProperties":false,"properties":{"billingPeriodDuration":{"minLength":1,"type":"string"},"timeExtension":{"enum":["TIME_EXTENSION_ACTIVE","TIME_EXTENSION_INACTIVE"],"type":"string"}},"required":["billingPeriodDuration"],"type":"object"},"regionalConfigs":{"items":{"additionalProperties":false,"properties":{"currency":{"pattern":"^[A-Z]{3}$","type":"string"},"newSubscriberAvailability":{"default":true,"type":"boolean"},"priceMicros":{"pattern":"^\\d+$","type":"string"},"regionCode":{"pattern":"^[A-Z]{2}$","type":"string"}},"required":["regionCode","priceMicros","currency"],"type":"object"},"minItems":1,"type":"array"}},"required":["basePlanId","regionalConfigs"],"type":"object"},"minItems":1,"type":"array"},"listings":{"description":"At least one localization is required","items":{"additionalProperties":false,"properties":{"benefits":{"description":"Up to four benefit bullets of at most 40 chars each per locale","items":{"maxLength":40,"minLength":1,"type":"string"},"maxItems":4,"type":"array"},"description":{"description":"Localized description (max 200 chars)","maxLength":200,"type":"string"},"languageCode":{"description":"BCP-47 locale code, e.g. en-US","minLength":1,"type":"string"},"title":{"description":"Localized subscription title (max 55 chars)","maxLength":55,"type":"string"}},"required":["languageCode","title"],"type":"object"},"minItems":1,"type":"array"},"packageName":{"description":"Android package name (e.g. com.example.app)","type":"string"},"productId":{"description":"Subscription product ID, e.g. com.example.app.pro_monthly","maxLength":40,"pattern":"^[a-z0-9][a-z0-9._]*$","type":"string"},"regionsVersion":{"default":"2022/02","description":"Google Play regions version. Default 2022/02 matches Google API expectations.","type":"string"}},"required":["packageName","productId","listings","basePlans"],"type":"object"},"name":"google_create_subscription"}
