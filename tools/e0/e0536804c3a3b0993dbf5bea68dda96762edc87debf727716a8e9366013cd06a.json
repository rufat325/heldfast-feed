{
 "description": "Create a calendar event. Dates are ISO 8601 strings in UTC. For virtual events set meeting_url; for in-person set location. event_type controls which field the UI shows.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cover_image_url": {
    "format": "uri",
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "description_format": {
    "enum": [
     "markdown",
     "tiptap_json"
    ],
    "type": "string"
   },
   "description_json": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "end_date": {
    "description": "ISO 8601 timestamp",
    "type": "string"
   },
   "event_type": {
    "enum": [
     "virtual",
     "in-person",
     "hybrid"
    ],
    "type": "string"
   },
   "location": {
    "type": "string"
   },
   "max_attendees": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "meeting_url": {
    "format": "uri",
    "type": "string"
   },
   "start_date": {
    "description": "ISO 8601 timestamp",
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timezone": {
    "description": "IANA tz, e.g. \"America/New_York\"",
    "type": "string"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "event_type",
   "start_date",
   "end_date"
  ],
  "type": "object"
 },
 "name": "hivelearn_create_event"
}
