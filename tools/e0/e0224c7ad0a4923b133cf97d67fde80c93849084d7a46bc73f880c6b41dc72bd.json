{
 "description": "Fetch SmartTest execution history for a testId (top 5 recent runs), an optional platform-rooted folder/file scope, or a scenario when scenarioId is set. Prefer testId when you have it from fetch-execution-report. Typically omit environment to avoid env scoping. Use branchName and scope.filePaths as for coverage. Optional platform (web|ios|android) and dimensionFilters narrow results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "branchName": {
    "type": "string"
   },
   "dimensionFilters": {
    "items": {
     "properties": {
      "dimension": {
       "minLength": 1,
       "type": "string"
      },
      "values": {
       "items": {
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      }
     },
     "required": [
      "dimension",
      "values"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "environment": {
    "type": "string"
   },
   "limit": {
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   },
   "offset": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "platform": {
    "enum": [
     "web",
     "ios",
     "android"
    ],
    "type": "string"
   },
   "release": {
    "type": "string"
   },
   "scenarioId": {
    "type": "string"
   },
   "scope": {
    "properties": {
     "filePaths": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "folderPath": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "string"
       }
      ]
     }
    },
    "type": "object"
   },
   "testId": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get-execution-history"
}
