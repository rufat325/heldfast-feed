{
 "description": "List WEEEK tasks with server-side filters. Set allPages=true together with userId, startDate, and endDate to fetch every matching page inside the connector without returning unrelated workspace pages.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allPages": {
    "default": false,
    "type": "boolean"
   },
   "completed": {
    "type": "boolean"
   },
   "endDate": {
    "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "minimum": 0,
    "type": "integer"
   },
   "projectId": {
    "type": "integer"
   },
   "sortBy": {
    "enum": [
     "name",
     "type",
     "priority",
     "duration",
     "overdue",
     "created",
     "date",
     "start"
    ],
    "type": "string"
   },
   "startDate": {
    "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$",
    "type": "string"
   },
   "userId": {
    "format": "uuid",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "weeek_list_tasks"
}
