{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Job queue with at-least-once delivery. enqueue(payload: any JSON, optional dedupe_key/channel); claim\nreturns job and receipt (or job null; wait_seconds up to 30); ack/release/renew need seq and the current\nreceipt (renew defaults to the queue's visibility_seconds; dead lists up to limit, default 50). Unacked jobs return after visibility_seconds (default 60) and dead-letter after max_attempts\n(default 5). Make side effects idempotent; never ack before finishing.","inputSchema":{"properties":{"action":{"enum":["create","read","enqueue","claim","ack","release","renew","job","dead","touch","delete"],"title":"Action","type":"string"},"channel":{"anyOf":[{"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,99}$","type":"string"},{"type":"null"}],"default":null,"title":"Channel"},"dedupe_key":{"anyOf":[{"maxLength":200,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"title":"Dedupe Key"},"delay_seconds":{"anyOf":[{"maximum":86400,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Delay Seconds"},"id":{"anyOf":[{"pattern":"^[A-Za-z0-9_-]{16,64}$","type":"string"},{"type":"null"}],"default":null,"title":"Id"},"limit":{"anyOf":[{"maximum":100,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Limit"},"max_attempts":{"anyOf":[{"maximum":100,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Max Attempts"},"payload":{"default":null,"title":"Payload"},"receipt":{"anyOf":[{"maxLength":128,"minLength":16,"type":"string"},{"type":"null"}],"default":null,"title":"Receipt"},"seq":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Seq"},"ttl_seconds":{"anyOf":[{"maximum":604800,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Ttl Seconds"},"visibility_seconds":{"anyOf":[{"maximum":43200,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Visibility Seconds"},"wait_seconds":{"anyOf":[{"maximum":30,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Wait Seconds"}},"required":["action"],"title":"queueArguments","type":"object"},"name":"queue"}
