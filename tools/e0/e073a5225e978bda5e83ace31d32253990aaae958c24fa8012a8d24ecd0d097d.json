{
 "description": "Rotate a scoped sub-key (POST /v1/keys/{key_id}/rotate). Prior key honors grace_hours (default 24). Root Bearer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "grace_hours": {
    "description": "Grace window for superseded key (hours)",
    "maximum": 168,
    "minimum": 1,
    "type": "integer"
   },
   "key_id": {
    "description": "Sub-key UUID from lithtrix_keys_list",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "key_id"
  ],
  "type": "object"
 },
 "name": "lithtrix_keys_rotate"
}
