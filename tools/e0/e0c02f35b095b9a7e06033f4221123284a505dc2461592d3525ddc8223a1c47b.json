{
 "description": "List all contracts. Can filter by status.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Maximum number of results (default: 50, max: 100)",
    "type": "number"
   },
   "status": {
    "description": "Filter by contract status",
    "enum": [
     "draft",
     "pending",
     "pending_payment",
     "fully_signed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_contracts"
}
