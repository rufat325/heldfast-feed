{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Runs and clusters Oxlint and TypeScript (and optionally Biome) lint and type diagnostics for one or more project paths. Read-only; no files are written or modified. Paths default to the project root (\".\") when omitted; paths must be relative and within the project directory \u2014 absolute paths or paths outside the root return an error response. Use this for a full project scan; use check_files instead for faster incremental checks after editing specific files. Each call re-runs all enabled engines with no caching.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "paths": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 512,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "check_project",
 "outputSchema": {
  "properties": {
   "checkId": {
    "type": "string"
   },
   "clusters": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "clusterId": {
       "type": "string"
      },
      "fileCount": {
       "type": "integer"
      },
      "issueCount": {
       "type": "integer"
      },
      "priority": {
       "type": "integer"
      },
      "rootCauseSummary": {
       "type": "string"
      },
      "ruleIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "sampleIssueIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "suggestedAction": {
       "type": "string"
      }
     },
     "required": [
      "clusterId",
      "rootCauseSummary",
      "ruleIds",
      "issueCount",
      "fileCount",
      "priority"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "code": {
    "type": "string"
   },
   "engine": {
    "enum": [
     "oxlint",
     "tsc",
     "biome",
     "eslint"
    ],
    "type": "string"
   },
   "engines": {
    "additionalProperties": false,
    "properties": {
     "biome": {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "status": {
        "enum": [
         "ok",
         "error",
         "disabled"
        ],
        "type": "string"
       }
      },
      "required": [
       "status"
      ],
      "type": "object"
     },
     "eslint": {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "status": {
        "enum": [
         "ok",
         "error",
         "disabled"
        ],
        "type": "string"
       }
      },
      "required": [
       "status"
      ],
      "type": "object"
     },
     "oxlint": {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "status": {
        "enum": [
         "ok",
         "error",
         "disabled"
        ],
        "type": "string"
       }
      },
      "required": [
       "status"
      ],
      "type": "object"
     },
     "tsc": {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "status": {
        "enum": [
         "ok",
         "error",
         "disabled"
        ],
        "type": "string"
       }
      },
      "required": [
       "status"
      ],
      "type": "object"
     }
    },
    "type": "object"
   },
   "fileRuleChurnWarning": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "checkCount": {
        "type": "integer"
       },
       "file": {
        "type": "string"
       },
       "hint": {
        "type": "string"
       },
       "rule": {
        "type": "string"
       }
      },
      "required": [
       "file",
       "rule",
       "checkCount",
       "hint"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "filteredOut": {
    "type": "integer"
   },
   "filteredOutCount": {
    "type": "integer"
   },
   "filteredOutIssueCount": {
    "type": "integer"
   },
   "loopWarning": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "hint": {
        "type": "string"
       },
       "occurrences": {
        "type": "integer"
       },
       "signature": {
        "type": "string"
       }
      },
      "required": [
       "signature",
       "occurrences",
       "hint"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "message": {
    "type": "string"
   },
   "nextStep": {
    "type": "string"
   },
   "omittedIssueCount": {
    "type": "integer"
   },
   "projectRoot": {
    "type": "string"
   },
   "remainingIssues": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "col": {
       "type": "integer"
      },
      "file": {
       "type": "string"
      },
      "fixable": {
       "type": "boolean"
      },
      "issueId": {
       "type": "string"
      },
      "line": {
       "type": "integer"
      },
      "rule": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning"
       ],
       "type": "string"
      }
     },
     "required": [
      "issueId",
      "file",
      "line",
      "col",
      "rule",
      "severity",
      "fixable"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "schemaVersion": {
    "enum": [
     "1.3",
     "1.4"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "clean",
     "issues_found",
     "error"
    ],
    "type": "string"
   },
   "totalIssues": {
    "type": "integer"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 }
}
