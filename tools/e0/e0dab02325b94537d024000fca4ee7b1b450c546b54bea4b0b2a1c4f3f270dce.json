  "title": "Color Converter"
 },
 "description": "Use this when you need one color's exact values across every common format. Accepts a hex (#abc or #aabbcc), rgb(r, g, b) with r/g/b 0-255, or hsl(h, s%, l%) color and returns hex, rgb {r,g,b}, hsl {h,s,l}, hsv {h,s,v}, cmyk {c,m,y,k}, and oklch {l,c,h} (CSS Color 4: sRGB -> linear -> OKLab -> OKLCH, rounded to 4 decimals). Note oklch.l is 0-1 (not 0-100) and hue is 0 for grays. Deterministic: same input, same output. Example: \"#ff0000\" -> oklch {l: 0.628, c: 0.2577, h: 29.2339}. Alpha channels are not supported.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "color": {
    "description": "A color as hex (#abc or #aabbcc), rgb(r, g, b) with r/g/b 0-255, or hsl(h, s%, l%). Alpha is not supported.",
    "type": "string"
   }
  },
  "required": [
   "color"
  ],
  "type": "object"
 },
 "name": "convert_color",
