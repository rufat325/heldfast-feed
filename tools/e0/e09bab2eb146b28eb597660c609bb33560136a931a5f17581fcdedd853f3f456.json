{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Bulk-create ClockNext customers in ONE request \u2014 for backfilling an existing user base. Returns a PER-ROW result (created id, or an error) so one duplicate/bad row never aborts the batch.\n\nRules:\n- Each customer needs name + email; up to 200 per call. For a larger base, call again in \u2264200-row chunks.\n- Match results back to your users by email.\n- MCP-only bulk endpoint (no SDK / public API).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customers": {
    "description": "Customers to create; name + email required each; \u2264200 per call.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "addressLine1": {
       "description": "Billing address, line 1.",
       "type": [
        "string",
        "null"
       ]
      },
      "addressLine2": {
       "description": "Billing address, line 2.",
       "type": [
        "string",
        "null"
       ]
      },
      "city": {
       "description": "Billing address city.",
       "type": [
        "string",
        "null"
       ]
      },
      "country": {
       "description": "Billing address country.",
       "type": [
        "string",
        "null"
       ]
      },
      "currencyCode": {
       "description": "ISO 4217 (3 letters); must be enabled for the org. Defaults to the org currency.",
       "type": "string"
      },
      "description": {
       "description": "Optional freeform description of the customer.",
       "type": [
        "string",
        "null"
       ]
      },
      "email": {
       "description": "Primary email \u2014 required, and the key bulk import matches back on.",
       "minLength": 1,
       "type": "string"
      },
      "legalName": {
       "description": "Registered legal name (for invoices), when it differs from `name`.",
       "type": [
        "string",
        "null"
       ]
      },
      "logoUrl": {
       "description": "URL of the customer's logo image.",
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "description": "Customer / company name.",
       "minLength": 1,
       "type": "string"
      },
      "notes": {
       "description": "Internal notes about the customer.",
       "type": [
        "string",
        "null"
       ]
      },
      "phone": {
       "description": "Contact phone number.",
       "type": [
        "string",
        "null"
       ]
      },
      "pincode": {
       "description": "Postal / ZIP / PIN code.",
       "type": [
        "string",
        "null"
       ]
      },
      "state": {
       "description": "Billing address state / province / region.",
       "type": [
        "string",
        "null"
       ]
      },
      "taxId": {
       "description": "Tax identifier shown on invoices (VAT / GST / EIN\u2026).",
       "type": [
        "string",
        "null"
       ]
      },
      "website": {
       "description": "The customer's website.",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "name",
      "email"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "customers"
  ],
  "type": "object"
 },
 "name": "clocknext_bulk_import_customers",
 "title": "ClockNext: bulk import customers"
}
