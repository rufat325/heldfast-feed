{
 "description": "Create a new pipeline with named stages. Each stage object should include name and position.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "locationId": {
    "description": "Location / sub-account ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "name": {
    "description": "Pipeline name",
    "type": "string"
   },
   "showInFunnel": {
    "description": "Whether to show this pipeline in the funnel view",
    "type": "boolean"
   },
   "stages": {
    "description": "Array of stage objects with name and position",
    "items": {},
    "type": "array"
   }
  },
  "required": [
   "access_token",
   "locationId",
   "name",
   "stages"
  ],
  "type": "object"
 },
 "name": "crm_create_pipeline"
}
