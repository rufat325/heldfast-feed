{
 "description": "Publish a new skill to Sayba Skill Market. Requires SAYBA_API_KEY.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category_id": {
    "description": "Category (cat_text, cat_translate, cat_code, cat_data, cat_creative, cat_knowledge, cat_tool)",
    "type": "string"
   },
   "description": {
    "description": "What the skill does",
    "type": "string"
   },
   "input_schema": {
    "description": "JSON schema for input parameters (as string)",
    "type": "string"
   },
   "name": {
    "description": "Skill display name",
    "type": "string"
   },
   "pricing_type": {
    "description": "free | paid_download | paid_per_call",
    "type": "string"
   },
   "prompt_template": {
    "description": "Prompt template with {variable} placeholders",
    "type": "string"
   },
   "slug": {
    "description": "Unique skill identifier (e.g. 'my-translator')",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "name",
   "description",
   "category_id",
   "prompt_template"
  ],
  "type": "object"
 },
 "name": "publish_skill"
}
