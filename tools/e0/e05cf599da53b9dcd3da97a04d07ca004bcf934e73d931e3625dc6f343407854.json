{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:ads"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a standalone creative"
 },
 "description": "Create a standalone creative. Spending/deletion: preview, then owner-approved confirm:true with the same requestId. Other edits: one call. Creates request active; report returned status and claim live only when active. Full field guide: soclo://tools/soclo_ads_create_ad_creative.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The connected ad account in Soclo.",
    "minLength": 1,
    "type": "string"
   },
   "adAccountId": {
    "description": "Advertiser/ad account selected from your Soclo connection.",
    "type": "string"
   },
   "confirm": {
    "description": "True only after owner approval of spending/deletion preview.",
    "type": "boolean"
   },
   "expectedBudgetAmount": {
    "description": "Approved preview amount; changes require a new preview.",
    "type": "number"
   },
   "expectedBudgetType": {
    "description": "Approved preview budget type: daily or lifetime.",
    "type": "string"
   },
   "expectedCurrency": {
    "description": "Approved preview currency, e.g. GBP.",
    "type": "string"
   },
   "parameters": {
    "type": "object"
   },
   "payload": {
    "properties": {
     "aiDisclosure": {
      "enum": [
       "OPT_IN",
       "OPT_OUT"
      ],
      "type": "string"
     },
     "body": {
      "description": "Primary text",
      "type": "string"
     },
     "callToAction": {
      "description": "CTA type (same whitelist as POST /v1/ads/create).",
      "type": "string"
     },
     "carouselCards": {
      "items": {
       "properties": {
        "callToAction": {
         "type": "string"
        },
        "description": {
         "maxLength": 255,
         "type": "string"
        },
        "headline": {
         "maxLength": 255,
         "type": "string"
        },
        "imageUrl": {
         "type": "string"
        },
        "linkUrl": {
         "type": "string"
        }
       },
       "required": [
        "imageUrl",
        "linkUrl"
       ],
       "type": "object"
      },
      "maxItems": 10,
      "minItems": 2,
      "type": "array"
     },
     "creativeFeatures": {
      "type": "object"
     },
     "description": {
      "maxLength": 255,
      "type": "string"
     },
     "headline": {
      "maxLength": 255,
      "type": "string"
     },
     "imageHash": {
      "type": "string"
     },
     "imageUrl": {
      "type": "string"
     },
     "linkUrl": {
      "type": "string"
     },
     "multiAdvertiser": {
      "enum": [
       "OPT_IN",
       "OPT_OUT"
      ],
      "type": "string"
     },
     "promotion": {
      "anyOf": [
       {
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "urlTags": {
      "description": "Appended to every outbound URL (e.g. utm_source=fb).",
      "type": "string"
     }
    },
    "required": [
     "headline",
     "body",
     "linkUrl"
    ],
    "type": "object"
   },
   "platform": {
    "description": "The campaign platform.",
    "type": "string"
   },
   "requestId": {
    "description": "Reuse this request ID for confirmation and outcome recovery.",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "payload"
  ],
  "type": "object"
 },
 "name": "soclo_ads_create_ad_creative",
 "title": "Create a standalone creative"
}
