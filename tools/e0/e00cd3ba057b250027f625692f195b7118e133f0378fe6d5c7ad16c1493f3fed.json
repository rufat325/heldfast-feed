{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Ask the corpus by COORDINATE rather than keyword. Filter works by axis weights (e.g. religion \u2208 {T,s} AND work \u2208 {T,s} returns the God-and-Work source set across genres), controlled themes, qualities/emotions, genre, and free text. Returns card metadata: the one-line claim, themes, coordinates, qualities. FREE and read-only.\n\n[capability: library-extraction-cards \u00b7 mirrors: POST /api/corpus/query]",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "axes": {
    "additionalProperties": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "description": "Axis \u2192 allowed weights. ALL listed axes must match. e.g. {\"religion\":[\"T\",\"s\"],\"work\":[\"T\",\"s\"]}",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "genre": {
    "type": "string"
   },
   "include_passages": {
    "default": false,
    "description": "Include theme-anchored passage pointers.",
    "type": "boolean"
   },
   "limit": {
    "default": 50,
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "qualities": {
    "description": "Cards carrying ANY of these qualities (emotions, for being-human).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "text": {
    "description": "Substring match over title / author / one-line claim.",
    "type": "string"
   },
   "themes": {
    "description": "Cards citing ANY of these controlled themes.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "topic": {
    "default": "being-human",
    "description": "Coordinate system to query (topic_configs.slug).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "vela.corpus.query",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "applied": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "hits": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "author": {
       "type": "string"
      },
      "coordinates": {
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "genre": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "libraryId": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "oneLineClaim": {
       "type": "string"
      },
      "qualities": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "signaturePassages": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "code": {
          "type": "string"
         },
         "quote": {
          "type": "string"
         },
         "theme": {
          "type": "string"
         }
        },
        "required": [
         "code",
         "theme",
         "quote"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "sourceSlug": {
       "type": "string"
      },
      "themes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "year": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "sourceSlug",
      "libraryId",
      "title",
      "author",
      "year",
      "genre",
      "oneLineClaim",
      "themes",
      "coordinates",
      "qualities"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "returned": {
    "type": "number"
   },
   "topic": {
    "type": "string"
   },
   "total": {
    "type": "number"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "topic",
   "total",
   "returned",
   "hits",
   "applied"
  ],
  "type": "object"
 },
 "title": "vela.corpus.query"
}
