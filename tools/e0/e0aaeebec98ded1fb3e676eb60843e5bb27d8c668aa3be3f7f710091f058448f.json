{
 "description": "Resolve or abstain; every candidate must bind source, value hash, observation time and bounded confidence; 0.003 USDC.",
 "inputSchema": {
  "properties": {
   "candidates": {
    "items": {
     "required": [
      "source",
      "value_sha256",
      "observed_at",
      "confidence"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 2,
    "type": "array"
   },
   "policy": {
    "type": "object"
   }
  },
  "required": [
   "candidates",
   "policy"
  ],
  "type": "object"
 },
 "name": "conflict_resolution"
}
