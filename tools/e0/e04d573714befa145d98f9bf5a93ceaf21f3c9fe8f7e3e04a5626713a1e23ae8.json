{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a customer"
 },
 "description": "Create a customer record. Not needed before booking \u2014 bookeo_create_booking can create the customer inline. Bookeo: POST /customers.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "acceptSmsReminders": {
    "type": "boolean"
   },
   "dateOfBirth": {
    "description": "RFC 3339 full-date, e.g. 1990-04-23.",
    "type": "string"
   },
   "emailAddress": {
    "type": "string"
   },
   "firstName": {
    "type": "string"
   },
   "gender": {
    "enum": [
     "male",
     "female",
     "unknown"
    ],
    "type": "string"
   },
   "languageCode": {
    "description": "Preferred language, e.g. en_US (underscore, not dash).",
    "type": "string"
   },
   "lastName": {
    "type": "string"
   },
   "middleName": {
    "type": "string"
   },
   "phoneNumbers": {
    "items": {
     "properties": {
      "number": {
       "type": "string"
      },
      "type": {
       "enum": [
        "mobile",
        "work",
        "home",
        "fax"
       ],
       "type": "string"
      }
     },
     "required": [
      "number",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "streetAddress": {
    "properties": {
     "address1": {
      "type": "string"
     },
     "address2": {
      "type": "string"
     },
     "city": {
      "type": "string"
     },
     "countryCode": {
      "description": "ISO 3166-1 alpha-2, e.g. US.",
      "type": "string"
     },
     "postcode": {
      "type": "string"
     },
     "state": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "firstName",
   "lastName"
  ],
  "type": "object"
 },
 "name": "bookeo_create_customer",
 "title": "Create a customer"
}
