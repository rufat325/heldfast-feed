{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Lists the domain names rentadomain.sh has for rent right now, each with its monthly price and term menu; call it first, or whenever the user wants a domain and has not named one.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "default": 20,
    "description": "How many names to return, 1 to 50.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Text the host must contain; empty or absent lists every name.",
    "maxLength": 64,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_names",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "names": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "host": {
       "type": "string"
      },
      "monthly": {
       "type": "string"
      },
      "monthly_cents": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "rent_url": {
       "type": "string"
      },
      "term_menu": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "monthly": {
          "type": "string"
         },
         "monthly_cents": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "months": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         }
        },
        "required": [
         "months",
         "monthly_cents",
         "monthly"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "host",
      "monthly_cents",
      "monthly",
      "term_menu",
      "url",
      "rent_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "type": "string"
   },
   "total": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
