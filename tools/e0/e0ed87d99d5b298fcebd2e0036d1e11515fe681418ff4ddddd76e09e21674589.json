{
 "description": "List the employer organization's OpenTrain Agreements documents with bounded cursor pagination (limit 1-100; pass result.nextCursor as cursor). Requires agreements:read. Requires the agreements family flag and the agreements_native rollout; denials carry details.reason (AGENT_SURFACE_DISABLED, AGREEMENTS_DISABLED, TENANT_ACCESS_DENIED).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "opentrain_agreements_documents_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "documents": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "createdAt": {
         "$ref": "#/properties/result/properties/documents/items/properties/currentVersion/anyOf/0/properties/publishedAt"
        },
        "currentVersion": {
         "anyOf": [
          {
           "additionalProperties": false,
           "properties": {
            "publishedAt": {
             "format": "date-time",
             "type": "string"
            },
            "versionId": {
             "$ref": "#/properties/result/properties/documents/items/properties/documentId"
            },
            "versionNumber": {
             "minimum": 1,
             "type": "integer"
            }
           },
           "required": [
            "versionId",
            "versionNumber",
            "publishedAt"
           ],
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "description": {
         "anyOf": [
          {
           "maxLength": 2000,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "documentId": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "draftRevision": {
         "minimum": 0,
         "type": "integer"
        },
        "fields": {
         "additionalProperties": false,
         "properties": {
          "count": {
           "minimum": 0,
           "type": "integer"
          },
          "fieldsHash": {
           "anyOf": [
            {
             "$ref": "#/properties/result/properties/documents/items/properties/source/properties/sha256/anyOf/0"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "count",
          "fieldsHash"
         ],
         "type": "object"
        },
        "key": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "source": {
         "additionalProperties": false,
         "properties": {
          "fileName": {
           "anyOf": [
            {
             "maxLength": 255,
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "sha256": {
           "anyOf": [
            {
             "pattern": "^[0-9a-f]{64}$",
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "status": {
           "enum": [
            "NONE",
            "PENDING",
            "READY"
           ],
           "type": "string"
          }
         },
         "required": [
          "status",
          "fileName",
          "sha256"
         ],
         "type": "object"
        },
        "sourceKind": {
         "enum": [
          "EDITOR",
          "PDF_UPLOAD",
          "MARKDOWN",
          "HTML",
          "DOCX_EDITABLE",
          "DOCX_LAYOUT"
         ],
         "type": "string"
        },
        "title": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "updatedAt": {
         "$ref": "#/properties/result/properties/documents/items/properties/currentVersion/anyOf/0/properties/publishedAt"
        }
       },
       "required": [
        "documentId",
        "key",
        "title",
        "description",
        "sourceKind",
        "draftRevision",
        "source",
        "fields",
        "currentVersion",
        "createdAt",
        "updatedAt"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "nextCursor": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "documents",
     "nextCursor"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
