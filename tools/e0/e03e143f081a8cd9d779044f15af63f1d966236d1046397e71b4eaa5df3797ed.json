{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"\uc784\uae08 \ud56d\ubaa9\ub9c8\ub2e4 \uc138 \uc694\uc18c(\uc815\ud574\uc9c4 \uc8fc\uae30\u00b7\uc9c0\uae09 \ub300\uc0c1\u00b7\uadfc\ubb34\uc2dc\uac04\uc758 \ub300\uac00)\uc640 \ubd99\uc5b4 \uc788\ub294 \uc870\uac74(\uc9c0\uae09\uc77c \uc7ac\uc9c1\u00b7\uadfc\ubb34\uc77c\uc218\u00b7\ucd9c\uadfc\uc728)\uc744 \ubc1b\uc544, \ud1b5\uc0c1\uc784\uae08\uc5d0 \ub4e4\uc5b4\uac00\ub294 \ucabd / \ube60\uc9c0\ub294 \ucabd / \uc785\ub825\ub9cc\uc73c\ub85c \uac00\ub9ac\uae30 \uc5b4\ub824\uc6c0(\ubcf4\ub958) \uc911 \uc5b4\ub290 \ucabd\uc73c\ub85c \ubcfc \uc694\uc18c\uac00 \uc788\ub294\uc9c0\uc640 \uadfc\uac70 \ud310\uacb0 \uc6d0\ubb38\uc744 \ub0b8\ub2e4(\uc0ac\uc774\ud2b8 /tools/ordinary-wage-check \uc640 \uac19\uc740 \uc5d4\uc9c4). \uae30\uc900\uc740 \uc5f0\uc7a5\uadfc\ub85c \ub4f1\uc744 \uc81c\uacf5\ud55c \ub0a0\ub85c \uac00\ub978\ub2e4 \u2014 2024. 12. 19.\ubd80\ud130 \uc0c8 \uae30\uc900(\ub300\ubc95\uc6d0 2020\ub2e4247190 \uc804\uc6d0\ud569\uc758\uccb4, \uace0\uc815\uc131 \uc81c\uc678), 2024. 12. 18.\uae4c\uc9c0 \uc885\uc804 \uae30\uc900(2012\ub2e489399, \uace0\uc815\uc131). \ub450 \uae30\uc900 \uacb0\uacfc\ub97c \ud568\uaed8 \ubcf4\uc778\ub2e4. \uc2dc\uac04\uae09(\ucc38\uace0) = \ub4e4\uc5b4\uac00\ub294 \ucabd \ud56d\ubaa9\uc758 1\ub144 \uae08\uc561 \ud569 \u00f7 12 \u00f7 \uc6d4 \uae30\uc900\uc2dc\uac04(\uc2dc\ud589\ub839 \uc81c6\uc870 \uc81c2\ud56d \uc81c4\u00b75\u00b77\ud638), \uc18c\uc218 \uc14b\uc9f8 \uc790\ub9ac\uc5d0\uc11c \ubc18\uc62c\ub9bc. \uc131\uacfc\uae09\uc740 \ud3c9\uac00\uc640 \ubb34\uad00\ud55c \ucd5c\uc18c \ubcf4\uc7a5\ubd84\ub9cc, \uac00\uc871\uc218\ub2f9\uc740 \ubaa8\ub450\uc5d0\uac8c \uc8fc\ub294 \uae30\ubcf8\uae08\uc561\ub9cc \ub354\ud558\uace0, \uc804\ub144\ub3c4 \uc2e4\uc801\ubd84 \uc131\uacfc\uae09\uacfc \uc8fc\ud734\uc218\ub2f9 \uac19\uc740 \ubc95\uc815\uc218\ub2f9\uc740 \ud569\uacc4\uc5d0 \ub123\uc9c0 \uc54a\ub294\ub2e4. \uacb0\uacfc\ub294 \uaddc\uc815 \uc6d0\ubb38\uacfc \uc6b4\uc6a9 \uc2e4\ud0dc\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c8 \uc218 \uc788\ub294 \uc810\uac80\uc774\uba70 \ub2e8\uc815\ud558\uc9c0 \uc54a\ub294\ub2e4. \uc5f0\uc7a5\u00b7\uc57c\uac04\u00b7\ud734\uc77c\uadfc\ub85c\uc218\ub2f9 \uae08\uc561\uc740 \uacc4\uc0b0\ud558\uc9c0 \uc54a\uace0, \ubcd1\ud589\uc0ac\uac74(\uc0c8 \uae30\uc900 \uc18c\uae09) \uc5ec\ubd80\ub294 \uac00\ub9ac\uc9c0 \uc54a\ub294\ub2e4.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"date":{"description":"\uc5f0\uc7a5\uadfc\ub85c \ub4f1\uc744 \uc81c\uacf5\ud55c \ub0a0(\uc810\uac80 \uae30\uc900\uc77c) YYYY-MM-DD. \ube44\uc6b0\uba74 \uc624\ub298(KST)","type":"string"},"items":{"description":"\uc784\uae08 \ud56d\ubaa9 \ubaa9\ub85d","items":{"additionalProperties":false,"properties":{"amount":{"description":"1\ud68c \uc9c0\uae09\uc561(\uc6d0, \uadfc\ubb34\ub97c \ube60\uc9d0\uc5c6\uc774 \ud588\uc744 \ub54c \uc815\ud574\uc9c4 \uae08\uc561). 0 \uc774\uba74 \ube44\uc5b4 \uc788\ub294 \uac83\uc73c\ub85c \ubcf4\uace0 \ubcf4\ub958","type":"number"},"attendanceRate":{"description":"\uc804\uc561\uc744 \uc8fc\ub294 \ucd9c\uadfc\uc728(%) \uc870\uac74(\uadfc\ubb34\uc77c\uc218 \uc870\uac74\uacfc \ud568\uaed8 \ub123\uc9c0 \uc54a\ub294\ub2e4)","type":"number"},"baseForAll":{"description":"\uac00\uc871\uc218\ub2f9\ub9cc \u2014 \ubd80\uc591\uac00\uc871\uacfc \uc0c1\uad00\uc5c6\uc774 \ubaa8\ub450\uc5d0\uac8c \uc8fc\ub294 1\ud68c \uae30\ubcf8\uae08\uc561(\uc6d0, \uc5c6\uc73c\uba74 0)","type":"number"},"employedOnPayday":{"description":"\uc9c0\uae09\uc77c\uc5d0 \uc7ac\uc9c1 \uc911\uc774\uc5b4\uc57c \ubc1b\ub294\ub2e4","type":"boolean"},"forWork":{"$ref":"#/properties/items/items/properties/regular","default":"unknown","description":"\uadfc\ubb34\uc2dc\uac04\uc758 \ub300\uac00: \uc815\ud574\uc9c4 \uadfc\ubb34\uc2dc\uac04\uc744 \ube60\uc9d0\uc5c6\uc774 \uc77c\ud558\uba74 \uadf8 \ub300\uac00\ub85c \ubc1b\ub098. \uc2e4\uc801 \ud3c9\uac00\u00b7\ubb34\uc0ac\uace0\u00b7\ucd94\uac00 \uadfc\ubb34 \uac19\uc740 \uc694\uac74\uc774\uba74 no. \uc7ac\uc9c1\u00b7\uadfc\ubb34\uc77c\uc218\u00b7\ucd9c\uadfc\uc728 \uc870\uac74\ub9cc \uc788\uc73c\uba74 yes(\uc870\uac74\uc740 \uc544\ub798 \uce78\uc5d0). \uc131\uacfc\uae09\uc740 \ubcf4\uc9c0 \uc54a\ub294\ub2e4"},"kind":{"description":"\uc885\ub958 \u2014 base(\uae30\ubcf8\uae09) \u00b7 allowance(\uc9c1\ubb34\u00b7\uc9c1\ucc45\uc218\ub2f9) \u00b7 tenure(\uadfc\uc18d\uc218\ub2f9) \u00b7 bonus(\uc815\uae30\uc0c1\uc5ec\uae08) \u00b7 holiday(\uba85\uc808\uc0c1\uc5ec\u00b7\ud734\uac00\ube44) \u00b7 attendance(\uadfc\ubb34\uc77c\uc218(\ub9cc\uadfc\u00b7\ucd9c\uadfc\uc728) \uc870\uac74 \uc218\ub2f9) \u00b7 performance(\uc131\uacfc\uae09) \u00b7 business(\uacbd\uc601\uc131\uacfc\uae09\u00b7\uaca9\ub824\uae08) \u00b7 family(\uac00\uc871\uc218\ub2f9) \u00b7 extra(\ubb34\uc0ac\uace0\uc218\ub2f9 \ub4f1 \ucd94\uac00 \uc694\uac74 \uc218\ub2f9) \u00b7 disability(\uc7a5\uc560\uc778\uc218\ub2f9) \u00b7 statutory(\uc8fc\ud734\uc218\ub2f9 \ub4f1 \ubc95\uc815\uc218\ub2f9) \u00b7 other(\uadf8 \ubc16\uc758 \uc218\ub2f9)","enum":["base","allowance","tenure","bonus","holiday","attendance","performance","business","family","extra","disability","statutory","other"],"type":"string"},"leaveOrDisciplineOnly":{"description":"\ud734\uc9c1\uc790\u00b7\ubcf5\uc9c1\uc790\u00b7\uc9d5\uacc4 \ub300\uc0c1\uc790\uc5d0\uac8c\ub294 \uc8fc\uc9c0 \uc54a\ub294\ub2e4\ub294 \uaddc\uc815\uc774 \uc788\ub2e4","type":"boolean"},"minimum":{"description":"\uc131\uacfc\uae09\ub9cc \u2014 \ud3c9\uac00\uc640 \ubb34\uad00\ud558\uac8c \ucd5c\uc18c\ub85c \ubcf4\uc7a5\ub41c 1\ud68c \uae08\uc561(\uc6d0, \uc5c6\uc73c\uba74 0)","type":"number"},"name":{"description":"\ud68c\uc0ac\uc5d0\uc11c \ubd80\ub974\ub294 \uc774\ub984(\ube44\uc6b0\uba74 \uc885\ub958 \uc774\ub984)","type":"string"},"performanceYear":{"description":"\uc131\uacfc\uae09\ub9cc \u2014 current(\uc810\uac80 \uae30\uc900\uc77c\uc774 \uc18d\ud55c \ud574\uc758 \uc2e4\uc801\ubd84, \uc9c0\uae09\uc774 \ub2e4\uc74c \ud574\uc5ec\ub3c4)\u00b7previous(\uc804\ub144\ub3c4 \uc2e4\uc801\ubd84, \uc9c0\uae09 \uc2dc\uae30\ub9cc \uae30\uc900\uc77c\uc774 \uc18d\ud55c \ud574)\u00b7unknown(\ubaa8\ub984)","enum":["current","previous","unknown"],"type":"string"},"proRataOnLeave":{"description":"\uc9c0\uae09\uc77c \uc804\uc5d0 \ud1f4\uc9c1\ud574\ub3c4 \uadf8\ub54c\uae4c\uc9c0 \uadfc\ubb34\uc77c\uc218\uc5d0 \ube44\ub840\ud574 \uc9c0\uae09\ud55c\ub2e4(\uc9c0\uae09\uc77c \uc7ac\uc9c1 \uc870\uac74\uc774 \uc788\uc744 \ub54c\ub9cc, 2024. 12. 18.\uae4c\uc9c0 \uc81c\uacf5\ubd84\uc5d0\ub9cc \uc601\ud5a5)","type":"boolean"},"proRataOnShortDays":{"description":"\uc815\ud55c \uc77c\uc218\u00b7\ucd9c\uadfc\uc728\uc744 \ubabb \ucc44\uc6cc\ub3c4 \uc77c\ud55c \ub0a0\ub9cc\ud07c \uc77c\ud560\ud574 \uc9c0\uae09\ud55c\ub2e4(\uadfc\ubb34\uc77c\uc218\u00b7\ucd9c\uadfc\uc728 \uc870\uac74\uc774 \uc788\uc744 \ub54c\ub9cc, 2024. 12. 18.\uae4c\uc9c0 \uc81c\uacf5\ubd84\uc5d0\ub9cc \uc601\ud5a5)","type":"boolean"},"regular":{"default":"unknown","description":"\uc815\ud574\uc9c4 \uc8fc\uae30: \ub9e4\ub2ec \ub610\ub294 \uc815\ud574\uc9c4 \uc8fc\uae30\ub9c8\ub2e4 \uc9c0\uae09\ud558\ub3c4\ub85d \uc815\ud574\uc838 \uc788\ub098 \u2014 yes(\uc608)\u00b7no(\uc544\ub2c8\uc624)\u00b7unknown(\ubaa8\ub984)","enum":["yes","no","unknown"],"type":"string"},"timesPerYear":{"description":"1\ub144\uc5d0 \uc8fc\ub294 \ud69f\uc218 \u2014 12(\ub9e4\ub2ec)\u00b76(\uaca9\uc6d4)\u00b74(\ubd84\uae30)\u00b73(\uc5f0 3\ubc88)\u00b72(\ubc18\uae30\u00b7\uba85\uc808)\u00b71(\uc5f0 1\ubc88). \ube44\uc6b0\uba74 \uc885\ub958\ubcc4 \uae30\ubcf8\uac12(\uc815\uae30\uc0c1\uc5ec\uae08 6, \uba85\uc808\uc0c1\uc5ec 2, \uc131\uacfc\uae09\u00b7\uacbd\uc601\uc131\uacfc\uae09 1, \uadf8 \ubc16 12)","type":"integer"},"uniform":{"$ref":"#/properties/items/items/properties/regular","default":"unknown","description":"\uc9c0\uae09 \ub300\uc0c1: \ubaa8\ub450\uc5d0\uac8c, \ub610\ub294 \uc9c1\ubb34\u00b7\uc790\uaca9\u00b7\uadfc\uc18d\uae30\uac04\ucc98\ub7fc \uc77c\uc758 \uac00\uce58\uc640 \uad00\ub828\ub41c \uc870\uac74\uc744 \uac16\ucd98 \uc0ac\ub78c \ubaa8\ub450\uc5d0\uac8c \uc8fc\ub098. \ubd80\uc591\uac00\uc871 \uc218\u00b7\uc7a5\uc560 \uc5ec\ubd80\ucc98\ub7fc \uc77c\uacfc \ubb34\uad00\ud55c \uc870\uac74\uc774\uba74 no"},"workDays":{"additionalProperties":false,"description":"\uc77c\uc815 \uadfc\ubb34\uc77c\uc218\ub97c \ucc44\uc6cc\uc57c \ubc1b\ub294 \uc870\uac74(\ucd9c\uadfc\uc728 \uc870\uac74\uacfc \ud568\uaed8 \ub123\uc9c0 \uc54a\ub294\ub2e4)","properties":{"required":{"description":"\uc870\uac74 \uc77c\uc218","type":"integer"},"scheduled":{"description":"\uadf8 \uae30\uac04\uc758 \uc18c\uc815\uadfc\ub85c\uc77c\uc218(2\uac1c\uc6d4\ub9c8\ub2e4 \ub530\uc9c0\uba74 2\uac1c\uc6d4\ubd84)","type":"integer"}},"required":["required","scheduled"],"type":"object"}},"required":["kind","amount"],"type":"object"},"minItems":1,"type":"array"},"unitHours":{"description":"\uc6d4 \uae30\uc900\uc2dc\uac04(\uc18c\uc218 \ub458\uc9f8 \uc790\ub9ac\uae4c\uc9c0, 744 \uc774\ud558). \ube44\uc6b0\uba74 209 \u2014 \uc8fc 40\uc2dc\uac04 + \uc8fc\ud734 8\uc2dc\uac04\uc744 365\uc77c\ub85c \uc148\ud574 \ubc18\uc62c\ub9bc\ud55c \uac12","type":"number"}},"required":["items"],"type":"object"},"name":"check_ordinary_wage","title":"\ud1b5\uc0c1\uc784\uae08 \uc810\uac80"}
