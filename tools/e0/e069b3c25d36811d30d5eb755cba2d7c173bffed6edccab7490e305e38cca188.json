{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List query execution history on Ncloud Data Query with optional status filtering and pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "pageNo": {
    "description": "Page number (default: 1)",
    "minimum": 1,
    "type": "number"
   },
   "pageSize": {
    "description": "Items per page (1-500, default: 20)",
    "maximum": 500,
    "minimum": 1,
    "type": "number"
   },
   "status": {
    "description": "Filter by query status",
    "enum": [
     "QUEUED",
     "STARTING",
     "RUNNING",
     "FINISHED",
     "FAILED",
     "CANCELED"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ncloud_dataquery_list_queries"
}
