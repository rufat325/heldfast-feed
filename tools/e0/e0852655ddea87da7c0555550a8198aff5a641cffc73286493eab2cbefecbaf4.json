{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update building"
 },
 "description": "Update an existing building by ID. Requires buildings:write scope. latitude and longitude must be sent together; send both as null to clear the building position.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "area_sqft": {
    "description": "Area in square feet",
    "minimum": 0,
    "type": "number"
   },
   "building_type_id": {
    "description": "Building type ID (from building_types)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "floors": {
    "description": "Number of floors",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "id": {
    "description": "Building ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "latitude": {
    "anyOf": [
     {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "WGS 84 latitude of the building, in decimal degrees. Must be sent together with longitude."
   },
   "longitude": {
    "anyOf": [
     {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "WGS 84 longitude of the building, in decimal degrees. Must be sent together with latitude."
   },
   "name": {
    "description": "Building name",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "site_id": {
    "description": "Site ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "type": {
    "description": "Building type label",
    "maxLength": 100,
    "type": "string"
   },
   "year_built": {
    "description": "Year the building was constructed",
    "maximum": 2100,
    "minimum": 1800,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_building",
 "title": "Update building"
}
