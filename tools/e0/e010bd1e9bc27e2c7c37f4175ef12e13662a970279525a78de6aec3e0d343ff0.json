{
 "description": "Declare who a watched agent is: model provider, run cadence, role, purpose, operator, and whether to publish a shareable public passport at /a/<slug>. Declarations never change the receipt-derived numbers next to them; publishing exposes only this address, never the rest of the watch list.",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "Watched agent address (0x\u202640 hex)",
    "type": "string"
   },
   "cadence": {
    "description": "always_on, scheduled, event_driven, on_demand",
    "enum": [
     "always_on",
     "scheduled",
     "event_driven",
     "on_demand",
     "unknown"
    ],
    "type": "string"
   },
   "display_name": {
    "description": "Name shown instead of the raw address",
    "type": "string"
   },
   "model": {
    "description": "Optional model or framework detail",
    "type": "string"
   },
   "operator": {
    "description": "Who runs it",
    "type": "string"
   },
   "provider": {
    "description": "Which model drives the agent",
    "enum": [
     "anthropic",
     "openai",
     "google",
     "xai",
     "meta",
     "mistral",
     "deepseek",
     "qwen",
     "open_source",
     "multi",
     "none",
     "unknown"
    ],
    "type": "string"
   },
   "public": {
    "description": "Publish a public passport page",
    "type": "boolean"
   },
   "purpose": {
    "description": "One or two sentences on what it is for",
    "type": "string"
   },
   "role": {
    "enum": [
     "trading",
     "market_making",
     "prediction",
     "treasury",
     "payments",
     "research",
     "infra",
     "personal",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "set_agent_passport"
}
