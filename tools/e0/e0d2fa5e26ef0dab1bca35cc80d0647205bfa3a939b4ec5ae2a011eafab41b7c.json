{
 "description": "[OPERATOR] Revoke a delegation. Optionally cascade to all sub-delegations.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cascade": {
    "default": true,
    "description": "Also revoke all sub-delegations",
    "type": "boolean"
   },
   "delegation_id": {
    "description": "Delegation ID to revoke",
    "type": "string"
   },
   "reason": {
    "description": "Why the delegation is being revoked",
    "type": "string"
   }
  },
  "required": [
   "delegation_id",
   "reason"
  ],
  "type": "object"
 },
 "name": "revoke_delegation"
}
