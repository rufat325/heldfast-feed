{
 "description": "Tag an agent-generated artifact with provenance metadata (content hash, risk class, authoring agent).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "artifact_type": {
    "description": "e.g. email_draft, code_script, database_query",
    "type": "string"
   },
   "content": {
    "description": "The artifact content (used for hash, not stored)",
    "type": "string"
   },
   "delegation_ref": {
    "type": "string"
   },
   "intended_use": {
    "type": "string"
   },
   "requires_human_execution": {
    "default": false,
    "type": "boolean"
   },
   "risk_class": {
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "trust_epoch": {
    "default": 1,
    "type": "number"
   },
   "valid_until": {
    "type": "string"
   }
  },
  "required": [
   "delegation_ref",
   "intended_use",
   "risk_class",
   "content",
   "artifact_type",
   "valid_until"
  ],
  "type": "object"
 },
 "name": "create_artifact_provenance"
}
