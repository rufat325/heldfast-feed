{
 "annotations": {
  "readOnlyHint": true,
  "title": "Compute path"
 },
 "description": "Compute (but do not execute) a path to a goal and report its status/cost/timing without moving the bot. Useful to test reachability before committing to `goto`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "goalType": {
    "description": "Which kind of pathfinder goal to build",
    "enum": [
     "block",
     "near",
     "xz",
     "nearxz",
     "y",
     "getToBlock",
     "lookAtBlock",
     "placeBlock",
     "composite_any",
     "composite_all",
     "invert"
    ],
    "type": "string"
   },
   "goals": {
    "description": "Nested goals for composite_any/composite_all/invert",
    "items": {
     "properties": {
      "goalType": {
       "type": "string"
      },
      "range": {
       "type": "number"
      },
      "x": {
       "type": "number"
      },
      "y": {
       "type": "number"
      },
      "z": {
       "type": "number"
      }
     },
     "required": [
      "goalType"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "range": {
    "description": "Acceptable distance from the target (for near/nearxz/follow)",
    "type": "number"
   },
   "timeout": {
    "description": "Max ms to spend computing the path",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "x": {
    "description": "Target X (required for most goal types)",
    "type": "number"
   },
   "y": {
    "description": "Target Y",
    "type": "number"
   },
   "z": {
    "description": "Target Z",
    "type": "number"
   }
  },
  "required": [
   "goalType"
  ],
  "type": "object"
 },
 "name": "get_path_to"
}
