{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get table list in a catalog with optional filtering and sorting",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "catalogId": {
    "description": "Catalog ID",
    "type": "number"
   },
   "dataFormats": {
    "description": "Filter by data format (csv|json|xml|parquet|avro|orc|unknown|CLOUD_DB_FOR_MYSQL|CLOUD_DB_FOR_MSSQL|CLOUD_DB_FOR_MONGODB|CLOUD_DB_FOR_POSTGRESQL|JDBC)",
    "type": "string"
   },
   "databaseName": {
    "description": "Filter by database name",
    "type": "string"
   },
   "location": {
    "description": "Filter by location string",
    "type": "string"
   },
   "pageNo": {
    "description": "Page number (default: 1)",
    "type": "number"
   },
   "pageSize": {
    "description": "Page size 1~200 (default: 20)",
    "type": "number"
   },
   "sortField": {
    "description": "Sort field (tableName|databaseName|createTime)",
    "type": "string"
   },
   "sortIsAsc": {
    "description": "Sort ascending (true/false)",
    "type": "boolean"
   },
   "tableName": {
    "description": "Filter by table name",
    "type": "string"
   },
   "tagKeyValue": {
    "description": "Filter by tag key:value",
    "type": "string"
   }
  },
  "required": [
   "catalogId"
  ],
  "type": "object"
 },
 "name": "ncloud_datacatalog_get_tables"
}
