{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Backlinks"
 },
 "description": "Turn backlink data from Ahrefs, Semrush or similar into links won back, won or cleaned up. Pick with mode: broken = Broken and lost backlinks and 404 visits into 301s and outreach. Needs rows[{target_url, source_url, anchor, domain_rating, dofollow, http_code}]. opportunities = Sites linking to competitors, and unlinked brand mentions. Needs site. outreach = One outreach email per site, as drafts for the user's mail after approval. Needs your_site, prospects[{page, type, your_url, dead_url, anchor, contact}]. disavow = A conservative disavow.txt, only after a manual action or clear negative SEO. Needs rows[{url_from, domain, is_spam, domain_rating, anchor, traffic}], reason.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "audit_id": {
    "description": "Optional: a finished site audit, to match on page titles too.",
    "maxLength": 2000,
    "type": "string"
   },
   "brand": {
    "description": "Brand name to look for in mention pages.",
    "maxLength": 2000,
    "type": "string"
   },
   "competitors": {
    "description": "Each competitor with its referring domains.",
    "items": {
     "properties": {
      "domain": {
       "maxLength": 2000,
       "type": "string"
      },
      "referring_domains": {
       "items": {
        "properties": {
         "domain": {
          "maxLength": 2000,
          "type": "string"
         },
         "domain_rating": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         },
         "traffic": {
          "type": "number"
         },
         "url_from": {
          "description": "A page on that site that links to the competitor, if known.",
          "maxLength": 2048,
          "type": "string"
         }
        },
        "required": [
         "domain"
        ],
        "type": "object"
       },
       "maxItems": 3000,
       "type": "array"
      }
     },
     "required": [
      "domain",
      "referring_domains"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   },
   "detail": {
    "description": "brief = short summary.",
    "enum": [
     "full",
     "brief"
    ],
    "type": "string"
   },
   "format": {
    "description": "Rule format, default redirects (Cloudflare Pages and Netlify _redirects).",
    "enum": [
     "redirects",
     "nginx",
     "apache",
     "nextjs",
     "csv"
    ],
    "type": "string"
   },
   "live_urls": {
    "description": "Optional: your live pages, instead of reading the sitemap.",
    "items": {
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "memory_key": {
    "description": "site_memory key, records this call.",
    "maxLength": 80,
    "type": "string"
   },
   "mentions": {
    "description": "Pages that mention the brand.",
    "items": {
     "maxLength": 2000,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "mode": {
    "description": "Default broken.",
    "enum": [
     "broken",
     "opportunities",
     "outreach",
     "disavow"
    ],
    "type": "string"
   },
   "prospects": {
    "items": {
     "properties": {
      "anchor": {
       "maxLength": 120,
       "type": "string"
      },
      "contact": {
       "description": "Email or name if known.",
       "maxLength": 120,
       "type": "string"
      },
      "dead_url": {
       "description": "For broken: the dead link on their page.",
       "maxLength": 2048,
       "type": "string"
      },
      "domain_rating": {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "page": {
       "description": "Their page.",
       "maxLength": 2048,
       "type": "string"
      },
      "traffic": {
       "minimum": 0,
       "type": "number"
      },
      "type": {
       "enum": [
        "broken",
        "lost",
        "mention",
        "resource"
       ],
       "type": "string"
      },
      "your_url": {
       "description": "Your page to link to.",
       "maxLength": 2048,
       "type": "string"
      }
     },
     "required": [
      "page",
      "type",
      "your_url"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "reason": {
    "description": "Why a disavow is considered.",
    "enum": [
     "manual_action",
     "negative_seo",
     "other"
    ],
    "type": "string"
   },
   "rows": {
    "description": "Broken backlink rows, one per linking page.",
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "sender_name": {
    "description": "Name to sign with.",
    "maxLength": 80,
    "type": "string"
   },
   "site": {
    "description": "Optional: your site's address.",
    "maxLength": 2000,
    "type": "string"
   },
   "your_site": {
    "description": "Your site or brand name, e.g.",
    "maxLength": 2000,
    "type": "string"
   },
   "yours": {
    "description": "Your own referring domains.",
    "items": {
     "properties": {
      "domain": {
       "maxLength": 2000,
       "type": "string"
      },
      "domain_rating": {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "traffic": {
       "type": "number"
      },
      "url_from": {
       "description": "A page on that site that links to the competitor, if known.",
       "maxLength": 2048,
       "type": "string"
      }
     },
     "required": [
      "domain"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "backlinks",
 "outputSchema": {
  "type": "object"
 },
 "title": "Backlinks"
}
