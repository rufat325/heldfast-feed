 "description": "Delete one owned contact only after delete_person_preview. Preserves a complete restore snapshot for 30 days; undo with undo_contact_change using restore_id. Requires a request_id for retry-safe idempotency. ($0.10; API key required)",
 "destructiveHint": true,
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "idempotency_key": {
    "description": "Alias for request_id.",
    "type": "string"
   },
   "person_id": {
    "description": "UUID of the owned contact to delete.",
    "type": "string"
   },
   "preview_id": {
    "description": "Durable preview_id returned by delete_person_preview.",
    "type": "string"
   },
   "request_id": {
    "description": "Required idempotency key; retries return the original result.",
    "type": "string"
   },
   "restore_window_acknowledged": {
    "description": "Must be true after reviewing the 30-day restore window.",
    "type": "boolean"
   }
  },
  "required": [
   "person_id",
   "preview_id",
   "restore_window_acknowledged",
   "request_id"
  ],
  "type": "object"
 },
