{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "RAG Pipeline Cost Calculator"
 },
 "description": "Use when a user needs end-to-end RAG cost estimation (embedding + vector store + generation). Returns monthly cost with breakdown and dominant-component identification.",
 "inputSchema": {
  "examples": [
   {
    "corpus_tokens": 25000000,
    "queries_per_day": 5000
   }
  ],
  "properties": {
   "answer_tokens": {
    "description": "Avg answer tokens (default 400)",
    "minimum": 0,
    "type": "number"
   },
   "chunk_size_tokens": {
    "description": "Avg chunk size (default 512)",
    "minimum": 64,
    "type": "number"
   },
   "chunks_retrieved": {
    "description": "Chunks per query (default 5)",
    "minimum": 1,
    "type": "number"
   },
   "corpus_tokens": {
    "description": "Indexed corpus size in tokens",
    "minimum": 0,
    "type": "number"
   },
   "embedding_provider": {
    "description": "Embedding model",
    "enum": [
     "openai-3-small",
     "openai-3-large",
     "voyage-3",
     "voyage-3-lite",
     "cohere-embed-v3",
     "google-text-embed-004"
    ],
    "type": "string"
   },
   "generator_model": {
    "description": "Generator model (default claude-sonnet-4-6)",
    "type": "string"
   },
   "generator_provider": {
    "description": "Generator LLM provider (default anthropic)",
    "type": "string"
   },
   "queries_per_day": {
    "description": "User query volume per day",
    "minimum": 0,
    "type": "number"
   },
   "question_tokens": {
    "description": "Avg question tokens (default 100)",
    "minimum": 0,
    "type": "number"
   },
   "reindex_fraction_per_month": {
    "description": "Fraction of corpus re-embedded per month (default 0.1)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "vector_store": {
    "description": "Vector store",
    "enum": [
     "pinecone",
     "weaviate",
     "qdrant",
     "chroma",
     "turbopuffer"
    ],
    "type": "string"
   }
  },
  "required": [
   "queries_per_day",
   "corpus_tokens"
  ],
  "type": "object"
 },
 "name": "rag-pipeline-cost-calculator",
 "title": "RAG Pipeline Cost Calculator"
}
