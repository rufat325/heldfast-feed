{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "utilpeek: convert a color and check WCAG contrast"
 },
 "description": "utilpeek: Convert a color between hex, RGB, HSL and OKLCH and check WCAG contrast. For contrast alone use check_wcag_contrast. Returns a CSS color (hex, rgb(), hsl() or a CSS name) as hex, rgb, hsl, hsv, naive cmyk, OKLCH and WCAG relative luminance; with a `background`, the WCAG 2.x contrast ratio and AA / AAA pass or fail for normal and large text and UI components (unrounded: #777 on white is 4.48:1 and fails AA). An unparseable or out-of-range color is a 422 before any payment (not charged). A translucent color is composited over the background before the contrast is computed. Typically under 0.1 s. Price: USD 0.001. Free: 10 utilpeek calls per IP per UTC day. Docs: https://tanod.dev/learn/color-contrast-checker-api.html",
 "inputSchema": {
  "properties": {
   "background": {
    "anyOf": [
     {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional second color (e.g. the background): adds the WCAG 2.x contrast ratio and AA / AAA pass / fail.",
    "title": "Background"
   },
   "color": {
    "description": "A CSS color: hex (#rgb, #rgba, #rrggbb, #rrggbbaa), rgb() / rgba(), hsl() / hsla() or a CSS color name (148 names, plus transparent).",
    "maxLength": 64,
    "minLength": 1,
    "title": "Color",
    "type": "string"
   }
  },
  "required": [
   "color"
  ],
