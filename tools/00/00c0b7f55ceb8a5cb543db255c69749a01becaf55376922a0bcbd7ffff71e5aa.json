    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "actionId": {
        "type": "string"
       },
       "args": {}
      },
      "required": [
       "actionId",
       "args"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "createdAt": {
    "type": "string"
   },
   "handoff": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "destination": {
        "additionalProperties": false,
        "properties": {
         "destination": {
          "enum": [
           "matches",
           "browse",
           "applications",
           "messages",
           "profile",
           "billing",
           "help",
           "feedback",
           "job",
           "pack"
          ],
          "type": "string"
         },
         "params": {
          "additionalProperties": {
           "type": "string"
          },
          "propertyNames": {
           "type": "string"
          },
          "type": "object"
         }
        },
        "required": [
