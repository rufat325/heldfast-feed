        ],
        "type": "object"
       },
       "note": {
        "maxLength": 200,
        "type": "string"
       },
       "preserved": {
        "type": "boolean"
       },
       "reason": {
        "enum": [
         "needs_credentials",
         "needs_payment_details",
         "needs_consent",
         "needs_entitlement",
         "needs_prerequisite",
         "person_must_do"
        ],
        "type": "string"
       },
       "remaining": {
        "maxLength": 200,
