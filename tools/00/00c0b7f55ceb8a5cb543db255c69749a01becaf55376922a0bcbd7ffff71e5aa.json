      "properties": {
       "actionId": {
        "type": "string"
       },
       "args": {},
       "until": {
        "type": "string"
       }
      },
      "required": [
       "until",
       "actionId",
       "args"
      ],
      "type": "object"
     },
     {
      "type": "null"
