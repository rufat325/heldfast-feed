{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Change how part of the resume looks"
 },
 "description": "Changes alignment, bold, italic or underline formatting of a tailored resume without changing its words. line identifies a passage and section identifies a heading; selected text can supply the target when neither is given. No writing model or allowance is used. The receipt includes undo.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "align": {
    "enum": [
     "left",
     "center"
    ],
    "type": "string"
   },
   "applicationId": {
    "type": "string"
   },
   "bold": {
    "description": "`false` removes the mark.",
    "type": "boolean"
   },
   "italic": {
    "description": "`false` removes the mark.",
    "type": "boolean"
   },
   "line": {
    "description": "A few words that identify one non-blank line of the tailored resume, matched case-insensitively.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "section": {
    "description": "A heading as it appears on the resume, such as SUMMARY or EXPERIENCE; the section's lines under it are styled together. The heading line itself is not \u2014 to style it, name it as a `line`.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "text": {
    "description": "A phrase within the targeted lines. When given, the marks apply to it alone; otherwise to the whole of each line.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "underline": {
    "description": "`false` removes the mark.",
    "type": "boolean"
   }
  },
  "required": [
   "applicationId"
  ],
  "type": "object"
 },
 "name": "format_resume",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actionId": {
    "type": "string"
   },
