{"_meta":{"xdata.kr/credential":{"providers":["shinhan_easy"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=shinhan_easy","required":true,"windows_pc_needed":false}},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: shinhan_easy__auth__id_password_session__login (\uac19\uc740 account_link_id). \ub4f1\ub85d\ub41c \uc2e0\ud55c\uc740\ud589 \uacc4\uc88c \ud558\ub098\uc758 \uac70\ub798\ub0b4\uc5ed\uc744 \uc870\ud68c\ud569\ub2c8\ub2e4. bank_account_credential_id \ub85c \uace0\ub978 \uacc4\uc88c\ub97c \uc740\ud589 \uacc4\uc88c \ubaa9\ub85d\uc5d0\uc11c \ucc3e\uc544 \uadf8 \uacc4\uc88c\ub97c \uc5f4\uace0, \ubaa9\ub85d\uc5d0 \uc5c6\ub294 \uacc4\uc88c\ub294 \uc870\ud68c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uacb0\uacfc\ub294 sort_order \ub300\ub85c \uc815\ub82c\ud569\ub2c8\ub2e4(\uae30\ubcf8\uc740 \ucd5c\uadfc \uba3c\uc800). \ud30c\uc77c: \uc5d1\uc140(xlsx) \u00b7 \uc774 \uc791\uc5c5\uc758 \uacb0\uacfc\ub85c \ub9cc\ub4e0 \ubb38\uc11c - output_formats \ub85c \uccad\ud560 \ub54c\ub9cc \ub9cc\ub4ed\ub2c8\ub2e4. \uacb0\uacfc\uc758 artifacts[] \uc5d0 \uc2e4\ub9ac\uace0, \ub0b4\ub824\ubc1b\uae30 \ub9c1\ud06c(download_url)\ub294 15\ubd84 \ub3d9\uc548 \uc5f4\ub9ac\uba70 \ud30c\uc77c\uc740 7\uc77c \ub3d9\uc548 \ubcf4\uad00\ub429\ub2c8\ub2e4. \ub9c1\ud06c\uac00 \ub9cc\ub8cc\ub418\uba74 \uacb0\uacfc\uc758 job_id \ub85c xdata__job__result \ub97c \ub2e4\uc2dc \ubd88\ub7ec \uc0c8 \ub9c1\ud06c\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ub85c\uadf8\uc778 \uc5c6\uc774 \ubc1b\uc740 \uacb0\uacfc\ub294 \ud568\uaed8 \uc628 recovery_receipt \ub97c \ub530\ub85c \ubcf4\uad00\ud588\ub2e4\uac00, \ucc98\uc74c\uc758 job_id \ub098 pack_run_id \uc640 \ud568\uaed8 xdata__job__result \uc5d0 \ubcf4\ub0b4\uc138\uc694. \uc99d\ud45c\ub85c\ub294 \uadf8 \uacb0\uacfc \ud558\ub098\ub9cc, \uc6d0\ub798 \ud30c\uc77c \ubcf4\uad00 \uae30\uac04\uc774 \ub05d\ub0a0 \ub54c\uae4c\uc9c0 \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc99d\ud45c\ub294 \uacf5\uac1c\ud558\uc9c0 \ub9c8\uc138\uc694. \uc783\uc5b4\ubc84\ub9ac\uba74 \uac00\uc785\ud574\ub3c4 \ub418\ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub85c\uadf8\uc778\ud574\ub3c4 \uc99d\ud45c\ub294 \uadf8\ub300\ub85c \uc4f0\uc774\uace0, \ub2e4\ub978 \uacb0\uacfc\ub294 \uc5f4\uc9c0 \ubabb\ud569\ub2c8\ub2e4. \uc99d\ud45c\uac00 \uc5c6\uc73c\uba74 \ucc98\uc74c \uacc4\uc815\uacfc \uac19\uc740 \ud658\uacbd(\ub370\ubaa8 \u00b7 \uc815\uc2dd)\uc5d0\uc11c\ub9cc \uacb0\uacfc\ub97c \uc77d\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. bank_account_credential_id(\uacc4\uc88c \ud558\ub098), bank_account_credential_ids(\uc5ec\ub7ec \uacc4\uc88c), all_accounts(\ubaa8\ub4e0 \uacc4\uc88c) \uc911 \ud558\ub098\ub9cc \ubcf4\ub0b4 \uc8fc\uc138\uc694. \uacc4\uc88c\ub9c8\ub2e4 \uc0ac\uc6a9 \ud1a0\ud070\uc774 \ud558\ub098\uc529 \ub4ed\ub2c8\ub2e4. \uae30\uc5c5\uc815\ubcf4 \ube0c\ub9ac\ud504\ucc98\ub7fc \ud55c \ubc88\uc5d0 \uc5ec\ub7ec \uc0ac\uc6a9 \ud1a0\ud070\uc744 \uc4f0\ub294 \uc5c5\ubb34\ub294 \uadf8 \uac12\ub9cc\ud07c \uacc4\uc88c\ub9c8\ub2e4 \ub4ed\ub2c8\ub2e4. \ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc774\uba74 \uccab \uc694\uccad \uc804\uc5d0 request_idempotency_key \uac12\uc744 \ub9cc\ub4e4\uc5b4 \uc800\uc7a5\ud558\uc138\uc694. \uc751\ub2f5\uc744 \ubc1b\uc9c0 \ubabb\ud55c \uadf8 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c\ub9cc \uac19\uc740 \uc778\uc790\uc640 \ud568\uaed8 \uadf8 \uac12\uc744 \ub2e4\uc2dc \ubcf4\ub0b4\uace0, \uc0c8\ub85c \uc2e4\ud589\ud560 \ub54c\ub294 \uc0c8 \uac12\uc744 \uc4f0\uc138\uc694. \uc774 \uac12 \uc5c6\uc774 \ub2e4\uc2dc \ubd80\ub974\uba74 \uc0c8 \uc694\uccad\uc774 \ub429\ub2c8\ub2e4. \uacc4\uc815 \uc5c6\uc774 \ub9db\ubcf4\uae30\ub85c \ubd80\ub97c \ub54c\ub294 \uc774 \uc120\ud0dd \uce78\uc744 \uc4f8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uae30\uad00 \uc5c5\ubb34\uc5d0 \ub530\ub85c \uc788\ub294 idempotency_key \uce78\uc740 \ub2e4\ub978 \uce78\uc774\ub2c8 \uadf8\ub300\ub85c \ub450\uc138\uc694. \uc0ac\uc5c5\uc790 \uc720\ud615: \uac1c\uc778\uc0ac\uc5c5\uc790 \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 2\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uc11c\ube44\uc2a4\uc5d0 \uacc4\uc815\uc744 \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694.","type":"string"},"all_accounts":{"description":"true \uba74 \uc774 \uc740\ud589\uc5d0 \ub4f1\ub85d\ub41c \ubaa8\ub4e0 \uacc4\uc88c\ub97c \uacc4\uc88c\ub9c8\ub2e4 \ub530\ub85c \ucc98\ub9ac\ud569\ub2c8\ub2e4. \uacc4\uc88c\ub9c8\ub2e4 \uc774 \ub3c4\uad6c\uc758 \uc0ac\uc6a9 \ud1a0\ud070\uc774 \ub4ed\ub2c8\ub2e4. bank_account_credential_id(\uacc4\uc88c \ud558\ub098), bank_account_credential_ids(\uc5ec\ub7ec \uacc4\uc88c), all_accounts(\ubaa8\ub4e0 \uacc4\uc88c) \uc911 \ud558\ub098\ub9cc \ubcf4\ub0b4 \uc8fc\uc138\uc694.","type":"boolean"},"bank_account_credential_id":{"description":"\uc870\ud68c\ud560 \uacc4\uc88c\uc758 bank_account_credential_id. \uc2e0\ud55c\uc740\ud589 \uc5f0\ub3d9 \uacc4\uc88c \ubaa9\ub85d\uc774 \ub3cc\ub824\uc900 \uac12\uc744 \uadf8\ub300\ub85c \uc785\ub825\ud574 \uc8fc\uc138\uc694.","type":"string"},"bank_account_credential_ids":{"description":"\uc774 \uc740\ud589\uc758 \uacc4\uc88c \ubaa9\ub85d \ub3c4\uad6c\uac00 \ub3cc\ub824\uc900 bank_account_credential_id \uac12