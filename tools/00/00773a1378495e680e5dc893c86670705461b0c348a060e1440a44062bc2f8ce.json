{
 "description": "Create a new publisher",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "can_admin_account": {
    "description": "Grant administrator privileges",
    "type": "boolean"
   },
   "can_approve_ads": {
    "description": "Allow publisher to approve/deny ad items",
    "type": "boolean"
   },
   "can_change_password": {
    "description": "Whether publisher can change password",
    "type": "boolean"
   },
   "can_view_wordpress_key": {
    "description": "Allow publisher to view WordPress key",
    "type": "boolean"
   },
   "default_payout": {
    "additionalProperties": false,
    "description": "Default payout configuration",
    "properties": {
     "cpa": {
      "type": "number"
     },
     "cpc": {
      "type": "number"
     },
     "cpm": {
      "type": "number"
     },
     "fixed": {
      "type": "number"
     },
     "type": {
      "enum": [
       "rate",
       "percent"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "domain": {
    "description": "Publisher domain (top-level domains only)",
    "type": "string"
   },
   "email": {
    "description": "Contact email (allows publisher to log in)",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Custom metadata key-value pairs",
    "type": "object"
   },
   "name": {
    "description": "Publisher name",
    "type": "string"
   },
   "seller_type": {
    "description": "Seller type for ads.txt",
    "enum": [
     "publisher",
     "intermediary",
     "both"
    ],
    "type": "string"
   },
   "timezone": {
    "description": "Timezone (e.g., \"America/New_York\")",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_publisher"
}
