    "type": "string"
   },
   "r1": {
    "description": "Reserve of token1.",
    "type": "string"
   },
   "t": {
    "description": "Timestamp, Unix epoch milliseconds.",
    "type": "number"
   },
   "usd": {
    "description": "Total value locked, USD.",
    "type": "string"
   },
   "v": {
    "description": "Version/volume counter.",
    "type": "number"
   }
  },
  "required": [
   "chain",
   "pair",
   "usd",
   "r0",
   "r1",
   "n",
   "v",
   "t"
  ],
  "type": "object"
 },
 "title": "Last DEX TVL"
}
