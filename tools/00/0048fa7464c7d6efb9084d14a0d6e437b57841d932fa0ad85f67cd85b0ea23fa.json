  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chain": {
    "description": "EVM chain: eth, base, arbitrum, bsc, polygon.",
    "type": "string"
   },
   "pair": {
    "description": "Canonical pair, e.g. WETH-USDC.",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "pair"
  ],
  "type": "object"
 },
 "name": "last_tvl",
