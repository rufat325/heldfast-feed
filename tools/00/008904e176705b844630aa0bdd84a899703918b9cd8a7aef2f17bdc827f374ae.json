 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search CI guides"
 },
 "description": "Searches the public competitive intelligence library on debriefing.io: how-to guides, glossary terms, tool comparisons, alternatives pages, company profiles, and market intel posts. Returns the title, a short excerpt, and the page URL of each match, best match first. Needs no Debriefing account.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "collection": {
    "description": "Only search one part of the library",
    "enum": [
     "guides",
     "intel",
     "glossary",
     "comparisons",
     "alternatives",
     "competitive-profiles"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Words to find, such as battlecard or win-loss interview",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_guides",
 "outputSchema": {
  "properties": {
   "free_brief": {
    "properties": {
     "text": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "url",
     "text"
    ],
    "type": "object"
   },
   "items": {
    "items": {
     "properties": {
      "collection": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "excerpt": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "updated_on": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "collection",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "items",
   "free_brief"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Search CI guides"
