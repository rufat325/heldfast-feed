{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Return exact-model, exact-version upgrade prerequisites, risks, checks, and rollback without downloading software. Missing or incomplete knowledge may create or update a tracked research demand. No device commands are executed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "current_version": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9()._\\-/]*$",
    "type": "string"
   },
   "enabled_features": {
    "default": [],
    "items": {
     "maxLength": 240,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   },
   "model": {
    "maxLength": 240,
    "minLength": 1,
    "type": "string"
   },
   "operating_system": {
    "default": "IOS XE",
    "maxLength": 240,
    "minLength": 1,
    "type": "string"
   },
   "target_version": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9()._\\-/]*$",
    "type": "string"
   }
  },
  "required": [
   "model",
   "current_version",
   "target_version"
  ],
  "type": "object"
 },
 "name": "advise_network_upgrade",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "applicability": {
    "additionalProperties": false,
    "properties": {
     "current_version": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "operating_system": {
      "type": "string"
     },
     "target_version": {
      "type": "string"
     },
     "vendor": {
      "type": "string"
     }
    },
    "required": [
     "vendor",
     "model",
     "operating_system",
     "current_version",
     "target_version"
    ],
    "type": "object"
   },
   "assurance": {
    "additionalProperties": false,
    "properties": {
     "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "last_verified_at": {
      "type": "string"
     },
     "validation_level": {
      "const": "documentation_reviewed",
      "type": "string"
     }
    },
    "required": [
     "validation_level",
     "last_verified_at",
     "confidence"
    ],
    "type": "object"
   },
   "breaking_changes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "next_action": {
    "enum": [
     "use_advice",
     "request_expert_answer"
    ],
    "type": "string"
   },
   "prerequisites": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "procedure": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "reload_expected": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ]
   },
   "rollback": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "security_advisories": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "applicability": {
       "type": "string"
      },
      "disposition": {
       "type": "string"
      },
      "id": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "applicability",
      "disposition"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "supported_with_checks",
     "blocked",
     "unknown"
    ],
    "type": "string"
   },
   "verification": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "status",
   "applicability",
   "breaking_changes",
   "security_advisories",
   "prerequisites",
   "procedure",
   "verification",
   "rollback",
   "reload_expected",
   "next_action",
   "assurance",
   "limitations"
  ],
  "type": "object"
 },
 "title": "Advise Network Upgrade"
}
