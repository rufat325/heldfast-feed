{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"How big a selection is -- rows, stations, time span -- without fetching\n    it.  Call this before get_data.","inputSchema":{"properties":{"apply_qc":{"default":true,"description":"DEFAULT TRUE: drop the observations the store's recommended quality control rejects; false keeps every observation, flagged ones included","title":"Apply Qc","type":"boolean"},"cruise":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"string"},{"type":"null"}],"default":null,"description":"cruise expocodes, a list or a string; ocean observation tables only","title":"Cruise"},"end":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"ISO date or datetime, EXCLUSIVE","title":"End"},"height_max":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Height Max"},"height_min":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Height Min"},"id":{"description":"a variable id from search_variables","title":"Id","type":"string"},"lat_max":{"anyOf":[{"maximum":90,"minimum":-90,"type":"number"},{"type":"null"}],"default":null,"title":"Lat Max"},"lat_min":{"anyOf":[{"maximum":90,"minimum":-90,"type":"number"},{"type":"null"}],"default":null,"title":"Lat Min"},"lon_max":{"anyOf":[{"maximum":180,"minimum":-180,"type":"number"},{"type":"null"}],"default":null,"title":"Lon Max"},"lon_min":{"anyOf":[{"maximum":180,"minimum":-180,"type":"number"},{"type":"null"}],"default":null,"title":"Lon Min"},"start":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"ISO date or datetime, inclusive (2025-01-01)","title":"Start"},"station":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"string"},{"type":"null"}],"default":null,"description":"station ids -- a list, or one id (or several, comma-separated) as a string; CASE-SENSITIVE: HTM150 (trigram + sampling height) for atmosphere, SE-Htm for FLUXNET