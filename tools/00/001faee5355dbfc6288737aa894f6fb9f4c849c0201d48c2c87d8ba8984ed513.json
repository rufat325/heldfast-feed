{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get block"
 },
 "description": "Inspect the block at a world coordinate. Returns name/position and (detailed) hardness, diggability, line-of-sight, estimated dig time and sign text. Returns name 'air'/null-ish if the chunk is unloaded.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "extraInfos": {
    "description": "Include sign/painting/block-entity data (slower). Default true.",
    "type": "boolean"
   },
   "format": {
    "description": "Response detail level; \"concise\" (default) or \"detailed\"",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   },
   "x": {
    "description": "X world coordinate (integer for blocks)",
    "type": "number"
   },
   "y": {
    "description": "Y world coordinate (integer for blocks)",
    "type": "number"
   },
   "z": {
    "description": "Z world coordinate (integer for blocks)",
    "type": "number"
   }
  },
  "required": [
   "x",
   "y",
   "z"
  ],
  "type": "object"
 },
 "name": "get_block_at"
}
