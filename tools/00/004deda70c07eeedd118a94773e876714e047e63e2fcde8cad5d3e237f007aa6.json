{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read-only: validate an ordered TouchDesigner operator chain against embedded operator docs, documented connections, family/category filters, and optional TouchDesigner version compatibility. It does not create or modify TD nodes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "Alias for family; optional expected operator category.",
    "minLength": 1,
    "type": "string"
   },
   "chain": {
    "description": "Ordered TouchDesigner operator names, display names, or slugs to validate.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "family": {
    "description": "Optional expected operator family/category, e.g. TOP, CHOP, SOP, DAT, or POP.",
    "minLength": 1,
    "type": "string"
   },
   "require_documented_connections": {
    "default": false,
    "description": "When true, adjacent pairs must be documented by embedded connection guides.",
    "type": "boolean"
   },
   "target_version": {
    "description": "Optional target TouchDesigner stable version, e.g. 099, 2023, or 2024.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "chain"
  ],
  "type": "object"
 },
 "name": "validate_operator_chain",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "connectionChecks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "documented": {
       "type": "boolean"
      },
      "from": {
       "type": "string"
      },
      "fromIndex": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "port": {
       "type": "string"
      },
      "portHint": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      },
      "source": {
       "enum": [
        "common_output",
        "common_input",
        "workflow",
        "none",
        "unresolved_operator"
       ],
       "type": "string"
      },
      "to": {
       "type": "string"
      },
      "toIndex": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "from",
      "to",
      "fromIndex",
      "toIndex",
      "documented",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "issues": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "actualFamily": {
       "type": "string"
      },
      "addedIn": {
       "type": "string"
      },
      "expectedFamily": {
       "type": "string"
      },
      "from": {
       "type": "string"
      },
      "index": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "message": {
       "type": "string"
      },
      "operator": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "warning",
        "error"
       ],
       "type": "string"
      },
      "suggestions": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "targetVersion": {
       "type": "string"
      },
      "to": {
       "type": "string"
      },
      "type": {
       "enum": [
        "missing_operator",
        "family_mismatch",
        "undocumented_connection",
        "version_incompatible"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextToolHints": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "normalizedChain": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "displayName": {
       "type": "string"
      },
      "found": {
       "type": "boolean"
      },
      "input": {
       "type": "string"
      },
      "operator": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "subcategory": {
       "type": "string"
      },
      "summary": {
       "type": "string"
      }
     },
     "required": [
      "input",
      "operator",
      "found"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "severity": {
    "enum": [
     "ok",
     "warning",
     "error"
    ],
    "type": "string"
   },
   "suggestions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "valid": {
    "type": "boolean"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "valid",
   "severity",
   "normalizedChain",
   "issues",
   "warnings",
   "connectionChecks",
   "suggestions",
   "nextToolHints"
  ],
  "type": "object"
 },
 "title": "Validate operator chain"
}
