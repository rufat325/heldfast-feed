{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Get fax status"},"description":"Read one outbound fax's delivery state and attempts. Use after send_approved_fax or list_faxes. Use get_review_status for a human approval decision and read_inbound_fax for a received fax. Returns queued, active, delivered, partial, failed or unknown, plus carrier evidence when delivered or partial. Evidence is not legal proof of acceptance. Repeated polls are safe and free, with no send or approval side effects. Scope: fax:read.","inputSchema":{"properties":{"fax_id":{"description":"Outbound fax id from send_approved_fax or list_faxes. Format: fax_ followed by 32 lowercase hexadecimal characters. Required, no default. This is a delivery job, not an approval request or inbox item.","examples":["fax_0123456789abcdef0123456789abcdef"],"pattern":"^fax_[0-9a-f]{32}$","title":"Fax Id","type":"string"}},"required":["fax_id"],"title":"get_fax_statusArguments","type":"object"},"name":"get_fax_status","outputSchema":{"$defs":{"Attempt":{"additionalProperties":true,"properties":{"attempt_number":{"title":"Attempt Number","type":"integer"},"error":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Error"},"evidence":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"title":"Evidence"},"failure_code":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Failure Code"},"fax_job_id":{"title":"Fax Job Id","type":"string"},"finished_at":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Finished At"},"id":{"title":"Id","type":"string"},"pages_sent":{"title":"Pages Sent","type":"integer"},"provider":{"title":"Provider","type":"string"},"provider_ref":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Provider Ref"},"started_at":{"title":"Started At","type":"string"},"status":{"title":"Status","type":"string"}},"required":["id","fax_job_id","attempt_number","provider","provider_ref","status","pages_sent","fail