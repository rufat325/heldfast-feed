  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "const": "coaching_send_back_plan",
      "type": "string"
     },
     "assignmentId": {
      "type": "string"
     },
     "contractId": {
      "type": "string"
     },
     "cycle": {
      "additionalProperties": false,
      "properties": {
       "closedAt": {
        "type": [
         "string",
         "null"
        ]
       },
       "closedReason": {
        "anyOf": [
         {
          "enum": [
           "ACCEPTED",
           "GRADED",
           "SUPERSEDED",
           "CANCELLED"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "cycleNumber": {
        "type": "integer"
       },
       "reason": {
        "type": [
         "string",
         "null"
        ]
       },
       "requestedQuestionIds": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "reviewCycleId": {
        "type": "string"
       },
       "sentAt": {
        "type": [
         "string",
         "null"
        ]
       },
       "sourceAttemptId": {
        "type": "string"
       },
       "status": {
        "enum": [
         "DRAFT",
         "OPEN",
         "RESUBMITTED",
         "CLOSED"
        ],
        "type": "string"
       }
      },
      "required": [
       "reviewCycleId",
       "cycleNumber",
       "status",
       "sourceAttemptId",
       "requestedQuestionIds",
       "reason",
       "sentAt",
       "closedAt",
       "closedReason"
      ],
      "type": "object"
     },
     "deadline": {
      "additionalProperties": false,
      "properties": {
       "blockAt": {
        "type": [
         "string",
         "null"
        ]
       },
       "dueAt": {
        "type": [
         "string",
         "null"
        ]
       },
       "dueSoon": {
        "type": "boolean"
       },
       "inheritedUnchanged": {
        "type": "boolean"
       },
       "overdue": {
        "type": "boolean"
       }
      },
      "required": [
       "dueAt",
       "blockAt",
       "overdue",
       "dueSoon"
      ],
      "type": "object"
     },
     "draftCommentCount": {
      "type": "integer"
     },
     "effects": {
      "additionalProperties": false,
      "properties": {
       "configuredAttemptImpact": {
        "type": "integer"
       },
       "notifications": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "publishesDraftBatch": {
        "type": "boolean"
       },
       "resultingAssignmentStatus": {
        "const": "RETURNED",
        "type": "string"
       },
       "resultingWaitingRole": {
        "const": "WORKER",
        "type": "string"
       }
      },
      "required": [
       "configuredAttemptImpact",
       "resultingAssignmentStatus",
       "resultingWaitingRole",
       "notifications",
       "publishesDraftBatch"
      ],
      "type": "object"
     },
     "expectedSubmittedAt": {
      "type": "string"
     },
     "findings": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "message": {
         "type": "string"
        },
        "reason": {
         "type": "string"
        }
       },
       "required": [
        "reason",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "jobId": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "ok": {
      "type": "boolean"
     },
     "planExpiresAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "planToken": {
      "type": [
       "string",
       "null"
      ]
     },
     "reason": {
      "type": "string"
     },
     "requestedQuestions": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "prompt": {
         "type": [
          "string",
          "null"
         ]
        },
        "questionId": {
         "type": "string"
        }
       },
       "required": [
        "questionId",
        "prompt"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "action",
     "ok",
     "findings",
     "assignmentId",
     "jobId",
     "contractId",
     "cycle",
     "requestedQuestions",
     "draftCommentCount",
     "reason",
     "expectedSubmittedAt",
     "deadline",
     "effects",
     "planToken",
     "planExpiresAt",
     "note"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
