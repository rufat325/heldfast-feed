{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "project_todos:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "NO-WRITE selective send-back plan (dedicated read-scoped registry preflight project_todos.quizzes.coaching.send_back_plan; KEYLESS by design). Validates the DRAFT selection against the live submission; returns typed findings and \u2014 when clean \u2014 a signed expiring planToken bound to the EXACT reviewed draft-batch + review-state digests. Nothing is written; the worker sees nothing. Confirm via opentrain_quiz_coaching_send_back_confirm; any drift fails closed as 409 PLAN_STALE. Requires project_todos:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "minLength": 1,
    "type": "string"
   },
   "expectedSubmittedAt": {
    "format": "date-time",
    "type": "string"
   },
   "reason": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "reviewCycleId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "assignmentId",
   "reviewCycleId",
   "reason",
   "expectedSubmittedAt"
  ],
  "type": "object"
 },
 "name": "opentrain_quiz_coaching_send_back_plan",
