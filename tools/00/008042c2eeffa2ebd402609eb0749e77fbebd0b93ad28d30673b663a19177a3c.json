{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Generate AI-powered alt text for an image URL. Returns the result synchronously (may take a few seconds). Uses account credits; additional languages and image conversion can increase the total. Can overwrite existing alt text when requested.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "asset_id": {
    "description": "Custom asset ID (default: auto-generated hash)",
    "maxLength": 256,
    "type": "string"
   },
   "gpt_prompt": {
    "description": "Custom prompt template. Use {{AltText}} as a placeholder for the generated alt text.",
    "maxLength": 768,
    "type": "string"
   },
   "keywords": {
    "description": "Keywords to incorporate",
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "lang": {
    "description": "Comma-separated language codes (e.g. 'en', 'en,fr,es')",
    "maxLength": 64,
    "type": "string"
   },
   "max_chars": {
    "description": "Maximum character length for the alt text",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "metadata": {
    "additionalProperties": {
     "maxLength": 256,
     "type": "string"
    },
    "description": "Custom metadata (string key-value pairs)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "negative_keywords": {
    "description": "Keywords to avoid",
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "overwrite": {
    "description": "Overwrite existing alt text if image was previously processed",
    "type": "boolean"
   },
   "tags": {
    "description": "Tags for organization",
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "url": {
    "description": "Public URL of the image",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "generate_alt_text",
 "title": "Generate Alt Text"
}
