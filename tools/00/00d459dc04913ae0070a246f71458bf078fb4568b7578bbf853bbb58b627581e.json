  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "items": {
    "items": {
     "properties": {
      "color": {
       "maxLength": 60,
       "type": "string"
      },
      "product_id": {
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "maximum": 20,
       "minimum": 1,
       "type": "integer"
      },
      "size": {
       "maxLength": 40,
       "type": "string"
      }
     },
     "required": [
      "product_id"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "create_bag_link",
 "title": "Create a GENOSYS bag link"
