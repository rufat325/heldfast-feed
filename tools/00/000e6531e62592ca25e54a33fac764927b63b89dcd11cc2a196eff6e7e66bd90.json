{
 "description": "Max 50 entries per bulk call\u2014split large catalogs into batches of ~50 to avoid oversized tool payloads. For full re-import: delete-entries once, then set-entries in 50-entry chunks; or replace-entries with deleteOrphans=false until the final batch (deleteOrphans=true). Alias for replace-entries (mode=replace). Pass filter as scope; send up to 50 entries per call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deleteOrphans": {
    "description": "Delete scope entries missing from this batch (default true; set false until final batch)",
    "type": "boolean"
   },
   "entries": {
    "description": "Import batch (max 50 per call)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "type": "string"
      },
      "payload": {
       "additionalProperties": {},
       "type": "object"
      },
      "refs": {
       "additionalProperties": false,
       "properties": {
        "entryIds": {
         "description": "Related entry ids, e.g. flow steps pointing to other entries",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "files": {
         "description": "Workspace-relative file paths where this fact lives",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "moduleName": {
         "description": "Module name from list-modules; per-entry override of batch moduleName",
         "type": "string"
        }
       },
       "type": "object"
      },
      "summary": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "kind",
      "title",
      "summary"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "filter": {
    "additionalProperties": false,
    "description": "Scope filter (kind, moduleName, tags)",
    "properties": {
     "kind": {
      "description": "Exact entry kind in scope",
      "type": "string"
     },
     "kinds": {
      "description": "Entry kinds in scope",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "moduleName": {
      "description": "Only entries linked to this module",
      "type": "string"
     },
     "tags": {
      "description": "Entries having any of these tags",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "mode": {
    "description": "Only replace mode is supported (full slice sync)",
    "enum": [
     "replace"
    ],
    "type": "string"
   },
   "moduleName": {
    "description": "Default refs.moduleName for entries without refs.moduleName",
    "type": "string"
   },
   "projectId": {
    "description": "Required. Call list-projects first (query by workspace folder name) and pass the matching projectId. Never omit. default-project is forbidden.",
    "minLength": 1,
    "type": "string"
   },
   "upsertBy": {
    "description": "Match keys (default kind+title)",
    "items": {
     "enum": [
      "kind",
      "title",
      "id"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "projectId",
   "mode",
   "filter",
   "entries"
  ],
  "type": "object"
 },
 "name": "import-entries",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "created": {
    "type": "number"
   },
   "deleted": {
    "type": "number"
   },
   "entryIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "updated": {
    "type": "number"
   }
  },
  "required": [
   "created",
   "updated",
   "deleted",
   "entryIds",
   "message"
  ],
  "type": "object"
 },
 "title": "Import Entries"
}
