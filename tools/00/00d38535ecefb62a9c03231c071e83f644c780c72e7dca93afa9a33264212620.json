{
 "description": "Issue an owner-signed mandate (SD-JWT VC) for an agent: spend caps in WHOLE currency units (per transaction / day / task / total), optional human-approval threshold, validity window. The mandate file path is returned; point the gateway at it (MANDARE_MANDATE_PATH).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_did": {
    "description": "The agent's did:key (from mandare_issue_passport)",
    "maxLength": 512,
    "minLength": 4,
    "pattern": "^did:[a-z0-9]+:[A-Za-z0-9._:%-]+$",
    "type": "string"
   },
   "approval_above": {
    "description": "Spends above this wait for an async human approval",
    "exclusiveMinimum": 0,
    "maximum": 1000000,
    "type": "number"
   },
   "currency": {
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "per_day": {
    "exclusiveMinimum": 0,
    "maximum": 1000000,
    "type": "number"
   },
   "per_task": {
    "exclusiveMinimum": 0,
    "maximum": 1000000,
    "type": "number"
   },
   "per_tx": {
    "description": "Max per single call/transaction, whole currency units",
    "exclusiveMinimum": 0,
    "maximum": 1000000,
    "type": "number"
   },
   "purpose": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "total": {
    "exclusiveMinimum": 0,
    "maximum": 1000000,
    "type": "number"
   },
   "valid_hours": {
    "exclusiveMinimum": 0,
    "maximum": 8760,
    "type": "number"
   }
  },
  "required": [
   "agent_did"
  ],
  "type": "object"
 },
 "name": "mandare_issue_mandate",
 "title": "Issue a mandate"
}
