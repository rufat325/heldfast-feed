  "properties": {
   "description": {
    "description": "New description",
    "type": "string"
   },
   "html": {
    "description": "Replacement email HTML (HTML-mode templates)",
    "type": "string"
   },
   "name": {
    "description": "New template name",
    "type": "string"
   },
   "status": {
    "description": "New status",
    "enum": [
     "draft",
     "exported"
    ],
    "type": "string"
   },
   "template_id": {
    "description": "Template UUID",
    "type": "string"
   }
  },
  "required": [
   "template_id"
  ],
  "type": "object"
 },
 "name": "update_template"
}
