{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create YouTube clip"
 },
 "description": "Creates a public TubeChop link for an exact time range in a public YouTube video. Free clips expire after seven days.",
 "inputSchema": {
  "properties": {
   "comment": {
    "description": "An optional note shown with the clip.",
    "maxLength": 280,
    "type": [
     "string",
     "null"
    ]
   },
   "end_seconds": {
    "description": "The clip end time in seconds. It cannot exceed the source video duration and must be at least 0.5 seconds after start_seconds. The clip length (end_seconds minus start_seconds) cannot exceed 80% of the source video duration.",
    "minimum": 0,
    "type": "number"
   },
   "idempotency_key": {
    "description": "A unique key for this intended clip, such as a UUID. Reuse it when retrying the same request.",
    "maxLength": 100,
    "minLength": 8,
    "type": "string"
   },
   "start_seconds": {
    "description": "The clip start time in seconds, including decimals.",
    "minimum": 0,
    "type": "number"
   },
   "youtube_url": {
    "description": "A public YouTube URL or 11-character YouTube video ID.",
    "maxLength": 255,
    "type": "string"
   }
  },
  "required": [
   "youtube_url",
   "start_seconds",
   "end_seconds",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "create_youtube_clip",
 "outputSchema": {
  "properties": {
   "clip": {
    "properties": {
     "id": {
      "type": "string"
     },
     "manage_url": {
      "format": "uri",
      "type": "string"
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "id",
     "url",
     "manage_url"
    ],
    "type": "object"
   },
   "policy": {
    "properties": {
     "expires_at": {
      "format": "date-time",
      "type": "string"
     },
     "expires_in_days": {
      "type": "integer"
     },
     "message": {
      "type": "string"
     },
     "visibility": {
      "enum": [
       "public"
      ],
      "type": "string"
     }
    },
    "required": [
     "visibility",
     "expires_at",
     "expires_in_days",
     "message"
    ],
    "type": "object"
   },
   "reused": {
    "type": "boolean"
   },
   "source": {
    "properties": {
     "channel": {
      "type": "string"
     },
     "duration_seconds": {
      "type": "integer"
     },
     "end_seconds": {
      "type": "number"
     },
     "start_seconds": {
      "type": "number"
     },
     "title": {
      "type": "string"
     },
     "youtube_id": {
      "type": "string"
     },
     "youtube_url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "youtube_id",
     "youtube_url",
     "title",
     "channel",
     "duration_seconds",
     "start_seconds",
     "end_seconds"
    ],
    "type": "object"
   }
  },
  "required": [
   "clip",
   "source",
   "policy",
   "reused"
  ],
  "type": "object"
 },
 "title": "Create YouTube clip"
}
