{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Runs a Docker container from an image and returns structured container ID and status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "command": {
    "default": [],
    "description": "Command to run in the container",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "cpus": {
    "description": "Number of CPUs to allocate (e.g., 1.5)",
    "type": "number"
   },
   "detach": {
    "default": true,
    "description": "Run container in background (default: true)",
    "type": "boolean"
   },
   "entrypoint": {
    "description": "Override image entrypoint (--entrypoint)",
    "maxLength": 65536,
    "type": "string"
   },
   "env": {
    "default": [],
    "description": "Environment variables (e.g., [\"KEY=VALUE\"])",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "envFile": {
    "description": "Read environment variables from a file (--env-file)",
    "maxLength": 4096,
    "type": "string"
   },
   "hostname": {
    "description": "Container hostname (-h, --hostname)",
    "maxLength": 255,
    "type": "string"
   },
   "image": {
    "description": "Docker image to run (e.g., nginx:latest)",
    "maxLength": 255,
    "type": "string"
   },
   "memory": {
    "description": "Memory limit (e.g., \"512m\", \"1g\") for resource constraints",
    "maxLength": 255,
    "type": "string"
   },
   "name": {
    "description": "Container name",
    "maxLength": 255,
    "type": "string"
   },
   "network": {
    "description": "Connect to a Docker network (--network)",
    "maxLength": 255,
    "type": "string"
   },
   "path": {
    "description": "Working directory",
    "maxLength": 4096,
    "type": "string"
   },
   "platform": {
    "description": "Target platform for multi-arch testing (e.g., \"linux/amd64\")",
    "maxLength": 255,
    "type": "string"
   },
   "ports": {
    "default": [],
    "description": "Port mappings (e.g., [\"8080:80\", \"443:443\"])",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "pull": {
    "description": "Pull image policy: \"always\", \"missing\", or \"never\" (--pull)",
    "enum": [
     "always",
     "missing",
     "never"
    ],
    "type": "string"
   },
   "readOnly": {
    "default": false,
    "description": "Mount the container root filesystem as read-only (default: false)",
    "type": "boolean"
   },
   "restart": {
    "description": "Restart policy for the container (--restart)",
    "enum": [
     "no",
     "always",
     "unless-stopped",
     "on-failure"
    ],
    "type": "string"
   },
   "rm": {
    "default": false,
    "description": "Remove container after exit (default: false)",
    "type": "boolean"
   },
   "shmSize": {
    "description": "Size of /dev/shm (e.g., \"2g\") for browser-based testing containers",
    "maxLength": 255,
    "type": "string"
   },
   "user": {
    "description": "Run as a specific user (e.g., \"root\", \"1000:1000\")",
    "maxLength": 255,
    "type": "string"
   },
   "volumes": {
    "default": [],
    "description": "Volume mounts (e.g., [\"/host/path:/container/path\"])",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "workdir": {
    "description": "Working directory inside the container (-w, --workdir)",
    "maxLength": 4096,
    "type": "string"
   }
  },
  "required": [
   "image"
  ],
  "type": "object"
 },
 "name": "run",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "containerId": {
    "type": "string"
   },
   "detached": {
    "type": "boolean"
   },
   "errorCategory": {
    "enum": [
     "image-not-found",
     "port-conflict",
     "permission-denied",
     "daemon-error",
     "unknown"
    ],
    "type": "string"
   },
   "exitCode": {
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "stderr": {
    "type": "string"
   },
   "stdout": {
    "type": "string"
   }
  },
  "required": [
   "containerId",
   "detached"
  ],
  "type": "object"
 },
 "title": "Docker Run"
}
