{
 "description": "Paid Trade Execution Quote ($0.01 USDC). Gets an indicative swap quote before a trade; supports Solana via Jupiter and EVM via 0x when provider keys are configured. Requires token addresses and decimals for custom assets. Returns estimated output and quote source. Read-only: never signs, submits, or executes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "exclusiveMinimum": 0,
    "maximum": 1000000000000,
    "type": "number"
   },
   "chain": {
    "enum": [
     "solana",
     "ethereum",
     "base",
     "arbitrum",
     "optimism",
     "polygon"
    ],
    "type": "string"
   },
   "from_asset": {
    "maxLength": 90,
    "minLength": 1,
    "type": "string"
   },
   "from_decimals": {
    "maximum": 36,
    "minimum": 0,
    "type": "integer"
   },
   "max_slippage_bps": {
    "default": 100,
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "to_asset": {
    "maxLength": 90,
    "minLength": 1,
    "type": "string"
   },
   "to_decimals": {
    "maximum": 36,
    "minimum": 0,
    "type": "integer"
   },
   "venues": {
    "items": {
     "enum": [
      "jupiter",
      "0x"
     ],
     "type": "string"
    },
    "maxItems": 2,
    "type": "array"
   }
  },
  "required": [
   "chain",
   "from_asset",
   "to_asset",
   "amount"
  ],
  "type": "object"
 },
 "name": "estimate_trade_execution",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "cache": {
      "additionalProperties": false,
      "properties": {
       "age_ms": {
        "minimum": 0,
        "type": "number"
       },
       "hit": {
        "type": "boolean"
       }
      },
      "required": [
       "hit",
       "age_ms"
      ],
      "type": "object"
     },
     "failed_sources": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "reason": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "source",
        "reason"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "latency_ms": {
      "minimum": 0,
      "type": "number"
     },
     "partial": {
      "type": "boolean"
     },
     "sources": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "sources",
     "latency_ms",
     "partial",
     "failed_sources",
     "cache"
    ],
    "type": "object"
   },
   "success": {
    "const": true,
    "type": "boolean"
   },
   "timestamp": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "tool": {
    "type": "string"
   }
  },
  "required": [
   "success",
   "tool",
   "timestamp",
   "data",
   "meta"
  ],
  "type": "object"
 }
}
