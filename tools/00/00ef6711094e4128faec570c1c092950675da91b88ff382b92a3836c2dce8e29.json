{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Crawl a site and generate a spec-conformant llms.txt document listing its pages, grouped by top-level section.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "maxPages": {
    "description": "max pages to crawl (default 30, clamped to 1\u2013100)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "timeout": {
    "description": "per-request fetch timeout in ms",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "url": {
    "description": "site URL to crawl",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "generate_llms_txt",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "markdown": {
    "type": "string"
   },
   "pageCount": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "markdown",
   "pageCount"
  ],
  "type": "object"
 }
}
