{
 "description": "Add a deadline/countdown to track. Specify either expiresIn (minutes from now) or expiresAt (specific time).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "What happens when deadline expires",
    "type": "string"
   },
   "expiresAt": {
    "additionalProperties": false,
    "description": "Specific game time when deadline expires",
    "properties": {
     "day": {
      "minimum": 1,
      "type": "number"
     },
     "hour": {
      "maximum": 23,
      "minimum": 0,
      "type": "number"
     },
     "minute": {
      "maximum": 59,
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "day",
     "hour",
     "minute"
    ],
    "type": "object"
   },
   "expiresIn": {
    "description": "Minutes from now until expiration",
    "minimum": 1,
    "type": "number"
   },
   "id": {
    "description": "Unique deadline ID",
    "type": "string"
   },
   "name": {
    "description": "Deadline name (e.g., 'Midnight')",
    "type": "string"
   },
   "onExpireFlag": {
    "description": "Flag to set when deadline expires",
    "type": "string"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   },
   "warnOnApproach": {
    "default": true,
    "description": "Warn when within 1 hour (default: true)",
    "type": "boolean"
   }
  },
  "required": [
   "sessionId",
   "id",
   "name",
   "description"
  ],
  "type": "object"
 },
 "name": "add_deadline"
}
