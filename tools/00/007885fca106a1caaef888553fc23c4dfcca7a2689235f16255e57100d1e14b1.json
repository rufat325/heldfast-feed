{
 "description": "Manage Open Label calibration rounds: list rounds with per-annotator pass/fail results, create a round from gold units, open it (serves through the gold rails), or close it (scores from the gold events). Requires open-label:read for list, open-label:write otherwise.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "What to do.",
    "enum": [
     "list",
     "create",
     "open",
     "close"
    ],
    "type": "string"
   },
   "kind": {
    "enum": [
     "PRE_PRODUCTION",
     "REFRESHER"
    ],
    "type": "string"
   },
   "minScoredCount": {
    "type": "integer"
   },
   "name": {
    "description": "Round name (create).",
    "type": "string"
   },
   "passThreshold": {
    "type": "number"
   },
   "projectId": {
    "description": "The Open Label project id.",
    "type": "string"
   },
   "roundId": {
    "description": "Round id (open/close).",
    "type": "string"
   },
   "sampleSize": {
    "description": "Gold units to sample (create).",
    "type": "integer"
   }
  },
  "required": [
   "projectId",
   "action"
  ],
  "type": "object"
 },
 "name": "open_label_calibration_round",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
