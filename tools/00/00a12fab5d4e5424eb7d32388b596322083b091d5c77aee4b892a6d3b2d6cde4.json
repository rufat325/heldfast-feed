  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Institutional Holdings"
 },
 "description": "Returns top-N institutional holders of a US public company at a specific period_end (latest by default), with aggregate institutional shares, total market value, holder count, and HHI concentration (sum of squared share-of-total percentages).  Sourced from Form 13F-HR via the by-issuer partition.  Institutional tier only.  13F filings carry a ~45-day reporting lag \u2014 staleness_warning fires when latest data is older than 90 days.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "as_of_date": {
    "description": "Point-in-time cutoff (YYYY-MM-DD): only 13F filings ACCEPTED by SEC on or before this date are considered, applied BEFORE the latest period is resolved. A 13F/A amendment or late filing accepted after this date is excluded (zero look-ahead) \u2014 use this for survivorship-free backtests. Omit for the latest knowable book.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "lineage_detail": {
    "default": "compact",
    "description": "Per-row provenance envelope. compact / full / off.",
    "enum": [
     "off",
     "compact",
     "full"
    ],
    "type": "string"
   },
   "period_end": {
    "description": "Quarter-end of the 13F reporting period (YYYY-MM-DD). Omit to use the latest period available. This is a REPORTING period, NOT a point-in-time cutoff \u2014 use as_of_date for that.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "ticker": {
    "description": "Stock ticker symbol of the issuer \u2014 or a CIK (SEC identifier).",
    "maxLength": 10,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9.\\-]+$",
    "type": "string"
   },
   "top_n": {
    "default": 25,
    "description": "Maximum holders to return, ranked by market_value_usd. Default 25, max 200.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },
 "name": "get_institutional_holdings",
