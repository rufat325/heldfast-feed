{
 "description": "Search NPK (standardized positions catalog) codes by keyword or number",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "lang": {
    "default": "en",
    "description": "Search language",
    "enum": [
     "de",
     "fr",
     "it",
     "en"
    ],
    "type": "string"
   },
   "query": {
    "description": "Search term (keyword or code number)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_npk_codes"
}
