{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List instruments with stories"
 },
 "description": "The listed companies, commodities, indices, currency and central-bank policy rates that have at least one FocusPulse story right now, for one country (IN or US), with how many stories each has. Use it to see what is covered before asking for an instrument's stories with get_instrument_stories. Information only \u2014 never investment advice.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "country": {
    "description": "Market: 'IN' (India) or 'US'.",
    "enum": [
     "IN",
     "US"
    ],
    "type": "string"
   },
   "hours": {
    "description": "Lookback window in hours, default 24, max 48 \u2014 older stories are purged.",
    "maximum": 48,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "country"
  ],
  "type": "object"
 },
 "name": "list_instruments",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "code": {
    "enum": [
     "OK",
     "NO_DATA"
    ],
    "type": "string"
   },
   "country": {
    "enum": [
     "IN",
     "US"
    ],
    "type": "string"
   },
   "instruments": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "company",
        "commodity",
        "index",
        "currency",
        "policy_rate"
       ],
       "type": "string"
      },
      "latest_story_at": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "stories": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "kind",
      "stories",
      "latest_story_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "number"
   },
   "window_hours": {
    "type": "number"
   }
  },
  "required": [
   "code",
   "instruments",
   "total",
   "country",
   "window_hours"
  ],
  "type": "object"
 },
 "title": "List instruments with stories"
}
