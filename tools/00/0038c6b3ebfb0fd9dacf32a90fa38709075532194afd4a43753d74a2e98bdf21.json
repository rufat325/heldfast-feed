{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check DNS Propagation"
 },
 "description": "Check whether a DNS change has propagated: asks Google, Cloudflare, Quad9, OpenDNS and AdGuard the same question at once and reports which resolvers agree, with TTLs. Different answers can also mean load balancing, not only an unfinished change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Domain name to check (e.g., \"github.com\")",
    "type": "string"
   },
   "resolvers": {
    "description": "Resolvers to ask, at least two. Omit for all five.",
    "items": {
     "enum": [
      "google",
      "cloudflare",
      "quad9",
      "opendns",
      "adguard"
     ],
     "type": "string"
    },
    "minItems": 2,
    "type": "array"
   },
   "type": {
    "description": "Record type (default: A)",
    "enum": [
     "A",
     "AAAA",
     "CNAME",
     "MX",
     "NS",
     "TXT"
    ],
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "dns_propagation"
}
