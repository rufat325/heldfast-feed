{"_meta":{"xdata.kr/credential":{"providers":["work24"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=work24","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: work24__auth__npki_session__login (\uac19\uc740 account_link_id). \ucd08\uc548\uc744 \uc2e4\uc81c \ud654\uba74\uacfc \ub300\uc870\ud574 \ucca8\ubd80 \uc11c\ub958 \ubaa9\ub85d\uacfc \uc81c\ucd9c\ud560 \uc218 \uc788\ub294\uc9c0\ub97c \ub3cc\ub824\uc90d\ub2c8\ub2e4. \uc81c\ucd9c\uc740 \ud558\uc9c0 \uc54a\uc73c\uba70, submit \uc804\uc5d0 \ubc18\ub4dc\uc2dc \uac70\uce58\ub294 \ud655\uc778\uc785\ub2c8\ub2e4. \uc77c\ubd80 \uc0ac\uc5c5\uc740 \ud654\uba74\uc744 \uc62e\uae38 \ub54c \ucd08\uc548\uc774 \uc800\uc7a5\ub418\uba70, \uc800\uc7a5\ub410\ub294\uc9c0\ub294 \uacb0\uacfc\uc758 safety.save_executed \uac00 \uc54c\ub824 \uc90d\ub2c8\ub2e4. \ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc774\uba74 \uccab \uc694\uccad \uc804\uc5d0 request_idempotency_key \uac12\uc744 \ub9cc\ub4e4\uc5b4 \uc800\uc7a5\ud558\uc138\uc694. \uc751\ub2f5\uc744 \ubc1b\uc9c0 \ubabb\ud55c \uadf8 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c\ub9cc \uac19\uc740 \uc778\uc790\uc640 \ud568\uaed8 \uadf8 \uac12\uc744 \ub2e4\uc2dc \ubcf4\ub0b4\uace0, \uc0c8\ub85c \uc2e4\ud589\ud560 \ub54c\ub294 \uc0c8 \uac12\uc744 \uc4f0\uc138\uc694. \uc774 \uac12 \uc5c6\uc774 \ub2e4\uc2dc \ubd80\ub974\uba74 \uc0c8 \uc694\uccad\uc774 \ub429\ub2c8\ub2e4. \uacc4\uc815 \uc5c6\uc774 \ub9db\ubcf4\uae30\ub85c \ubd80\ub97c \ub54c\ub294 \uc774 \uc120\ud0dd \uce78\uc744 \uc4f8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uae30\uad00 \uc5c5\ubb34\uc5d0 \ub530\ub85c \uc788\ub294 idempotency_key \uce78\uc740 \ub2e4\ub978 \uce78\uc774\ub2c8 \uadf8\ub300\ub85c \ub450\uc138\uc694. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 1\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"business_management_no":{"description":"11-digit \uace0\uc6a9\ubcf4\ud5d8 \uc0ac\uc5c5\uc7a5\uad00\ub9ac\ubc88\ud638. \ube44\uc6b0\uba74 \ub85c\uadf8\uc778 \uc2dc \uc800\uc7a5\ub41c \uac12\uc744 \uc4f4\ub2e4.","type":"string"},"programme_key":{"description":"\uce74\ud0c8\ub85c\uadf8 \uc0ac\uc5c5 \ud0a4 (\uc608: w24_b0010 \uace0\uc6a9\ucd09\uc9c4\uc7a5\ub824\uae08). subsidy_pack \uc9c4\ub2e8 \uacb0\uacfc\uc758 programme_key \ub97c \uadf8\ub300\ub85c \ub123\ub294\ub2e4.","type":"string"},"receipt_no":{"description":"\ubbfc\uc6d0\uc2e0\uccad\uc811\uc218\ubc88\ud638 (cvplRqutRcno). workplace_save \uac00 \ubc1c\uae09\ud55c \uac12.","type":"string"},"request_idempotency_key":{"description":"\ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc5d0\uc11c \uc751\ub2f5\uc744 \ubabb \ubc1b\uc740 \uac19\uc740 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c \uc4f0\ub294 \uc120\ud0dd \uac12\uc785\ub2c8\ub2e4. \uc4f0\ub294 \ubc95\uc740 \ub3c4\uad6c \uc124\uba85\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.","maxLength":128,"minLength":1,"pattern":"^[\\x20-\\x7E]+$","type":"string"}},"required":["programme_key","receipt_no"],"type":"object"},"name":"w