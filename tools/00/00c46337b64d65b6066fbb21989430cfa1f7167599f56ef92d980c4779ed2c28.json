{"description":"Find OSM POIs inside a bounding box. Use for \"every park in this area\" or \"all restaurants in this neighborhood\". Bounding box is (south, west, north, east) in degrees.","inputSchema":{"properties":{"east":{"description":"Maximum longitude","type":"number"},"limit":{"description":"Max results (1-1000, default 200)","type":"number"},"north":{"description":"Maximum latitude","type":"number"},"south":{"description":"Minimum latitude","type":"number"},"tag":{"description":"OSM tag filter (e.g., \"leisure=park\", \"amenity=hospital\")","type":"string"},"west":{"description":"Minimum longitude","type":"number"}},"required":["south","west","north","east","tag"],"type":"object"},"name":"places_in_bbox"}
