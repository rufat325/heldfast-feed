{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Busca medicamentos no Bul\u00e1rio Eletr\u00f4nico da ANVISA pelo nome comercial. Retorna lista paginada com n\u00famero de processo, empresa e links de bula.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "count": {
    "description": "Resultados por p\u00e1gina (padr\u00e3o: 10, m\u00e1x: 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "nome": {
    "description": "Nome comercial do medicamento",
    "minLength": 1,
    "type": "string"
   },
   "pagina": {
    "description": "N\u00famero da p\u00e1gina (padr\u00e3o: 1)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "nome"
  ],
  "type": "object"
 },
 "name": "buscar_por_nome",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_meta": {
    "additionalProperties": false,
    "properties": {
     "data_da_base": {
      "description": "ISO 8601 da \u00faltima atualiza\u00e7\u00e3o da base consultada",
      "type": "string"
     },
     "defasagem_dias": {
      "description": "Dias desde data_da_base",
      "type": "number"
     },
     "fonte": {
      "description": "Identifica\u00e7\u00e3o da fonte que respondeu (ex: anvisa_api, cache_local)",
      "type": "string"
     },
     "modo": {
      "enum": [
       "cache_local",
       "online"
      ],
      "type": "string"
     },
     "status": {
      "description": "'stale' quando defasagem > 30 dias",
      "enum": [
       "ok",
       "stale"
      ],
      "type": "string"
     }
    },
    "required": [
     "data_da_base",
     "fonte",
     "defasagem_dias",
     "modo"
    ],
    "type": "object"
   },
   "data": {
    "additionalProperties": false,
    "properties": {
     "medicamentos": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "dataAtualizacao": {
         "type": "string"
        },
        "empresa": {
         "type": "string"
        },
        "idBulaPacienteProtegido": {
         "type": "string"
        },
        "idBulaProfissionalProtegido": {
         "type": "string"
        },
        "nomeProduto": {
         "type": "string"
        },
        "numProcesso": {
         "type": "string"
        }
       },
       "required": [
        "numProcesso",
        "nomeProduto",
        "empresa"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "pagina": {
      "type": "number"
     },
     "total": {
      "description": "N\u00famero de resultados retornados nesta p\u00e1gina",
      "type": "number"
     }
    },
    "required": [
     "total",
     "pagina",
     "medicamentos"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "_meta"
  ],
  "type": "object"
 },
 "title": "Buscar Medicamento por Nome Comercial"
}
