{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Bring an amount in Argentine pesos from one month to another using an official index: \"ipc\" (default) composes INDEC's monthly inflation month by month, the way contracts indexed \"por IPC\" are updated; \"cer\" and \"uva\" divide the BCRA index of one month by the other (the way inflation-adjusted loans and deposits work). Use it for \"how much is X pesos from <month> worth today\", \"what would a rent of X from <month> be now\" or \"how much was today's X worth back in <month>\" (pass a \"from\" later than \"to\"). Only \"ipc\" can go past the last published month: up to 12 months ahead are completed with El Tablero's projection of monthly inflation, and the response says exactly which months are published and which are projected, with 80% and 95% ranges for the adjusted amount. Read-only, no side effects, no authentication. Rate limited to 60 calls per minute per IP. Data updates at most once per business day.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "description": "Amount in pesos at the month given in from.",
    "exclusiveMinimum": 0,
    "maximum": 1000000000000000,
    "type": "number"
   },
   "from": {
    "description": "Month of the amount, YYYY-MM.",
    "pattern": "^\\d{4}-\\d{2}$",
    "type": "string"
   },
   "index": {
    "description": "\"ipc\" (default), \"cer\" or \"uva\".",
    "enum": [
     "ipc",
     "cer",
     "uva"
    ],
    "type": "string"
   },
   "to": {
    "description": "Target month, YYYY-MM. Defaults to the last published month of the index. Earlier than from inverts the adjustment.",
    "pattern": "^\\d{4}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "amount",
   "from"
  ],
  "type": "object"
 },
 "name": "adjust_for_inflation",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "adjusted_amount": {
    "type": "number"
   },
   "amount": {
    "type": "number"
   },
   "attribution": {
    "type": "string"
   },
   "bands": {
    "additionalProperties": false,
    "description": "Only when some months are projected",
    "properties": {
     "adjusted_amount_80": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
       {
        "type": "number"
       },
       {
        "type": "number"
       }
      ],
      "type": "array"
     },
     "adjusted_amount_95": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
       {
        "type": "number"
       },
       {
        "type": "number"
       }
      ],
      "type": "array"
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "adjusted_amount_80",
     "adjusted_amount_95",
     "note"
    ],
    "type": "object"
   },
   "change_pct": {
    "description": "Cumulative change of the index between from and to",
    "type": "number"
   },
   "disclaimer": {
    "type": "string"
   },
   "factor": {
    "type": "number"
   },
   "from": {
    "description": "YYYY-MM",
    "type": "string"
   },
   "index": {
    "enum": [
     "ipc",
     "cer",
     "uva"
    ],
    "type": "string"
   },
   "index_name": {
    "type": "string"
   },
   "index_values": {
    "additionalProperties": false,
    "description": "CER and UVA only: the index values used",
    "properties": {
     "from": {
      "additionalProperties": false,
      "properties": {
       "date": {
        "type": "string"
       },
       "value": {
        "type": "number"
       }
      },
      "required": [
       "date",
       "value"
      ],
      "type": "object"
     },
     "to": {
      "additionalProperties": false,
      "properties": {
       "date": {
        "type": "string"
       },
       "value": {
        "type": "number"
       }
      },
      "required": [
       "date",
       "value"
      ],
      "type": "object"
     }
    },
    "required": [
     "from",
     "to"
    ],
    "type": "object"
   },
   "key": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "projected_months": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "published_through": {
    "description": "Last month of the index that is published; later months are projected",
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "steps": {
    "description": "IPC only: the monthly inflation composed, month by month",
    "items": {
     "additionalProperties": false,
     "properties": {
      "change_pct": {
       "description": "Monthly inflation applied for that month",
       "type": "number"
      },
      "month": {
       "description": "YYYY-MM",
       "type": "string"
      },
      "status": {
       "enum": [
        "published",
        "projected"
       ],
       "type": "string"
      }
     },
     "required": [
      "month",
      "change_pct",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "to": {
    "description": "YYYY-MM",
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "attribution",
   "index",
   "index_name",
   "key",
   "source",
   "url",
   "amount",
   "from",
   "to",
   "adjusted_amount",
   "factor",
   "change_pct",
   "published_through",
   "projected_months",
   "note"
  ],
  "type": "object"
 },
 "title": "Adjust an amount in pesos for inflation"
}
