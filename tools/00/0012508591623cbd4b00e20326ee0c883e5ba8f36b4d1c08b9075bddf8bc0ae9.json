{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Answer a question about a named destination from its published FAQs; omit query to read them all.",
 "inputSchema": {
  "properties": {
   "cursor": {
    "default": 0,
    "description": "Number of items to skip; pass `next_cursor` from the previous page.",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "destination": {
    "description": "Destination name or slug, e.g. 'Los Cabos'; list_cities names them.",
    "maxLength": 256,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of items to return.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "default": null,
    "description": "Text to match in question/answer.",
    "maxLength": 256,
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "destination"
  ],
  "type": "object"
 },
 "name": "destination_faq",
 "outputSchema": {
  "additionalProperties": false,
  "description": "The Yenta response envelope: a status, the answer in `item` or `items`, and the approved content revision it was read from.",
  "properties": {
   "item": {
    "type": [
     "object",
     "null"
    ]
   },
   "items": {
    "type": [
     "array",
     "null"
    ]
   },
   "pagination": {
    "type": [
     "object",
     "null"
    ]
   },
   "reason": {
    "type": [
     "string",
     "null"
    ]
   },
   "sample": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "source": {
    "type": "object"
   },
   "status": {
    "enum": [
     "ok",
     "not_available",
     "validation_error"
    ],
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "title": "Destination FAQ by name"
}
