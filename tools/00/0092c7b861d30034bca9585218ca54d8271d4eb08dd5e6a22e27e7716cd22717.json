{
 "description": "Update order metadata: customer email, internal notes, shipment tracking, PO number and delivery address. Only provided fields change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customerEmail": {
    "type": "string"
   },
   "notes": {
    "description": "Internal note, never shown to the buyer",
    "type": "string"
   },
   "orderId": {
    "minLength": 1,
    "type": "string"
   },
   "poNumber": {
    "description": "Buyer's purchase-order reference",
    "type": "string"
   },
   "shippingAddress": {
    "description": "Correct the delivery address; omitted leaves it unchanged",
    "properties": {
     "city": {
      "minLength": 1,
      "type": "string"
     },
     "company": {
      "type": "string"
     },
     "country": {
      "description": "ISO 3166-1 alpha-2 country code",
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "line1": {
      "minLength": 1,
      "type": "string"
     },
     "line2": {
      "type": "string"
     },
     "name": {
      "minLength": 1,
      "type": "string"
     },
     "phone": {
      "type": "string"
     },
     "postalCode": {
      "minLength": 1,
      "type": "string"
     },
     "region": {
      "type": "string"
     },
     "vatId": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "line1",
     "postalCode",
     "city",
     "country"
    ],
    "type": "object"
   },
   "trackingCarrier": {
    "type": "string"
   },
   "trackingNumber": {
    "type": "string"
   }
  },
  "required": [
   "orderId"
  ],
  "type": "object"
 },
 "name": "update_order_details"
}
