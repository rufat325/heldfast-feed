{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return declared provenance plus timestamped bounded conformance and reliability observations. Evidence is not trust, safety, quality, or endorsement.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cursor": {
    "maxLength": 512,
    "type": "string"
   },
   "id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "subject_type": {
    "enum": [
     "organic",
     "sponsored"
    ],
    "type": "string"
   }
  },
  "required": [
   "subject_type",
   "id"
  ],
  "type": "object"
 },
 "name": "get_evidence_history",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {}
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Get resource evidence history"
}
