{
 "_meta": {
  "openai/ui": {
   "entrypoints": [
    {
     "extensions": [
      ".tldr"
     ],
     "type": "file"
    }
   ]
  },
  "ui": {
   "resourceUri": "ui://codex-tldraw/board.html"
  },
  "ui/resourceUri": "ui://codex-tldraw/board.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Opens a .tldr file in an interactive tldraw editor.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "file": {
    "properties": {
     "name": {
      "minLength": 1,
      "type": "string"
     },
     "resourceUri": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "name",
     "resourceUri"
    ],
    "type": "object"
   }
  },
  "required": [
   "file"
  ],
  "type": "object"
 },
 "name": "open_tldraw_file",
 "title": "Open tldraw board"
}
