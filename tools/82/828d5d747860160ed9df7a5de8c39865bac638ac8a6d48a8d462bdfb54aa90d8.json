{
 "annotations": {},
 "description": "Update an existing transaction by ID. Only the fields supplied are changed. Card identity and type (BUY/SELL) cannot be changed via this endpoint - delete and re-create instead. Requires IWMM_API_KEY.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "date": {
    "type": "string"
   },
   "fees": {
    "minimum": 0,
    "type": "number"
   },
   "id": {
    "description": "Transaction ID from list_transactions.",
    "minimum": 1,
    "type": "integer"
   },
   "notes": {
    "type": "string"
   },
   "pricePerUnit": {
    "minimum": 0,
    "type": "number"
   },
   "quantity": {
    "minimum": 1,
    "type": "integer"
   },
   "source": {
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_transaction"
}
