{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Pr\u00e9pare uniquement un lien priv\u00e9 vers FiltreCharbon.com. Ne cr\u00e9e aucune commande et ne r\u00e9alise aucun paiement. Client coordinates are optional: obtain explicit user consent before passing them. The link contains personal data in its fragment; show it only to that user, never publish it. The user reviews product and address on the site and confirms payment themselves. Do not submit card data. Supports France and Belgium.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "client": {
    "additionalProperties": false,
    "properties": {
     "adresse": {
      "maxLength": 128,
      "type": "string"
     },
     "cp": {
      "maxLength": 12,
      "type": "string"
     },
     "email": {
      "format": "email",
      "maxLength": 128,
      "type": "string"
     },
     "nom": {
      "maxLength": 64,
      "type": "string"
     },
     "pays": {
      "enum": [
       "FR",
       "BE"
      ],
      "type": "string"
     },
     "prenom": {
      "maxLength": 64,
      "type": "string"
     },
     "tel": {
      "maxLength": 32,
      "type": "string"
     },
     "ville": {
      "maxLength": 64,
      "type": "string"
     }
    },
    "required": [
     "prenom",
     "nom",
     "email",
     "adresse",
     "cp",
     "ville",
     "pays"
    ],
    "type": "object"
   },
   "consentement_coordonnees": {
    "default": false,
    "type": "boolean"
   },
   "fc_ref": {
    "pattern": "^(?:FC|FV|FW)\\d{1,3}$",
    "type": "string"
   },
   "id_product": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "qte": {
    "default": 1,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "src": {
    "default": "autre",
    "enum": [
     "chatgpt",
     "claude",
     "gemini",
     "perplexity",
     "copilot",
     "autre"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "preparer_commande",
 "title": "Pr\u00e9parer un lien / Prepare checkout link"
}
