{
 "description": "Render a JavaScript SPA page and extract its content as LLM-ready Markdown. Uses a headless browser to execute JavaScript, then extracts the main article content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cookies": {
    "description": "Cookies to inject before page load (e.g., session tokens)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "domain": {
       "description": "Cookie domain (auto-inferred from URL if omitted)",
       "type": "string"
      },
      "expires": {
       "description": "Expiration timestamp",
       "type": "number"
      },
      "httpOnly": {
       "description": "HttpOnly flag",
       "type": "boolean"
      },
      "name": {
       "description": "Cookie name",
       "minLength": 1,
       "type": "string"
      },
      "path": {
       "description": "Cookie path (default: '/')",
       "type": "string"
      },
      "sameSite": {
       "description": "SameSite attribute",
       "enum": [
        "Strict",
        "Lax",
        "None"
       ],
       "type": "string"
      },
      "secure": {
       "description": "Secure flag",
       "type": "boolean"
      },
      "value": {
       "description": "Cookie value",
       "type": "string"
      }
     },
     "required": [
      "name",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "headers": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Custom HTTP headers (e.g., Authorization)",
    "type": "object"
   },
   "includeMetadata": {
    "description": "Include title/author/excerpt as YAML frontmatter (default: true)",
    "type": "boolean"
   },
   "url": {
    "description": "The URL of the SPA page to read",
    "format": "uri",
    "type": "string"
   },
   "waitForSelector": {
    "description": "CSS selector to wait for before extraction",
    "type": "string"
   },
   "waitTimeout": {
    "description": "Navigation timeout in ms (default: 30000)",
    "maximum": 120000,
    "minimum": 1000,
    "type": "number"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "spa_read"
}
