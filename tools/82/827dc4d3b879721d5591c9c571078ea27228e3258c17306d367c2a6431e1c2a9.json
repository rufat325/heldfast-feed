{
 "description": "Add keywords to a Google Ads ad group with specified match types",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ad_group_id": {
    "description": "Ad group ID",
    "type": "string"
   },
   "customer_id": {
    "description": "Google Ads customer/account ID",
    "type": "string"
   },
   "keywords": {
    "description": "Keywords to add",
    "items": {
     "additionalProperties": false,
     "properties": {
      "matchType": {
       "description": "Match type",
       "enum": [
        "BROAD",
        "PHRASE",
        "EXACT"
       ],
       "type": "string"
      },
      "text": {
       "description": "Keyword text",
       "type": "string"
      }
     },
     "required": [
      "text",
      "matchType"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "customer_id",
   "ad_group_id",
   "keywords"
  ],
  "type": "object"
 },
 "name": "google_ads_add_keywords"
}
