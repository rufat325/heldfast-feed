{"_meta":{"openai/outputTemplate":"ui://siteverdict/score-card-v1.html","openai/toolInvocation/invoked":"Audit ready","openai/toolInvocation/invoking":"Auditing the website\u2026","openai/widgetAccessible":false,"securitySchemes":[{"scopes":["siteverdict.tools"],"type":"oauth2"},{"type":"noauth"}],"ui":{"resourceUri":"ui://siteverdict/score-card-v1.html"}},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":true,"title":"Full website audit"},"description":"Runs the tracking & consent, speed & revenue, accessibility (WCAG 2.2), domain/email health and AI-search readiness checks IN PARALLEL on one website, then merges them into an overall score, an executive summary and a single fix list ranked by severity, legal/revenue impact and effort. Best first call for \"audit my website\" or \"what should I fix first\". Partial results are returned if one check fails. Starts one Apify run per check on the caller's Apify account (pay-per-event).","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"checks":{"default":["tracking_consent","speed_revenue","accessibility","domain_email","ai_search"],"description":"Which checks to run (default: all five). domain_email uses the URL's domain.","items":{"enum":["tracking_consent","speed_revenue","accessibility","domain_email","ai_search"],"type":"string"},"maxItems":5,"minItems":1,"type":"array"},"device":{"default":"mobile","description":"Emulated device for the speed and UX checks; Google ranks on mobile.","enum":["mobile","desktop"],"type":"string"},"maxCostUsd":{"description":"Total spend cap across all runs on YOUR Apify account (split evenly per check). Default: $2 per check.","maximum":100,"minimum":0.05,"type":"number"},"maxPages":{"default":3,"description":"Pages per crawler-based check (keeps cost and time down).","maximum":10,"minimum":1,"type":"integer"},"url":{"description":"Public website URL, e.g. \"https://example.com\" (https:// is added if