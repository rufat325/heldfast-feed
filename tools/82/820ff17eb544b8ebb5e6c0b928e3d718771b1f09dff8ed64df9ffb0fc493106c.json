{
 "description": "List recent SMS messages sent from this account.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 50,
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "since": {
    "description": "ISO-8601 cutoff",
    "format": "date-time",
    "type": "string"
   },
   "status": {
    "enum": [
     "queued",
     "sent",
     "delivered",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_sms"
}
