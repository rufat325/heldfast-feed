{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Apply an agent team"
 },
 "description": "Without sign-in: apply a zero-cost Team manifest or template as unclaimed agents with their team connections. Returns agent ids, Agent Card URLs, enrollment codes and one claim_token for the whole team.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "expected_team_hash": {
    "description": "team_hash from city_plan_team; apply is refused if the plan changed.",
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Stable caller-chosen key; retry with the same key and unchanged arguments.",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "manifest": {
    "additionalProperties": {},
    "description": "A centralcity.agent/v1 manifest (kind Agent or Team). See docs/AGENT_MANIFEST.md; list templates with city_list_templates.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "parent_agent_id": {
    "description": "Optional existing agent to create under (lineage for cascade revoke). Not available anonymously.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "template": {
    "description": "Built-in template reference, for example template:research-team@1.0.0.",
    "maxLength": 128,
    "pattern": "^template:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?@\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$",
    "type": "string"
   }
  },
  "required": [
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "city_apply_team",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "agents": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "create",
        "update",
        "noop"
       ],
       "type": "string"
      },
      "agent_card_url": {
       "type": "string"
      },
      "agent_id": {
       "type": "string"
      },
      "capability": {
       "type": "string"
      },
      "depth": {
       "type": "number"
      },
      "display_name": {
       "type": "string"
      },
      "enrollment": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "agent_id": {
           "type": "string"
          },
          "endpoint": {
           "type": "string"
          },
          "enrollment_code": {
           "type": "string"
          },
          "expires_at": {
           "type": "string"
          },
          "single_use": {
           "const": true,
           "type": "boolean"
          }
         },
         "required": [
          "enrollment_code",
          "agent_id",
          "endpoint",
          "expires_at",
          "single_use"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "manifest_hash": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "parent_agent_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "revision": {
       "type": [
        "number",
        "null"
       ]
      },
      "runtime_mode": {
       "enum": [
        "hosted",
        "external"
       ],
       "type": "string"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "agent_id",
      "action",
      "display_name",
      "runtime_mode",
      "capability",
      "manifest_hash",
      "revision",
      "parent_agent_id",
      "depth",
      "status",
      "agent_card_url",
      "enrollment"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "claim": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "agent_ids": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "claim_token": {
        "type": "string"
       },
       "claim_url": {
        "type": "string"
       },
       "endpoint": {
        "type": "string"
       },
       "single_use": {
        "const": true,
        "type": "boolean"
       }
      },
      "required": [
       "claim_token",
       "claim_url",
       "endpoint",
       "agent_ids",
       "single_use"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "connections": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "create",
        "noop"
       ],
       "type": "string"
      },
      "connection_id": {
       "type": "string"
      },
      "from": {
       "type": "string"
      },
      "to": {
       "type": "string"
      }
     },
     "required": [
      "from",
      "to",
      "connection_id",
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "mode": {
    "enum": [
     "owned",
     "unclaimed"
    ],
    "type": "string"
   },
   "next_actions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "secrets_already_issued": {
    "type": "boolean"
   },
   "team_hash": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "mode",
   "team_hash",
   "agents",
   "connections",
   "claim",
   "secrets_already_issued",
   "next_actions"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Apply an agent team"
}
