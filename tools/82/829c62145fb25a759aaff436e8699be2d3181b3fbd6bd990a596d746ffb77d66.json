 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Model"
 },
 "description": "Add a glTF or GLB model at geographic coordinates. Returns { success: boolean, data?: unknown, message?: string, error?: string }.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "heading": {
    "default": 0,
    "description": "Heading angle (degrees), 0=North",
    "type": "number"
   },
   "height": {
    "default": 0,
    "description": "Placement height (meters)",
    "maximum": 50000000,
    "minimum": -12000,
    "type": "number"
   },
   "label": {
    "description": "Model label text",
    "maxLength": 200,
    "type": "string"
   },
   "latitude": {
    "description": "Latitude (-90 to 90)",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "description": "Longitude (-180 to 180)",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "pitch": {
    "default": 0,
    "description": "Pitch angle (degrees)",
    "type": "number"
   },
   "roll": {
    "default": 0,
    "description": "Roll angle (degrees)",
    "type": "number"
   },
   "scale": {
    "default": 1,
    "description": "Model scale factor",
    "exclusiveMinimum": 0,
    "maximum": 100000,
