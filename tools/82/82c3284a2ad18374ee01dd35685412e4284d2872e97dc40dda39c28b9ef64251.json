  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "index": {
    "description": "0-based index of the block to remove",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "postId": {
    "description": "The post ID",
    "type": "string"
   }
  },
  "required": [
   "postId",
   "index"
  ],
  "type": "object"
 },
 "name": "remove_post_block",
