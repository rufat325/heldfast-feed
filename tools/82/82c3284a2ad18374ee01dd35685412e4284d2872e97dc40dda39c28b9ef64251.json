  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Remove Post Block"
 },
 "description": "Remove the block at the given index (0-based). All subsequent blocks shift up by one.",
 "execution": {
  "taskSupport": "forbidden"
 },
