{
 "description": "Update the display order of fields within a collection",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collection_slug": {
    "description": "The collection slug",
    "type": "string"
   },
   "fields": {
    "description": "Array of { uuid, order } objects",
    "items": {
     "properties": {
      "order": {
       "description": "New display order (0-based)",
       "type": "number"
      },
      "uuid": {
       "description": "Field UUID",
       "type": "string"
      }
     },
     "required": [
      "uuid",
      "order"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "collection_slug",
   "fields"
  ],
  "type": "object"
 },
 "name": "reorder_fields",
 "title": "Reorder Fields"
}
