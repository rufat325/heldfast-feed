{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true,
  "title": "Generate PDF"
 },
 "description": "Render the current page as a PDF document.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "landscape": {
    "description": "Landscape orientation (default false)",
    "type": [
     "boolean",
     "null"
    ]
   },
   "print_background": {
    "description": "Print background graphics (default false)",
    "type": [
     "boolean",
     "null"
    ]
   },
   "scale": {
    "anyOf": [
     {
      "maximum": 2,
      "minimum": 0.1,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Page scale factor (default 1)"
   },
   "session_id": {
    "description": "Session ID returned by browser_navigate",
    "type": "string"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "browser_generate_pdf"
}
