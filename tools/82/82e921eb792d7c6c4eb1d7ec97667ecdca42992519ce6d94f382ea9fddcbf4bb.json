{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Tracking and consent"
 },
 "description": "Whether analytics and consent are set up right, and whether the numbers add up. Pick with mode: ga4 = GA4 tags, events and duplicates. Needs url. consent = Cookie banner and Consent Mode v2. Needs url. gsc_vs_ga4 = Search Console clicks against GA4 sessions per page: broken or filtered tracking. Needs gsc[{page, clicks}], ga4[{landing_page, sessions}].",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "detail": {
    "description": "brief = short summary.",
    "enum": [
     "full",
     "brief"
    ],
    "type": "string"
   },
   "ga4": {
    "description": "GA4 sessions per landing page, organic Google only.",
    "items": {
     "properties": {
      "landing_page": {
       "maxLength": 2000,
       "type": "string"
      },
      "sessions": {
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "landing_page",
      "sessions"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "minItems": 1,
    "type": "array"
   },
   "gsc": {
    "description": "Search Console clicks per page.",
    "items": {
     "properties": {
      "clicks": {
       "minimum": 0,
       "type": "number"
      },
      "page": {
       "maxLength": 2048,
       "type": "string"
      }
     },
     "required": [
      "page",
      "clicks"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "minItems": 1,
    "type": "array"
   },
   "memory_key": {
    "description": "site_memory key, records this call.",
    "maxLength": 80,
    "type": "string"
   },
   "mode": {
    "description": "Default ga4.",
    "enum": [
     "ga4",
     "consent",
     "gsc_vs_ga4"
    ],
    "type": "string"
   },
   "url": {
    "description": "Full address of the page, for example https://example.com/.",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tracking",
 "outputSchema": {
  "type": "object"
 },
 "title": "Tracking and consent"
}
