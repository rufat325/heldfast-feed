{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a defect from a test failure with the context written into it; `title`, `actual_result` and `severity` are required. The API has no way to attach runs or results to a defect \u2014 reference them in actual_result. For a defect unrelated to a failure use qase_defect_upsert. Cost: one API call, about 0.5s; file one defect per distinct cause.",
 "inputSchema": {
  "properties": {
   "actual_result": {
    "description": "Observed behavior. Required by the API",
    "type": "string"
   },
   "attachments": {
    "description": "Hashes from qase_attachment_upload",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "code": {
    "description": "Project code, e.g. DEMO",
    "maxLength": 10,
    "minLength": 2,
    "pattern": "^[A-Z0-9_]+$",
    "type": "string"
   },
   "custom_field": {
    "additionalProperties": {},
    "description": "Custom fields by ID, e.g. { \"12\": \"value\" }",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "description": {
    "description": "Extra context beyond the observed behavior",
    "type": "string"
   },
   "severity": {
    "description": "Required by the API",
    "enum": [
     "undefined",
     "blocker",
     "critical",
     "major",
     "normal",
     "minor",
     "trivial"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Tag names, e.g. [\"regression\", \"payments\"]",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Defect title",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "code",
   "title",
   "severity",
   "actual_result"
  ],
  "type": "object"
 },
 "name": "qase_triage_defect",
 "title": "Triage failure into defect"
}
