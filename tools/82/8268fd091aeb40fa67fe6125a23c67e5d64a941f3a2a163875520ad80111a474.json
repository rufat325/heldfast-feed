{
 "_meta": {
  "spellbook.finance/limitations": [
   "Only selector, marketplace scope, absolute multiplier and optional protected band are exposed.",
   "Creation does not publish or trigger repricing. Use preview to inspect bounded customer impacts.",
   "The server retains demand behavior; this tool cannot choose or expose it."
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create a seller pricing amendment"
 },
 "description": "Create one bounded seller pricing amendment from a selector, marketplace scope, absolute multiplier and optional protected band. Returns saved readback. The server retains its adaptive default internally; this tool has no demand behavior input and does not publish or reprice.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "enabled": {
    "default": true,
    "description": "Whether the amendment starts enabled. Omit for enabled.",
    "type": "boolean"
   },
   "marketplaceScope": {
    "anyOf": [
     {
      "const": "all",
      "description": "Apply across all supported marketplaces.",
      "type": "string"
     },
     {
      "additionalProperties": false,
      "properties": {
       "channels": {
        "description": "Specific marketplace channels for this amendment.",
        "items": {
         "enum": [
          "ebay",
          "tcg",
          "manapool",
          "shopify",
          "cardtrader"
         ],
         "type": "string"
        },
        "maxItems": 5,
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "channels"
      ],
      "type": "object"
     }
    ],
    "description": "Marketplace scope. Required."
   },
   "mode": {
    "additionalProperties": false,
    "description": "Absolute multiplier and optional protected band. Required.",
    "properties": {
     "multiplier": {
      "description": "Absolute multiplier applied by this amendment. Required.",
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "protectedBand": {
      "additionalProperties": false,
      "description": "Optional seller-approved protected band.",
      "properties": {
       "multiplier": {
        "description": "Protected multiplier at or above the threshold.",
        "exclusiveMinimum": 0,
        "type": "number"
       },
       "thresholdUsd": {
        "description": "Original market anchor threshold in USD.",
        "exclusiveMinimum": 0,
        "type": "number"
       }
      },
      "required": [
       "thresholdUsd",
       "multiplier"
      ],
      "type": "object"
     }
    },
    "required": [
     "multiplier"
    ],
    "type": "object"
   },
   "name": {
    "description": "Seller-selected amendment name. Required.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "anyOf": [
     {
      "maxLength": 1000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Optional seller notes; null clears notes."
   },
   "priority": {
    "description": "Seller-selected precedence priority. Required.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "selector": {
    "additionalProperties": false,
    "description": "The bounded inventory selector. Required.",
    "properties": {
     "condition": {
      "description": "Optional condition selector.",
      "enum": [
       "NM",
       "LP",
       "MP",
       "HP",
       "DMG"
      ],
      "type": "string"
     },
     "finish": {
      "description": "Optional finish selector.",
      "enum": [
       "nf",
       "fo",
       "etched",
       "surge",
       "rh",
       "1e",
       "1e-fo"
      ],
      "type": "string"
     },
     "originalAnchorPriceBand": {
      "additionalProperties": false,
      "description": "Optional original market anchor band selector.",
      "properties": {
       "maxUsd": {
        "description": "Protected band upper bound in USD.",
        "minimum": 0,
        "type": "number"
       },
       "minUsd": {
        "description": "Protected band lower bound in USD.",
        "minimum": 0,
        "type": "number"
       }
      },
      "type": "object"
     },
     "releaseFamilyCode": {
      "description": "Release family selector.",
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
     },
     "scryfallId": {
      "description": "Exact Scryfall printing selector. Requires setCode when supplied.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "setCode": {
      "description": "Set code selector.",
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "workspaceId": {
    "description": "The workspace the seller selected. The caller must own it. Required.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "workspaceId",
   "name",
   "priority",
   "selector",
   "marketplaceScope",
   "mode"
  ],
  "type": "object"
 },
 "name": "spellbook_pricing_amendment_create"
}
