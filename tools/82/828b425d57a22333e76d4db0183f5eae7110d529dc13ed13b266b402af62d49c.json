{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List static DNS entries on a MikroTik router with optional filtering by name and type.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 100,
    "description": "Max results to return.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Filter by hostname (partial match)",
    "type": "string"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset.",
    "minimum": 0,
    "type": "integer"
   },
   "routerId": {
    "description": "Router ID; omit to use the default router.",
    "type": "string"
   },
   "type": {
    "default": "all",
    "description": "Filter by record type",
    "enum": [
     "A",
     "CNAME",
     "TXT",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_dns_entries",
 "title": "List DNS Entries"
}
