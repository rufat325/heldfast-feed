    "type": "string"
   },
   "is_favorite": {
    "description": "Whether the tag is a favorite",
    "type": "boolean"
   },
   "name": {
    "description": "Tag name",
    "type": "string"
   },
   "view_mode": {
    "description": "View mode for the tag page",
    "type": "string"
   }
