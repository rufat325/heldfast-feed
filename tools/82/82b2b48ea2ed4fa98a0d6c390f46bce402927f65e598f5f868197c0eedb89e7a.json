{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read queue metadata and pending, claimed, completed and failed counts using the read token. Does not list payloads, disclose role tokens or extend the fixed expiry.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "queue_id": {
    "pattern": "^[a-f0-9]{32}$",
    "type": "string"
   },
   "read_token": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "queue_id",
   "read_token"
  ],
  "type": "object"
 },
 "name": "read_agent_queue",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "counts": {
    "additionalProperties": false,
    "properties": {
     "claimed": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     },
     "completed": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     },
     "failed": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     },
     "pending": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     },
     "total": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "pending",
     "claimed",
     "completed",
     "failed",
     "total"
    ],
    "type": "object"
   },
   "created_at_timestamp": {
    "type": "integer"
   },
   "expire_timestamp": {
    "type": "integer"
   },
   "ok": {
    "type": "boolean"
   },
   "queue_id": {
    "pattern": "^[a-f0-9]{32}$",
    "type": "string"
   }
  },
  "required": [
   "ok",
   "queue_id",
   "created_at_timestamp",
   "expire_timestamp",
   "counts"
  ],
  "type": "object"
 },
 "title": "Read agent queue"
}
