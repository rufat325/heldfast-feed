 "description": "Fetch observations from a dataset/edition/version. Pass dimension filters as `dimensions` map ({\"geography\": \"K02000001\", \"time\": \"2023\"}). Use `*` for \"all values\" within a dimension.",
 "inputSchema": {
  "examples": [
   {
    "dataset_id": "cpih01",
    "dimensions": {
     "geography": "K02000001",
     "time": "2023"
    },
    "edition": "time-series",
    "version": "1"
   },
   {
    "dataset_id": "ashe-table-1",
    "dimensions": {
     "geography": "*",
     "time": "2023"
    },
    "edition": "annual",
    "version": "2"
   }
  ],
  "properties": {
   "dataset_id": {
    "description": "ONS dataset ID",
    "type": "string"
   },
   "dimensions": {
    "description": "Dimension code \u2192 value (or \"*\" for all). Example: {\"geography\":\"K02000001\",\"time\":\"2023\"}.",
    "type": "object"
   },
   "edition": {
    "description": "Edition label",
    "type": "string"
   },
   "version": {
    "description": "Version",
    "type": "string"
   }
  },
  "required": [
   "dataset_id",
   "edition",
   "version",
   "dimensions"
  ],
  "type": "object"
 },
 "name": "get_observations",
