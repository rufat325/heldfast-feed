{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Get listing"},"description":"Use this when the user asks about one particular listing \u2014 its description, photos or features \u2014 or shares a new.estate listing link. Full details of one listing published on new.estate: description, photos, features and every characteristic shown on the listing page, including country-specific fields, named in the requested language. Takes a listing id from search_listings or the URL of a listing page. Contact details are not returned; the advertiser can be contacted on the listing page.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"id":{"description":"Listing id from a search result, or the listing page URL.","maxLength":400,"minLength":1,"type":"string"},"locale":{"default":"en-US","description":"Language of names, titles, descriptions and listing URLs, e.g. en-US, pl-PL, de-DE.","enum":["en-US","en-GB","en-AU","en-CA","en-IE","en-NZ","pl-PL","cs-CZ","sk-SK","hr-HR","sr-RS","sl-SI","bg-BG","fr-FR","fr-CH","fr-BE","fr-CA","de-DE","de-AT","de-CH","es-ES","es-MX","es-AR","es-CO","es-CL","it-IT","ro-RO","nl-NL","nl-BE","sv-SE","da-DK","nb-NO","is-IS","fi-FI","hu-HU","el-GR","lt-LT","lv-LV","et-EE","uk-UA","pt-PT","pt-BR"],"type":"string"}},"required":["id"],"type":"object"},"name":"get_listing","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"agency":{"anyOf":[{"additionalProperties":false,"properties":{"name":{"type":"string"}},"required":["name"],"type":"object"},{"type":"null"}]},"area":{"anyOf":[{"additionalProperties":false,"properties":{"unit":{"type":"string"},"value":{"type":"number"}},"required":["value","unit"],"type":"object"},{"type":"null"}]},"attributes":{"description":"All characteristics shown on the listing page, including country-specific fields, as label \u2192 v