    "type": "boolean"
   },
   "max_findings": {
    "description": "Cap the number of findings returned to protect agent context (default: 200).",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "path": {
    "description": "Absolute path to the repository or directory to scan.",
    "type": "string"
   },
   "scanners": {
    "description": "Limit which scanner classes run: sast, secret, vuln, misconfig, license, ai. Default: all.",
    "items": {
     "enum": [
      "sast",
      "secret",
      "vuln",
      "misconfig",
      "license",
      "ai"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "severity_threshold": {
    "description": "Only return findings at or above this severity (default: info \u2014 all).",
    "enum": [
     "critical",
     "high",
     "medium",
     "low",
     "info"
    ],
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
