{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Compare"
 },
 "description": "Compare pages side by side. Pick with mode: pages = Your page against up to 3 competitors. Needs url, competitors. html = Two versions of HTML before and after. Needs before, after. preview = Deploy preview against production before merging. Needs preview_url, production_url.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "HTML after the change.",
    "maxLength": 921600,
    "type": "string"
   },
   "before": {
    "description": "HTML before the change.",
    "maxLength": 921600,
    "type": "string"
   },
   "bypass_token": {
    "description": "Vercel protection bypass secret.",
    "maxLength": 200,
    "type": "string"
   },
   "competitors": {
    "description": "Competitor page addresses.",
    "items": {
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "detail": {
    "description": "brief = short summary.",
    "enum": [
     "full",
     "brief"
    ],
    "type": "string"
   },
   "keyword": {
    "description": "Optional search term to compare keyword use.",
    "maxLength": 2000,
    "type": "string"
   },
   "memory_key": {
    "description": "site_memory key, records this call.",
    "maxLength": 80,
    "type": "string"
   },
   "mode": {
    "description": "Default pages.",
    "enum": [
     "pages",
     "html",
     "preview"
    ],
    "type": "string"
   },
   "paths": {
    "description": "Paths like /pricing, default /.",
    "items": {
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "preview_url": {
    "description": "The deploy preview URL.",
    "maxLength": 2048,
    "type": "string"
   },
   "production_url": {
    "description": "The live site.",
    "maxLength": 2048,
    "type": "string"
   },
   "url": {
    "description": "Full address, for example https://example.com.",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "compare",
 "outputSchema": {
  "type": "object"
 },
 "title": "Compare"
}
