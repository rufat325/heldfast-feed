{
 "description": "Convert an image between JPEG, PNG, WebP, and AVIF formats. Requires base64-encoded image input.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "image_base64": {
    "description": "Base64-encoded image file",
    "type": "string"
   },
   "quality": {
    "description": "Output quality (1-100)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "to": {
    "description": "Target format",
    "enum": [
     "jpeg",
     "png",
     "webp",
     "avif"
    ],
    "type": "string"
   }
  },
  "required": [
   "image_base64",
   "to"
  ],
  "type": "object"
 },
 "name": "bytario_image_convert"
}
