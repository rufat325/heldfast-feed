{
 "description": "Browse the Acta public record. List topics (optionally filtered), get entries for a topic (with type/state filters), or look up a single entry with its responses.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "list_topics: browse topics. feed: entries for a topic. entry: single entry with responses.",
    "enum": [
     "list_topics",
     "feed",
     "entry"
    ],
    "type": "string"
   },
   "entry_id": {
    "description": "Entry ID (required for entry action)",
    "type": "string"
   },
   "q": {
    "description": "Filter topic names by substring (for list_topics)",
    "type": "string"
   },
   "state": {
    "description": "Filter feed by computed state",
    "enum": [
     "open",
     "contested",
     "superseded",
     "resolved",
     "supported"
    ],
    "type": "string"
   },
   "topic": {
    "description": "Topic slug (required for feed action)",
    "type": "string"
   },
   "type": {
    "description": "Filter feed by contribution type",
    "enum": [
     "question",
     "claim",
     "prediction"
    ],
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "acta_query"
}
