{
 "description": "Create or update a request inside a collection (matched by name). The collection is created if it doesn't exist. Optionally nest it under a folder path.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "collection": {
    "description": "Collection name or id. Created if missing.",
    "type": "string"
   },
   "folderPath": {
    "description": "Folder path, e.g. [\"Auth\",\"JWT\"]. Created as needed.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "request": {
    "additionalProperties": false,
    "properties": {
     "auth": {
      "additionalProperties": false,
      "properties": {
       "apikey": {
        "additionalProperties": false,
        "properties": {
         "addTo": {
          "enum": [
           "header",
           "query"
          ],
          "type": "string"
         },
         "key": {
          "type": "string"
         },
         "value": {
          "type": "string"
         }
        },
        "required": [
         "key",
         "value",
         "addTo"
        ],
        "type": "object"
       },
       "basic": {
        "additionalProperties": false,
        "properties": {
         "password": {
          "type": "string"
         },
         "username": {
          "type": "string"
         }
        },
        "required": [
         "username",
         "password"
        ],
        "type": "object"
       },
       "bearer": {
        "additionalProperties": false,
        "properties": {
         "token": {
          "type": "string"
         }
        },
        "required": [
         "token"
        ],
        "type": "object"
       },
       "type": {
        "enum": [
         "none",
         "bearer",
         "basic",
         "apikey"
        ],
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "type": "object"
     },
     "body": {
      "type": "string"
     },
     "bodyType": {
      "enum": [
       "json",
       "form",
       "text",
       "graphql",
       "multipart",
       "none"
      ],
      "type": "string"
     },
     "headers": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "method": {
      "enum": [
       "GET",
       "POST",
       "PUT",
       "PATCH",
       "DELETE",
       "OPTIONS",
       "HEAD"
      ],
      "type": "string"
     },
     "name": {
      "description": "Human-readable request name; also the upsert match key within a collection.",
      "type": "string"
     },
     "tests": {
      "description": "Assertions run automatically after send_request.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "expected": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "operator": {
         "enum": [
          "eq",
          "neq",
          "contains",
          "not_contains",
          "gt",
          "lt",
          "exists"
         ],
         "type": "string"
        },
        "property": {
         "type": "string"
        },
        "source": {
         "enum": [
          "status",
          "time",
          "body",
          "header",
          "jsonpath"
         ],
         "type": "string"
        }
       },
       "required": [
        "source",
        "operator",
        "expected"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "url": {
      "description": "Request URL. May contain {{variable}} placeholders resolved from the environment and collection.",
      "type": "string"
     }
    },
    "required": [
     "name",
     "method",
     "url"
    ],
    "type": "object"
   }
  },
  "required": [
   "collection",
   "request"
  ],
  "type": "object"
 },
 "name": "upsert_request"
}
