         "minimum": 0,
         "type": "number"
        },
        "basisAmount": {
         "description": "BT-93/BT-100: Grundbetrag des Prozentsatzes. Ohne Angabe die Summe der lineNetAmount aller Positionen mit ratePercent (bei gemischten Kategorien desselben Satzes nur die mit categoryCode).",
         "type": "number"
        },
        "categoryCode": {
