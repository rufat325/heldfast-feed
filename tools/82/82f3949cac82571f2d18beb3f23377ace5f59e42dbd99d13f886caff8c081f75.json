{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Use when the submitter provides a technical, operating, development, capital, software, or specialist capability. Registration is not Quiet Stance endorsement.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agent_source": {
    "maxLength": 80,
    "type": "string"
   },
   "consent": {
    "const": true,
    "type": "boolean"
   },
   "country_location": {
    "maxLength": 220,
    "minLength": 1,
    "type": "string"
   },
   "current_state": {
    "maxLength": 2200,
    "minLength": 2,
    "type": "string"
   },
   "estimated_value": {
    "maxLength": 120,
    "type": "string"
   },
   "evidence_note": {
    "maxLength": 1200,
    "type": "string"
   },
   "idempotency_key": {
    "description": "Recommended random retry key. Reuse only for retries of the exact same submission; it also acts as the private status token.",
    "maxLength": 200,
    "minLength": 32,
    "type": "string"
   },
   "name": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "maxLength": 1800,
    "type": "string"
   },
   "organization": {
    "maxLength": 240,
    "type": "string"
   },
   "signal_name": {
    "maxLength": 220,
    "minLength": 1,
    "type": "string"
   },
   "summary": {
    "maxLength": 3000,
    "minLength": 20,
    "type": "string"
   },
   "support_needed": {
    "maxLength": 300,
    "type": "string"
   },
   "work_email": {
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   }
  },
  "required": [
   "name",
   "work_email",
   "signal_name",
   "country_location",
   "summary",
   "current_state",
   "consent"
  ],
  "type": "object"
 },
 "name": "register_partner_capability",
 "title": "Register a qualified capability"
}
