 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get reliability"
 },
 "description": "How reliable a dashboard\u2019s services and URL monitors were over 7, 30 or 90 days: the least reliable first, with the share of time without a reported problem (minor issues count, so one long minor issue makes it low), time in each severity, incidents and recovery, and what tends to break together.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "dashboard": {
    "description": "A dashboard\u2019s name or id",
    "type": "string"
   },
   "days": {
    "anyOf": [
     {
      "const": 7,
      "type": "number"
     },
     {
      "const": 30,
      "type": "number"
     },
     {
      "const": 90,
      "type": "number"
     }
    ],
    "description": "7, 30 (the default) or 90"
   }
  },
  "required": [
   "dashboard"
  ],
  "type": "object"
 },
 "name": "get_reliability",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "breaksTogether": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "first": {
       "type": "string"
      },
      "followedBy": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "minutesLater": {
          "type": "number"
         },
         "name": {
          "type": "string"
         },
         "times": {
          "type": "number"
         }
        },
        "required": [
         "name",
         "times",
         "minutesLater"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "times": {
       "type": "number"
      }
     },
     "required": [
      "first",
      "times",
      "followedBy"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "dashboard": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "name"
    ],
    "type": "object"
   },
   "days": {
    "type": "number"
   },
   "medianRecoveryMinutes": {
    "type": [
     "number",
     "null"
    ]
   },
   "services": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "incidents": {
       "type": "number"
      },
      "kind": {
       "enum": [
        "service",
        "url"
       ],
       "type": "string"
      },
      "longestMinutes": {
       "type": "number"
      },
      "medianRecoveryMinutes": {
       "type": [
        "number",
        "null"
       ]
      },
      "minutesWithProblems": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "problemDays": {
       "additionalProperties": {
        "type": "number"
       },
       "description": "The UTC days the period touches, by their worst problem status",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "problemMinutes": {
       "additionalProperties": {
        "type": "number"
       },
       "description": "Minutes in each problem status, over the same period as uptime",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "slug": {
