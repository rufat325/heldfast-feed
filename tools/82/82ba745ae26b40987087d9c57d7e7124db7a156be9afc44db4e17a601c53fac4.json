{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Calculate four pillars. Unknown time returns no hour pillar. Gregorian date, IANA timezone, explicit day boundary. No prediction.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "dayBoundary": {
    "default": "midnight",
    "enum": [
     "midnight",
     "zi"
    ],
    "type": "string"
   },
   "locale": {
    "default": "en",
    "enum": [
     "zh",
     "en"
    ],
    "type": "string"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "solarTime": {
    "default": false,
    "type": "boolean"
   },
   "time": {
    "anyOf": [
     {
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "timezone": {
    "default": "Asia/Shanghai",
    "type": "string"
   }
  },
  "required": [
   "date"
  ],
  "type": "object"
 },
 "name": "calculate_bazi"
}
