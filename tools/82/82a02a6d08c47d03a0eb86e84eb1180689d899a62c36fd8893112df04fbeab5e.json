{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List all cards in a set, paginated. Supports the same filters as search_cards (rarity, type, format, legality).",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "description": "Set code.",
    "type": "string"
   },
   "format": {
    "enum": [
     "standard",
     "commander",
     "modern",
     "legacy",
     "vintage",
     "brawl",
     "explorer",
     "historic",
     "oathbreaker",
     "pauper",
     "pioneer"
    ],
    "type": "string"
   },
   "legality": {
    "enum": [
     "legal",
     "banned",
     "restricted"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "minimum": 1,
    "type": "integer"
   },
   "rarity": {
    "enum": [
     "common",
     "uncommon",
     "rare",
     "mythic"
    ],
    "type": "string"
   },
   "type": {
    "type": "string"
   }
  },
  "required": [
   "code"
  ],
  "type": "object"
 },
 "name": "list_set_cards"
}
