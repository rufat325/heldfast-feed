{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a Portkey API key for auth. Org keys grant broader access; workspace keys are scoped. WARNING: The key secret is returned ONCE in the tool result and will be visible in MCP transcripts and LLM context \u2014 store it securely immediately. Using the key grants access immediately according to its scopes, defaults, and limits. Workspace keys require workspace_id and user keys require user_id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "alert_emails": {
    "description": "Email addresses for alerts",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "alert_threshold": {
    "description": "Alert threshold percentage (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "credit_limit": {
    "description": "Credit limit for usage",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "default_allow_config_override": {
    "description": "Allow callers to override the default config",
    "type": "boolean"
   },
   "default_config_id": {
    "description": "Default configuration ID to use with this key",
    "type": "string"
   },
   "default_metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Default metadata key-value pairs",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "description": {
    "description": "Optional description for the key",
    "type": "string"
   },
   "expires_at": {
    "description": "Expiration date in ISO 8601 format",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "name": {
    "description": "Display name for the API key",
    "type": "string"
   },
   "organisation_id": {
    "description": "Organisation UUID",
    "type": "string"
   },
   "rate_limit_rpm": {
    "description": "Rate limit in requests per minute",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "rate_limits": {
    "anyOf": [
     {
      "items": {
       "properties": {
        "type": {
         "description": "Whether the limit counts requests or tokens",
         "enum": [
          "requests",
          "tokens"
         ],
         "type": "string"
        },
        "unit": {
         "description": "Rate window unit for the request or token count",
         "enum": [
          "rpd",
          "rph",
          "rpm",
          "rps",
          "rpw"
         ],
         "type": "string"
        },
        "value": {
         "description": "Maximum count in the selected rate window",
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "type",
        "unit",
        "value"
       ],
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "Request or token rate limits, or null to clear them"
   },
   "rotation_policy": {
    "anyOf": [
     {
      "description": "Automatic API-key rotation policy, or null to remove it",
      "properties": {
       "key_transition_period_ms": {
        "description": "Overlap in milliseconds before the previous key expires",
        "maximum": 9007199254740991,
        "minimum": 1800000,
        "type": "integer"
       },
       "next_rotation_at": {
        "anyOf": [
         {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "description": "Explicit next rotation timestamp in ISO 8601 format"
       },
       "rotation_period": {
        "anyOf": [
         {
          "enum": [
           "weekly",
           "monthly"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "description": "Built-in weekly or monthly automatic rotation cadence"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Automatic API-key rotation policy, or null to disable it"
   },
   "scopes": {
    "description": "Permission scopes for the key (e.g., ['logs.read', 'analytics.read'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sub_type": {
    "description": "Sub-type: 'user' for user-associated keys or 'service' for service accounts",
    "enum": [
     "user",
     "service"
    ],
    "type": "string"
   },
   "type": {
    "description": "Key type: 'organisation' for org-wide access or 'workspace' for workspace-scoped",
    "enum": [
     "organisation",
     "workspace"
    ],
    "type": "string"
   },
   "user_id": {
    "description": "User ID (required for user sub-type keys)",
    "type": "string"
   },
   "workspace_id": {
    "description": "Workspace ID (required for workspace-type keys)",
    "type": "string"
   }
  },
  "required": [
   "type",
   "sub_type",
   "name",
   "scopes"
  ],
  "type": "object"
 },
 "name": "create_api_key",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
