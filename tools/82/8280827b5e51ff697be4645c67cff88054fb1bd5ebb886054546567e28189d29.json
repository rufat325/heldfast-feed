{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the design-knowledge-base rules relevant to one step of designing a garden (brief / koncept / dispozicia / vysadba / materialy) \u2014 up to 20 rules, each with its predicate, numeric thresholds, strength (must/should/may), confidence tag, and cited sources. No garden scene is read or required; this is reference knowledge, not a check against a specific design. Deterministic: the same step always returns the same rule set.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "step": {
    "description": "Design process step to fetch rules for: brief, koncept, dispozicia, vysadba, materialy. Call this once per step you are working on \u2014 do not assume one step's rules cover another.",
    "enum": [
     "brief",
     "koncept",
     "dispozicia",
     "vysadba",
     "materialy"
    ],
    "type": "string"
   }
  },
  "required": [
   "step"
  ],
  "type": "object"
 },
 "name": "studio_design_rules",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "rules": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "area": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "legalNote": {
       "enum": [
        "not-law",
        "law-cz-only",
        "municipal-varies"
       ],
       "type": "string"
      },
      "module": {
       "type": "string"
      },
      "numbers": {
       "additionalProperties": {
        "type": "number"
       },
       "type": "object"
      },
      "sources": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "checkedAt": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "ref": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        },
        "required": [
         "name",
         "url",
         "checkedAt"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "strength": {
       "enum": [
        "must",
        "should",
        "may"
       ],
       "type": "string"
      },
      "tag": {
       "enum": [
        "measured",
        "cited",
        "expert",
        "opinion"
       ],
       "type": "string"
      },
      "textKey": {
       "type": "string"
      },
      "when": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "area",
      "strength",
      "tag",
      "when",
      "numbers",
      "textKey",
      "sources",
      "module"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "step": {
    "enum": [
     "brief",
     "koncept",
     "dispozicia",
     "vysadba",
     "materialy"
    ],
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "total": {
    "type": "number"
   },
   "truncated": {
    "type": "number"
   }
  },
  "required": [
   "step",
   "rules",
   "total",
   "truncated",
   "summary"
  ],
  "type": "object"
 },
 "title": "GridGarden garden-design rule book (by design step)"
}
