{
 "description": "HIGH RISK: attach a published agreement version to Project To-dos, creating one To-do per job and one signing request per recipient (future hires are added as they join when the audience includes them). Requires the receipt from opentrain_agreements_project_todos_attach_preflight, confirmLive: true and yes: true (refused before any request otherwise, reason CONFIRMATION_REQUIRED); any change since the preview (roster, version, request, rollout) fails PREFLIGHT_RECEIPT_STALE and nothing is attached. Receipt-backed: a replay of the same idempotencyKey returns the stored outcome. Requires agreements:write and project_todos:write. Requires the agreements family flag and the agreements_native rollout; denials carry details.reason (AGENT_SURFACE_DISABLED, AGREEMENTS_DISABLED, TENANT_ACCESS_DENIED).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "enum": [
     "ACTIVE",
     "FUTURE",
     "ACTIVE_AND_FUTURE",
     "SELECTED"
    ],
    "type": "string"
   },
   "blockingMode": {
    "default": "NONE",
    "enum": [
     "NONE",
     "IMMEDIATE",
     "AFTER_DUE"
    ],
    "type": "string"
   },
   "confirmLive": {
    "const": true,
    "type": "boolean"
   },
   "dueAt": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "idempotencyKey": {
    "description": "Durable-receipt idempotency key sent as the Idempotency-Key header. Same key + same payload replays the stored outcome (replayed: true); same key + a changed payload is a 409.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "jobIds": {
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "preflightReceipt": {
    "maxLength": 8192,
    "minLength": 16,
    "type": "string"
   },
   "selectedContractIds": {
    "default": [],
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "versionId": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "yes": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "versionId",
   "jobIds",
   "audience",
   "preflightReceipt",
   "confirmLive",
   "yes",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_agreements_project_todos_attach",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "const": "attach",
      "type": "string"
     },
     "failures": {
      "items": {
       "maxLength": 300,
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "includesFutureHires": {
      "type": "boolean"
     },
     "jobs": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "createdAssignments": {
         "minimum": 0,
         "type": "integer"
        },
        "failed": {
         "minimum": 0,
         "type": "integer"
        },
        "itemId": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "jobId": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "queued": {
         "minimum": 0,
         "type": "integer"
        },
        "requests": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "assignmentId": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
           },
           "contractId": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
           },
           "requestId": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
           },
           "status": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "requestId",
           "assignmentId",
           "contractId",
           "status"
          ],
          "type": "object"
         },
         "maxItems": 500,
         "type": "array"
        },
        "skippedExistingAssignments": {
         "minimum": 0,
         "type": "integer"
        },
        "todoVersionId": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "jobId",
        "itemId",
        "todoVersionId",
        "createdAssignments",
        "skippedExistingAssignments",
        "queued",
        "failed",
        "requests"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     "queuedCount": {
      "minimum": 0,
      "type": "integer"
     },
     "replayed": {
      "type": "boolean"
     },
     "versionId": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "action",
     "versionId",
     "includesFutureHires",
     "jobs",
     "queuedCount",
     "failures",
     "replayed"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
