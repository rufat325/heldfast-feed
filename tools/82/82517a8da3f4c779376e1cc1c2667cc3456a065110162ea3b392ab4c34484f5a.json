{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find products by natural language, SKU, MPN, GTIN, brand, price, shop or vehicle. Use for shopping and product comparison requests.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "brand": {
    "maxLength": 70,
    "type": "string"
   },
   "category_id": {
    "minimum": 1,
    "type": "integer"
   },
   "in_stock": {
    "default": true,
    "type": "boolean"
   },
   "lang": {
    "default": "es",
    "pattern": "^[a-z]{2}$",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "max_price": {
    "minimum": 0,
    "type": "number"
   },
   "min_price": {
    "minimum": 0,
    "type": "number"
   },
   "page": {
    "default": 1,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "pricing": {
    "default": "public",
    "description": "customer only works with a valid logged-in PrestaShop session. The server derives the group.",
    "enum": [
     "public",
     "customer"
    ],
    "type": "string"
   },
   "q": {
    "description": "Product query, reference or identifier.",
    "maxLength": 160,
    "type": "string"
   },
   "registration": {
    "maxLength": 16,
    "type": "string"
   },
   "shop": {
    "default": "tudetic",
    "enum": [
     "tudetic",
     "mototic",
     "scubatic",
     "biketic",
     "autotic",
     "trekktic",
     "cubiertas",
     "ociotic",
     "decortic"
    ],
    "type": "string"
   },
   "sort": {
    "enum": [
     "relevance",
     "price_asc",
     "price_desc",
     "name_asc",
     "name_desc"
    ],
    "type": "string"
   },
   "vehicle_cc": {
    "maxLength": 30,
    "type": "string"
   },
   "vehicle_make": {
    "maxLength": 80,
    "type": "string"
   },
   "vehicle_model": {
    "maxLength": 120,
    "type": "string"
   },
   "vehicle_year": {
    "maxLength": 20,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_products",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "pricing": {
    "type": "object"
   },
   "results": {
    "items": {
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "schema_version": {
    "type": "string"
   },
   "total_results": {
    "type": "integer"
   }
  },
  "required": [
   "schema_version",
   "pricing",
   "results"
  ],
  "type": "object"
 },
 "title": "Search Tudetic products"
}
