{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search eToro instruments (stocks, crypto, ETFs, etc.) by keyword or exact ticker.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "exactSymbol": {
    "description": "If true, match by exact ticker symbol (e.g. 'AAPL') instead of free-text",
    "type": "boolean"
   },
   "page": {
    "description": "Page number (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "description": "Results per page (default 10, max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search keyword (e.g. 'AAPL', 'Bitcoin', 'Tesla')",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "etoro_search_instruments",
 "title": "Search instruments"
}
