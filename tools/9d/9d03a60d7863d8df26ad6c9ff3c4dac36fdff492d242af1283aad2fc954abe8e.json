{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "National Park Service campgrounds nearest a point, with whether each is open today by its published schedule, site counts and reservation links. Schedules only: check nationalparks_get_park_status for current alerts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "default": 10,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "max_km": {
    "default": 100,
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "number"
   },
   "open_today_only": {
    "default": true,
    "type": "boolean"
   }
  },
  "required": [
   "latitude",
   "longitude"
  ],
  "type": "object"
 },
 "name": "nationalparks_find_campgrounds",
 "title": "Find national park campgrounds"
}
