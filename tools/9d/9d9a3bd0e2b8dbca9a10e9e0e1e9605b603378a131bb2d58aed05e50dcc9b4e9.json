{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Asks Huasheng for a change in your own words \u2014 \"make it livelier\", \"cut it to a minute\", \"try a different opening\". **This is not how you answer a question.** When the video is PAUSED waiting on you, use huasheng_answer_question; using this instead leaves the question hanging forever. To reword one specific clip, huasheng_edit_clip is faster and more precise \u2014 this tool handles open-ended requests. Set clip or animation to anchor words such as 'this' and 'here' to one exact storyboard item. Never set both. Follow it with huasheng_wait_for_project.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "animation": {
    "description": "Optional animation id from huasheng_list_clips; cannot be combined with clip",
    "minimum": 1,
    "type": "integer"
   },
   "attachments": {
    "description": "Materials to hand Huasheng with the request, up to 8: ids from huasheng_list_materials, or file paths / public URLs (added to the library first, analysed and billed like huasheng_manage_materials). A hint the agent may use, not an order \u2014 say in the request what to do with them",
    "items": {
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "clip": {
    "description": "Optional 1-based clip position from huasheng_list_clips; cannot be combined with animation",
    "minimum": 1,
    "type": "integer"
   },
   "pid": {
    "description": "The 15-digit video id; no default.",
    "type": "integer"
   },
   "request": {
    "description": "What to change, in the user's own words",
    "type": "string"
   }
  },
  "required": [
   "pid",
   "request"
  ],
  "type": "object"
 },
 "name": "huasheng_ask_agent",
 "outputSchema": {
  "properties": {
   "action": {
    "properties": {
     "accepted": {
      "type": "boolean"
     },
     "action_id": {
      "type": "string"
     },
     "client_action_id": {
      "description": "App-supplied id; repeats reuse the first result",
      "type": "string"
     },
     "entity": {
      "properties": {
       "id": {
        "type": "string"
       },
       "snapshot": {
        "type": "object"
       },
       "type": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "id"
      ],
      "type": "object"
     },
     "error": {
      "properties": {
       "code": {
        "type": "string"
       },
       "retryable": {
        "type": "boolean"
       },
       "suggested_action": {
        "type": "string"
       }
      },
      "required": [
       "code",
       "retryable"
      ],
      "type": "object"
     },
     "followup": {
      "properties": {
       "prompt": {
        "type": "string"
       },
       "required": {
        "description": "Deprecated; always false",
        "type": "boolean"
       }
      },
      "required": [
       "required"
      ],
      "type": "object"
     },
     "kind": {
      "description": "e.g. footage.replace",
      "type": "string"
     },
     "next_call": {
      "properties": {
       "arguments": {
        "type": "object"
       },
       "tool": {
        "type": "string"
       }
      },
      "required": [
       "tool",
       "arguments"
      ],
      "type": "object"
     },
     "operation": {
      "properties": {
       "id": {
        "description": "Pass to huasheng_wait_for_action",
        "type": "string"
       },
       "poll_after_ms": {
        "type": "integer"
       },
       "progress": {
        "type": "number"
       }
      },
      "required": [
       "id"
      ],
      "type": "object"
     },
     "phase": {
      "enum": [
       "ACCEPTED",
       "PROCESSING",
       "SUCCEEDED",
       "FAILED",
       "CANCELLED",
       "STALE"
      ],
      "type": "string"
     },
     "pid": {
      "type": "integer"
     },
     "revision": {
      "type": "integer"
     },
     "summary": {
      "type": "string"
     },
     "terminal": {
      "type": "boolean"
     }
    },
    "required": [
     "action_id",
     "pid",
     "kind",
     "phase",
     "accepted",
     "terminal",
     "summary",
     "followup"
    ],
    "type": "object"
   },
   "answered": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "applied": {
    "description": "Whether the change has landed. If false, track action.operation.id and follow action.next_call when present",
    "type": "boolean"
   },
   "can_be": {
    "description": "When only reading: what it accepts",
    "type": "string"
   },
   "clip": {
    "description": "Which clip was changed",
    "type": "integer"
   },
   "current": {
    "description": "When only reading: the current value",
    "type": "string"
   },
   "label": {
    "description": "Human-readable name of the changed setting",
    "type": "string"
   },
   "note": {
    "description": "What to do next, in plain words",
    "type": "string"
   },
   "options": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "outcome": {
    "enum": [
     "started",
     "queued",
     "busy"
    ],
    "type": "string"
   },
   "pid": {
    "description": "The 15-digit video id",
    "type": "integer"
   },
   "run_id": {
    "type": "string"
   },
   "selected": {
    "properties": {
     "id": {
      "type": "string"
     },
     "position": {
      "type": "integer"
     },
     "type": {
      "enum": [
       "clip",
       "motion"
      ],
      "type": "string"
     }
    },
    "required": [
     "type",
     "position",
     "id"
    ],
    "type": "object"
   },
   "setting": {
    "type": "string"
   },
   "url": {
    "description": "Link to the video in Huasheng",
    "type": "string"
   },
   "value": {
    "type": "string"
   }
  },
  "required": [
   "pid",
   "url"
  ],
  "type": "object"
 },
 "title": "Ask Huasheng for a change"
}
