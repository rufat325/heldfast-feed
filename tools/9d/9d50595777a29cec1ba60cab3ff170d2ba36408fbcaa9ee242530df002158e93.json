{
 "description": "Raw POST /divoom_api command wrapper. Command is required; payload object is merged with enforced ReturnCode=0.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "command": {
    "type": "string"
   },
   "payload": {
    "type": "object"
   },
   "target": {
    "additionalProperties": false,
    "description": "Optional per-call target override. If omitted, environment variables are used.",
    "properties": {
     "host": {
      "description": "Device LAN IP. Example: 192.168.1.120",
      "type": "string"
     },
     "port": {
      "default": 9000,
      "description": "Device HTTP port, commonly 9000.",
      "type": "integer"
     },
     "timeoutMs": {
      "default": 45000,
      "description": "HTTP timeout in milliseconds.",
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "command"
  ],
  "type": "object"
 },
 "name": "watchface_raw_command"
}
