{
 "annotations": {
  "destructiveHint": true,
  "title": "Update an appointment"
 },
 "description": "Reschedule or edit an appointment (start/end time, staff, session type, notes \u2014 the only fields Mindbody lets you change) and/or move it through its status: confirm, unconfirm, arrive, unarrive, complete. Cancel and late-cancel are deliberately not offered (a late cancel can charge the client). Pass test: true to validate only. Requires a staff user token. Mindbody: POST /appointment/updateappointment.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "appointment_id": {
    "description": "The appointment id (from mindbody_list_staff_appointments).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "end_date_time": {
    "description": "New end, ISO 8601.",
    "type": "string"
   },
   "execute": {
    "description": "A status action to apply.",
    "enum": [
     "confirm",
     "unconfirm",
     "arrive",
     "unarrive",
     "complete"
    ],
    "type": "string"
   },
   "notes": {
    "description": "Replace the appointment notes.",
    "type": "string"
   },
   "send_email": {
    "description": "Send the site's automatic email.",
    "type": "boolean"
   },
   "session_type_id": {
    "description": "Change the session type.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "staff_id": {
    "description": "Move to this staff member.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "start_date_time": {
    "description": "New start, ISO 8601.",
    "type": "string"
   },
   "test": {
    "description": "When true, Mindbody validates the request but commits nothing. Use it to dry-run a write.",
    "type": "boolean"
   }
  },
  "required": [
   "appointment_id"
  ],
  "type": "object"
 },
 "name": "mindbody_update_appointment",
 "title": "Update an appointment"
}
