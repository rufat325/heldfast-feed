{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Wait for the next HTTP request on a watch started with watch.start. Returns method, path, headers, and body from the local buffer only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "slug": {
    "description": "Optional permanent slug such as billing. Omit to use this process's anonymous inspect URL. A named slug requires OPENWEBHOOK_TOKEN.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "timeout_ms": {
    "default": 30000,
    "description": "How long to wait in milliseconds. Range 1\u2013300000. Default 30000. Example: 60000.",
    "maximum": 300000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "watch.wait",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "webhook": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "body": {
        "type": "string"
       },
       "bodyEncoding": {
        "enum": [
         "utf8",
         "base64"
        ],
        "type": "string"
       },
       "headers": {
        "additionalProperties": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "items": {
            "type": "string"
           },
           "type": "array"
          }
         ]
        },
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       "id": {
        "type": "string"
       },
       "method": {
        "type": "string"
       },
       "path": {
        "type": "string"
       },
       "receivedAt": {
        "type": "string"
       },
       "requestUrl": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "receivedAt",
       "method",
       "path",
       "requestUrl",
       "body",
       "bodyEncoding",
       "headers"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "webhook"
  ],
  "type": "object"
 },
 "title": "Wait for webhook"
}
