     "json"
    ],
    "type": "string"
   },
   "language": {
    "description": "Language for team, competition and country names, and for the football-mania.com links (en, es, de, fr, it, pt, pt-BR, nl, ar, ru, tr, id, \u2026). Default: en",
    "type": "string"
   },
   "league_key": {
    "description": "League key from search (e.g. SpainPrimeraDivision), or the competition name",
    "type": "string"
   },
   "limit": {
    "description": "Players listed. Default: 20",
    "type": "number"
   }
  },
  "required": [
