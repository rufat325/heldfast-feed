{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List files in Google Drive. Use query parameter to filter results using Drive search syntax.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fields": {
    "description": "Fields to include in response. Defaults to common fields.",
    "type": "string"
   },
   "includeItemsFromAllDrives": {
    "default": true,
    "description": "Include files from shared drives",
    "type": "boolean"
   },
   "orderBy": {
    "description": "Sort order (e.g., \"modifiedTime desc\", \"name\")",
    "type": "string"
   },
   "pageSize": {
    "default": 100,
    "description": "Maximum number of files to return (1-1000)",
    "maximum": 1000,
    "minimum": 1,
    "type": "number"
   },
   "pageToken": {
    "description": "Token for pagination",
    "type": "string"
   },
   "q": {
    "description": "Search query using Drive search syntax (e.g., \"name contains 'report'\" or \"mimeType='application/pdf'\")",
    "type": "string"
   },
   "spaces": {
    "default": "drive",
    "description": "Spaces to search",
    "enum": [
     "drive",
     "appDataFolder"
    ],
    "type": "string"
   },
   "supportsAllDrives": {
    "default": true,
    "description": "Support shared drives",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "files_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "files": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "createdTime": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "mimeType": {
       "type": "string"
      },
      "modifiedTime": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "owners": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "displayName": {
          "type": "string"
         },
         "emailAddress": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "parents": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "shared": {
       "type": "boolean"
      },
      "size": {
       "type": "string"
      },
      "trashed": {
       "type": "boolean"
      },
      "webContentLink": {
       "type": "string"
      },
      "webViewLink": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "mimeType"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "incompleteSearch": {
    "type": "boolean"
   },
   "nextPageToken": {
    "type": "string"
   }
  },
  "required": [
   "files"
  ],
  "type": "object"
 },
 "title": "List files"
}
