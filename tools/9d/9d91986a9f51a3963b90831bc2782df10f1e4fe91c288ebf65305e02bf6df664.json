00,"type":"string"},"name":{"maxLength":100,"type":"string"},"phone":{"maxLength":100,"type":"string"}},"type":"object"},"electronic_address":{"additionalProperties":false,"properties":{"scheme":{"description":"EAS code, e.g. EM for e-mail","maxLength":10,"pattern":"^[A-Z0-9]{2,10}$","type":"string"},"value":{"maxLength":200,"minLength":1,"type":"string"}},"required":["scheme","value"],"type":"object"},"legal_info":{"description":"BT-33","maxLength":200,"type":"string"},"legal_registration_id":{"description":"BT-30","maxLength":100,"type":"string"},"name":{"maxLength":200,"minLength":1,"type":"string"},"tax_number":{"description":"BT-32, e.g. German Steuernummer or Romanian CUI","maxLength":30,"type":"string"},"trading_name":{"maxLength":200,"type":"string"},"vat_id":{"description":"BT-31","maxLength":30,"type":"string"}},"required":["name","address"],"type":"object"}},"required":["number","issue_date","currency","seller","buyer","lines"],"type":"object"},"target_format":{"description":"xrechnung-ubl = XRechnung 3.0 (Germany), facturx-cii = ZUGFeRD/Factur-X XML (EN 16931), cius-ro-ubl = Romanian e-Factura (RON only).","enum":["xrechnung-ubl","facturx-cii","cius-ro-ubl"],"type":"string"}},"required":["target_format","invoice"],"type":"object"},"name":"convert_invoice"}
