{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Tell Skym"
 },
 "description": "Continue this trip's conversation and living artifact. Send only the\n    user's requested changes, answers or corrections, not a full chat log.\n    Skym remembers useful facts and findings in the same report; trip_status\n    returns its current state and recent reply. A click is not a booking and\n    a hypothetical alternative is not a chosen destination. One message per\n    turn; the user sees the same conversation through claim_url.",
 "inputSchema": {
  "properties": {
   "grant": {
    "title": "Grant",
    "type": "string"
   },
   "lang": {
    "default": "en",
    "title": "Lang",
    "type": "string"
   },
   "message": {
    "title": "Message",
    "type": "string"
   },
   "trip_id": {
    "title": "Trip Id",
    "type": "integer"
   }
  },
  "required": [
   "trip_id",
   "grant",
   "message"
  ],
  "title": "tell_skymArguments",
  "type": "object"
 },
 "name": "tell_skym",
 "outputSchema": {
  "$defs": {
   "Attribution": {
    "properties": {
     "attribution": {
      "title": "Attribution",
      "type": "string"
     },
     "contract": {
      "title": "Contract",
      "type": "string"
     },
     "source": {
      "title": "Source",
      "type": "string"
     }
    },
    "required": [
     "source",
     "contract",
     "attribution"
    ],
    "title": "Attribution",
    "type": "object"
   },
   "ErrorOutput": {
    "additionalProperties": true,
    "properties": {
     "_meta": {
      "$ref": "#/$defs/Attribution"
     },
     "error": {
      "additionalProperties": true,
      "title": "Error",
      "type": "object"
     }
    },
    "required": [
     "_meta",
     "error"
    ],
    "title": "ErrorOutput",
    "type": "object"
   },
   "TellSkymOutput": {
    "additionalProperties": true,
    "properties": {
     "_meta": {
      "$ref": "#/$defs/Attribution"
     },
     "delivered": {
      "title": "Delivered",
      "type": "boolean"
     },
     "hint": {
      "title": "Hint",
      "type": "string"
     },
     "note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Note"
     },
     "skym_will_reply": {
      "title": "Skym Will Reply",
      "type": "boolean"
     },
     "trip_id": {
      "title": "Trip Id",
      "type": "integer"
     }
    },
    "required": [
     "_meta",
     "trip_id",
     "delivered",
     "skym_will_reply",
     "hint"
    ],
    "title": "TellSkymOutput",
    "type": "object"
   }
  },
  "anyOf": [
   {
    "$ref": "#/$defs/TellSkymOutput"
   },
   {
    "$ref": "#/$defs/ErrorOutput"
   }
  ],
  "title": "ToolOutput[TellSkymOutput]"
 }
}
