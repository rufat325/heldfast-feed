{
 "description": "Create a new draft invoice in Teamleader Focus",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customer_id": {
    "description": "Customer ID",
    "type": "string"
   },
   "customer_type": {
    "description": "Customer type",
    "enum": [
     "contact",
     "company"
    ],
    "type": "string"
   },
   "department_id": {
    "description": "Department ID",
    "type": "string"
   },
   "invoice_date": {
    "description": "Invoice date (YYYY-MM-DD, defaults to today)",
    "type": "string"
   },
   "line_items": {
    "description": "Line items for the invoice",
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "description": "Line item description",
       "type": "string"
      },
      "product_id": {
       "description": "Product ID (optional)",
       "type": "string"
      },
      "quantity": {
       "description": "Quantity",
       "type": "number"
      },
      "tax_rate_id": {
       "description": "Tax rate ID",
       "type": "string"
      },
      "unit_price_amount": {
       "description": "Unit price amount",
       "type": "number"
      },
      "unit_price_currency": {
       "description": "Currency code (e.g. 'EUR')",
       "type": "string"
      }
     },
     "required": [
      "quantity",
      "description",
      "unit_price_amount",
      "unit_price_currency",
      "tax_rate_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "note": {
    "description": "Note to include on the invoice",
    "type": "string"
   },
   "payment_term_days": {
    "description": "Number of days for payment term",
    "type": "number"
   },
   "payment_term_type": {
    "description": "Payment term type (e.g. 'cash', 'end_of_month', 'after_invoice_date')",
    "type": "string"
   }
  },
  "required": [
   "customer_type",
   "customer_id",
   "department_id",
   "payment_term_type",
   "line_items"
  ],
  "type": "object"
 },
 "name": "teamleader_create_invoice"
}
