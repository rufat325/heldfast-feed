  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "assignmentId"
  ],
  "type": "object"
 },
 "name": "opentrain_quiz_coaching_state",
