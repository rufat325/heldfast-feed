 },
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Bounded coaching state for one submitted assignment (view:\"state\"): the DRAFT selection cycle, the live OPEN/RESUBMITTED cycle, the 10 most recent cycles (full history rides opentrain_quiz_coaching_cycles), bounded thread summaries, and the latest submitted attempt. Worker names are masked; answer keys, expected answers, and worker personal data NEVER appear. Requires project_todos:read, a claimed account, and the default-off project-todos agent surface. Keyless read.",
 "execution": {
  "taskSupport": "forbidden"
 },
