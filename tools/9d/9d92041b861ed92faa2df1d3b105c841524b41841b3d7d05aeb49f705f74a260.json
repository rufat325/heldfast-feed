       },
       "required": [
        "threadId",
        "questionId",
        "status",
        "lastActivityAt",
        "resolvedAt"
       ],
       "type": "object"
      },
      "maxItems": 500,
      "type": "array"
     },
     "threadsTruncated": {
      "type": "boolean"
