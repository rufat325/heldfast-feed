  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "imagepeek: extract an image's dominant colours"
 },
 "description": "imagepeek: Extract the dominant colours of an image. For a placeholder string use image_blurhash. Returns an image's palette of `k` colours (hex, rgb, share), the dominant one and the average colour with its luminance, from a 200 px sample (median cut refined by k-means; transparent pixels ignored). Reads PNG, JPEG, WebP, GIF, TIFF, BMP, ICO and AVIF; other formats and images over 40 megapixels are refused (not charged). Images are never logged or stored. Typically 0.5-2 s. Price: USD 0.002. Free: 3 imagepeek calls per IP per UTC day. Docs: https://tanod.dev/learn/image-color-palette-api.html",
 "inputSchema": {
  "properties": {
   "auto_orient": {
    "default": true,
    "description": "Apply the EXIF orientation first (default true).",
    "title": "Auto Orient",
    "type": "boolean"
   },
   "image_base64": {
    "anyOf": [
     {
      "maxLength": 13333464,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "The image as standard or url-safe base64 (at most 10 MB decoded; a data:image/...;base64, prefix is fine); or use url.",
    "title": "Image Base64"
   },
   "k": {
    "default": 5,
    "description": "Palette size (1-10, default 5).",
    "maximum": 10,
    "minimum": 1,
    "title": "K",
    "type": "integer"
   },
   "url": {
    "anyOf": [
     {
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Public http(s) URL of the image (at most 10 MB; private, internal and IP-literal hosts are refused); or use image_base64.",
    "title": "Url"
   }
  },
