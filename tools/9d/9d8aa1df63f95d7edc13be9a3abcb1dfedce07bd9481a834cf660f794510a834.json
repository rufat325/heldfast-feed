      "title": "Unit"
     },
     "value": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Free-text values are untrusted.",
      "title": "Value"
     }
    },
    "required": [
