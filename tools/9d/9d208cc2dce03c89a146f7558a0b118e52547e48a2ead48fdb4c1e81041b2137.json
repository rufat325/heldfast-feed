{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List Datadog Case Management cases with search and filtering",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "pageNumber": {
    "default": 1,
    "description": "Page number (1-based, minimum 1)",
    "type": "number"
   },
   "pageSize": {
    "default": 25,
    "description": "Number of results per page (default 25)",
    "type": "number"
   },
   "query": {
    "description": "Search query to filter cases. Example: status:open priority:P1",
    "type": "string"
   },
   "sortField": {
    "default": "created_at",
    "description": "Field to sort by",
    "enum": [
     "created_at",
     "priority",
     "status"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list-cases"
}
