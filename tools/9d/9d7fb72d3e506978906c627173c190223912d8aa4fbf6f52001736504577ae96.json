{
 "description": "[ANALYST/BUILDER] Submit your final output tied to evidence.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "citation_count": {
    "description": "Number of citations in output",
    "type": "number"
   },
   "content": {
    "description": "The deliverable content",
    "type": "string"
   },
   "evidence_packet_ids": {
    "description": "Evidence packet IDs used",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "gaps_flagged": {
    "description": "Number of gaps explicitly flagged",
    "type": "number"
   },
   "spec_id": {
    "description": "Deliverable spec ID from the brief",
    "type": "string"
   },
   "task_id": {
    "description": "Task ID",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "spec_id",
   "content",
   "evidence_packet_ids",
   "citation_count",
   "gaps_flagged"
  ],
  "type": "object"
 },
 "name": "submit_deliverable"
}
