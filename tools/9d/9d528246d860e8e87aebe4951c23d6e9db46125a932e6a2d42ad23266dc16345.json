{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Edit Task"
 },
 "description": "Edit a task or mark it complete. Returns {success}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "commentary": {
    "description": "Updated commentary",
    "type": "string"
   },
   "complete": {
    "description": "Mark the task completed",
    "type": "boolean"
   },
   "datetime": {
    "description": "Updated due datetime 'YYYY-MM-DD HH:MM:SS'",
    "type": "string"
   },
   "id": {
    "description": "Task ID to edit",
    "type": "integer"
   },
   "performer_id": {
    "description": "Reassign to manager ID",
    "type": "integer"
   },
   "site": {
    "description": "Site (store) symbolic code. Required on create/edit when the API key is scoped to multiple sites (see list_sites).",
    "type": "string"
   },
   "text": {
    "description": "Updated task text",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "tasks_edit"
}
