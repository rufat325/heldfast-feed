{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List or search TAAFT partner deals. Results use the same approved offers as the public deals page and include full tool details plus the TAAFT code, discount, plan, terms, trial, and expiry data when known.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "feature": {
    "description": "Optional feature or tag.",
    "type": "string"
   },
   "limit": {
    "description": "Optional result cap. Omit it to list every matching deal.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "min_discount_amount": {
    "minimum": 0,
    "type": "number"
   },
   "min_discount_percent": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "pricing_model": {
    "enum": [
     "freeonly",
     "trial",
     "freemium",
     "paidonly",
     "nopricing"
    ],
    "type": "string"
   },
   "query": {
    "description": "Optional keywords such as \"social media scheduling\".",
    "type": "string"
   },
   "sort": {
    "default": "biggest-discount",
    "enum": [
     "biggest-discount",
     "newest"
    ],
    "type": "string"
   },
   "task": {
    "description": "Optional task name or task slug.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_deals",
