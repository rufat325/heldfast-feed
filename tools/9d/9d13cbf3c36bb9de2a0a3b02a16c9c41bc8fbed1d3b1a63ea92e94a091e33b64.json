{
 "description": "Create watercolor artwork from a text prompt as an asynchronous task.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aspect_ratio": {
    "default": "auto",
    "enum": [
     "auto",
     "1:1",
     "4:3",
     "3:4",
     "16:9",
     "9:16",
     "21:9",
     "9:21"
    ],
    "type": "string"
   },
   "idempotency_key": {
    "maxLength": 255,
    "minLength": 8,
    "type": "string"
   },
   "model": {
    "default": "watercolor-lite",
    "enum": [
     "watercolor-lite",
     "gpt-image-2",
     "nano-banana-pro",
     "nano-banana-2"
    ],
    "type": "string"
   },
   "prompt": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "resolution": {
    "default": "1k",
    "enum": [
     "1k",
     "2k",
     "4k"
    ],
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "generate_watercolor"
}
