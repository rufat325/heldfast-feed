{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Return train-level availability, prices, car groups and checkout URL for a route/date.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "adults": {
    "default": 1,
    "description": "Adult passengers.",
    "maximum": 9,
    "minimum": 1,
    "type": "integer"
   },
   "children": {
    "default": 0,
    "description": "Child passengers.",
    "maximum": 9,
    "minimum": 0,
    "type": "integer"
   },
   "date": {
    "description": "Travel date in YYYY-MM-DD.",
    "type": "string"
   },
   "departureFrom": {
    "description": "Local departure lower bound HH:mm.",
    "type": "string"
   },
   "departureTo": {
    "description": "Local departure upper bound HH:mm.",
    "type": "string"
   },
   "destination": {
    "description": "RZD expressCode or nodeId of destination station.",
    "type": "string"
   },
   "destinationNodeId": {
    "description": "Optional nodeId for building checkout URL.",
    "type": "string"
   },
   "largeFamily": {
    "default": false,
    "description": "Search large-family availability.",
    "type": "boolean"
   },
   "origin": {
    "description": "RZD expressCode or nodeId of origin station, e.g. 2038000 or 5a13...",
    "type": "string"
   },
   "originNodeId": {
    "description": "Optional nodeId for building checkout URL.",
    "type": "string"
   },
   "train": {
    "description": "Single exact train number.",
    "type": "string"
   },
   "trains": {
    "description": "Exact train numbers, e.g. [\"097\u042d\"].",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "origin",
   "destination",
   "date"
  ],
  "type": "object"
 },
 "name": "rzd_search_trains",
 "title": "Search RZD trains"
}
