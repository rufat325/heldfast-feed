{
 "description": "Read a local media file from the agent workspace, send it through Render inline when small, and start an UploadCheck run.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ai_review_seconds": {
    "type": "number"
   },
   "callback_url": {
    "type": "string"
   },
   "checks": {
    "type": "string"
   },
   "cost_guardrail": {
    "enum": [
     "downgrade",
     "block",
     "off"
    ],
    "type": "string"
   },
   "expected_script_path": {
    "type": "string"
   },
   "file_path": {
    "type": "string"
   },
   "idempotency_key": {
    "type": "string"
   },
   "included_minutes": {
    "type": "number"
   },
   "manifest_path": {
    "type": "string"
   },
   "max_inline_mb": {
    "type": "number"
   },
   "plan_id": {
    "type": "string"
   },
   "plan_price_cents": {
    "type": "number"
   },
   "profile": {
    "type": "string"
   },
   "sidecar_dir": {
    "type": "string"
   },
   "transcript_path": {
    "type": "string"
   },
   "upload_mode": {
    "enum": [
     "auto",
     "inline",
     "signed"
    ],
    "type": "string"
   },
   "watchlist_path": {
    "type": "string"
   }
  },
  "required": [
   "file_path"
  ],
  "type": "object"
 },
 "name": "qc_run_local_file"
}
