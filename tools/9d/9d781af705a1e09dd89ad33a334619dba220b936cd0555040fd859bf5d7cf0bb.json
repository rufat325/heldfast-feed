{
 "_meta": {
  "openai/outputTemplate": "ui://widget/xenition-tools.html",
  "openai/toolInvocation/invoked": "Here's what I found",
  "openai/toolInvocation/invoking": "Finding tools\u2026",
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "xenition.read",
     "xenition.write"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://xenition-app/xenition-tools.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find a built-in tool"
 },
 "description": "Use this when the user asks for a calculator, converter or generator (loan, currency, BMI, age, QR code and ~200 more) and you need the tool's id. Returns matching tools with links. To get an answer from the tool, pass its id to run_tool.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "max results to return (default 6)",
    "type": "integer"
   },
   "query": {
    "description": "what the user wants \u2014 e.g. 'loan calculator', 'currency converter', 'BMI', 'qr code'",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "find_tools",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "tools": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "openUrl": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "title",
      "description",
      "category"
     ],
     "type": "object"
    },
    "type": [
     "null",
     "array"
    ]
   }
  },
  "required": [
   "tools"
  ],
  "type": "object"
 },
 "title": "Find a built-in tool"
}
