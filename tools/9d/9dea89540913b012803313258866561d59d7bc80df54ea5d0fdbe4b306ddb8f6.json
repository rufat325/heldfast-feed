{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "wapiworld:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check if a WhatsApp number is connected"
 },
 "description": "Use this when someone asks whether a WhatsApp number is connected, waiting for QR pairing, starting or offline. Returns the instance's name, raw status and a health value: ready, pairing, starting, offline or unknown (no QR codes or credentials). Not for whether a sent message was delivered.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "instanceId": {
    "description": "Instance id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "instanceId"
  ],
  "type": "object"
 },
 "name": "get_instance_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "found": {
    "type": "boolean"
   },
   "health": {
    "description": "ready: connected; pairing: waiting for a QR scan; starting: connecting; offline: logged out or disconnected; unknown: unrecognized state",
    "enum": [
     "ready",
     "pairing",
     "starting",
     "offline",
     "unknown"
    ],
    "type": "string"
   },
   "instanceId": {
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   },
   "name": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "anyOf": [
     {
      "enum": [
       "starting",
       "qrcode",
       "ready",
       "logged_out",
       "not_connected",
       "disconnected",
       "offline",
       "STARTING",
       "QRCODE",
       "READY"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "found",
   "instanceId",
   "name",
   "status",
   "health"
  ],
  "type": "object"
 },
 "title": "Check if a WhatsApp number is connected"
}
