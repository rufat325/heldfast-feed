{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read a standing insight's full start, themes or wins detail and supporting evidence. Use themeId to open an individual theme returned by the themes card.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "brandSlug": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "card": {
    "enum": [
     "start",
     "themes",
     "wins"
    ],
    "type": "string"
   },
   "themeId": {
    "anyOf": [
     {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "brandSlug",
   "card"
  ],
  "type": "object"
 },
 "name": "parse_dashboard_standing",
 "outputSchema": {
  "properties": {
   "data": {},
   "dataAsOf": {
    "type": "string"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "parse:dashboard:read",
    "user:org:read"
   ],
   "type": "oauth2"
  }
 ]
}
