      "type": "null"
     }
    ],
    "default": null,
    "description": "Smallest trade to report, in USD (default 100, minimum 1). A high value over a short scan can return no trades.",
    "title": "Min Usd"
   },
   "mint": {
    "description": "SPL Token or Token-2022 mint address (base58, 32-44 characters).",
    "maxLength": 44,
    "minLength": 32,
    "pattern": "^[1-9A-HJ-NP-Za-km-z]+$",
    "title": "Mint",
    "type": "string"
   }
  },
