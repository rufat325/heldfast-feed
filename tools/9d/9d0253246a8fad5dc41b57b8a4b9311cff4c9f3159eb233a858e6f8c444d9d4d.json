{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Search X/Twitter for high-performing tweets to find content inspiration. Returns tweets with engagement metrics. Use filters to narrow results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "has_media": {
    "description": "Only return tweets with media attachments",
    "type": "boolean"
   },
   "lang": {
    "description": "Language filter (e.g. \"en\", \"es\", \"fr\")",
    "type": "string"
   },
   "max_results": {
    "description": "Number of results (10-100, default 20)",
    "maximum": 100,
    "minimum": 10,
    "type": "integer"
   },
   "min_likes": {
    "description": "Minimum number of likes (client-side filter)",
    "minimum": 0,
    "type": "integer"
   },
   "min_retweets": {
    "description": "Minimum number of retweets (client-side filter)",
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Search query (e.g. \"SaaS marketing\", \"from:naval\", \"#startup\")",
    "type": "string"
   },
   "sort_order": {
    "description": "Sort by relevancy (default) or recency",
    "enum": [
     "relevancy",
     "recency"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "opentweet_search_inspiration"
}
