  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Return qr_tracking_url for encoding in a QR. This tool does not return PNG image bytes. GET /v1/links/{id}/qr is the owner-only image. Requires registered account. Anonymous MCP is not supported.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "id": "example"
   },
   {
    "short_url": "https://xn--s7y.xn--3ds443g/example"
   }
  ],
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "id": {
      "description": "Existing short code. Mutually exclusive with short_url.",
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "short_url": {
      "description": "Existing short URL to tag for QR. Mutually exclusive with id.",
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "short_url"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "name": "create_qr",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "code": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "image_available": {
    "type": "boolean"
   },
   "message": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "qr_tracking_url": {
    "type": "string"
   },
   "request_id": {
    "type": "string"
   },
   "retryable": {
    "type": "boolean"
   },
   "short_url": {
    "type": "string"
   },
   "short_url_ascii": {
    "type": "string"
   },
   "state": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "request_id"
  ],
  "type": "object"
 },
 "title": "Create QR tracking URL"
}
