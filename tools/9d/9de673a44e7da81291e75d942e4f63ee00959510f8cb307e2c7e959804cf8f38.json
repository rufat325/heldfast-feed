{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Unlink an entity from another entity (by the linked entity id).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "confirm": {
    "description": "Set to true to confirm this destructive/bulk operation",
    "type": "boolean"
   },
   "entityId": {
    "type": "string"
   },
   "entityType": {
    "description": "Entity type: \"project\", \"portfolio\" or \"goal\"",
    "enum": [
     "project",
     "portfolio",
     "goal"
    ],
    "type": "string"
   },
   "right": {
    "description": "Id of the entity to unlink",
    "type": "string"
   }
  },
  "required": [
   "entityType",
   "entityId",
   "right"
  ],
  "type": "object"
 },
 "name": "delete_entity_link"
}
