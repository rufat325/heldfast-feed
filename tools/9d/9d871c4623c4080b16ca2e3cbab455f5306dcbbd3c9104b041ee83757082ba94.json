{
 "description": "Delegate a credential to an agent. Creates a scoped delegation with optional rate limits and expiry.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent_id": {
    "description": "The agent receiving the delegation",
    "type": "string"
   },
   "connection_id": {
    "description": "The connection or credential identifier to delegate",
    "type": "string"
   },
   "max_requests_per_hr": {
    "description": "Maximum requests per hour for this delegation",
    "type": "number"
   },
   "scopes_delegated": {
    "description": "Scopes to delegate (e.g. ['read', 'write'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "valid_until": {
    "description": "Expiry timestamp (ISO 8601)",
    "format": "date-time",
    "type": "string"
   }
  },
  "required": [
   "connection_id",
   "agent_id",
   "scopes_delegated"
  ],
  "type": "object"
 },
 "name": "vorim_delegate_credential"
}
