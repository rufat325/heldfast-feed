{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/contracts.jsonschema-validate",
  "agent-utilities/priceMicroUsd": 300
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Validate data using a bounded JSON Schema 2020-12 subset. PAID: 300 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "data": {},
     "schema": {
      "type": [
       "object",
       "boolean"
      ]
     }
    },
    "required": [
     "schema",
     "data"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "contracts_jsonschema_validate",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "issues": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "rule"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scope": {
    "type": "string"
   },
   "valid": {
    "type": "boolean"
   }
  },
  "required": [
   "valid",
   "issues",
   "scope"
  ],
  "type": "object"
 }
}
