{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Permanently delete a file. This cannot be undone. In almost all cases, you should use file_update with trashed:true instead, which moves the file to trash where it can be restored within 30 days.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fileId": {
    "description": "The ID of the file to permanently delete",
    "type": "string"
   },
   "supportsAllDrives": {
    "default": true,
    "description": "Support shared drives",
    "type": "boolean"
   }
  },
  "required": [
   "fileId"
  ],
  "type": "object"
 },
 "name": "file_delete",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "message"
  ],
  "type": "object"
 },
 "title": "Delete file permanently"
}
