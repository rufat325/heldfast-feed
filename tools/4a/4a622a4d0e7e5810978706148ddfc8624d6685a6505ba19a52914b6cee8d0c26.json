{
 "description": "Generate a full CHANGELOG.md entry from commit messages.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "commits": {
    "description": "Newline-separated conventional commit messages",
    "type": "string"
   },
   "date": {
    "default": "",
    "description": "Release date (YYYY-MM-DD). Defaults to today.",
    "type": "string"
   },
   "version": {
    "description": "Version number (e.g. '1.2.0')",
    "type": "string"
   }
  },
  "required": [
   "version",
   "commits"
  ],
  "type": "object"
 },
 "name": "generate_changelog"
}
