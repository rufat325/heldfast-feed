  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "route_name": {
    "description": "Route short name (e.g. \"T30\", \"32A\") or numeric external ID.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "route_name"
  ],
  "type": "object"
 },
 "name": "get_route_realtime",
