{
 "description": "Get a list of deals (orders) from GetCourse with optional filters by status and creation date. Supports async export polling for large datasets. Returns up to 50 deals per request.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "created_from": {
    "description": "Created date from (YYYY-MM-DD)",
    "type": "string"
   },
   "created_to": {
    "description": "Created date to (YYYY-MM-DD)",
    "type": "string"
   },
   "status": {
    "description": "Filter by deal status",
    "enum": [
     "new",
     "in_work",
     "payment_waiting",
     "finished",
     "cancelled",
     "false_deal"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_deals"
}
