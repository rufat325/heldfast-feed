{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Optimize multiple parameters"
 },
 "description": "Optimizes 2\u20136 parameters simultaneously using Nelder-Mead simplex search, for example Kp, Ki and Kd of a PID controller at once.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "maxIterations": {
    "description": "Max simulations to run, 5\u201360 (default: 30)",
    "type": "number"
   },
   "measureBlockId": {
    "description": "Scope or Display block to read the controlled signal from",
    "type": "string"
   },
   "objective": {
    "description": "Metric to minimize (default: iae)",
    "enum": [
     "iae",
     "overshoot",
     "settling_time"
    ],
    "type": "string"
   },
   "setpoint": {
    "description": "Target steady-state value (default: 1)",
    "type": "number"
   },
   "targets": {
    "description": "Parameters to optimize simultaneously",
    "items": {
     "properties": {
      "blockId": {
       "type": "string"
      },
      "max": {
       "type": "number"
      },
      "min": {
       "type": "number"
      },
      "paramName": {
       "type": "string"
      }
     },
     "required": [
      "blockId",
      "paramName",
      "min",
      "max"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "targets",
   "measureBlockId"
  ],
  "type": "object"
 },
 "name": "optimize_multi_parameter",
 "title": "Optimize multiple parameters"
}
