{
 "description": "Full-text and semantic search across experiences and travelers. Uses embedding similarity as fallback when text search returns no results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Results per page",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number",
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Search query",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "description": "Filter search type (default: all)",
    "enum": [
     "all",
     "experiences",
     "travelers"
    ],
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search"
}
