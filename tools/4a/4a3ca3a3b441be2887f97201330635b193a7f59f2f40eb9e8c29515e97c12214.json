  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Explain eligibility codes"
 },
 "description": "Decode Grants.gov applicant eligibility codes (such as 23, 12 or 99) in plain words: the official label, what it means, who counts, what to watch out for, and the source for each, with an as-of date. Give codes, applicant types (such as small_business), or nothing for the full table of 17 codes. Static reference with no network access. Informational, not legal advice.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "applicant_types": {
    "items": {
     "enum": [
      "state_government",
      "county_government",
      "city_or_township_government",
      "special_district_government",
      "independent_school_district",
      "public_higher_education",
      "tribal_government",
      "public_housing_authority",
      "tribal_organization",
      "nonprofit_501c3",
      "nonprofit_other",
      "private_higher_education",
      "individual",
      "for_profit_not_small",
      "small_business",
      "others",
      "unrestricted"
     ],
     "type": "string"
    },
    "maxItems": 17,
    "minItems": 1,
    "type": "array"
   },
   "codes": {
    "items": {
     "pattern": "^\\d{1,2}$",
     "type": "string"
    },
    "maxItems": 17,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "eligibility_explainer",
 "title": "Explain eligibility codes"
}
