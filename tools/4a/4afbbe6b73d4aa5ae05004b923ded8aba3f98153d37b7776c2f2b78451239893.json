{
 "description": "Evaluate ALLOW | DENY | REQUIRE_APPROVE for an agent action at the tool boundary. Sole PEP is Shield KYA; missing APPROVED means no irreversible side effect.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action or toolId",
    "type": "string"
   },
   "agentId": {
    "type": "string"
   },
   "approvalStatus": {
    "enum": [
     "NONE",
     "PENDING",
     "APPROVED",
     "REJECTED"
    ],
    "type": "string"
   },
   "args": {
    "description": "Tool args (hashed, not logged raw)",
    "type": "object"
   },
   "argsHash": {
    "type": "string"
   },
   "context": {
    "type": "object"
   },
   "host": {
    "enum": [
     "ide",
     "runtime"
    ],
    "type": "string"
   },
   "irreversible": {
    "type": "boolean"
   },
   "sessionRisk": {
    "enum": [
     "LOW",
     "MEDIUM",
     "HIGH"
    ],
    "type": "string"
   },
   "toolId": {
    "description": "Stable tool id (preferred)",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "kya.policy_evaluate"
}
