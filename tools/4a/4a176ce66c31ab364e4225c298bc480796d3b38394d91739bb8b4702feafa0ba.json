{
 "description": "Render a .riv animation (or state machine) to a real-time WebM video using canvas.captureStream() + MediaRecorder (VP9, falls back to VP8/generic webm). Default duration is one loop of the animation (2s for a bare state machine or when the animation's length can't be determined).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "animation": {
    "type": "string"
   },
   "artboard": {
    "type": "string"
   },
   "background": {
    "description": "CSS background color (default: transparent)",
    "type": "string"
   },
   "duration": {
    "description": "Seconds to record (default: one animation loop, or 2s)",
    "exclusiveMinimum": 0,
    "maximum": 30,
    "type": "number"
   },
   "fps": {
    "description": "captureStream() frame rate (default 30)",
    "exclusiveMinimum": 0,
    "maximum": 60,
    "type": "integer"
   },
   "height": {
    "exclusiveMinimum": 0,
    "maximum": 2048,
    "type": "integer"
   },
   "out": {
    "description": "Output .webm path (default: alongside the .riv)",
    "type": "string"
   },
   "path": {
    "description": "Path to the .riv file",
    "type": "string"
   },
   "stateMachine": {
    "type": "string"
   },
   "width": {
    "exclusiveMinimum": 0,
    "maximum": 2048,
    "type": "integer"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "riv_render_video",
 "title": "Render an animation to a WebM video"
}
