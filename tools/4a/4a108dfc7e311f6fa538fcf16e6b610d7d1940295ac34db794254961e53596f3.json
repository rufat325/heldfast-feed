{
 "_meta": {
  "openai/outputTemplate": "ui://widget/xenition-list.html",
  "openai/toolInvocation/invoked": "Your notes",
  "openai/toolInvocation/invoking": "Searching your notes\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "xenition.read",
     "xenition.write"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://xenition-app/xenition-list.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search notes"
 },
 "description": "Use this when the user is looking for one of their Xenition notes by words, tag or notebook. Returns matching notes with links. To search all their content (documents, decks, sheets), use search_artifacts.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "notebook": {
    "description": "only notes in this notebook",
    "type": "string"
   },
   "query": {
    "description": "free text to match in the note title/content",
    "type": "string"
   },
   "tag": {
    "description": "only notes with this tag",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_notes",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "integer"
   },
   "empty": {
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accent": {
       "type": "string"
      },
      "address": {
       "type": "string"
      },
      "detail": {
       "additionalProperties": true,
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "lat": {
       "type": [
        "null",
        "number"
       ]
      },
      "lng": {
       "type": [
        "null",
        "number"
       ]
      },
      "meta": {
       "type": "string"
      },
      "openUrl": {
       "type": "string"
      },
      "phone": {
       "type": "string"
      },
      "subtitle": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "website": {
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "title",
   "count",
   "items"
  ],
  "type": "object"
 },
 "title": "Search notes"
}
