{
 "description": "Export job definitions from a project in JSON, YAML, or XML format",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "description": "Export format (default json)",
    "enum": [
     "json",
     "xml",
     "yaml"
    ],
    "type": "string"
   },
   "groupPath": {
    "description": "Filter by group path",
    "type": "string"
   },
   "jobFilter": {
    "description": "Filter by job name",
    "type": "string"
   },
   "project": {
    "description": "Project name",
    "type": "string"
   }
  },
  "required": [
   "project"
  ],
  "type": "object"
 },
 "name": "rundeck_export_jobs"
}
