{
 "_meta": {
  "group": "schedule"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List members (technicians) for dispatch \u2014 each with timezone, working-hours calendar name, work role, and daily/schedule capacity. Filter by name or identifier; excludes inactive by default.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "identifier": {
    "description": "Exact member identifier",
    "type": "string"
   },
   "include_inactive": {
    "default": false,
    "description": "Include inactive members (default false)",
    "type": "boolean"
   },
   "name_contains": {
    "description": "Match first or last name (substring)",
    "type": "string"
   },
   "page_number": {
    "default": 1,
    "description": "Page number (default 1)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "page_size": {
    "default": 25,
    "description": "Results per page (default 25, max 1000)",
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "type": "integer"
   },
   "response_format": {
    "default": "markdown",
    "description": "Output format: human-readable markdown (default) or structured JSON",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "schedulable_only": {
    "default": false,
    "description": "Only members that are not schedule-restricted (default false)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "cw_list_members",
 "title": "List ConnectWise Members"
}
