{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Geo or CIDR map for Global Traffic Manager",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "detailedMapList": {
    "description": "Detailed map entries",
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "description": "CIDR subnet (e.g., 10.10.10.0/24)",
       "type": "string"
      },
      "geoIdMappings": {
       "description": "Geolocation mappings (for GEO type)",
       "items": {
        "additionalProperties": false,
        "properties": {
         "geoName": {
          "description": "Geolocation name (country/continent)",
          "type": "string"
         },
         "geoType": {
          "description": "Geolocation type (NATION, CONTINENT)",
          "type": "string"
         }
        },
        "required": [
         "geoName",
         "geoType"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "description": "Zone/detail name",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "mapType": {
    "description": "Map type",
    "enum": [
     "GEO",
     "CIDR"
    ],
    "type": "string"
   },
   "name": {
    "description": "Map name",
    "type": "string"
   }
  },
  "required": [
   "name",
   "mapType",
   "detailedMapList"
  ],
  "type": "object"
 },
 "name": "ncloud_gtm_create_geo_cidr_map"
}
