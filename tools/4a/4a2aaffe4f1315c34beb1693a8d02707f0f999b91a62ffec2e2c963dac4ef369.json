{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "CodeInspectus Generate SBOM"
 },
 "description": "Generate a CycloneDX or SPDX SBOM for the target project using Trivy plus the first-party offline Pub lockfile inventory, with native Pub fallback when Trivy is unavailable. Writes the SBOM file to the chosen output path and returns its location and component count. Offline.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "description": "SBOM format (default: cyclonedx).",
    "enum": [
     "cyclonedx",
     "spdx"
    ],
    "type": "string"
   },
   "output_path": {
    "description": "Where to write the SBOM file. Default: ~/.codeinspectus/sbom/<project>.<fmt>.json.",
    "type": "string"
   },
   "path": {
    "description": "Absolute path to the project to generate an SBOM for.",
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "codeinspectus_generate_sbom",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "component_count": {
    "type": "integer"
   },
   "coverage_state": {
    "enum": [
     "combined",
     "native_only",
     "trivy_only",
     "unavailable"
    ],
    "type": "string"
   },
   "ecosystems": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "format": {
    "type": "string"
   },
   "generated": {
    "type": "boolean"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "lockfiles_analyzed": {
    "minimum": 0,
    "type": "integer"
   },
   "note": {
    "type": "string"
   },
   "offline": {
    "type": "boolean"
   },
   "output_path": {
    "type": "string"
   },
   "providers": {
    "items": {
     "enum": [
      "trivy",
      "codeinspectus-pub"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "format",
   "output_path",
   "component_count",
   "generated",
   "offline",
   "providers",
   "ecosystems",
   "coverage_state",
   "lockfiles_analyzed",
   "limitations"
  ],
  "type": "object"
 },
 "title": "Generate a software bill of materials"
}
