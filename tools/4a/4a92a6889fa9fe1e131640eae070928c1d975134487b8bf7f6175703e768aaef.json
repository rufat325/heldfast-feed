     "type": "string"
    },
    "type": "array"
   },
   "outcome": {
    "enum": [
     "computed",
     "needs_inputs",
     "invalid_input"
    ],
    "type": "string"
   },
   "problems": {
    "items": {
     "type": "string"
    },
