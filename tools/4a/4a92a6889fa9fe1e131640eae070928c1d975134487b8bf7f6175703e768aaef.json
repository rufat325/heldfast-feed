{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when someone wants to compare 3D printing with injection molding for a quantity, using their own numbers: quantity, printed unit cost, tooling cost and molded unit cost. It returns the totals for each, the crossover quantity on those numbers, and the published range with sources. It makes up no cost, and when a number is missing it says which.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "molded_unit_cost": {
    "description": "The user's cost per molded part once the tool exists, in US dollars.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "printed_unit_cost": {
    "description": "The user's cost per printed part, in US dollars.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "quantity": {
    "description": "The total or yearly quantity to compare.",
    "maximum": 1000000,
    "minimum": 1,
    "type": "integer"
   },
   "revision_cost": {
    "description": "Cost per tool revision, in US dollars.",
    "minimum": 0,
    "type": "number"
   },
   "setup_cost": {
    "description": "Setup or secondary cost per printed order, in US dollars. Default 0.",
    "minimum": 0,
    "type": "number"
   },
   "tool_revisions": {
    "description": "Expected tool revisions. Default 0.",
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "tooling_cost": {
    "description": "What the mold costs, in US dollars. 0 if the user has no tooling quote yet.",
    "minimum": 0,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "compare_print_vs_molding",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
