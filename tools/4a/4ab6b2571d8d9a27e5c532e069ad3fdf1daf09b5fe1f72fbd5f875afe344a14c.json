{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update a Live Station VOD-to-Live channel's name, environment type or output protocol (vodchannelupdate).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "channelId": {
    "description": "VOD-to-Live channel ID",
    "type": "string"
   },
   "channelName": {
    "description": "Channel name (3-20 chars: Korean, letters, digits, '_') \u2014 required by the API even when unchanged",
    "type": "string"
   },
   "envType": {
    "description": "Channel environment type",
    "enum": [
     "REAL",
     "DEV",
     "STAGE"
    ],
    "type": "string"
   },
   "outputProtocol": {
    "description": "Output protocol",
    "enum": [
     "HLS",
     "LL_HLS",
     "HLS,DASH"
    ],
    "type": "string"
   }
  },
  "required": [
   "channelId",
   "channelName"
  ],
  "type": "object"
 },
 "name": "ncloud_livestation_update_vod_channel"
}
