{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "qa",
 "description": "Unified tool for multimodal AI evaluation: set action=guide for reference thresholds/interpretation (CLIP, FID, VQA), or set action=clip_score / fid_score / vqa_accuracy / pipeline to compute real metrics via HuggingFace Inference API and VLM BYOK calls. One tool for both reference and computation.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "guide (default) = reference thresholds/interpretation. clip_score/fid_score/vqa_accuracy = compute that metric. pipeline = run all three.",
    "enum": [
     "guide",
     "clip_score",
     "fid_score",
     "vqa_accuracy",
     "pipeline"
    ],
    "type": "string"
   },
   "api_key": {
    "description": "[vqa_accuracy] Your API key for the provider (BYOK).",
    "type": "string"
   },
   "clip": {
    "additionalProperties": true,
    "description": "[pipeline] {image_url, text} for CLIP.",
    "type": "object"
   },
   "fid": {
    "additionalProperties": true,
    "description": "[pipeline] {real_images, generated_images} for FID.",
    "type": "object"
   },
   "generated_images": {
    "description": "[fid_score] Array of generated image URLs.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "image_base64": {
    "description": "[clip_score/vqa_accuracy] Base64-encoded image data.",
    "type": "string"
   },
   "image_mime_type": {
    "description": "[clip_score/vqa_accuracy] MIME type for base64 image.",
    "type": "string"
   },
   "image_url": {
    "description": "[clip_score/vqa_accuracy] Public URL of the image.",
    "type": "string"
   },
   "metric": {
    "description": "[guide only] Metric to explain.",
    "enum": [
     "clip_score",
     "fid",
     "vqa_accuracy",
     "all"
    ],
    "type": "string"
   },
   "model": {
    "description": "[vqa_accuracy] VLM model ID (default: gpt-4o).",
    "type": "string"
   },
   "real_images": {
    "description": "[fid_score] Array of real image URLs.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "score": {
    "description": "[guide only] Optional score value to interpret.",
    "type": "number"
   },
   "system_prompt": {
    "description": "[vqa_accuracy] Optional system prompt.",
    "type": "string"
   },
   "test_cases": {
    "description": "[vqa_accuracy] Array of {question, accepted_answers} objects.",
    "items": {
     "properties": {
      "accepted_answers": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "question": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "text": {
    "description": "[clip_score only] Text description to compare against the image.",
    "type": "string"
   },
   "vqa": {
    "additionalProperties": true,
    "description": "[pipeline] VQA config object (same inputs as vqa_accuracy).",
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "multimodal_eval_guide",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "best_practices": {
    "type": "array"
   },
   "comparison_table": {
    "type": "array"
   },
   "errors": {},
   "metrics": {},
   "results": {},
   "score_interpretation": {},
   "web_tool": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
