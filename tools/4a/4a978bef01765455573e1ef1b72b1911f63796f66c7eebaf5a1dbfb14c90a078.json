 "description": "Create a new SERVICE ticket on a board for a company. Project tickets cannot be created here \u2014 they need a project and a phase.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
