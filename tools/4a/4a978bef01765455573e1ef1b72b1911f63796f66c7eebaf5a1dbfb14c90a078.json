   "board": {
    "description": "Service board name (e.g. \"Help Desk\")",
    "type": "string"
   },
   "company_id": {
    "description": "Company ID (find with cw_search_companies)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "initial_description": {
    "description": "Initial description note",
    "type": "string"
   },
   "priority": {
    "description": "Priority name (board default when omitted)",
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "description": "Output format: human-readable markdown (default) or structured JSON",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "status": {
    "description": "Status name (board default when omitted; must exist on the board \u2014 see cw_get_board)",
