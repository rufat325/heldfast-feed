{
 "description": "Find and replace text across a spreadsheet. Searches all sheets by default, or limit with gid/range. Supports regex with capture groups ($1, $2).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "find": {
    "description": "Text or regex pattern to find",
    "minLength": 1,
    "type": "string"
   },
   "gid": {
    "description": "Limit to specific sheet. If omitted, searches all sheets.",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "includeFormulas": {
    "description": "Search within formula text",
    "type": "boolean"
   },
   "matchCase": {
    "description": "Case-sensitive matching",
    "type": "boolean"
   },
   "matchEntireCell": {
    "description": "Only match entire cell content",
    "type": "boolean"
   },
   "range": {
    "description": "Limit to specific A1 range within the sheet (requires gid)",
    "minLength": 1,
    "type": "string"
   },
   "replacement": {
    "description": "Replacement text. Use $1, $2 for regex capture groups. Empty string deletes matches.",
    "type": "string"
   },
   "searchByRegex": {
    "description": "Treat find as RE2 regex",
    "type": "boolean"
   }
  },
  "required": [
   "id",
   "find",
   "replacement"
  ],
  "type": "object"
 },
 "name": "values-replace",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "formulasChanged": {
        "description": "Number of formula cells changed",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "occurrencesChanged": {
        "description": "Total replacements made",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "rowsChanged": {
        "description": "Number of rows with replacements",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "sheetsChanged": {
        "description": "Number of sheets with replacements",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "spreadsheetUrl": {
        "description": "URL of the spreadsheet",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       },
       "valuesChanged": {
        "description": "Number of non-formula cells changed",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "type",
       "id",
       "spreadsheetUrl",
       "occurrencesChanged",
       "valuesChanged",
       "formulasChanged",
       "rowsChanged",
       "sheetsChanged"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
