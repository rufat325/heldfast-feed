{
 "description": "Browse all items in one shadcn.io registry category, paginated.\nBest when you know which category to look in (e.g., \"pricing\", \"dashboard\", \"hero\").\nUse shadcn_registry_categories first to find the slug.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "Category slug \u2014 e.g., \"dashboard\", \"hero\", \"pricing\"",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "premium": {
    "description": "Restrict to free (false) or premium (true)",
    "type": "boolean"
   }
  },
  "required": [
   "category"
  ],
  "type": "object"
 },
 "name": "shadcn_registry_browse"
}
