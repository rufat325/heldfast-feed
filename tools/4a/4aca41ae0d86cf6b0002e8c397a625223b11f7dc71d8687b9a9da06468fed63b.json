{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Product changelog"
 },
 "description": "Read recent uploads.sh product updates (platform and CLI). Returns the latest entries with titles, dates, summaries, and a link to the full changelog at https://uploads.sh/changelog. Same as `uploads changelog`.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "How many entries to return (default 5, max 50).",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "changelog",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "type": "string"
      },
      "date": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "platform",
        "cli"
       ],
       "type": "string"
      },
      "summary": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "kind",
      "title",
      "date",
      "url",
      "tags",
      "summary",
      "body"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "feed": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "entries"
  ],
  "type": "object"
 },
 "title": "Product changelog"
}
