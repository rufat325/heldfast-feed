{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check how a split is going"
 },
 "description": "Return one split in full: who owes what, whether they have paid, the notes they left, and the share URLs.",
 "inputSchema": {
  "properties": {
   "admin_token": {
    "description": "The t= value from the manage URL, or the whole manage URL.",
    "type": "string"
   }
  },
  "required": [
   "admin_token"
  ],
  "type": "object"
 },
 "name": "get_split",
 "outputSchema": {
  "properties": {
   "collected": {
    "description": "How much has come in.",
    "type": "number"
   },
   "members": {
    "items": {
     "properties": {
      "adults": {
       "description": "Adults in this household (default 1).",
       "type": "number"
      },
      "amount": {
       "type": "number"
      },
      "children": {
       "description": "Children in this household. A child pays half an adult.",
       "type": "number"
      },
      "comment": {
       "description": "A note left by the payer.",
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "state": {
       "description": "One of: paid up front (not billed) / paid / unpaid.",
       "type": "string"
      }
     },
     "required": [
      "name",
      "amount",
      "state"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "paynow": {
    "properties": {
     "name": {
      "type": [
       "string",
       "null"
      ]
     },
     "target": {
      "type": "string"
     }
    },
    "required": [
     "target"
    ],
    "type": "object"
   },
   "people": {
    "type": "number"
   },
   "share_urls": {
    "items": {
     "properties": {
      "amount": {
       "type": "number"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "amount",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "title": {
    "type": "string"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "title",
   "total",
   "collected",
   "people",
   "members",
   "share_urls",
   "paynow"
  ],
  "type": "object"
 },
 "title": "Check how a split is going"
}
