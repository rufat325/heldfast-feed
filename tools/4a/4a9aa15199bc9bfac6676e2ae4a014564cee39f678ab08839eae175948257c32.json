{
 "description": "Read the invitation state for exactly one job + candidate (proposal_management.job_invitations.get). Unknown, hidden, banned, closed, and never-invited candidates ALL read the same uniform { invited: false, invitation: null } (no enumeration signal); otherwise the masked invitation with its derived state, hireAcceptancePending, and linked proposal id. structuredContent IS the raw validated lookup. Requires proposals:read scope, the hiring feature, and employer access to the job; the proposal_management family is DEFAULT-OFF (AGENT_SURFACE_PROPOSAL_MANAGEMENT_ENABLED) and a disabled family is a typed 403 AGENT_SURFACE_DISABLED.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "freelancerId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "jobId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "freelancerId"
  ],
  "type": "object"
 },
 "name": "opentrain_get_job_invitation",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asOf": {
    "type": "string"
   },
   "freelancerId": {
    "type": "string"
   },
   "invitation": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "candidate": {
        "additionalProperties": false,
        "properties": {
         "countryCode": {
          "type": [
           "string",
           "null"
          ]
         },
         "displayName": {
          "type": "string"
         },
         "profileSlug": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "displayName",
         "profileSlug",
         "countryCode"
        ],
        "type": "object"
       },
       "freelancerId": {
        "type": "string"
       },
       "hireAcceptancePending": {
        "type": "boolean"
       },
       "id": {
        "type": "string"
       },
       "invitedAt": {
        "type": "string"
       },
       "jobId": {
        "type": "string"
       },
       "linkedProposalId": {
        "type": [
         "string",
         "null"
        ]
       },
       "state": {
        "enum": [
         "INVITED",
         "DECLINED",
         "APPLIED",
         "HIRED"
        ],
        "type": "string"
       },
       "updatedAt": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "jobId",
       "freelancerId",
       "candidate",
       "invitedAt",
       "updatedAt",
       "state",
       "hireAcceptancePending",
       "linkedProposalId"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "invited": {
    "type": "boolean"
   },
   "jobId": {
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "freelancerId",
   "asOf",
   "invited",
   "invitation"
  ],
  "type": "object"
 }
}
