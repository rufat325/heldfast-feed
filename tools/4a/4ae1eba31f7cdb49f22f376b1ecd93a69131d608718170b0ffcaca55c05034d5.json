{
 "annotations": {
  "title": "Go to waypoint"
 },
 "description": "Navigate to a saved waypoint by name (pathfinds and blocks until arrival). Cancellable; throws NO_PATH if unreachable, TIMEOUT if it takes too long.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "name": {
    "description": "Waypoint name to travel to",
    "minLength": 1,
    "type": "string"
   },
   "range": {
    "description": "How close to get, in blocks (default 1)",
    "minimum": 0,
    "type": "number"
   },
   "timeout": {
    "description": "Max ms to spend navigating (default 60000)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "goto_waypoint"
}
