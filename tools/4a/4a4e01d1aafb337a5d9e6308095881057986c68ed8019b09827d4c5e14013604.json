    "minimum": -9007199254740991,
    "type": "integer"
   },
   "phone": {
    "description": "Primary phone number (mapped to the phones array).",
    "type": "string"
   },
   "visible_to": {
    "description": "Visibility group id (Pipedrive visibility setting).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
