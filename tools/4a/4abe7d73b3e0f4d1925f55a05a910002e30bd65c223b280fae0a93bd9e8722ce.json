{
 "_meta": {
  "growsurf/riskTier": "CONTENT"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create Program Resource"
 },
 "description": "Create a `FILE`, `LINK`, or `TEXT` resource for participants. `LINK` requires an HTTPS `url`. `TEXT` requires plain `text`. For a `FILE` up to 10 MB, call `growsurf_prepare_program_resource_file` first and pass its `uploadTicket` and `uploadResult` unchanged. New resources default to draft unless you set `isPublished`. Targets `campaignId` if you pass it, otherwise GROWSURF_CAMPAIGN_ID.",
 "inputSchema": {
  "additionalProperties": false,
  "allOf": [
   {
    "if": {
     "properties": {
      "type": {
       "const": "FILE"
      }
     }
    },
    "then": {
     "not": {
      "anyOf": [
       {
        "required": [
         "url"
        ]
       },
       {
        "required": [
         "text"
        ]
       }
      ]
     },
     "required": [
      "uploadTicket",
      "uploadResult"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "type": {
       "const": "LINK"
      }
     }
    },
    "then": {
     "not": {
      "anyOf": [
       {
        "required": [
         "text"
        ]
       },
       {
        "required": [
         "uploadTicket"
        ]
       },
       {
        "required": [
         "uploadResult"
        ]
       }
      ]
     },
     "required": [
      "url"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "type": {
       "const": "TEXT"
      }
     }
    },
    "then": {
     "not": {
      "anyOf": [
       {
        "required": [
         "url"
        ]
       },
       {
        "required": [
         "uploadTicket"
        ]
       },
       {
        "required": [
         "uploadResult"
        ]
       }
      ]
     },
     "required": [
      "text"
     ]
    }
   }
  ],
  "properties": {
   "campaignId": {
    "description": "Target program (campaign) id for this call. Defaults to GROWSURF_CAMPAIGN_ID when omitted. Pass the `id` returned by growsurf_create_campaign to configure or operate a program you just created, without restarting the server.",
    "type": "string"
   },
   "category": {
    "maxLength": 60,
    "type": [
     "string",
     "null"
    ]
   },
   "description": {
    "maxLength": 500,
    "type": [
     "string",
     "null"
    ]
   },
   "isPublished": {
    "type": "boolean"
   },
   "text": {
    "description": "Used only with `TEXT`.",
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "enum": [
     "FILE",
     "LINK",
     "TEXT"
    ],
    "type": "string"
   },
   "uploadResult": {
    "additionalProperties": true,
    "description": "The unmodified result returned by the secure upload flow. Used only with `FILE`.",
    "properties": {
     "asset_id": {
      "type": "string"
     },
     "bytes": {
      "maximum": 10485760,
      "minimum": 1,
      "type": "integer"
     },
     "format": {
      "type": "string"
     },
     "public_id": {
      "type": "string"
     },
     "resource_type": {
      "enum": [
       "image",
       "raw"
      ],
      "type": "string"
     },
     "secure_url": {
      "pattern": "^https://",
      "type": "string"
     },
     "signature": {
      "type": "string"
     },
     "type": {
      "const": "authenticated",
      "type": "string"
     },
     "version": {
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "public_id",
     "version",
     "signature",
     "resource_type",
     "type",
     "bytes",
     "secure_url"
    ],
    "type": "object"
   },
   "uploadTicket": {
    "description": "The one-time upload ticket. Used only with `FILE`.",
    "minLength": 20,
    "type": "string"
   },
   "url": {
    "description": "Used only with `LINK`.",
    "maxLength": 2048,
    "pattern": "^https://",
    "type": "string"
   }
  },
  "required": [
   "type",
   "title"
  ],
  "type": "object"
 },
 "name": "growsurf_create_program_resource",
 "outputSchema": {
  "description": "The created resource. Same shape as the items in the `growsurf_list_program_resources` result.",
  "type": "object"
 },
 "title": "Create Program Resource"
}
