{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "firefly:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get the parameter schema for a specific operation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entity": {
    "description": "Entity the operation belongs to.",
    "enum": [
     "account",
     "transaction",
     "budget",
     "category",
     "tag",
     "rule",
     "rule_group",
     "bill",
     "piggy_bank",
     "summary",
     "search",
     "insight",
     "currency",
     "exchange_rate",
     "attachment",
     "recurring_transaction",
     "autocomplete",
     "available_budget",
     "transaction_link",
     "link_type",
     "object_group",
     "preference",
     "configuration",
     "data_export",
     "analysis",
     "resolve"
    ],
    "type": "string"
   },
   "operation": {
    "description": "Operation name within that entity, as firefly_list_operations reports it, e.g. \"list\".",
    "type": "string"
   }
  },
  "required": [
   "entity",
   "operation"
  ],
  "type": "object"
 },
 "name": "firefly_get_schema"
}
