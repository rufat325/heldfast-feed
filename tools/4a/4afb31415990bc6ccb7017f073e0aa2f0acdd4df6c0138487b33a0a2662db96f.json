{
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "events": {
    "description": "Event types to watch",
    "items": {
     "enum": [
      "dom:mutation",
      "network:request",
      "network:response",
      "console:error",
      "console:warn",
      "navigation",
      "dialog"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "maxEvents": {
    "description": "Maximum events to capture (default: 1000)",
    "type": "number"
   },
   "urlPattern": {
    "description": "Filter network events by URL pattern",
    "type": "string"
   }
  },
  "required": [
   "events"
  ],
  "type": "object"
 },
 "name": "test_watch_events"
}
