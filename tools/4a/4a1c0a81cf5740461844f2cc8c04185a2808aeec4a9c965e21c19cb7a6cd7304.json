{
 "description": "Get a single custom object record by schema key and record ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "recordId": {
    "description": "The record ID to retrieve",
    "type": "string"
   },
   "schemaKey": {
    "description": "Custom object schema key",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "schemaKey",
   "recordId"
  ],
  "type": "object"
 },
 "name": "crm_get_object_record"
}
