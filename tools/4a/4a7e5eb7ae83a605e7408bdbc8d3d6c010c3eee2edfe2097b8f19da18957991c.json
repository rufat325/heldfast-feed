{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Searches the npm registry for packages matching a query. Note: pnpm and yarn do not have a search command, so this always uses npm.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "exclude": {
    "description": "Exclude packages matching this text from results (maps to --searchexclude)",
    "maxLength": 255,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of results to return (default: 20)",
    "type": "number"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "preferOnline": {
    "description": "Bypass cache and fetch fresh results from the registry (maps to --prefer-online)",
    "type": "boolean"
   },
   "query": {
    "description": "Search query string",
    "maxLength": 255,
    "type": "string"
   },
   "registry": {
    "description": "Registry URL to search (maps to --registry, e.g., 'https://npm.pkg.github.com')",
    "maxLength": 65536,
    "type": "string"
   },
   "searchopts": {
    "description": "Advanced search filtering options (maps to --searchopts)",
    "maxLength": 65536,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "packageManager": {
    "description": "Package manager that was used (npm, pnpm, or yarn)",
    "enum": [
     "npm",
     "pnpm",
     "yarn"
    ],
    "type": "string"
   },
   "packages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": "string"
      },
      "date": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "keywords": {
       "description": "Package keywords",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "links": {
       "additionalProperties": false,
       "description": "Package URLs",
       "properties": {
        "homepage": {
         "type": "string"
        },
        "npm": {
         "type": "string"
        },
        "repository": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "name": {
       "type": "string"
      },
      "scope": {
       "description": "Package scope (e.g., '@types')",
       "type": "string"
      },
      "score": {
       "description": "Registry-computed relevance score",
       "type": "number"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "version",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "packages"
  ],
  "type": "object"
 },
 "title": "Search npm Registry"
}
