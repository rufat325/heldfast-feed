{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Add localisation keys (mode add: key and text; language, file, replace) or repair localisation files (mode fix: BOM, broken quotes, keys missing from supported languages). Game keys are overridden from a replace folder. apply false returns the diff and writes nothing; apply true writes it. Returns up to 10 files with diffs. Example: {\"mode\":\"add\",\"entries\":[{\"key\":\"my_focus\",\"text\":\"My focus\"}]}","inputSchema":{"additionalProperties":false,"properties":{"apply":{"default":false,"description":"false returns the diff and writes nothing; true makes the same change.","type":"boolean"},"entries":{"items":{"additionalProperties":false,"properties":{"key":{"pattern":"^[A-Za-z0-9_.-]{1,256}$","type":"string"},"text":{"maxLength":2000,"type":"string"}},"required":["key","text"],"type":"object"},"maxItems":200,"minItems":1,"type":"array"},"file":{"maxLength":512,"minLength":1,"type":"string"},"fixes":{"default":["bom","quotes","missing_languages"],"items":{"enum":["bom","quotes","missing_languages"],"type":"string"},"maxItems":3,"minItems":1,"type":"array"},"language":{"default":"english","enum":["english","french","german","spanish","polish","russian","braz_por","japanese","simp_chinese","korean"],"type":"string"},"mode":{"enum":["add","fix"],"type":"string"},"paths":{"items":{"maxLength":512,"minLength":1,"type":"string"},"maxItems":200,"minItems":1,"type":"array"},"replace":{"default":false,"type":"boolean"},"requestKey":{"maxLength":256,"minLength":1,"type":"string"},"workspaceId":{"default":"current","pattern":"^[a-z][a-z0-9_-]{0,63}$","type":"string"}},"required":["mode"],"type":"object"},"name":"hoi4.localisation_write","outputSchema":{"additionalProperties":false,"properties":{"artifacts":{"items":{},"maxItems":32,"type":"array"},"blockers":{"items":{},"type":"array"},"changedFiles":{"items":{},"type":"array"},"code":{"type":"string"},"data":{"additionalProperties":{},"properties":{},"type":"object"},"diagnostics":{"items":{},"maxItems":20,"type":"array"},"filesScanned":{"items":{},"type":"array"},"proposedFiles":{"items":{},"type":"array"},"status":{"enum":["ok","blocked","error"],"type":"string"},"validation":{},"workspaceId":{"type":"string"}},"required":["status","code","workspaceId","validation","data"],"type":"object"},"title":"Add or fix localisation"}
