{
 "description": "Onboard a marketplace seller via Getnet Marketplace Management. Required before routing split payments to a seller.",
 "inputSchema": {
  "properties": {
   "bank_accounts": {
    "description": "Seller payout bank accounts",
    "type": "array"
   },
   "business_address": {
    "description": "Seller commercial address",
    "properties": {
     "city": {
      "type": "string"
     },
     "country_code": {
      "description": "ISO-3166 alpha-3 (e.g. BRA)",
      "type": "string"
     },
     "district": {
      "type": "string"
     },
     "mailing_address_equals": {
      "enum": [
       "S",
       "N"
      ],
      "type": "string"
     },
     "number": {
      "type": "string"
     },
     "postal_code": {
      "type": "string"
     },
     "state": {
      "type": "string"
     },
     "street": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "legal_document_number": {
    "type": "string"
   },
   "legal_document_type": {
    "enum": [
     "CPF",
     "CNPJ"
    ],
    "type": "string"
   },
   "legal_name": {
    "description": "Raz\u00e3o social (CNPJ) or full name (CPF)",
    "type": "string"
   },
   "mcc": {
    "description": "Merchant category code (ISO 18245)",
    "type": "string"
   },
   "merchant_id": {
    "description": "Marketplace merchant id",
    "type": "string"
   },
   "trade_name": {
    "description": "Nome fantasia",
    "type": "string"
   }
  },
  "required": [
   "merchant_id",
   "legal_document_type",
   "legal_document_number",
   "legal_name"
  ],
  "type": "object"
 },
 "name": "create_seller"
}
