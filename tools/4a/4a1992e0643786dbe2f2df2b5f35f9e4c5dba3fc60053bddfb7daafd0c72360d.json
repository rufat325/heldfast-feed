{"_meta":{"fastmcp":{"tags":[]}},"annotations":{"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Search this shop's product catalog (UCP catalog.search). Dimensions such as '80x80' work in the query. Returns products with price in minor units, availability status, URL and key parameters (metadata.parameters). filters.compatible_with keeps only products that fit a given product. Paginate with pagination.cursor.","inputSchema":{"additionalProperties":false,"properties":{"catalog":{"properties":{"attribution":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"description":"UCP attribution (ignored)."},"context":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"description":"UCP buyer context (ignored)."},"filters":{"anyOf":[{"properties":{"categories":{"anyOf":[{"items":{"type":"string"},"maxItems":20,"type":"array"},{"type":"null"}],"default":null,"description":"Not supported yet; ignored with a message."},"compatible_with":{"anyOf":[{"maxLength":100,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Only products that fit this product (product ID or SKU), i.e. those find_compatible returns as fits or fits_after_cut."},"price":{"anyOf":[{"properties":{"max":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"description":"Maximum, minor units."},"min":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"description":"Minimum, minor units."}},"type":"object"},{"type":"null"}],"default":null,"description":"Price incl. VAT in the shop currency, ISO 4217 minor units."}},"type":"object"},{"type":"null"}],"default":null},"pagination":{"anyOf":[{"properties":{"cursor":{"anyOf":[{"maxLength":64,"type":"string"},{"type":"null"}],"default":null,"description":"Opaque cursor."},"limit":{"anyOf":[{"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"description":"Requested page size (the server c