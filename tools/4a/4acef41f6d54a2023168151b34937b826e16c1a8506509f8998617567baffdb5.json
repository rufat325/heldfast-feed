{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create infrastructure asset document"
 },
 "description": "Attach document metadata to an infrastructure feature. Upload the file bytes first via create_upload_url, then pass the returned file_path here. Requires infrastructure_asset_documents:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Document category",
    "maxLength": 100,
    "type": "string"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "feature_id": {
    "description": "Infrastructure feature ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "file_path": {
    "description": "Storage path from create_upload_url (required)",
    "maxLength": 2000,
    "type": "string"
   },
   "file_size": {
    "description": "File size in bytes",
    "minimum": 0,
    "type": "number"
   },
   "file_type": {
    "description": "MIME type",
    "maxLength": 200,
    "type": "string"
   },
   "name": {
    "description": "Document name (required)",
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "feature_id",
   "name",
   "file_path"
  ],
  "type": "object"
 },
 "name": "create_infrastructure_asset_document",
 "title": "Create infrastructure asset document"
}
