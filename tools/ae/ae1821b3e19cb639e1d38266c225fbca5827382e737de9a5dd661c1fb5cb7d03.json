{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Rename, move (parent null = top level), change kind, budget inclusion, mandatory flag or archive a category.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "archived": {
    "type": "boolean"
   },
   "category": {
    "description": "Category name, path or id",
    "type": "string"
   },
   "include_in_budget": {
    "description": "Whether the category counts in budget calculations",
    "type": "boolean"
   },
   "kind": {
    "enum": [
     "expense",
     "income",
     "both"
    ],
    "type": "string"
   },
   "parent": {
    "description": "New top-level parent; null makes it top-level",
    "type": [
     "string",
     "null"
    ]
   },
   "required": {
    "type": "boolean"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "category"
  ],
  "type": "object"
 },
 "name": "update_category",
 "title": "Edit category"
}
