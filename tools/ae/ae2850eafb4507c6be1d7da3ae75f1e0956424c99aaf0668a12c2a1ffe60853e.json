{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Write a guarded starter marketplace index JSON with optional built-in seed entries and custom package entries. Use this before local_marketplace_index when planning a local package marketplace; overwrite=false protects existing index files.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "entries": {
    "default": [],
    "items": {
     "properties": {
      "description": {
       "minLength": 1,
       "type": "string"
      },
      "homepage": {
       "format": "uri",
       "type": "string"
      },
      "id": {
       "description": "Stable marketplace id.",
       "minLength": 1,
       "pattern": "^[a-z0-9][a-z0-9._-]*$",
       "type": "string"
      },
      "kind": {
       "default": "toolkit",
       "enum": [
        "recipe-pack",
        "component-pack",
        "look-pack",
        "asset-pack",
        "toolkit"
       ],
       "type": "string"
      },
      "license": {
       "type": "string"
      },
      "name": {
       "minLength": 1,
       "type": "string"
      },
      "source_path": {
       "description": "Local path or relative pack path for this entry.",
       "type": "string"
      },
      "tags": {
       "default": [],
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "version": {
       "default": "0.1.0",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "include_builtin_starters": {
    "default": true,
    "description": "Include starter package ideas that can be replaced with real local package paths.",
    "type": "boolean"
   },
   "name": {
    "default": "tdmcp-local-marketplace",
    "type": "string"
   },
   "out_file": {
    "description": "Path to the seed marketplace JSON file to write.",
    "type": "string"
   },
   "overwrite": {
    "default": false,
    "description": "When false, fail if out_file already exists.",
    "type": "boolean"
   }
  },
  "required": [
   "out_file"
  ],
  "type": "object"
 },
 "name": "marketplace_index_seed",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "builtin_count": {
    "type": "number"
   },
   "custom_count": {
    "type": "number"
   },
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "minLength": 1,
       "type": "string"
      },
      "homepage": {
       "format": "uri",
       "type": "string"
      },
      "id": {
       "description": "Stable marketplace id.",
       "minLength": 1,
       "pattern": "^[a-z0-9][a-z0-9._-]*$",
       "type": "string"
      },
      "kind": {
       "default": "toolkit",
       "enum": [
        "recipe-pack",
        "component-pack",
        "look-pack",
        "asset-pack",
        "toolkit"
       ],
       "type": "string"
      },
      "license": {
       "type": "string"
      },
      "name": {
       "minLength": 1,
       "type": "string"
      },
      "source_path": {
       "description": "Local path or relative pack path for this entry.",
       "type": "string"
      },
      "tags": {
       "default": [],
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "version": {
       "default": "0.1.0",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "version",
      "kind",
      "description",
      "tags"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "index_path": {
    "type": "string"
   },
   "name": {
    "type": "string"
   }
  },
  "required": [
   "index_path",
   "name",
   "entries",
   "builtin_count",
   "custom_count"
  ],
  "type": "object"
 },
 "title": "Marketplace index seed"
}
