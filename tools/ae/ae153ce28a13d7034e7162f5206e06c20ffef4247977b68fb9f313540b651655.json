 "description": "Official exchange rates for 30 major currencies (European Central Bank reference rates): latest or any date since 1999, convert an amount, or a time series. Frankfurter API over ECB reference rates, published each working day ~16:00 CET. For crypto use crypto_price. Price: free. Errors: returns isError with a message for invalid input or an upstream failure (not charged).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "amount": {
    "default": 1,
    "description": "Amount of the base currency to convert. Default 1.",
    "minimum": 0,
    "type": "number"
   },
   "date": {
    "description": "historical date (optional)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "end_date": {
    "description": "with date: returns a daily series",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "from": {
    "default": "USD",
    "description": "Base currency ISO 4217 code, e.g. \"USD\". Default \"USD\".",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "to": {
    "description": "targets (default: all) 0-30 items.",
    "items": {
     "pattern": "^[A-Za-z]{3}$",
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   }
  },
  "type": "object"
 },
