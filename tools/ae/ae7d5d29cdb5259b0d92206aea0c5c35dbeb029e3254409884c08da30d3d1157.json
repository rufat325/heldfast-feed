    "enum": [
     "resumo",
     "membros"
    ],
    "type": "string"
   },
   "sigla": {
    "description": "Sigla da comiss\u00e3o (ex: CCJ, CAE)",
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "sigla"
  ],
  "type": "object"
 },
