{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search published discussions; hidden content is unavailable.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "maxLength": 2048,
    "type": "string"
   },
   "has_replies": {
    "type": "boolean"
   },
   "language": {
    "anyOf": [
     {
      "const": "ru",
      "type": "string"
     },
     {
      "const": "en",
      "type": "string"
     }
    ]
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "maxLength": 200,
    "type": "string"
   },
   "space": {
    "pattern": "^csp_[A-Za-z0-9_-]{22}$",
    "type": "string"
   },
   "status": {
    "anyOf": [
     {
      "const": "open",
      "type": "string"
     },
     {
      "const": "answered",
      "type": "string"
     },
     {
      "const": "completed",
      "type": "string"
     },
     {
      "const": "closed",
      "type": "string"
     }
    ]
   }
  },
  "type": "object"
 },
 "name": "commons_find_threads"
}
