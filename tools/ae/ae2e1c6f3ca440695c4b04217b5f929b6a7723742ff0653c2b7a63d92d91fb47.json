{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false,
  "title": "Ops Alerts Update"
 },
 "description": "Update an alert rule. Partial update of a rule's tunable knobs. `metricId` is immutable \u2014 the metric also pins the aggregation, so a body carrying `metricId` is rejected with `409 IMMUTABLE_FIELD`; create a new rule bound to the other metric instead (rule deletion is dashboard-only).",
 "inputSchema": {
  "properties": {
   "comparator": {
    "enum": [
     "gt",
     "gte",
     "lt",
     "lte"
    ],
    "type": "string"
   },
   "enabled": {
    "type": "boolean"
   },
   "id": {
    "description": "A resource path identifier \u2014 an opaque `xxx_<ULID>` id (~30 chars) or the resource's `name`/`key`. 1\u2013128 characters; the upper bound matches the longest name/key any resource accepts, so an over-long value can never name a real row.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "notify": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "email": {
        "anyOf": [
         {
          "format": "email",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "slackChannel": {
        "anyOf": [
         {
          "additionalProperties": false,
          "properties": {
           "id": {
            "minLength": 1,
            "type": "string"
           },
           "name": {
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "id",
           "name"
          ],
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Delivery target for a notification; `null` = use the project default."
   },
   "severity": {
    "enum": [
     "danger",
     "warn",
     "info"
    ],
    "type": "string"
   },
   "threshold": {
    "type": "number"
   },
   "windowHours": {
    "maximum": 720,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "ops_alerts_update"
}
