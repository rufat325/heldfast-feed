{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Render one authorized PDF page crop as PNG. x/y/width/height are normalized 0-1 page fractions; output is bounded to four million pixels.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capability": {
    "description": "Document capability returned by POST /v1/documents.",
    "maxLength": 64,
    "minLength": 40,
    "type": "string"
   },
   "document_id": {
    "description": "UUID returned by POST /v1/documents.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "height": {
    "description": "Normalized crop height.",
    "maximum": 1,
    "minimum": 0.001,
    "type": "number"
   },
   "page": {
    "description": "1-based page to render.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "scale": {
    "description": "Render scale multiplier.",
    "maximum": 3,
    "minimum": 0.5,
    "type": "number"
   },
   "width": {
    "description": "Normalized crop width.",
    "maximum": 1,
    "minimum": 0.001,
    "type": "number"
   },
   "x": {
    "description": "Normalized left crop coordinate.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "y": {
    "description": "Normalized top crop coordinate.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "document_id",
   "capability",
   "page",
   "x",
   "y",
   "width",
   "height"
  ],
  "type": "object"
 },
 "name": "render_pdf_page_region",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "description": "Rendered PDF crop metadata; the image is returned as an MCP image content block.",
  "properties": {
   "accepts": {
    "items": {},
    "type": "array"
   },
   "bytes": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "contentType": {
    "type": "string"
   },
   "documentId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "error": {},
   "extensions": {},
   "page": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "resource": {},
   "x402Version": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Render PDF page region"
}
