{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get all instances of a recurring event within a time range.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "calendarId": {
    "default": "primary",
    "description": "Calendar ID",
    "type": "string"
   },
   "eventId": {
    "description": "Recurring event ID",
    "type": "string"
   },
   "maxResults": {
    "default": 250,
    "description": "Maximum instances to return",
    "maximum": 2500,
    "minimum": 1,
    "type": "number"
   },
   "pageToken": {
    "description": "Page token for pagination",
    "type": "string"
   },
   "showDeleted": {
    "default": false,
    "description": "Include deleted instances",
    "type": "boolean"
   },
   "timeMax": {
    "description": "Upper bound for instances (RFC3339)",
    "type": "string"
   },
   "timeMin": {
    "description": "Lower bound for instances (RFC3339)",
    "type": "string"
   }
  },
  "required": [
   "eventId"
  ],
  "type": "object"
 },
 "name": "event_instances",
 "title": "Get recurring event instances"
}
