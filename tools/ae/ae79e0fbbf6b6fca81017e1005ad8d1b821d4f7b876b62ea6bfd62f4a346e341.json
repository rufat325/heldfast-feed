{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "stories:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Revoke one public story share link. Anyone using that link will immediately lose access.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "confirmRevocation": {
    "const": true,
    "description": "True only after the user explicitly approved revoking this share link.",
    "type": "boolean"
   },
   "linkId": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "storyId": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "storyId",
   "linkId",
   "confirmRevocation"
  ],
  "type": "object"
 },
 "name": "revoke_story_share_link",
 "title": "Revoke a Story Share Link"
}
