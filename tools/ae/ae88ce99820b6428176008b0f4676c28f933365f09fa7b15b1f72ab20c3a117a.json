        "open_sites"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "note": {
      "type": "string"
     },
     "observed_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "page": {
      "type": "string"
     },
     "park": {
      "type": "string"
     },
     "park_key": {
      "type": "string"
     },
     "reservable_sites": {
      "type": "number"
     },
     "rules": {
      "additionalProperties": false,
      "properties": {
       "max_nights": {
        "type": [
         "number",
         "null"
        ]
       },
       "min_lead_days": {
        "type": "number"
       },
