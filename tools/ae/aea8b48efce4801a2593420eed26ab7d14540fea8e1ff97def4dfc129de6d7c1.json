{"_meta":{"pack":"usda-market-news"},"annotations":{"cost":{"all":1},"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Read dated rows from one USDA AMS livestock price report (Livestock Mandatory Price Reporting). Every response states the report family, report title, market type and office, and each row keeps its own basis fields (class, selling basis, grade, weight range) plus price low / high / weighted-average as separate fields: ranges are never collapsed and nothing is averaged here. Pick a section (see sections in ams_report_search; prices are usually in \"Detail\", not \"Summary\"). With no date it returns the most recent report date. If AMS has no rows for the requested date or section (not published yet, holiday, wrong section) the result is status \"no_rows_for_request\" with the report's last published date, not an empty array. Dates are ISO (2026-10-22).","inputSchema":{"examples":[{"date":"2026-10-19","limit":20,"report_id":2477,"section":"Detail"},{"report_id":2453,"section":"Current Cutout Values"}],"properties":{"date":{"description":"One report date, ISO YYYY-MM-DD.","type":"string"},"end_date":{"description":"Range end, ISO.","type":"string"},"limit":{"description":"Max rows (default 100, max 500). Newest first.","type":"number"},"report_id":{"description":"Report id from ams_report_search, e.g. 2466 (5 Area Daily Weighted Average Direct Slaughter Cattle).","type":"number"},"section":{"description":"Section name, case-insensitive (default \"Summary\"), e.g. \"Detail\".","type":"string"},"start_date":{"description":"Range start, ISO (use with end_date).","type":"string"}},"required":["report_id"],"type":"object"},"name":"ams_report","outputSchema":{"additionalProperties":true,"properties":{"complete":{"type":"boolean"},"data_as_of":{"type":"string"},"report":{"additionalProperties":true,"properties":{"market_location_city":{"type":"string"},"market_location_name":{"type":"string"},"market_location_state":{"type":"string"},"market_type":{"type":"string"},"market_type_category":{"type":"string"},"office_city":{"type":"string"},"office_code":{"type":"string"},"office_name":{"type":"string"},"office_state":{"type":"string"},"published_date":{"type":"string"},"report_title":{"type":"string"},"slug_id":{"type":"string"},"slug_name":{"type":"string"}},"type":"object"},"report_dates_in_result":{"additionalProperties":true,"properties":{"earliest":{"type":"string"},"latest":{"type":"string"}},"type":"object"},"report_family":{"type":"string"},"report_id":{"type":"number"},"report_last_published":{"type":"string"},"requested":{"additionalProperties":true,"properties":{"latest":{"type":"string"}},"type":"object"},"returned":{"type":"number"},"row_count":{"type":"number"},"rows":{"items":{"additionalProperties":true,"properties":{"choice_600_900_current":{"type":"string"},"report_date":{"type":"string"},"select_600_900_current":{"type":"string"}},"type":"object"},"type":"array"},"section":{"type":"string"},"sections_available":{"items":{"type":"string"},"type":"array"},"source":{"type":"string"},"status":{"type":"string"},"unit_note":{"type":"string"}},"type":"object"},"title":"Ams Report","version":"v1.3d6ca67e"}
