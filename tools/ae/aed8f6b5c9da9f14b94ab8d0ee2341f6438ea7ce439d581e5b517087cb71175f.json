{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true
 },
 "description": "Create a new assignment in a course.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assignment_group_id": {
    "description": "ID of the assignment group to place this assignment in",
    "type": "number"
   },
   "course_id": {
    "description": "The Canvas course ID",
    "type": "number"
   },
   "description": {
    "description": "Assignment description (HTML supported)",
    "type": "string"
   },
   "due_at": {
    "description": "Due date in ISO 8601 format (e.g. 2026-05-01T23:59:00Z)",
    "type": "string"
   },
   "name": {
    "description": "Assignment name",
    "type": "string"
   },
   "points_possible": {
    "description": "Maximum points for this assignment",
    "type": "number"
   },
   "submission_types": {
    "description": "Allowed submission types (e.g. [\"online_upload\", \"online_text_entry\", \"none\"])",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "course_id",
   "name"
  ],
  "type": "object"
 },
 "name": "create_assignment",
 "title": "Create Assignment"
}
