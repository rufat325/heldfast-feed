{
 "description": "Generate a formatted plan markdown entry for an implementation session. Pure template \u2014 no AI needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent": {
    "default": "AI",
    "description": "Who created the plan",
    "type": "string"
   },
   "approach": {
    "description": "High-level strategy and rationale",
    "type": "string"
   },
   "background": {
    "description": "Additional context for why this plan exists",
    "type": "string"
   },
   "branch": {
    "description": "Git branch name",
    "type": "string"
   },
   "constraints": {
    "description": "Known limitations or requirements",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "date": {
    "description": "Plan date in YYYY-MM-DD format",
    "type": "string"
   },
   "expectedOutcome": {
    "description": "What the codebase should look like after execution",
    "type": "string"
   },
   "goal": {
    "description": "What this plan aims to achieve (1-3 sentences)",
    "type": "string"
   },
   "lockVersion": {
    "description": "Current lock version",
    "type": "string"
   },
   "pls": {
    "description": "Current PLS score",
    "type": "number"
   },
   "references": {
    "description": "Links to issues, PRs, specs, or external resources",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "risks": {
    "description": "Potential problems and mitigations",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "scope": {
    "description": "Brief scope description",
    "type": "string"
   },
   "steps": {
    "description": "Ordered implementation steps (minimum 1)",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "title": {
    "description": "Plan title (short, kebab-case friendly)",
    "type": "string"
   }
  },
  "required": [
   "date",
   "title",
   "branch",
   "goal",
   "approach",
   "steps"
  ],
  "type": "object"
 },
 "name": "create_plan"
}
