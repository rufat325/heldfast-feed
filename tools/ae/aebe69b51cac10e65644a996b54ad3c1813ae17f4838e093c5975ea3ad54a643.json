{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The public calibration record: every model probability published before kick-off and scored after the result \u2014 count, hit rate, Brier score and reliability buckets (predicted probability vs observed frequency), overall and by question (match_result, total_goals_over_2_5, total_goals_over_3_5, half_time_goals_over_1_5, both_teams_score), plus the 50 most recent scored predictions. days sets the lookback window, default 90. Misses are included; nothing is filtered. Use when asked how accurate the model is or whether its probabilities are calibrated. It is a baseline statistical model, not a tipping service: quote hit rate and Brier score as a measure of the model, never as advice on what to do. Example: \"Is this model any good?\" \u2192 get_track_record, quote summary.hit_rate and accuracy.brier.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "days": {
    "anyOf": [
     {
      "maximum": 365,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Lookback window in days (default 90)"
   }
  },
  "type": "object"
 },
 "name": "get_track_record",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "attribution": {
    "description": "Cite as \"Data by football-charts.com\"",
    "type": [
     "string",
     "null"
    ]
   },
   "track_record": {
    "additionalProperties": true,
    "properties": {
     "accuracy": {
      "anyOf": [
       {
        "additionalProperties": true,
        "properties": {
         "brier": {
          "$ref": "#/properties/track_record/properties/summary/anyOf/0/properties/hit_rate",
          "description": "Brier score over scored probabilities; lower is better, 0.25 = coin flip"
         },
         "buckets": {
          "anyOf": [
           {
            "items": {
             "additionalProperties": true,
             "properties": {
              "avg_prob": {
               "$ref": "#/properties/track_record/properties/recent/anyOf/0/items/properties/line"
              },
              "hi": {
               "$ref": "#/properties/track_record/properties/recent/anyOf/0/items/properties/line"
              },
              "hit_rate": {
               "$ref": "#/properties/track_record/properties/recent/anyOf/0/items/properties/line"
              },
              "lo": {
               "$ref": "#/properties/track_record/properties/recent/anyOf/0/items/properties/line"
              },
              "n": {
               "$ref": "#/properties/track_record/properties/summary/anyOf/0/properties/correct"
              }
             },
             "type": "object"
            },
            "type": "array"
           },
           {
            "type": "null"
           }
          ]
         },
         "n": {
          "$ref": "#/properties/track_record/properties/summary/anyOf/0/properties/correct"
         }
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "by_question": {
      "anyOf": [
       {
        "additionalProperties": {
         "$ref": "#/properties/track_record/properties/summary/anyOf/0"
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "pending": {
      "$ref": "#/properties/track_record/properties/summary/anyOf/0/properties/n",
      "description": "Published but not yet scored"
     },
     "recent": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": true,
         "properties": {
          "away_team": {
           "$ref": "#/properties/track_record/properties/recent/anyOf/0/items/properties/slug"
          },
          "home_team": {
           "$ref": "#/properties/track_record/properties/recent/anyOf/0/items/properties/slug"
          },
          "league": {
           "$ref": "#/properties/track_record/properties/recent/anyOf/0/items/properties/slug"
          },
          "line": {
           "$ref": "#/properties/track_record/properties/summary/anyOf/0/properties/hit_rate"
          },
          "match_date": {
           "$ref": "#/properties/track_record/properties/recent/anyOf/0/items/properties/slug"
          },
          "model_prob": {
           "$ref": "#/properties/track_record/properties/recent/anyOf/0/items/properties/line"
          },
          "outcome": {
           "$ref": "#/properties/track_record/properties/recent/anyOf/0/items/properties/slug",
           "description": "'correct' | 'incorrect' | 'void'"
          },
          "question": {
           "$ref": "#/properties/track_record/properties/recent/anyOf/0/items/properties/slug"
          },
          "result_score": {
           "$ref": "#/properties/track_record/properties/recent/anyOf/0/items/properties/slug"
          },
          "side": {
           "$ref": "#/properties/track_record/properties/recent/anyOf/0/items/properties/slug"
          },
          "slug": {}
         },
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "description": "The 50 most recent scored predictions"
     },
     "summary": {
      "anyOf": [
       {
        "additionalProperties": true,
        "properties": {
         "correct": {
          "$ref": "#/properties/track_record/properties/summary/anyOf/0/properties/n"
         },
         "hit_rate": {
          "description": "correct / (correct + incorrect)"
         },
         "incorrect": {
          "$ref": "#/properties/track_record/properties/summary/anyOf/0/properties/correct"
         },
         "n": {
          "description": "Scored predictions"
         },
         "void": {
          "$ref": "#/properties/track_record/properties/summary/anyOf/0/properties/n",
          "description": "Postponed or abandoned; not scored"
         }
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "Whole window"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "track_record"
  ],
  "type": "object"
 },
 "title": "Model calibration record"
}
