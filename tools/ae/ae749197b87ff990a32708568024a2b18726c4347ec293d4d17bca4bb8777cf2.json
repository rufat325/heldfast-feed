{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Run a bounded FAIE evidence investigation. Public MCP investigations are ephemeral previews and do not persist the caller question into the shared investigation archive.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "asset_types": {
    "items": {
     "maxLength": 160,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   },
   "crop": {
    "maxLength": 120,
    "type": "string"
   },
   "horizon_days": {
    "default": 90,
    "maximum": 3650,
    "minimum": 1,
    "type": "integer"
   },
   "include_weak_evidence": {
    "default": false,
    "type": "boolean"
   },
   "question": {
    "description": "The bounded evidence question to investigate.",
    "maxLength": 1200,
    "minLength": 3,
    "type": "string"
   },
   "region_keys": {
    "items": {
     "maxLength": 160,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "thesis_assumptions": {
    "items": {
     "anyOf": [
      {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      {
       "additionalProperties": false,
       "properties": {
        "assumption_id": {
         "maxLength": 160,
         "type": "string"
        },
        "criticality": {
         "maxLength": 40,
         "type": "string"
        },
        "statement": {
         "maxLength": 500,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "statement"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 40,
    "type": "array"
   },
   "water_source": {
    "maxLength": 120,
    "type": "string"
   }
  },
  "required": [
   "question"
  ],
  "type": "object"
 },
 "name": "investigate_faie_evidence",
 "title": "Investigate agriculture, land, water, production, or resilience evidence"
}
