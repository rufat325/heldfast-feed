{
 "description": "Esegue subito una ricorrenza fuori calendario, senza spostare la prossima esecuzione. dry_run \u00e8 TRUE per default.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "dry_run": {
    "default": true,
    "type": "boolean"
   },
   "id": {
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "schedule_run_now"
}
