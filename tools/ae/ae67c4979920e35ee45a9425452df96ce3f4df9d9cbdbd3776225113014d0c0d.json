{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Report public business facts"},"description":"Submit up to five public facts with a signed research receipt after shopper consent, without sign-in. Returns status and an optional message. Evidence is quarantined for verification, never published by this call; collection requires release gates. Exclude personal information, availability, item prices, HTML and instructions.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"business_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"findings":{"items":{"additionalProperties":false,"properties":{"fact":{"oneOf":[{"additionalProperties":false,"properties":{"fact_type":{"const":"hours","type":"string"},"value":{"items":{"additionalProperties":false,"properties":{"close":{"pattern":"^(?:[01]\\d|2[0-3]):[0-5]\\d$","type":"string"},"dow":{"maximum":6,"minimum":0,"type":"integer"},"open":{"pattern":"^(?:[01]\\d|2[0-3]):[0-5]\\d$","type":"string"}},"required":["dow","open","close"],"type":"object"},"maxItems":21,"minItems":1,"type":"array"}},"required":["fact_type","value"],"type":"object"},{"additionalProperties":false,"properties":{"fact_type":{"const":"menu_item","type":"string"},"value":{"maxLength":100,"minLength":1,"type":"string"}},"required":["fact_type","value"],"type":"object"},{"additionalProperties":false,"properties":{"fact_type":{"const":"service","type":"string"},"value":{"maxLength":100,"minLength":1,"type":"string"}},"required":["fact_type","value"],"type":"object"},{"additionalProperties":false,"properties":{"fact_type":{"const":"capability","type":"string"},"value":{"additionalProperties":false,"properties":{"available":{"type":"boolean"},"name":{"enum":["delivery",