{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new task. Use parent to nest as a subtask, previous to position after a sibling.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "due": {
    "description": "Due date (RFC 3339, e.g. \"2026-06-01T00:00:00.000Z\")",
    "type": "string"
   },
   "notes": {
    "description": "Free-text notes / body",
    "type": "string"
   },
   "parent": {
    "description": "Parent task ID (insert as a subtask under this task)",
    "type": "string"
   },
   "previous": {
    "description": "Sibling task ID (insert immediately after this task)",
    "type": "string"
   },
   "status": {
    "description": "Task status: needsAction or completed",
    "type": "string"
   },
   "tasklist": {
    "description": "Task list ID to insert into",
    "type": "string"
   },
   "title": {
    "description": "Task title",
    "type": "string"
   }
  },
  "required": [
   "tasklist",
   "title"
  ],
  "type": "object"
 },
 "name": "tasks_tasks_insert"
}
