{
 "description": "Set the symbol on a specific pane by index",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "index": {
    "description": "Pane index (0-based)",
    "type": "number"
   },
   "symbol": {
    "description": "Symbol to set (e.g., NQ1!, ES1!, AAPL)",
    "type": "string"
   }
  },
  "required": [
   "index",
   "symbol"
  ],
  "type": "object"
 },
 "name": "pane_set_symbol"
}
