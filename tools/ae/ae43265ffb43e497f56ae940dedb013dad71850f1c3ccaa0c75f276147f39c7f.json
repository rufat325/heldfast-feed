{
 "description": "Extracts up to maxMatches non-overlapping regex matches from input, using Go's RE2-based regexp engine (linear-time, no backreferences/lookaround). Named groups (?P<name>...) are reported in namedGroups.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "type": "string"
   },
   "maxMatches": {
    "description": "stop after this many matches; omitted/<=0 means no limit",
    "type": "integer"
   },
   "pattern": {
    "description": "an RE2 regex pattern",
    "type": "string"
   }
  },
  "required": [
   "pattern",
   "input"
  ],
  "type": "object"
 },
 "name": "regex_extract",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "matches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "end": {
       "type": "integer"
      },
      "groups": {
       "items": {
        "type": "string"
       },
       "type": [
        "null",
        "array"
       ]
      },
      "match": {
       "type": "string"
      },
      "namedGroups": {
       "additionalProperties": {
        "type": "string"
       },
       "type": "object"
      },
      "start": {
       "type": "integer"
      }
     },
     "required": [
      "match",
      "start",
      "end"
     ],
     "type": "object"
    },
    "type": [
     "null",
     "array"
    ]
   }
  },
  "required": [
   "matches"
  ],
  "type": "object"
 }
}
