{
 "description": "Calculate enthalpy of flue gas from composition",
 "inputSchema": {
  "properties": {
   "Cp_unit": {
    "default": "Btu/lb-F",
    "description": "Cp output unit",
    "enum": [
     "Btu/lb-F",
     "Btu/lb-R",
     "Btu/lbm-F",
     "Btu/lbm-R",
     "J/g-C",
     "J/g-K",
     "J/kg-C",
     "J/kg-K",
     "cal/g-C",
     "cal/g-K",
     "cal/kg-C",
     "cal/kg-K",
     "kJ/g-C",
     "kJ/g-K",
     "kJ/kg-C",
     "kJ/kg-K",
     "kcal/g-C",
     "kcal/g-K",
     "kcal/kg-C",
     "kcal/kg-K"
    ],
    "type": "string"
   },
   "HC": {
    "description": "List of fuel component formula strings, e.g. ['CH4', 'C2H6', 'N2']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "MW_unit": {
    "default": "g/mol",
    "description": "MW output unit",
    "enum": [
     "g/gmol",
     "g/mol",
     "kg/kgmol",
     "kg/kmol",
     "lb/lbmol",
     "lb/mol"
    ],
    "type": "string"
   },
   "Tb": {
    "description": "Base temperature",
    "properties": {
     "unit": {
      "enum": [
       "C",
       "F",
       "K",
       "R"
      ],
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "value",
     "unit"
    ],
    "type": "object"
   },
   "Tg": {
    "description": "Flue gas temperature",
    "properties": {
     "unit": {
      "enum": [
       "C",
       "F",
       "K",
       "R"
      ],
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "value",
     "unit"
    ],
    "type": "object"
   },
   "dH_unit": {
    "default": "Btu/lb",
    "description": "Enthalpy output unit",
    "enum": [
     "Btu/lb",
     "Btu/lbm",
     "J/g",
     "J/kg",
     "cal/g",
     "cal/kg",
     "kJ/g",
     "kJ/kg",
     "kcal/g",
     "kcal/kg"
    ],
    "type": "string"
   },
   "mole": {
    "description": "Mole fraction list corresponding to HC, e.g. [0.90, 0.05, 0.05]",
    "items": {
     "type": "number"
    },
    "type": "array"
   }
  },
  "required": [
   "HC",
   "mole",
   "Tb",
   "Tg"
  ],
  "type": "object"
 },
 "name": "FLUEGAS"
}
