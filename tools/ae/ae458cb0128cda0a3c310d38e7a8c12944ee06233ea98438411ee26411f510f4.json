{
 "description": "Create a price alert via the TradingView alert dialog",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "condition": {
    "description": "Alert condition (e.g., \"crossing\", \"greater_than\", \"less_than\")",
    "type": "string"
   },
   "message": {
    "description": "Alert message",
    "type": "string"
   },
   "price": {
    "description": "Price level for the alert",
    "type": "number"
   }
  },
  "required": [
   "condition",
   "price"
  ],
  "type": "object"
 },
 "name": "alert_create"
}
