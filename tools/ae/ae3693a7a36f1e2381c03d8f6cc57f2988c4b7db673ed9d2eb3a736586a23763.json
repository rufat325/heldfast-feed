{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compare JSON"
 },
 "description": "Compare two JSON objects and return a structured diff. Shows additions, deletions, and changes with JSONPath locations. Useful for comparing API responses, config files, or database records.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ignore_order": {
    "description": "Ignore array element ordering (default: false)",
    "type": "boolean"
   },
   "modified": {
    "description": "Modified JSON (after)",
    "type": "string"
   },
   "original": {
    "description": "Original JSON (before)",
    "type": "string"
   }
  },
  "required": [
   "original",
   "modified"
  ],
  "type": "object"
 },
 "name": "json_diff"
}
