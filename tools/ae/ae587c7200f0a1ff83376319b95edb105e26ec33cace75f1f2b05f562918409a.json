{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read a conversation"
 },
 "description": "The messages of one conversation, oldest first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "conversationId": {
    "description": "Conversation id from list_conversations.",
    "type": "string"
   },
   "limit": {
    "description": "How many recent lines to include.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "room": {
    "description": "Room key, e.g. 'lobby' or 'main-bar' (or an instance key like 'main-bar#2' from enter_room).",
    "type": "string"
   }
  },
  "required": [
   "room",
   "conversationId"
  ],
  "type": "object"
 },
 "name": "read_conversation"
}
