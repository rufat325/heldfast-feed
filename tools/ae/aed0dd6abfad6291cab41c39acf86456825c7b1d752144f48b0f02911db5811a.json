     "medium",
     "high",
     "urgent"
    ],
    "type": "string"
   },
   "status": {
    "description": "Status filter",
    "enum": [
     "todo",
     "in_progress",
     "blocked",
     "done"
    ],
    "type": "string"
   },
   "taskId": {
    "description": "The task ID",
    "type": "string"
   },
   "title": {
    "description": "Title",
    "type": "string"
   }
  },
  "required": [
