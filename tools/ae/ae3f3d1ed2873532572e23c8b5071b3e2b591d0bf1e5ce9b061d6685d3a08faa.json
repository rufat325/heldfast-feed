{
 "description": "Generate a single Express route handler with validation, error handling, and JSDoc documentation",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "What this endpoint does",
    "type": "string"
   },
   "method": {
    "description": "HTTP method",
    "enum": [
     "GET",
     "POST",
     "PUT",
     "PATCH",
     "DELETE"
    ],
    "type": "string"
   },
   "params": {
    "default": [],
    "description": "Array of parameter definitions for validation",
    "items": {
     "properties": {
      "name": {
       "description": "Parameter name",
       "type": "string"
      },
      "required": {
       "description": "Whether the parameter is required",
       "type": "boolean"
      },
      "type": {
       "description": "Parameter type (string, number, boolean)",
       "type": "string"
      }
     },
     "required": [
      "name",
      "type",
      "required"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "path": {
    "description": "Route path (e.g. /users/:id)",
    "type": "string"
   },
   "response_example": {
    "default": "",
    "description": "Example JSON response for documentation",
    "type": "string"
   }
  },
  "required": [
   "method",
   "path",
   "description"
  ],
  "type": "object"
 },
 "name": "generate_endpoint"
}
