{
 "description": "Search D&D 5e SRD spells by name, level, school, class, concentration, ritual, components, damage type, or save type.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "class_name": {
    "description": "Spellcasting class (e.g. \"Wizard\", \"Cleric\")",
    "type": "string"
   },
   "concentration": {
    "description": "Filter by concentration requirement",
    "type": "boolean"
   },
   "damage_type": {
    "description": "Damage type (e.g. \"fire\", \"necrotic\", \"radiant\")",
    "type": "string"
   },
   "has_material": {
    "description": "Filter by material component requirement",
    "type": "boolean"
   },
   "level": {
    "description": "Spell level (0 for cantrips, 1-9 for leveled spells)",
    "maximum": 9,
    "minimum": 0,
    "type": "number"
   },
   "limit": {
    "default": 10,
    "description": "Results per page (max 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Offset for pagination",
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Search term for spell name or description",
    "type": "string"
   },
   "ritual": {
    "description": "Filter by ritual casting",
    "type": "boolean"
   },
   "save_type": {
    "description": "Saving throw type (e.g. \"DEX\", \"WIS\", \"CON\")",
    "type": "string"
   },
   "school": {
    "description": "School of magic (e.g. \"evocation\", \"necromancy\")",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_spells"
}
