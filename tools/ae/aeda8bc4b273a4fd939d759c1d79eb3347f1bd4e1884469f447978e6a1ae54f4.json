{
 "description": "GitHub Trending (which has no official API or history): today's list, this week, this month, or a language's daily list; or a past day's snapshot by date. Scraped daily and archived.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "date": {
    "description": "YYYY-MM-DD of an archived snapshot",
    "type": "string"
   },
   "language": {
    "enum": [
     "python",
     "typescript",
     "javascript",
     "go",
     "rust",
     "java",
     "c++",
     "shell"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "since": {
    "enum": [
     "daily",
     "weekly",
     "monthly"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "github_trending"
}
