{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Navigate the live project camera or persist a default view. expectedSpecVersion protects persisted changes from stale writes.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"expectedSpecVersion":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"input":{"properties":{"action":{"default":"navigate","description":"navigate = ephemeral fly-to (default); save = persist as project default view.","enum":["navigate","save"],"type":"string"},"camera":{"oneOf":[{"properties":{"bearing":{"default":0,"maximum":360,"minimum":0,"type":"number"},"center":{"prefixItems":[{"maximum":180,"minimum":-180,"type":"number"},{"maximum":90,"minimum":-90,"type":"number"}],"type":"array"},"pitch":{"default":0,"maximum":85,"minimum":0,"type":"number"},"type":{"const":"static","type":"string"},"zoom":{"maximum":22,"minimum":0,"type":"number"}},"required":["type","center","zoom"],"type":"object"},{"properties":{"bbox":{"prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"}],"type":"array"},"padding":{"default":20,"type":"number"},"type":{"const":"bounds","type":"string"}},"required":["type","bbox"],"type":"object"},{"properties":{"layerId":{"type":"string"},"padding":{"default":20,"type":"number"},"type":{"const":"layer-extent","type":"string"}},"required":["type","layerId"],"type":"object"}]},"timing":{"description":"Animation and pacing config. Only used with navigate action.","properties":{"duration":{"description":"Fly animation duration in milliseconds. Omit for auto (MapLibre default based on distance).","maximum":15000,"minimum":0,"type":"number"},"pause":{"description":"Hold time in milliseconds after arriving before continuing. Use for multi-step demos so the user can observe each view.","maximum":15000,"minimum":0,"type":"number"}},"type":"object"},"title":{"description":"Short descript