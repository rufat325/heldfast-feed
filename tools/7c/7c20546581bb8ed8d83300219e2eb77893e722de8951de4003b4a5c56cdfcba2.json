{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Khi app d\u00f9ng l\u1ea1i n\u1ed9i dung mail, t\u1ea1o template v\u1edbi bi\u1ebfn {{ten_bien}}. / Use to create a reusable email template.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "html": {
    "minLength": 1,
    "type": "string"
   },
   "idempotency_key": {
    "description": "Gi\u1eef c\u00f9ng key khi th\u1eed l\u1ea1i c\u00f9ng y\u00eau c\u1ea7u trong 24 gi\u1edd. / Reuse for retries.",
    "maxLength": 255,
    "minLength": 1,
    "pattern": "^[\\x21-\\x7e]+$",
    "type": "string"
   },
   "name": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "subject": {
    "maxLength": 998,
    "minLength": 1,
    "pattern": "^[^\\r\\n]+$",
    "type": "string"
   },
   "text": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "subject",
   "html"
  ],
  "type": "object"
 },
 "name": "mail_template_create",
 "title": "T\u1ea1o m\u1eabu email"
}
