{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Reads PDF, XLSX, CSV, DOCX and TXT documents into a DocumentBundle with page, line, table and cell provenance, deterministically and without OCR or a model. Returns a per-document summary and a bundleId to pass to extract_facts; ask for detail \"full\" to see the pages. Unsupported or unreadable files are reported, not dropped.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "detail": {
    "description": "summary (default): per-document counts and the bundleId; full: the whole DocumentBundle",
    "enum": [
     "summary",
     "full"
    ],
    "type": "string"
   },
   "inline": {
    "description": "Document bytes as base64, for hosts that cannot pass paths",
    "items": {
     "properties": {
      "base64": {
       "type": "string"
      },
      "name": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "name",
      "base64"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "lang": {
    "description": "Language of the text summary (default en)",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "limits": {
    "additionalProperties": {},
    "description": "Partial IngestLimits override (maxInputBytes, maxCells, ...)",
    "properties": {},
    "type": "object"
   },
   "paths": {
    "description": "Files or directories on the server\u2019s file system (a directory contributes its PDF, XLSX, CSV, DOCX and TXT files, non-recursive). Preferred for local installs",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "ingest_documents",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "bundle": {
    "additionalProperties": {},
    "properties": {
     "documents": {
      "items": {
       "additionalProperties": {},
       "properties": {},
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "documents"
    ],
    "type": "object"
   },
   "bundleId": {
    "type": "string"
   },
   "documents": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "contentType": {
       "type": "string"
      },
      "error": {
       "additionalProperties": {},
       "properties": {
        "code": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "message"
       ],
       "type": "object"
      },
      "format": {
       "type": "string"
      },
      "lang": {
       "type": "string"
      },
      "lines": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "pages": {
       "type": "number"
      },
      "sha256": {
       "type": "string"
      },
      "tables": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "format",
      "contentType",
      "sha256",
      "lang",
      "pages",
      "tables",
      "lines"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "description": "Set when the call failed",
    "type": "string"
   },
   "errors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Ingest supplier documents"
}
