{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true
 },
 "description": "Create a new rubric in a course with criteria and rating levels. Optionally link it to an assignment immediately.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "association": {
    "description": "Optional assignment association",
    "properties": {
     "assignment_id": {
      "description": "Assignment ID to link this rubric to",
      "type": "number"
     },
     "purpose": {
      "description": "Purpose of the association (e.g., \"grading\")",
      "type": "string"
     },
     "use_for_grading": {
      "description": "Whether to use this rubric for grading",
      "type": "boolean"
     }
    },
    "required": [
     "assignment_id"
    ],
    "type": "object"
   },
   "course_id": {
    "description": "The Canvas course ID",
    "type": "number"
   },
   "criteria": {
    "description": "Rubric criteria",
    "items": {
     "properties": {
      "description": {
       "description": "Criterion description",
       "type": "string"
      },
      "points": {
       "description": "Maximum points for this criterion",
       "type": "number"
      },
      "ratings": {
       "description": "Rating levels for this criterion (highest to lowest)",
       "items": {
        "properties": {
         "description": {
          "description": "Rating level description",
          "type": "string"
         },
         "points": {
          "description": "Points for this rating level",
          "type": "number"
         }
        },
        "required": [
         "description",
         "points"
        ],
        "type": "object"
       },
       "minItems": 2,
       "type": "array"
      }
     },
     "required": [
      "description",
      "points",
      "ratings"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "title": {
    "description": "The rubric title",
    "type": "string"
   }
  },
  "required": [
   "course_id",
   "title",
   "criteria"
  ],
  "type": "object"
 },
 "name": "create_rubric",
 "title": "Create Rubric"
}
