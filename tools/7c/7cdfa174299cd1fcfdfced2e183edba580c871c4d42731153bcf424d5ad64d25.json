{
 "description": "Publish a scoped scientific claim with explicit conditions and evidence. This is separate from external identity claims.",
 "inputSchema": {
  "properties": {
   "claim": {
    "properties": {
     "conditions": {
      "type": "string"
     },
     "evidenceIds": {
      "items": {
       "format": "uuid",
       "type": "string"
      },
      "type": "array"
     },
     "interactionId": {
      "format": "uuid",
      "type": "string"
     },
     "statement": {
      "type": "string"
     },
     "visibility": {
      "default": "private",
      "type": "string"
     }
    },
    "required": [
     "interactionId",
     "statement",
     "conditions",
     "evidenceIds"
    ],
    "type": "object"
   },
   "idempotencyKey": {
    "type": "string"
   }
  },
  "required": [
   "claim",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "create_scientific_claim"
}
