{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Checks a schematic transcription in progress \u2014 call it after every page while transcribing an image or PDF (see embedcalc_get_extraction_guide), with the whole netlist so far. It does not review the design.\n\nReturns { ready, stats, problems[], unconnectedParts[], halfConnectedParts[], singlePinNets[], next }.\nproblems = contradictions that must be fixed (a pin in two nets, a ref missing from parts). unconnectedParts / halfConnectedParts = parts whose connections were not transcribed yet. Call embedcalc_review_schematic only when ready is true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "schematic": {
    "additionalProperties": false,
    "properties": {
     "mcu": {
      "additionalProperties": false,
      "properties": {
       "family": {
        "type": "string"
       },
       "part": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "nets": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "name": {
         "minLength": 1,
         "type": "string"
        },
        "pins": {
         "items": {
          "pattern": "^[^.]+\\.[^.]+$",
          "type": "string"
         },
         "minItems": 1,
         "type": "array"
        },
        "voltage_v": {
         "type": "number"
        }
       },
       "required": [
        "name",
        "pins"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "parts": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "pinDirs": {
         "additionalProperties": {
          "enum": [
           "in",
           "out",
           "bidir",
           "power",
           "passive",
           "nc"
          ],
          "type": "string"
         },
         "type": "object"
        },
        "pinRoles": {
         "additionalProperties": {
          "enum": [
           "anode",
           "cathode",
           "positive",
           "negative"
          ],
          "type": "string"
         },
         "type": "object"
        },
        "ratings": {
         "additionalProperties": false,
         "properties": {
          "power_w": {
           "exclusiveMinimum": 0,
           "type": "number"
          },
          "voltage_v": {
           "exclusiveMinimum": 0,
           "type": "number"
          }
         },
         "type": "object"
        },
        "ref": {
         "minLength": 1,
         "type": "string"
        },
        "type": {
         "enum": [
          "mcu",
          "cap",
          "res",
          "ind",
          "ic",
          "conn",
          "xtal",
          "led",
          "diode",
          "other"
         ],
         "type": "string"
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "ref",
        "type"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "parts",
     "nets"
    ],
    "type": "object"
   }
  },
  "required": [
   "schematic"
  ],
  "type": "object"
 },
 "name": "embedcalc_check_transcription",
 "title": "Check Schematic Transcription"
}
