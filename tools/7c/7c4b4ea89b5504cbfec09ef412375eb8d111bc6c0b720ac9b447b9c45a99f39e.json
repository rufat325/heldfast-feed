{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send log entries to Datadog",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "logs": {
    "description": "Array of log entries to send",
    "items": {
     "properties": {
      "ddsource": {
       "description": "Source integration name. Example: nodejs",
       "type": "string"
      },
      "ddtags": {
       "description": "Tags (comma-separated). Example: env:prod,version:1.2.3",
       "type": "string"
      },
      "hostname": {
       "description": "Originating host. Example: ip-10-0-1-42",
       "type": "string"
      },
      "message": {
       "description": "Log message content",
       "type": "string"
      },
      "service": {
       "description": "Service name. Example: my-api",
       "type": "string"
      },
      "status": {
       "description": "Log status. Example: info, warn, error",
       "type": "string"
      }
     },
     "required": [
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "logs"
  ],
  "type": "object"
 },
 "name": "send-logs"
}
