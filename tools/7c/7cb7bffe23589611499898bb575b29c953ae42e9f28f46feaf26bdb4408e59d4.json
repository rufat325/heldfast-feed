{
 "_meta": {
  "ui": {
   "resourceUri": "ui://amira/map",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Research places with coordinates and ancestor rollups. One item can count under both city and country. Feed a name into search_research_items.location.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "bbox": {
    "description": "[west, south, east, north]",
    "items": {
     "type": "number"
    },
    "maxItems": 4,
    "minItems": 4,
    "type": "array"
   },
   "country": {
    "description": "One country, exact name or alias, plus its cities",
    "maxLength": 1000,
    "type": "string"
   },
   "filters": {
    "additionalProperties": false,
    "description": "Research-item filters applied before place counts",
    "properties": {
     "added_since": {
      "maxLength": 40,
      "type": "string"
     },
     "collection": {
      "maxLength": 1000,
      "type": "string"
     },
     "contributor": {
      "maxLength": 1000,
      "type": "string"
     },
     "country": {
      "maxLength": 1000,
      "type": "string"
     },
     "genre": {
      "maxLength": 1000,
      "type": "string"
     },
     "has_media": {
      "type": "boolean"
     },
     "keyword": {
      "maxLength": 1000,
      "type": "string"
     },
     "language": {
      "maxLength": 1000,
      "type": "string"
     },
     "location": {
      "maxLength": 1000,
      "type": "string"
     },
     "location_id": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "modified_since": {
      "maxLength": 40,
      "type": "string"
     },
     "project_id": {
      "anyOf": [
       {
        "maxLength": 256,
        "type": "string"
       },
       {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       }
      ]
     },
     "research_section": {
      "maxLength": 1000,
      "type": "string"
     },
     "resource_type": {
      "maxLength": 1000,
      "type": "string"
     },
     "subject": {
      "maxLength": 1000,
      "type": "string"
     },
     "university": {
      "maxLength": 1000,
      "type": "string"
     },
     "year_from": {
      "maximum": 2200,
      "minimum": 0,
      "type": "integer"
     },
     "year_to": {
      "maximum": 2200,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "keyword": {
    "description": "Substring filter on the place name",
    "maxLength": 1000,
    "type": "string"
   },
   "limit": {
    "description": "Default 50, max 300",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "near": {
    "additionalProperties": false,
    "description": "Places within km of a point",
    "properties": {
     "km": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "latitude": {
      "type": "number"
     },
     "longitude": {
      "type": "number"
     }
    },
    "required": [
     "latitude",
     "longitude",
     "km"
    ],
    "type": "object"
   },
   "offset": {
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_locations",
 "title": "List locations"
}
