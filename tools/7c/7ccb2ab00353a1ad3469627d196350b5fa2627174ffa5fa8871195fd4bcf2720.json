{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Ratio calculator"
 },
 "description": "Work with ratios. Mode 'simplify': reduce a ratio a : b to its lowest terms, and give the 1 : n form and the decimal a / b. Mode 'solve': find the missing value x in the equivalent ratio a : b = c : x using cross multiplication. All inputs must be positive. Source: https://hopi.co.uk/ratio-calculator/",
 "inputSchema": {
  "allOf": [
   {
    "if": {
     "properties": {
      "mode": {
       "const": "solve"
      }
     }
    },
    "then": {
     "required": [
      "c"
     ]
    }
   }
  ],
  "properties": {
   "a": {
    "description": "First term of the ratio (positive)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "b": {
    "description": "Second term of the ratio (positive)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "c": {
    "description": "Known term of the equivalent ratio, mode 'solve' (a : b = c : x)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "mode": {
    "description": "'simplify' a ratio, or 'solve' for the missing value",
    "enum": [
     "simplify",
     "solve"
    ],
    "type": "string"
   }
  },
  "required": [
   "mode",
   "a",
   "b"
  ],
  "type": "object"
 },
 "name": "hopi_ratio_calculator",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "a": {
    "type": "number"
   },
   "b": {
    "type": "number"
   },
   "decimal": {
    "type": "number"
   },
   "mode": {
    "type": "string"
   },
   "oneToN": {
    "type": "string"
   },
   "simplified": {
    "type": "string"
   },
   "simplifiedA": {
    "type": "number"
   },
   "simplifiedB": {
    "type": "number"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "a",
   "b",
   "mode",
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "Ratio calculator"
}
