{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Make a class set of math bingo cards: each card holds answers, and the caller's list reads the problems aloud. Up to 500 cards, each with its own layout. A card needs at least as many different answers as it has squares. Returns a PDF link.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"cards":{"description":"How many different cards. Defaults to 30.","maximum":500,"minimum":1,"type":"integer"},"from":{"description":"Smallest number in the problems.","maximum":100,"minimum":0,"type":"integer"},"op":{"description":"add, subtract, multiply or divide.","enum":["add","subtract","multiply","divide"],"type":"string"},"seed":{"description":"Layout. The same input and seed give the same sheet. Leave out for a new layout.","maximum":2147483647,"minimum":0,"type":"integer"},"size":{"description":"Squares per side: 3, 4, 5. 3 and 5 have a free middle square. Defaults to 5.","enum":[3,4,5],"type":"number"},"title":{"description":"Title on every card. Defaults to the operation's name.","maxLength":80,"type":"string"},"to":{"description":"Largest number in the problems.","maximum":100,"minimum":0,"type":"integer"}},"required":["op","from","to"],"type":"object"},"name":"make_math_bingo","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"maker":{"enum":["bingo-maker","criss-cross-maker","color-by-math-maker","crossword-maker","flashcard-maker","handwriting-maker","math-drill-maker","math-bingo-maker","math-riddle-maker","name-activity-book","name-coloring-page","name-tracing-maker","secret-code-maker","skip-count-dot-to-dot","spelling-pack","word-scramble-maker","word-search-maker"],"type":"string"},"makerUrl":{"type":"string"},"pdfUrl":{"type":"string"},"seed":{"anyOf":[{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},{"type":"null"}