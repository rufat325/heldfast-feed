{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Usage and spend"
 },
 "description": "X (Twitter): report the post-read consumption of the current billing cycle against the monthly project cap (with an optional per-day and per-app breakdown), alongside the local credit-spend estimate for this session. The platform numbers are READ COUNTS, not money \u2014 X publishes no spend API \u2014 and the session estimate is a local, advisory figure that resets when the server restarts. Use it to check headroom before a high-volume read.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "days": {
    "description": "Days of daily breakdown to return (1-90; the API defaults to 7). Out-of-range values are clamped into the window.",
    "type": "integer"
   },
   "raw": {
    "description": "Return the exact API JSON instead of the compact report.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "x_usage_get",
 "outputSchema": {
  "properties": {
   "data": {
    "anyOf": [
     {
      "properties": {
       "note": {
        "type": "string"
       },
       "platform": {
        "properties": {
         "by_app": {
          "items": {
           "properties": {
            "client_app_id": {
             "type": "string"
            },
            "posts_read": {
             "type": "number"
            }
           },
           "required": [
            "client_app_id",
            "posts_read"
           ],
           "type": "object"
          },
          "type": "array"
         },
         "cap": {
          "type": "number"
         },
         "cap_reset_day": {
          "type": "number"
         },
         "daily": {
          "items": {
           "properties": {
            "date": {
             "type": "string"
            },
            "posts_read": {
             "type": "number"
            }
           },
           "required": [
            "date",
            "posts_read"
           ],
           "type": "object"
          },
          "type": "array"
         },
         "percent_used": {
          "type": "number"
         },
         "posts_read": {
          "type": "number"
         },
         "project_id": {
          "type": "string"
         }
        },
        "required": [
         "posts_read"
        ],
        "type": "object"
       },
       "session_budget": {
        "properties": {
         "limit_usd": {
          "type": "number"
         },
         "mode": {
          "enum": [
           "warn",
           "hard"
          ],
          "type": "string"
         },
         "percent_used": {
          "type": "number"
         },
         "remaining_usd": {
          "type": "number"
         },
         "spent_usd": {
          "type": "number"
         }
        },
        "required": [
         "spent_usd",
         "mode"
        ],
        "type": "object"
       }
      },
      "required": [
       "platform",
       "session_budget",
       "note"
      ],
      "type": "object"
     },
     {
      "description": "Uncompacted X API envelope (raw: true).",
      "type": "object"
     }
    ]
   },
   "meta": {
    "properties": {
     "budget_warning": {
      "type": "string"
     },
     "cost_usd": {
      "type": "number"
     },
     "session_total_usd": {
      "type": "number"
     }
    },
    "required": [
     "cost_usd",
     "session_total_usd"
    ],
    "type": "object"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 }
}
