d":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Outstanding Principal Usd"},"rank":{"title":"Rank","type":"integer"},"settled_loan_count":{"title":"Settled Loan Count","type":"integer"},"wallet_address":{"title":"Wallet Address","type":"string"}},"required":["rank","wallet_address","outstanding_principal","earnings","outstanding_principal_usd","earnings_usd","net_effective_apr_percent","default_rate_percent","originated_loan_count","settled_loan_count","defaulted_loan_count","gondi_url"],"title":"TopLender","type":"object"}},"description":"Ranked in `currency_symbol`, a lender's amounts are whole tokens and its\n`_usd` fields null; ranked across every currency, the other way round.\nEarnings are the interest and fees of the period. The effective APR is net\nof the protocol fee; it and the default rate are null below 10 positions.","properties":{"as_of":{"format":"date-time","title":"As Of","type":"string"},"currency_symbol":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Currency Symbol"},"lenders":{"items":{"$ref":"#/$defs/TopLender"},"title":"Lenders","type":"array"}},"required":["as_of","currency_symbol","lenders"],"title":"TopLenders","type":"object"},"title":"Top lenders"}
