{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get metadata for a specific file by ID. Use file_download to get the file content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fields": {
    "description": "Fields to include in response. Defaults to all common fields.",
    "type": "string"
   },
   "fileId": {
    "description": "The ID of the file to retrieve",
    "type": "string"
   },
   "supportsAllDrives": {
    "default": true,
    "description": "Support shared drives",
    "type": "boolean"
   }
  },
  "required": [
   "fileId"
  ],
  "type": "object"
 },
 "name": "file_get",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "capabilities": {
    "additionalProperties": {
     "type": "boolean"
    },
    "type": "object"
   },
   "createdTime": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "lastModifyingUser": {
    "additionalProperties": false,
    "properties": {
     "displayName": {
      "type": "string"
     },
     "emailAddress": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "mimeType": {
    "type": "string"
   },
   "modifiedTime": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "owners": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "displayName": {
       "type": "string"
      },
      "emailAddress": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "parents": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "shared": {
    "type": "boolean"
   },
   "size": {
    "type": "string"
   },
   "starred": {
    "type": "boolean"
   },
   "trashed": {
    "type": "boolean"
   },
   "webContentLink": {
    "type": "string"
   },
   "webViewLink": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "name",
   "mimeType"
  ],
  "type": "object"
 },
 "title": "Get file metadata"
}
