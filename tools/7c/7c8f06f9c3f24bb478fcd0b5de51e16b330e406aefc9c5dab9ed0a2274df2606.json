{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find elected-Lagna windows"
 },
 "description": "EXPERT electional search: finds ascendant-sign windows across 1 day (up to 3 with an API key) and scores each elected Lagna structurally (lord strength and dignity, benefic/malefic placement, Moon condition, activity-karaka state, prohibited-period overlap). Ineligible windows stay visible with fail reasons; draft rules, never a guarantee.",
 "inputSchema": {
  "anyOf": [
   {
    "required": [
     "place"
    ]
   },
   {
    "required": [
     "latitude",
     "longitude",
     "timezone"
    ]
   }
  ],
  "properties": {
   "activity": {
    "enum": [
     "marriage",
     "griha_pravesh",
     "travel",
     "business_start",
     "vehicle_purchase",
     "property_purchase",
     "naming",
     "contract",
     "important_conversation",
     "new_venture",
     "surgery"
    ],
    "type": "string"
   },
   "days": {
    "default": 1,
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "place": {
    "description": "Catalogue query or display label when explicit coordinates are supplied",
    "type": "string"
   },
   "startDate": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "timezone": {
    "description": "Required IANA timezone when explicit coordinates are supplied, for example Asia/Kolkata",
    "type": "string"
   },
   "timezoneOffset": {
    "description": "Optional fallback offset; derived from timezone and the requested local date when omitted",
    "maximum": 14,
    "minimum": -14,
    "type": "number"
   }
  },
  "required": [
   "startDate"
  ],
  "type": "object"
 },
 "name": "find_elected_lagna",
 "outputSchema": {
  "properties": {
   "place": {
    "type": "object"
   },
   "rulebook": {
    "type": "object"
   },
   "safety": {
    "type": "object"
   },
   "schemaVersion": {
    "const": "sahadeva-elected-lagna-1"
   },
   "windows": {
    "type": "array"
   }
  },
  "required": [
   "schemaVersion",
   "place",
   "rulebook",
   "windows",
   "safety"
  ],
  "type": "object"
 },
 "title": "Find elected-Lagna windows"
}
