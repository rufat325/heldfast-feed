{
 "description": "Record a debugging dead end so we don't repeat it. Captures what was tried and why it failed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attempted": {
    "description": "What was tried",
    "type": "string"
   },
   "files_involved": {
    "description": "Files involved",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "led_to_decision": {
    "description": "Timestamp of the decision this dead end led to",
    "type": "string"
   },
   "lesson": {
    "description": "What to remember for next time",
    "type": "string"
   },
   "project": {
    "description": "Which project",
    "type": "string"
   },
   "tags": {
    "description": "Tags for searching",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "why_failed": {
    "description": "Why it didn't work",
    "type": "string"
   }
  },
  "required": [
   "attempted",
   "why_failed"
  ],
  "type": "object"
 },
 "name": "dead_end_record"
}
