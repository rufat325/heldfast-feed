{
 "description": "Create a secure checkout link for one room option from get_hotel. Give the link to the traveller: it opens our checkout with that exact room, dates and price, where they enter their details and pay (rate re-confirmed live). Links last 24 hours. Never ask the traveller for card details yourself.",
 "inputSchema": {
  "properties": {
   "adults": {
    "default": 2,
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "checkin": {
    "description": "YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "checkout": {
    "description": "YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "children_ages": {
    "items": {
     "maximum": 17,
     "minimum": 1,
     "type": "integer"
    },
    "type": "array"
   },
   "hotel_id": {
    "type": "string"
   },
   "option_id": {
    "description": "option_id from get_hotel",
    "type": "string"
   },
   "rooms": {
    "default": 1,
    "maximum": 6,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "hotel_id",
   "option_id",
   "checkin",
   "checkout"
  ],
  "type": "object"
 },
 "name": "create_booking_link"
}
