{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get a current signed crypto index price from /api/index/v1/price. Returns symbol, price, optional priceText, at, grade, signature, kid and sig. Preserve priceText exactly for verify_print. Optional tier, confidence, dispersionBps, interval, sources, engine and cadence describe the observation. Pass the whole print including v2 to verify_print; require recordValid=true before trusting quality fields. Coverage changes: use list_index_assets to discover assets. A stale or unavailable response means no current price, never zero.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "symbol": {
    "description": "Crypto ticker symbol, e.g. BTC, ETH, SOL",
    "maxLength": 20,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9]+$",
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "get_index_price",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "at": {
    "maxLength": 40,
    "type": "string"
   },
   "cadence": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "band": {
        "enum": [
         "real-time",
         "five-second",
         "ten-second",
         "slow",
         "unavailable"
        ],
        "type": "string"
       },
       "calculatedAgeMs": {
        "anyOf": [
         {
          "$ref": "#/properties/confidence/anyOf/0"
         },
         {
          "type": "null"
         }
        ]
       },
       "newestSourceAgeMs": {
        "anyOf": [
         {
          "$ref": "#/properties/confidence/anyOf/0"
         },
         {
          "type": "null"
         }
        ]
       },
       "oldestSourceAgeMs": {
        "anyOf": [
         {
          "$ref": "#/properties/confidence/anyOf/0"
         },
         {
          "type": "null"
         }
        ]
       },
       "p50UpdateMs": {
        "anyOf": [
         {
          "$ref": "#/properties/confidence/anyOf/0"
         },
         {
          "type": "null"
         }
        ]
       },
       "p95UpdateMs": {
        "anyOf": [
         {
          "$ref": "#/properties/confidence/anyOf/0"
         },
         {
          "type": "null"
         }
        ]
       },
       "updatesLast120s": {
        "$ref": "#/properties/sources/anyOf/0"
       }
      },
      "required": [
       "band",
       "calculatedAgeMs",
       "newestSourceAgeMs",
       "oldestSourceAgeMs",
       "p50UpdateMs",
       "p95UpdateMs"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "confidence": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "dispersionBps": {
    "anyOf": [
     {
      "$ref": "#/properties/confidence/anyOf/0"
     },
     {
      "type": "null"
     }
    ]
   },
   "engine": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "accountUrl": {
      "const": "https://thepulse.markets/developers/access",
      "type": "string"
     },
     "code": {
      "pattern": "^[A-Z][A-Z0-9_]{0,79}$",
      "type": "string"
     },
     "nextAction": {
      "enum": [
       "wait",
       "review_access",
       "check_limits",
       "reconnect",
       "check_input",
       "choose_another_symbol",
       "report_issue"
      ],
      "type": "string"
     },
     "retryAfterSeconds": {
      "maximum": 86400,
      "minimum": 1,
      "type": "integer"
     },
     "retryable": {
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "nextAction"
    ],
    "type": "object"
   },
   "getKey": {
    "maxLength": 256,
    "type": "string"
   },
   "grade": {
    "enum": [
     "consensus",
     "blended",
     "indicative",
     "composite",
     "single-source"
    ],
    "type": "string"
   },
   "interval": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "lower": {
        "anyOf": [
         {
          "$ref": "#/properties/confidence/anyOf/0"
         },
         {
          "type": "null"
         }
        ]
       },
       "upper": {
        "anyOf": [
         {
          "$ref": "#/properties/confidence/anyOf/0"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "lower",
       "upper"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "kid": {
    "pattern": "^[A-Za-z0-9._:-]{1,64}$",
    "type": "string"
   },
   "note": {
    "maxLength": 2048,
    "type": "string"
   },
   "price": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "priceText": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "requestId": {
    "description": "Identifier for this MCP call; not a signed price field.",
    "format": "uuid",
    "type": "string"
   },
   "sample": {
    "const": true,
    "type": "boolean"
   },
   "sig": {
    "const": "pulse-index-v1",
    "type": "string"
   },
   "signature": {
    "maxLength": 88,
    "minLength": 88,
    "pattern": "^[A-Za-z0-9+/]{86}==$",
    "type": "string"
   },
   "sources": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "success": {
    "const": true,
    "type": "boolean"
   },
   "symbol": {
    "pattern": "^[A-Za-z0-9]{1,20}$",
    "type": "string"
   },
   "tier": {
    "anyOf": [
     {
      "maxLength": 20,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "v2": {
    "additionalProperties": false,
    "properties": {
     "canonical": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
     },
     "kid": {
      "$ref": "#/properties/kid"
     },
     "sig": {
      "const": "pulse-index-v2",
      "type": "string"
     },
     "signature": {
      "$ref": "#/properties/signature"
     }
    },
    "required": [
     "sig",
     "canonical",
     "signature",
     "kid"
    ],
    "type": "object"
   }
  },
  "required": [
   "requestId"
  ],
  "type": "object"
 },
 "title": "Get Pulse Verity Index Price"
}
