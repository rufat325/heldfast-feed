{"description":"Prototype (Figma Design only): add an interaction to a node; existing reactions are kept.","inputSchema":{"properties":{"action":{"properties":{"destinationId":{"description":"Target id; for NODE","type":"string"},"navigation":{"description":"For NODE (default NAVIGATE)","enum":["NAVIGATE","SWAP","OVERLAY","SCROLL_TO","CHANGE_TO"],"type":"string"},"openInNewTab":{"description":"For URL (default false)","type":"boolean"},"overlayRelativePosition":{"description":"For OVERLAY navigation","properties":{"x":{"type":"number"},"y":{"type":"number"}},"required":["x","y"],"type":"object"},"preserveScrollPosition":{"description":"Default false","type":"boolean"},"transition":{"description":"Omit for no animation","properties":{"direction":{"description":"Required for directional types","enum":["LEFT","RIGHT","TOP","BOTTOM"],"type":"string"},"duration":{"description":"Seconds (default 0.3)","type":"number"},"easing":{"description":"Default LINEAR","properties":{"easingFunctionCubicBezier":{"description":"Required for CUSTOM_CUBIC_BEZIER","properties":{"x1":{"type":"number"},"x2":{"type":"number"},"y1":{"type":"number"},"y2":{"type":"number"}},"required":["x1","y1","x2","y2"],"type":"object"},"type":{"description":"GENTLE/QUICK/BOUNCY/SLOW are spring presets","enum":["LINEAR","EASE_IN","EASE_OUT","EASE_IN_AND_OUT","EASE_IN_BACK","EASE_OUT_BACK","EASE_IN_AND_OUT_BACK","CUSTOM_CUBIC_BEZIER","GENTLE","QUICK","BOUNCY","SLOW","CUSTOM_SPRING"],"type":"string"}},"required":["type"],"type":"object"},"matchLayers":{"description":"Directional types only (default false)","type":"boolean"},"type":{"description":"DISSOLVE/SMART_ANIMATE/SCROLL_ANIMATE take no direction; the others need one","enum":["DISSOLVE","SMART_ANIMATE","SCROLL_ANIMATE","MOVE_IN","MOVE_OUT","PUSH","SLIDE_IN","SLIDE_OUT"],"type":"string"}},"required":["type"],"type":"object"},"type":{"description":"NODE covers all navigation (set navigation); BACK = previous frame; CLOSE closes an overlay; URL opens a URL