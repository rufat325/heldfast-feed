{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Memory Graph"
 },
 "description": "Query the knowledge graph: find entities, their relationships, and linked memories. Use entity name to start traversal, or browse all entities by type. Supports multi-hop traversal (depth 1-3).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "depth": {
    "default": 1,
    "description": "Graph traversal depth (1-3 hops)",
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "entity": {
    "description": "Entity name to start graph traversal from",
    "type": "string"
   },
   "entity_type": {
    "description": "Filter entities by type",
    "enum": [
     "person",
     "project",
     "tool",
     "concept",
     "organization",
     "file",
     "package",
     "pattern",
     "work_item",
     "pull_request",
     "commit",
     "team",
     "department",
     "sop",
     "agent"
    ],
    "type": "string"
   },
   "include_memories": {
    "default": true,
    "description": "Include linked memories in the response",
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "description": "Maximum entities to return",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "memory_graph"
}
