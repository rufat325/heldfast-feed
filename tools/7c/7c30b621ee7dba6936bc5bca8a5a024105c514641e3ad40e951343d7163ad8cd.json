       "maxLength": 64,
       "type": "string"
      },
      "text": {
       "maxLength": 200000,
       "type": "string"
      },
      "time_of_day": {
       "maxLength": 16,
       "type": "string"
      },
      "type": {
       "enum": [
        "scene_heading",
        "action",
        "character",
        "parenthetical",
        "dialogue",
        "transition",
        "shot",
        "note"
       ],
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
