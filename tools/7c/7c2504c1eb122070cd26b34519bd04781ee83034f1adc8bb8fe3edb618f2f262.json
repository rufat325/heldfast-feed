        "const": "test-suite",
        "type": "string"
       }
      ],
      "description": "Optional justification for a coarse file/module-level symbol traceability relationship when narrower function/class/type symbols exist."
     },
     "key_arguments": {
      "description": "predicate_schema only: argument names that determine the remaining arguments (a functional dependency), e.g. [\"sensor\"] for reading(sensor, value). Rule contradiction analysis treats two atoms with identical keys as the same fact; without it the predicate is multivalued and opposing rules stay unresolved instead of disjoint.",
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
     },
     "links": {
      "description": "Optional references. Example: ['REQ-cli-gc','https://example.com/spec'].",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "logic_claims": {
      "description": "Requirement-only manifest of every atomic normative claim key returned by kb_model mode analyze (CLI: semantic-advisor). A requirement is logic-complete only when every key is grounded by a linked property_value or predicate fact with the same claim_key.",
      "items": {
       "pattern": "^CLAIM-[A-F0-9]{16}$",
       "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
     },
     "operator": {
      "anyOf": [
       {
        "const": "eq",
        "type": "string"
       },
       {
        "const": "neq",
        "type": "string"
       },
