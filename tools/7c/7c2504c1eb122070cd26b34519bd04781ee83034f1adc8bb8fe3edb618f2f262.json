{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create or update Kibi entities"
 },
 "description": "Create or update one entity and optional relationships. Use for KB mutations after validating intent; prefer a dryRun:true call first because it validates without writing and returns semantic advisor receipts for prose-heavy requirements. Use kb_model (mode requirement) before hand-writing strict property facts from prose, and kb_model (mode predicates) before hand-writing ontology predicate facts. Use the `relationships` array for batch creation of multiple links in a single call (e.g., linking a requirement to multiple tests or facts). Prefer modeling requirements as reusable fact links (`constrains`, `requires_property`, or `requires_predicate`) so consistency and contradiction checks remain queryable. Relationship endpoints must already exist in KB. For requirements, the write will be rejected if it contradicts existing current requirements that constrain the same subject with incompatible properties. To replace a conflicting requirement, include a `supersedes` relationship from the new requirement to the old one in the same request, then upsert the old requirement with status closed (kb_check blocks a superseded requirement that is not closed). Successful writes may return non-blocking semantic advisor warnings; inspect and repair those warnings before treating prose as contradiction-checkable. Do not use for read-only inspection. Side effects: writes KB, may refresh symbol coordinates; dryRun:true writes nothing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "document": {
    "description": "Optional source-first document write. Paths are workspace-relative; omit body when updating to preserve the existing body bytes.",
    "properties": {
     "body": {
      "type": "string"
     },
     "path": {
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "dryRun": {
    "description": "Validate the payload and return schema/modeling errors, a normalized preview and the semantic advisor receipt without writing the KB or workspace. Use it as the preflight before the real write.",
    "type": "boolean"
   },
   "id": {
    "description": "Unique entity ID (string). Example: 'REQ-cli-gc'. Name entities by the behavior they govern (<TYPE>-<area>-<behavior>), never by the next free number. Existing ID updates the entity; new ID creates it.",
    "type": "string"
   },
   "properties": {
    "additionalProperties": {},
    "allOf": [
     {
      "if": {
       "anyOf": [
        {
         "required": [
          "claim_key"
         ]
        },
        {
         "required": [
          "claim_text"
         ]
        }
       ]
      },
      "then": {
       "required": [
        "claim_key",
        "claim_text"
       ]
      }
     },
     {
      "if": {
       "required": [
        "proof_receipts"
       ]
      },
      "then": {
       "required": [
        "verification_scope"
       ]
      }
     }
    ],
    "description": "Entity fields to persist. Must include title and status. If created_at, updated_at, or source are omitted, server fills defaults.",
    "properties": {
     "aliases": {
      "description": "Optional vocabulary aliases for predicate discovery.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "approval_ref": {
      "description": "Requirement-only. Optional reference to the exception's approval decision record.",
      "minLength": 1,
      "type": "string"
     },
     "approved_by": {
      "description": "Requirement-only. The human who approved this exception requirement. An exception that exempts a requirement and is specified_by a success scenario makes that scenario feasible only when approved_by is set.",
      "minLength": 1,
      "type": "string"
     },
     "argument_aliases": {
      "additionalProperties": {},
      "description": "predicate_schema only: legacy spellings keyed by argument name, each mapped to a declared constant, e.g. {\"severity\": {\"warn\": \"warning\"}}. kibi migrate rewrites facts that still use an alias.",
      "properties": {},
      "type": "object"
     },
     "argument_constants": {
      "additionalProperties": {},
      "description": "predicate_schema only: allowed constants keyed by argument name, e.g. {\"severity\": [\"warning\", \"info\"]}. Predicate facts must use a listed constant for those arguments; unlisted arguments stay open.",
      "properties": {},
      "type": "object"
     },
     "argument_descriptions": {
      "description": "Optional ordered argument explanations.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "argument_names": {
      "description": "Ordered argument role names for predicate_schema facts.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "argument_types": {
      "description": "Ordered argument types for predicate_schema facts.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "canonical_key": {
      "description": "Optional canonical identity key for predicate or strict fact claims.",
      "type": "string"
     },
     "claim_key": {
      "description": "Stable semantic-advisor key for the atomic prose clause grounded by this fact.",
      "pattern": "^CLAIM-[A-F0-9]{16}$",
      "type": "string"
     },
     "claim_span_end": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "claim_span_start": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "claim_text": {
      "description": "Exact atomic requirement clause represented by this fact, retained for human audit.",
      "type": "string"
     },
     "closed_world": {
      "description": "Optional closed-world marker for strict fact interpretation.",
      "type": "boolean"
     },
     "examples": {
      "description": "Optional ground-term examples for a predicate schema.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "exempts_claims": {
      "description": "Requirement-only. Claim keys of the exempted requirement whose constraints this exception waives; omit to waive the whole requirement.",
      "items": {
       "pattern": "^CLAIM-[A-F0-9]{16}$",
       "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
     },
     "fact_kind": {
      "anyOf": [
       {
        "const": "subject",
        "type": "string"
       },
       {
        "const": "property_value",
        "type": "string"
       },
       {
        "const": "observation",
        "type": "string"
       },
       {
        "const": "meta",
        "type": "string"
       },
       {
        "const": "predicate_schema",
        "type": "string"
       },
       {
        "const": "predicate",
        "type": "string"
       },
       {
        "const": "rule_schema",
        "type": "string"
       },
       {
        "const": "rule",
        "type": "string"
       }
      ],
      "description": "Optional fact lane kind for fact entities. Strict lane uses 'subject' and 'property_value'; context lane uses 'observation' or 'meta'; ontology lane uses 'predicate_schema' or 'predicate'. Use kb_model (mode requirement or predicates) when starting from prose."
     },
     "granularity_reason": {
      "anyOf": [
       {
        "const": "config-artifact",
        "type": "string"
       },
       {
        "const": "module-level-behavior",
        "type": "string"
       },
       {
        "const": "extractor-miss",
        "type": "string"
       },
       {
        "const": "legacy-link",
        "type": "string"
       },
