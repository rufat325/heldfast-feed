{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Change a schedule that mails a table's or a report's rows as a file: its day, time, time zone, who gets it, which report, the file type.",
 "inputSchema": {
  "properties": {
   "app_id": {
    "description": "Project ID (from list_projects)",
    "type": "string"
   },
   "day": {
    "description": "Monday \u2026 Sunday, or Daily",
    "type": "string"
   },
   "file_type": {
    "description": "xls | csv",
    "type": "string"
   },
   "new_name": {
    "type": "string"
   },
   "recipients": {
    "description": "The whole list of email addresses",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "report_id": {
    "description": "A report of the same table; \"\" = the whole table",
    "type": "string"
   },
   "run_time": {
    "description": "HH:MM, 24 hours",
    "type": "string"
   },
   "schedule_id": {
    "description": "From list_schedules",
    "type": "string"
   },
   "time_zone": {
    "description": "e.g. UTC+02 (the first word of a zone)",
    "type": "string"
   }
  },
  "required": [
   "app_id",
   "schedule_id"
  ],
  "type": "object"
 },
 "name": "update_schedule",
 "securitySchemes": [
  {
   "scopes": [
    "mcp"
   ],
   "type": "oauth2"
  }
 ]
}
