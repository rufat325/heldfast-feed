{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create infrastructure asset"
 },
 "description": "Create an infrastructure asset (feature - segment or node). Geometry must be GeoJSON Point (for nodes) or LineString (for segments) in EPSG:4326; coordinates are [longitude, latitude]. `length_m`, `slope_pct`, and `risk_score` are computed server-side. Requires infrastructure_assets:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "asset_type_id": {
    "description": "Asset type ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "building_id": {
    "description": "Building ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "condition_score": {
    "description": "Condition score (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "consequence_of_failure_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "data_source": {
    "description": "Data source",
    "maxLength": 200,
    "type": "string"
   },
   "depth_m": {
    "description": "Depth (m)",
    "minimum": 0,
    "type": "number"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "diameter_mm": {
    "description": "Diameter (mm)",
    "minimum": 0,
    "type": "number"
   },
   "environmental_impact": {
    "description": "LOW, MEDIUM, HIGH, CRITICAL",
    "type": "string"
   },
   "expected_lifetime_years": {
    "description": "Expected lifetime (years)",
    "minimum": 0,
    "type": "number"
   },
   "external_ids": {
    "additionalProperties": {},
    "description": "Free-form external ID map",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "feature_code": {
    "description": "Feature ID - human-readable asset identifier, unique per tenant (typically the source GIS asset id)",
    "maxLength": 100,
    "type": "string"
   },
   "feature_type": {
    "description": "\"segment\" (LineString) or \"node\" (Point)",
    "enum": [
     "segment",
     "node"
    ],
    "type": "string"
   },
   "financial_impact": {
    "description": "LOW, MEDIUM, HIGH, CRITICAL",
    "type": "string"
   },
   "flow_direction": {
    "description": "Flow direction",
    "enum": [
     "with_geometry",
     "against_geometry"
    ],
    "type": "string"
   },
   "from_feature_id": {
    "description": "From-node feature ID (segments)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "from_invert_m": {
    "description": "From-invert elevation (m)",
    "type": "number"
   },
   "from_street": {
    "description": "From street (segments)",
    "maxLength": 200,
    "type": "string"
   },
   "geometry": {
    "anyOf": [
     {
      "properties": {
       "coordinates": {
        "items": false,
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
         {
          "type": "number"
         },
         {
          "type": "number"
         }
        ],
        "type": "array"
       },
       "type": {
        "const": "Point",
        "type": "string"
       }
      },
      "required": [
       "type",
       "coordinates"
      ],
      "type": "object"
     },
     {
      "properties": {
       "coordinates": {
        "items": {
         "items": false,
         "maxItems": 2,
         "minItems": 2,
         "prefixItems": [
          {
           "type": "number"
          },
          {
           "type": "number"
          }
         ],
         "type": "array"
        },
        "minItems": 2,
        "type": "array"
       },
       "type": {
        "const": "LineString",
        "type": "string"
       }
      },
      "required": [
       "type",
       "coordinates"
      ],
      "type": "object"
     }
    ],
    "description": "GeoJSON geometry - Point for nodes, LineString for segments"
   },
   "image_url": {
    "description": "Image URL",
    "type": "string"
   },
   "install_date": {
    "description": "Install date (YYYY-MM-DD)",
    "type": "string"
   },
   "lanes": {
    "description": "Lane count",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "last_maintenance_date": {
    "description": "Last maintenance date (YYYY-MM-DD)",
    "type": "string"
   },
   "likelihood_of_failure_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "location_id": {
    "description": "Location ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "manufacturer_id": {
    "description": "Manufacturer ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "material": {
    "description": "Material",
    "maxLength": 200,
    "type": "string"
   },
   "model": {
    "description": "Model",
    "maxLength": 200,
    "type": "string"
   },
   "name": {
    "description": "Feature name",
    "maxLength": 500,
    "type": "string"
   },
   "network_id": {
    "description": "Infrastructure network ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "positional_accuracy_class": {
    "description": "Positional accuracy class",
    "enum": [
     "survey_grade",
     "mapping_grade",
     "sketch",
     "unknown"
    ],
    "type": "string"
   },
   "purchase_cost": {
    "description": "Purchase cost",
    "minimum": 0,
    "type": "number"
   },
   "purchase_cost_calculation_method": {
    "description": "Cost calc method",
    "enum": [
     "manual",
     "calculated_sqft",
     "calculated_unit"
    ],
    "type": "string"
   },
   "purchase_date": {
    "description": "Purchase date (YYYY-MM-DD)",
    "type": "string"
   },
   "qr_code": {
    "description": "QR code",
    "maxLength": 200,
    "type": "string"
   },
   "quantity": {
    "description": "Quantity",
    "minimum": 0,
    "type": "number"
   },
   "regulatory_impact": {
    "description": "LOW, MEDIUM, HIGH, CRITICAL",
    "type": "string"
   },
   "reputation_impact": {
    "description": "LOW, MEDIUM, HIGH, CRITICAL",
    "type": "string"
   },
   "risk_factor": {
    "description": "Risk factor: CRITICAL, HIGH, MEDIUM, LOW",
    "type": "string"
   },
   "road_class": {
    "anyOf": [
     {
      "maximum": 6,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "O. Reg. 239/02 road class 1-6 (1-2 arterial, 3-4 collector, 5-6 local)"
   },
   "safety_impact": {
    "description": "LOW, MEDIUM, HIGH, CRITICAL",
    "type": "string"
   },
   "salvage_value": {
    "description": "Salvage value",
    "minimum": 0,
    "type": "number"
   },
   "salvage_value_percentage": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "serial_number": {
    "description": "Serial number",
    "maxLength": 200,
    "type": "string"
   },
   "service_impact": {
    "description": "LOW, MEDIUM, HIGH, CRITICAL",
    "type": "string"
   },
   "site_id": {
    "description": "Site ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "status_id": {
    "description": "Asset status ID",
    "type": "string"
   },
   "system_class_id": {
    "description": "System class ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "system_group_id": {
    "description": "System group ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "system_id": {
    "description": "System ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "to_feature_id": {
    "description": "To-node feature ID (segments)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "to_invert_m": {
    "description": "To-invert elevation (m)",
    "type": "number"
   },
   "to_street": {
    "description": "To street (segments)",
    "maxLength": 200,
    "type": "string"
   },
   "unit_of_measure": {
    "description": "Unit of measure",
    "maxLength": 50,
    "type": "string"
   },
   "unit_replacement_value": {
    "description": "Unit replacement value",
    "minimum": 0,
    "type": "number"
   },
   "width_m": {
    "description": "Width (m)",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "network_id",
   "feature_type",
   "geometry"
  ],
  "type": "object"
 },
 "name": "create_infrastructure_asset",
 "title": "Create infrastructure asset"
}
