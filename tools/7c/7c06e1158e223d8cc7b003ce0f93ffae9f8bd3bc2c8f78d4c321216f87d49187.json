{
 "description": "Add a new product to an existing store.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Product description",
    "type": "string"
   },
   "name": {
    "description": "Product name",
    "type": "string"
   },
   "price": {
    "description": "Price in dollars (e.g. 29.99)",
    "type": "number"
   },
   "product_type": {
    "description": "Product type (default: physical)",
    "type": "string"
   },
   "store_id": {
    "description": "The store ID to add the product to",
    "type": "string"
   }
  },
  "required": [
   "store_id",
   "name",
   "price"
  ],
  "type": "object"
 },
 "name": "add_product"
}
