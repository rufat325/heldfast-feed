 "description": "Search published TradeBasis US dealer research, BHPH (buy here pay here) economics and portfolio benchmarks, the experimental BHPH Macro Conditions Index and its methodology, public blog articles, and legacy briefs. No arguments lists the catalog. topic retrieves a document by ID/slug/title; topic + section retrieves a section or continuation part. query searches; optional limit is an integer 1\u201320 (default 5). These modes cannot be combined. Returns published Markdown tables, dated evidence, sources and qualifications, not new financial analysis. Long documents return an overview and section directory. Publication is rechecked on every retrieval; unverifiable sources return retryable errors, not cached article text. Blog access uses the public internet. Publication/update dates, CMS modification, data coverage and retrieval time are distinct. Structured output uses operation=list/search/get/section/invalid; retrieval includes the requested Markdown and publisher caveats. Unknown dates and coverage remain null. No search cursor is supported; use returned section/part IDs for long content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Search results only: integer 1\u201320, default 5. Requires query.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Ordinary-language search of published dealer research and blog articles. Cannot be combined with topic or section.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "section": {
    "description": "Section or versioned part ID returned by this tool. Requires topic. Oversized sections list all continuation IDs.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "topic": {
    "description": "Stable document ID, legacy slug, or title. Alone retrieves a document; with section retrieves that section. Empty topic retains legacy listing behavior.",
    "maxLength": 256,
    "type": "string"
   }
  },
  "type": "object"
