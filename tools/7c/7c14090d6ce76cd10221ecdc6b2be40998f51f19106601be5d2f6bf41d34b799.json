{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Inspect seed landmarks in mm, paged within each category (max 100 per category).\n\n        Returns centre, corners, edge midpoints and origin intersections. Full\n        section polylines are omitted. Follow next_offset for more points.\n        ",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "mesh_id": {
    "pattern": "^[A-Za-z0-9_-]{1,80}$",
    "title": "Mesh Id",
    "type": "string"
   },
   "offset": {
    "default": 0,
    "minimum": 0,
    "title": "Offset",
    "type": "integer"
   },
   "workspace_id": {
    "pattern": "^[0-9a-f]{48}$",
    "title": "Workspace Id",
    "type": "string"
   }
  },
  "required": [
   "workspace_id",
   "mesh_id"
  ],
  "title": "mesh_landmarksArguments",
  "type": "object"
 },
 "name": "mesh_landmarks",
 "outputSchema": {
  "additionalProperties": true,
  "title": "mesh_landmarksDictOutput",
  "type": "object"
 }
}
