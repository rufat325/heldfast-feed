{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Rank suitable published courses and books using the buyer need, college, kind and USD budget. Explain personalized learning accurately; ask the customer to confirm suitability.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "budgetMinor": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "college": {
    "enum": [
     "dating",
     "marriage",
     "family"
    ],
    "type": "string"
   },
   "currency": {
    "const": "USD",
    "type": "string"
   },
   "includeBook": {
    "default": false,
    "type": "boolean"
   },
   "kind": {
    "enum": [
     "course",
     "book"
    ],
    "type": "string"
   },
   "need": {
    "maxLength": 500,
    "minLength": 3,
    "type": "string"
   },
   "query": {
    "maxLength": 150,
    "type": "string"
   }
  },
  "required": [
   "need",
   "currency",
   "includeBook"
  ],
  "type": "object"
 },
 "name": "recommend_offer"
}
