{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Activate or deactivate a sub account's API access key. A deactivated key cannot call the API but is not deleted, so it can be re-activated later.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accessKey": {
    "description": "Access key to change (see ncloud_list_sub_account_access_keys)",
    "type": "string"
   },
   "active": {
    "description": "true: activate, false: deactivate",
    "type": "boolean"
   },
   "subAccountId": {
    "description": "Sub account ID",
    "type": "string"
   }
  },
  "required": [
   "subAccountId",
   "accessKey",
   "active"
  ],
  "type": "object"
 },
 "name": "ncloud_set_sub_account_access_key_status"
}
