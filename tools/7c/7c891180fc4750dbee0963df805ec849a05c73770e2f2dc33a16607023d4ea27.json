{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Epic"
 },
 "description": "Update an epic. Pass only the fields you want to change. Set status to \"cancelled\" to soft-delete. Pass branch=\"current\" to pin to the active branch, or empty string to clear.",
 "inputSchema": {
  "properties": {
   "branch": {
    "description": "Branch to scope this epic to: \"current\" = active branch, \"\" = clear.",
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "id": {
    "description": "Epic ID",
    "type": "integer"
   },
   "name": {
    "type": "string"
   },
   "priority": {
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "sort_order": {
    "type": "integer"
   },
   "status": {
    "enum": [
     "planned",
     "in_progress",
     "completed",
     "cancelled"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "epic_update"
}
