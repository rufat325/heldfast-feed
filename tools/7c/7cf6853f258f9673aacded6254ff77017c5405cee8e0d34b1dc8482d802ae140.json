{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Encode text or a URL as a QR code and return a crisp, dependency-free SVG you can paste straight into a page, deck or doc.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ecc": {
    "default": "M",
    "description": "Error-correction level: L=7%, M=15%, Q=25%, H=30% recoverable.",
    "enum": [
     "L",
     "M",
     "Q",
     "H"
    ],
    "type": "string"
   },
   "size": {
    "default": 320,
    "description": "SVG pixel size.",
    "maximum": 1024,
    "minimum": 64,
    "type": "integer"
   },
   "text": {
    "description": "Text or URL to encode.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "qr_code",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "svg": {
    "description": "The QR code as SVG markup.",
    "type": "string"
   }
  },
  "required": [
   "svg"
  ],
  "type": "object"
 },
 "title": "Generate a QR code (SVG)"
}
