    "type": "string"
   },
   "paymentDate": {
    "description": "Date du paiement (YYYY-MM-DD), mapp\u00e9e vers date",
    "type": "string"
   },
   "paymentMethod": {
    "description": "Mode de paiement : ID de `boond://dictionary/paymentMethods`",
