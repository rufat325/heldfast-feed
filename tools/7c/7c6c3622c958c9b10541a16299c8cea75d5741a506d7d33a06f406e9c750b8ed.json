{
 "_meta": {
  "category": "compile",
  "tier": "cli"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compile status"
 },
 "description": "Poll an asynchronous compile started by log10x_compile (or a link started by log10x_compile_link), by its `job_id`. Returns `job_status` (running / completed / failed / timed_out), the units produced so far + the linked `.10x.tar` (path + size), elapsed time, the engine exit code, and a credential-redacted tail of the engine log. Crucially, it promotes the engine's scan/link DIAGNOSTICS into the envelope so the compiler is not a black box at 100k\u2013500k-file scale: per-language scan-failure counts with capped failure samples (which files failed to parse and why), and the link report (units merged / skipped, files excluded by folder/name filter, and the symbol-type histogram: class / enum / log / exec). Those appear once the compiler-10x image carries the engine diagnostics change; on an older image the tool degrades to unit counts + the log tail. The first terminal poll captures the exit code into the job record and frees the container; later polls stay readable and the compiled library is never removed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "job_id": {
    "description": "The job id returned by log10x_compile (data.payload.job_id).",
    "type": "string"
   },
   "log_lines": {
    "default": 40,
    "description": "How many trailing engine-log lines to include in data.payload.log_tail (credential-redacted). 0 to omit. Raise it when diagnosing a failed run.",
    "maximum": 400,
    "minimum": 0,
    "type": "integer"
   },
   "view": {
    "const": "summary",
    "default": "summary",
    "description": "summary returns the typed envelope (data.payload.job_status, .diagnostics, .output, .log_tail).",
    "type": "string"
   }
  },
  "required": [
   "job_id"
  ],
  "type": "object"
 },
 "name": "log10x_compile_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "actions": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "args": {
       "additionalProperties": {},
       "default": {},
       "type": "object"
      },
      "reason": {
       "type": "string"
      },
      "role": {
       "enum": [
        "required-next",
        "recommended-next",
        "optional-followup",
        "alternative"
       ],
       "type": "string"
      },
      "tool": {
       "type": "string"
      }
     },
     "required": [
      "tool",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "data": {},
   "generated_at": {
    "type": "string"
   },
   "images": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "alt": {
       "type": "string"
      },
      "data": {
       "type": "string"
      },
      "mimeType": {
       "default": "image/png",
       "enum": [
        "image/png",
        "image/jpeg",
        "image/gif",
        "image/webp"
       ],
       "type": "string"
      }
     },
     "required": [
      "data"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "type": "string"
   },
   "render_hint": {
    "additionalProperties": false,
    "properties": {
     "callouts": {
      "default": [],
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "chart": {
      "enum": [
       "sparkline",
       "timeseries",
       "bar",
       "none"
      ],
      "type": "string"
     },
     "units": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "schema_epoch": {
    "type": "string"
   },
   "schema_version": {
    "const": "1.0",
    "type": "string"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "bullets": {
      "items": {
       "type": "string"
      },
      "maxItems": 5,
      "type": "array"
     },
     "callout": {
      "type": "string"
     },
     "headline": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "headline"
    ],
    "type": "object"
   },
   "tool": {
    "type": "string"
   },
   "truncated": {
    "default": false,
    "type": "boolean"
   },
   "view": {
    "default": "summary",
    "enum": [
     "summary",
     "markdown"
    ],
    "type": "string"
   },
   "warnings": {
    "default": [],
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "schema_version",
   "schema_epoch",
   "tool",
   "generated_at",
   "summary"
  ],
  "type": "object"
 },
 "title": "Compile status"
}
