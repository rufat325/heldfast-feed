{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Changes a catalogue row \u2014 its name, price, unit, account, tax \u2014 or retires it with active: false. Documents already written keep the text, the price and the account they were invoiced with; an invoice is a statement about the day it was raised, and this tool cannot rewrite one. Retiring is the way to withdraw something: deleting is refused while any line still points at it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "description": "False retires it: searches stop offering it and the lines that already carry it are untouched.",
    "type": "boolean"
   },
   "code": {
    "description": "A new reference for it.",
    "minLength": 1,
    "type": "string"
   },
   "company_id": {
    "description": "Needed with product_code, to say which company the code belongs to.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "description": {
    "type": [
     "string",
     "null"
    ]
   },
   "kind": {
    "enum": [
     "service",
     "goods"
    ],
    "type": "string"
   },
   "name": {
    "minLength": 1,
    "type": "string"
   },
   "product_code": {
    "description": "Instead of product_id, with company_id.",
    "minLength": 1,
    "type": "string"
   },
   "product_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "purchase_account_code": {
    "minLength": 1,
    "type": "string"
   },
   "purchase_price": {
    "type": [
     "string",
     "number",
     "null"
    ]
   },
   "purchase_tax_code": {
    "minLength": 1,
    "type": "string"
   },
   "sale_account_code": {
    "minLength": 1,
    "type": "string"
   },
   "sale_price": {
    "type": [
     "string",
     "number",
     "null"
    ]
   },
   "sale_tax_code": {
    "minLength": 1,
    "type": "string"
   },
   "unit_code": {
    "description": "UN/ECE recommendation 20: C62 a piece, HUR an hour, DAY a day, MON a month, KGM, LTR, MTR, KWH. Defaults to C62.",
    "maxLength": 3,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "update_product",
 "title": "Change a product"
}
