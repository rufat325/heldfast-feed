{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Run an isolated scheduling demo"
 },
 "description": "Run a complete, anonymous demo with a fictional team in a single call. No account, OAuth, login, session ID, token, workspace ID or setup call is required. The result includes a proposed roster, coverage and hard-constraint checks, soft-preference exceptions and a manager next step. Each call is isolated; its schedule is not saved or published. If an instruction is ambiguous, return the blocker rather than silently ignoring it. Use fictional information only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "coverage_per_shift": {
    "default": 1,
    "description": "Workers required on each enabled shift for each operating day.",
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "demands": {
    "description": "Optional explicit fictional shift requirements. Each row can include day, role, start, end, shift, and required or min_required/max_required headcount. Omit to use sample shifts.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "day": {
       "description": "Shift date in YYYY-MM-DD format.",
       "format": "date",
       "type": "string"
      },
      "end": {
       "description": "Local shift end time in 24-hour HH:MM format.",
       "pattern": "^\\d{2}:\\d{2}$",
       "type": "string"
      },
      "max_required": {
       "description": "Maximum headcount to assign to this shift.",
       "maximum": 100,
       "minimum": 1,
       "type": "integer"
      },
      "min_required": {
       "description": "Minimum headcount needed for this shift.",
       "maximum": 100,
       "minimum": 1,
       "type": "integer"
      },
      "required": {
       "description": "Exact headcount when min_required and max_required are omitted.",
       "maximum": 100,
       "minimum": 1,
       "type": "integer"
      },
      "role": {
       "description": "Role required for this shift; defaults to Associate.",
       "type": "string"
      },
      "shift": {
       "description": "Optional short shift label.",
       "type": "string"
      },
      "start": {
       "description": "Local shift start time in 24-hour HH:MM format.",
       "pattern": "^\\d{2}:\\d{2}$",
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "industry": {
    "default": "restaurant",
    "description": "Business type used to select the fictional sample team and shift templates.",
    "enum": [
     "auto-repair",
     "clinic",
     "restaurant",
     "retail",
     "warehouse"
    ],
    "type": "string"
   },
   "manager_request": {
    "description": "Optional natural-language scheduling instructions for this fictional team only. Ambiguous requests stop for review; never include real staff or business data.",
    "maxLength": 4000,
    "type": "string"
   },
   "operating_days_per_week": {
    "default": 7,
    "description": "Number of open days, starting Monday. For example, 5 means Monday through Friday.",
    "maximum": 7,
    "minimum": 1,
    "type": "integer"
   },
   "period_mode": {
    "default": "week",
    "description": "Schedule length: week or month. Defaults to one week.",
    "enum": [
     "week",
     "month"
    ],
    "type": "string"
   },
   "period_start": {
    "description": "Optional date in YYYY-MM-DD format inside the requested week or month; otherwise the next full period is selected.",
    "type": "string"
   },
   "team_size": {
    "description": "Number of synthetic workers, from 4 to 12; defaults to the selected industry's sample size.",
    "maximum": 12,
    "minimum": 4,
    "type": "integer"
   },
   "time_limit_seconds": {
    "default": 2,
    "description": "Solver time budget, from 0.1 to 10 seconds. Defaults to 2 seconds.",
    "maximum": 10,
    "minimum": 0.1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "run_public_demo",
 "outputSchema": {
