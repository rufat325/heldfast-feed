{
 "description": "Edit specific areas of an image using mask-based inpainting. Requires source image, mask (black=edit, white=keep), and prompt.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "image": {
    "description": "Local file path of the source image to edit",
    "minLength": 1,
    "type": "string"
   },
   "magic_prompt": {
    "description": "Auto-enhance prompts (default: AUTO)",
    "enum": [
     "AUTO",
     "ON",
     "OFF"
    ],
    "type": "string"
   },
   "mask": {
    "description": "Local file path of the mask image (black=edit, white=keep, min 10% black)",
    "minLength": 1,
    "type": "string"
   },
   "num_images": {
    "description": "Number of variations (1-8, default: 1)",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "prompt": {
    "description": "Description of desired changes",
    "maxLength": 10000,
    "minLength": 1,
    "type": "string"
   },
   "rendering_speed": {
    "description": "Speed/quality tradeoff (default: DEFAULT)",
    "enum": [
     "FLASH",
     "TURBO",
     "DEFAULT",
     "QUALITY"
    ],
    "type": "string"
   },
   "seed": {
    "description": "Reproducibility seed",
    "maximum": 2147483647,
    "minimum": 0,
    "type": "integer"
   },
   "style_type": {
    "description": "Visual style (default: AUTO)",
    "enum": [
     "AUTO",
     "GENERAL",
     "REALISTIC",
     "DESIGN",
     "FICTION"
    ],
    "type": "string"
   }
  },
  "required": [
   "image",
   "mask",
   "prompt"
  ],
  "type": "object"
 },
 "name": "ideogram_edit"
}
