{
 "description": "Paid Wallet Risk Check ($0.02 USDC on Base). Call before an agent sends funds to, accepts value from, grants an approval to, or interacts with an unfamiliar address. Checks whether the address is a wallet or contract and reads basic on-chain metadata. Sanctions, scam, drainer, mixer, and malicious-address intelligence are unknown unless a trusted provider is configured; without one, the result is cautious and low-confidence, not a safety certification. Never send private keys or seed phrases.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "address": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "chain": {
    "enum": [
     "base",
     "base-sepolia"
    ],
    "type": "string"
   }
  },
  "required": [
   "chain",
   "address"
  ],
  "type": "object"
 },
 "name": "check_wallet",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "address": {
    "type": "string"
   },
   "address_type": {
    "enum": [
     "wallet",
     "contract"
    ],
    "type": "string"
   },
   "cached": {
    "type": "boolean"
   },
   "chain": {
    "enum": [
     "base",
     "base-sepolia"
    ],
    "type": "string"
   },
   "checked_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "contract": {
    "additionalProperties": false,
    "properties": {
     "code_size_bytes": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "is_contract": {
      "type": "boolean"
     },
     "proxy": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "verified": {
      "type": [
       "boolean",
       "null"
      ]
     }
    },
    "required": [
     "is_contract",
     "verified",
     "proxy",
     "code_size_bytes"
    ],
    "type": "object"
   },
   "data_freshness_seconds": {
    "minimum": 0,
    "type": "number"
   },
   "degraded": {
    "type": "boolean"
   },
   "drainer_risk": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "exposures": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "distance": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "relationship": {
       "enum": [
        "direct",
        "indirect"
       ],
       "type": "string"
      },
      "severity": {
       "enum": [
        "low",
        "medium",
        "high",
        "critical"
       ],
       "type": "string"
      }
     },
     "required": [
      "category",
      "relationship",
      "distance",
      "severity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "known_malicious": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "mixer_exposure": {
    "additionalProperties": false,
    "properties": {
     "direct": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "level": {
      "enum": [
       "none",
       "low",
       "medium",
       "high",
       "unknown"
      ],
      "type": "string"
     }
    },
    "required": [
     "level",
     "direct"
    ],
    "type": "object"
   },
   "onchain": {
    "additionalProperties": false,
    "properties": {
     "block_number": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "chain_id": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "native_balance_wei": {
      "type": "string"
     },
     "transaction_count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "chain_id",
     "native_balance_wei",
     "transaction_count",
     "block_number"
    ],
    "type": "object"
   },
   "recommendation": {
    "enum": [
     "allow",
     "caution",
     "block"
    ],
    "type": "string"
   },
   "reputation": {
    "enum": [
     "neutral",
     "suspicious",
     "malicious",
     "unknown"
    ],
    "type": "string"
   },
   "risk_confidence": {
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "risk_level": {
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "risk_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "sanctions_match": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "scam_risk": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "sources": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "success": {
    "const": true,
    "type": "boolean"
   },
   "suspicious_activity": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "success",
   "chain",
   "address",
   "address_type",
   "risk_score",
   "risk_level",
   "risk_confidence",
   "recommendation",
   "reputation",
   "sanctions_match",
   "known_malicious",
   "scam_risk",
   "drainer_risk",
   "mixer_exposure",
   "exposures",
   "suspicious_activity",
   "warnings",
   "contract",
   "onchain",
   "sources",
   "degraded",
   "cached",
   "checked_at",
   "data_freshness_seconds"
  ],
  "type": "object"
 }
}
