{
 "description": "Edit a blog article \u2014 title, content, excerpt, SEO fields, status, author, or category. Set status='published' to make it live on your PostKing blog.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "articleId": {
    "description": "Blog article ID",
    "type": "string"
   },
   "authorId": {
    "description": "Author ID (from list_blog_authors)",
    "type": "string"
   },
   "brandId": {
    "description": "Brand ID (uses active brand if omitted)",
    "type": "string"
   },
   "categoryId": {
    "description": "Category ID (from list_blog_categories)",
    "type": "string"
   },
   "content": {
    "description": "Full post body (HTML or markdown)",
    "type": "string"
   },
   "excerpt": {
    "type": "string"
   },
   "metaDescription": {
    "type": "string"
   },
   "metaTitle": {
    "type": "string"
   },
   "status": {
    "description": "'published' makes it live on your blog",
    "enum": [
     "draft",
     "published"
    ],
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "articleId"
  ],
  "type": "object"
 },
 "name": "update_blog_article"
}
