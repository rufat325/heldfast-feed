{
 "_meta": {
  "stackfacts/http": "POST /v1/models/estimate",
  "stackfacts/keywords": [
   "LLM cost estimate",
   "price per million tokens",
   "token cost calculator",
   "how much will this prompt cost"
  ],
  "stackfacts/paid": true,
  "stackfacts/price_usd": "0.003"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Estimate the USD cost of an LLM call from input, output and cached token counts, exact to the micro-dollar, with the price lines used.",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "input_tokens"
    ]
   },
   {
    "required": [
     "output_tokens"
    ]
   },
   {
    "required": [
     "cached_tokens"
    ]
   }
  ],
  "properties": {
   "cached_tokens": {
    "description": "Cached input tokens (cache reads)",
    "maximum": 10000000000,
    "minimum": 0,
    "type": "integer"
   },
   "input_tokens": {
    "description": "Uncached input tokens",
    "maximum": 10000000000,
    "minimum": 0,
    "type": "integer"
   },
   "model": {
    "description": "provider/model id, e.g. openai/gpt-4o",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "output_tokens": {
    "description": "Output tokens",
    "maximum": 10000000000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "model"
  ],
  "type": "object"
 },
 "name": "stackfacts_models_estimate"
}
