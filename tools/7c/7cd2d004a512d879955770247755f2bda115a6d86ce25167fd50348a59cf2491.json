{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update a Data Stream topic settings (partitions can only be increased, not decreased)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Topic description (max 200 chars)",
    "type": "string"
   },
   "partitions": {
    "description": "Number of partitions (can only increase)",
    "maximum": 16,
    "minimum": 1,
    "type": "number"
   },
   "retentionMs": {
    "description": "Message retention in ms",
    "maximum": 1296000000,
    "minimum": 3600000,
    "type": "number"
   },
   "topicId": {
    "description": "Topic ID to update",
    "type": "string"
   }
  },
  "required": [
   "topicId",
   "description",
   "partitions",
   "retentionMs"
  ],
  "type": "object"
 },
 "name": "ncloud_datastream_update_topic"
}
