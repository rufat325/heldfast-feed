{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Feature Request"
 },
 "description": "Submit a new feature request or upvote an existing matching request. ALWAYS ask for confirmation before writing.",
 "inputSchema": {
  "properties": {
   "area": {
    "description": "System area of request",
    "enum": [
     "orders",
     "CRM",
     "email marketing",
     "finance",
     "farm management",
     "genetics",
     "hatch",
     "apiary",
     "MCP/API",
     "other"
    ],
    "type": "string"
   },
   "confirm": {
    "description": "Set to true to commit, false for dry-run preview",
    "type": "boolean"
   },
   "description": {
    "description": "Detailed explanation of the feature (max 5000 chars)",
    "type": "string"
   },
   "farmId": {
    "description": "The unique farm ID",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Unique request idempotency key",
    "type": "string"
   },
   "title": {
    "description": "The brief title of the requested feature (max 200 chars)",
    "type": "string"
   }
  },
  "required": [
   "farmId",
   "title",
   "description",
   "area"
  ],
  "type": "object"
 },
 "name": "create_feature_request"
}
