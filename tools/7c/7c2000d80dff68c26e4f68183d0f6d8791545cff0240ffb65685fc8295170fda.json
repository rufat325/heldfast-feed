{
 "_meta": {
  "openai/toolInvocation/invoked": "Found kids' activities",
  "openai/toolInvocation/invoking": "Finding kids' activities\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Kids' activities in a neighborhood"
 },
 "description": "Get kids' activities and businesses in a neighborhood \u2014 classes, sports, arts, tutoring, etc. Use count_only for category breakdown, or limit/offset to page the full list (reports total/returned). Each place's last_refreshed is when we last confirmed it was still listed.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count_only": {
    "default": false,
    "description": "Return only category counts",
    "type": "boolean"
   },
   "limit": {
    "default": 50,
    "description": "Max activities to return (ignored when count_only)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "nta_code": {
    "description": "NTA code",
    "maxLength": 6,
    "type": "string"
   },
   "offset": {
    "default": 0,
    "description": "Number of activities to skip, for paging through the full list",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "nta_code"
  ],
  "type": "object"
 },
 "name": "get-activities",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "total": {
    "type": "number"
   }
  },
  "required": [
   "total"
  ],
  "type": "object"
 }
}
