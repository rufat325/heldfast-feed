{
 "description": "Add interactive form fields to a stored PDF \u2014 from placeholder tags (refined via fieldOverrides) and/or explicitly positioned fields.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "documentId": {
    "description": "The document ID",
    "type": "string"
   },
   "fieldOverrides": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "autoFill": {
       "type": "boolean"
      },
      "description": {
       "type": "string"
      },
      "fontSize": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "height": {
       "exclusiveMinimum": 0,
       "type": "integer"
      },
      "optional": {
       "type": "boolean"
      },
      "options": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "role": {
       "type": "string"
      },
      "width": {
       "exclusiveMinimum": 0,
       "type": "integer"
      }
     },
     "type": "object"
    },
    "description": "Per-field overrides keyed by field name",
    "type": "object"
   },
   "fields": {
    "description": "Fields to add at explicit positions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "autoFill": {
       "type": "boolean"
      },
      "description": {
       "type": "string"
      },
      "fontSize": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "height": {
       "minimum": 1,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "optional": {
       "type": "boolean"
      },
      "options": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "page": {
       "minimum": 1,
       "type": "integer"
      },
      "role": {
       "type": "string"
      },
      "type": {
       "enum": [
        "signature",
        "text",
        "number",
        "textarea",
        "date",
        "time",
        "datetime",
        "checkbox",
        "radio",
        "select"
       ],
       "type": "string"
      },
      "value": {
       "type": "string"
      },
      "width": {
       "minimum": 1,
       "type": "integer"
      },
      "x": {
       "type": "number"
      },
      "y": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "type",
      "page",
      "height",
      "width",
      "x",
      "y"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "preSignedUrlExpiresIn": {
    "description": "Generate a fresh pre-signed download URL expiring in this many seconds (60\u201386400)",
    "maximum": 86400,
    "minimum": 60,
    "type": "integer"
   }
  },
  "required": [
   "documentId"
  ],
  "type": "object"
 },
 "name": "add_form_fields"
}
