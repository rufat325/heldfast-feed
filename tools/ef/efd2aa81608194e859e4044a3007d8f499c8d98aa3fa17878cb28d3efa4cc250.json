{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "CWR validation"
 },
 "description": "CWR validation: checks the text of a CWR 2.1 (Common Works Registration) file used to register songs with music royalties societies such as The MLC, PRS for Music / ICE, SACEM or CMRRA. Returns whether the file is valid, error and warning counts, and each issue with its line, rule, plain-language explanation and how to fix it. Pass the file content as ASCII text, up to 256 KB; larger files can be uploaded at https://trackforge.studio/cwr-tool. Validation does not guarantee acceptance by a society. The file is not stored.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cwr_text": {
    "description": "The full CWR file content (ASCII text, HDR to TRL).",
    "maxLength": 262144,
    "minLength": 1,
    "type": "string"
   },
   "filename": {
    "description": "Optional original filename, e.g. CW260001TF_000.V21. A society receiver code in the name selects that society's rules.",
    "maxLength": 255,
    "type": "string"
   },
   "recipient_profile": {
    "default": "cisac_base",
    "description": "Which society's rules to apply; cisac_base when unsure.",
    "enum": [
     "cisac_base",
     "mlc",
     "cmrra",
     "alltrack_worldwide",
     "alltrack_us_only",
     "capasso_africa",
     "ice",
     "sacem",
     "siae",
     "sgae",
     "prs"
    ],
    "type": "string"
   }
  },
  "required": [
   "cwr_text"
  ],
  "type": "object"
 },
 "name": "validate_cwr",
 "outputSchema": {
  "$defs": {
   "CwrIssue": {
    "properties": {
     "field": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Field"
     },
     "fix_hint": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Fix Hint"
     },
     "fix_location": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Fix Location"
     },
     "line_number": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Line Number"
     },
     "message": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Message"
     },
     "plain_message": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Plain Message"
     },
     "rule_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Rule Id"
     },
     "severity": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Severity"
     },
     "value": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Value"
     },
     "why_it_matters": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Why It Matters"
     }
    },
    "title": "CwrIssue",
    "type": "object"
   }
  },
  "properties": {
   "error_count": {
    "title": "Error Count",
    "type": "integer"
   },
   "full_report": {
    "title": "Full Report",
    "type": "string"
   },
   "is_valid": {
    "title": "Is Valid",
    "type": "boolean"
   },
   "issues": {
    "items": {
     "$ref": "#/$defs/CwrIssue"
    },
    "title": "Issues",
    "type": "array"
   },
   "issues_total": {
    "title": "Issues Total",
    "type": "integer"
   },
   "issues_truncated": {
    "title": "Issues Truncated",
    "type": "boolean"
   },
   "line_endings_converted": {
    "title": "Line Endings Converted",
    "type": "boolean"
   },
   "recipient_profile": {
    "title": "Recipient Profile",
    "type": "string"
   },
   "recipient_resolution": {
    "additionalProperties": true,
    "title": "Recipient Resolution",
    "type": "object"
   },
   "record_count": {
    "title": "Record Count",
    "type": "integer"
   },
   "spec_version": {
    "title": "Spec Version",
    "type": "string"
   },
   "status_dimensions": {
    "anyOf": [
     {
      "additionalProperties": true,
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Status Dimensions"
   },
   "stored": {
    "default": false,
    "title": "Stored",
    "type": "boolean"
   },
   "transaction_count": {
    "title": "Transaction Count",
    "type": "integer"
   },
   "warning_count": {
    "title": "Warning Count",
    "type": "integer"
   }
  },
  "required": [
   "is_valid",
   "spec_version",
   "recipient_profile",
   "recipient_resolution",
   "record_count",
   "transaction_count",
   "error_count",
   "warning_count",
   "issues",
   "issues_total",
   "issues_truncated",
   "line_endings_converted",
   "full_report"
  ],
  "title": "CwrValidationResult",
  "type": "object"
 },
 "title": "CWR validation (CWR 2.1 file check)"
}
