    "minLength": 1,
    "type": "string"
   },
   "description": {
    "description": "Optional session description / GM notes.",
    "type": "string"
   },
   "endAt": {
    "description": "Session end time as an ISO-8601 instant.",
    "type": "string"
   },
   "invitedUserIds": {
    "description": "User IDs to invite (must be active campaign members).",
