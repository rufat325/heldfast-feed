{
 "annotations": {
  "destructiveHint": true,
  "title": "Add a DNS record"
 },
 "description": "WRITE. Add a record to a DNS zone. Takes effect on live DNS. bunny.net: PUT /dnszone/{zoneId}/records.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "accelerated": {
    "description": "Route the record through the CDN (CDN acceleration).",
    "type": "boolean"
   },
   "comment": {
    "description": "Free-text note on the record.",
    "maxLength": 1024,
    "type": "string"
   },
   "disabled": {
    "description": "Keep the record but stop serving it.",
    "type": "boolean"
   },
   "flags": {
    "description": "Flags (CAA).",
    "maximum": 255,
    "minimum": 0,
    "type": "integer"
   },
   "name": {
    "description": "Record name relative to the zone; empty string for the apex, e.g. 'www'.",
    "maxLength": 255,
    "type": "string"
   },
   "port": {
    "description": "Port (SRV).",
    "maximum": 65535,
    "minimum": 0,
    "type": "integer"
   },
   "priority": {
    "description": "Priority (MX, SRV).",
    "maximum": 65535,
    "minimum": 0,
    "type": "integer"
   },
   "pull_zone_id": {
    "description": "Pull Zone ID, for type PullZone.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "tag": {
    "description": "Tag (CAA), e.g. 'issue'.",
    "maxLength": 255,
    "type": "string"
   },
   "ttl": {
    "description": "TTL in seconds.",
    "maximum": 2147483647,
    "minimum": 0,
    "type": "integer"
   },
   "type": {
    "description": "Record type.",
    "enum": [
     "A",
     "AAAA",
     "CNAME",
     "TXT",
     "MX",
     "Redirect",
     "Flatten",
     "PullZone",
     "SRV",
     "CAA",
     "PTR",
     "Script",
     "NS",
     "SVCB",
     "HTTPS",
     "TLSA"
    ],
    "type": "string"
   },
   "value": {
    "description": "Record value, e.g. an IP for A, a hostname for CNAME, text for TXT.",
    "maxLength": 4096,
    "type": "string"
   },
   "weight": {
    "description": "Weight (SRV, weighted records).",
    "maximum": 65535,
    "minimum": 0,
    "type": "integer"
   },
   "zone_id": {
    "description": "The DNS Zone ID.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "zone_id",
   "type",
   "name",
   "value"
  ],
  "type": "object"
 },
 "name": "bunny_add_dns_record",
 "title": "Add a DNS record"
}
