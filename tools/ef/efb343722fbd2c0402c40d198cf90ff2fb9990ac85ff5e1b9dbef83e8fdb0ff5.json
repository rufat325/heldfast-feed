{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Requests a 30-minute intro call at a free time from get_available_slots. Farrukh confirms every request; Cal.com then emails the Google Meet invitation. Confirm the details with the user first.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"company":{"description":"Company the person works for","maxLength":100,"minLength":2,"pattern":"^[^\\r\\n]*$","type":"string"},"email":{"description":"Cal.com sends the invitation to this address","format":"email","maxLength":254,"pattern":"^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"lang":{"default":"en","description":"Language of the invitation: \"de\" or \"en\".","enum":["de","en"],"type":"string"},"link":{"anyOf":[{"const":"","type":"string"},{"maxLength":500,"pattern":"^[^\\s\\p{Cc}]+$","type":"string"}],"default":"","description":"Optional link, e.g. to the job posting"},"name":{"description":"Full name of the person who will join the call","maxLength":100,"minLength":2,"pattern":"^[^\\r\\n]*$","type":"string"},"reason":{"description":"What the call is about, 10 to 1000 characters","maxLength":1000,"minLength":10,"type":"string"},"start":{"description":"Start of a free slot from get_available_slots","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$","type":"string"},"timeZone":{"description":"IANA time zone of the user, e.g. \"Europe/Berlin\" or \"America/New_York\".","maxLength":64,"type":"string"}},"required":["name","email","company","reason","start","timeZone"],"type":"object"},"name":"book_call","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"label":{"type":"string"},"start":{"type":"string"},"status":{"const":"requested","type":"string"}},"required":["status","start","label"],"type":"object"},"title":"Request an intro call"}
