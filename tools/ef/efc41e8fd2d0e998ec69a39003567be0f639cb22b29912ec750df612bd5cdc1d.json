{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a product"
 },
 "description": "MUTATES LIVE STORE DATA. Create a new product in the store. Provide the common fields directly (name is required); anything else goes in `fields`, which is merged into the request body. Swell backend REST API: POST /products.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "active": {
    "description": "Whether the product is active/visible.",
    "type": "boolean"
   },
   "description": {
    "description": "Product description.",
    "type": "string"
   },
   "fields": {
    "additionalProperties": {},
    "description": "Any additional product fields, merged into the request body (e.g. attributes, options, images).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "description": "Product name (required).",
    "type": "string"
   },
   "price": {
    "description": "Product price.",
    "type": "number"
   },
   "sku": {
    "description": "Stock-keeping unit.",
    "type": "string"
   },
   "stock_level": {
    "description": "Available stock quantity.",
    "type": "number"
   },
   "type": {
    "description": "Product type, e.g. \"standard\", \"subscription\", \"digital\".",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "swell_create_product",
 "title": "Create a product"
}
