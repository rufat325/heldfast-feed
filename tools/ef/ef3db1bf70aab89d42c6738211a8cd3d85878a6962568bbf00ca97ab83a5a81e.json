{
 "description": "Pushes commits to remote. Always confirm with user. Force push to main/master is blocked.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cwd": {
    "description": "Repository path",
    "type": "string"
   },
   "force": {
    "description": "Force push (--force)",
    "type": "boolean"
   },
   "rev": {
    "description": "Revision to push (-r)",
    "type": "string"
   },
   "to": {
    "description": "Destination bookmark (--to)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "sl_push"
}
