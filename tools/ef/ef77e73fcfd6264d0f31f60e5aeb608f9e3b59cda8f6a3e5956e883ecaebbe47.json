{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List generated reports in your clariBI organization. Returns id, title, status, output format, and download URL.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 20,
    "description": "Page size (1-100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Row offset for pagination.",
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "description": "Filter by status (pending, generating, completed, failed, cancelled).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_reports",
 "outputSchema": {
  "properties": {
   "items": {
    "items": {
     "properties": {
      "completed_at": {
       "format": "date-time",
       "type": [
        "string",
        "null"
       ]
      },
      "created_at": {
       "format": "date-time",
       "type": [
        "string",
        "null"
       ]
      },
      "download_url": {
       "description": "Present only once status is \"completed\".",
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "format": "uuid",
       "type": "string"
      },
      "output_format": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "web_url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "status",
      "web_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "limit": {
    "type": "integer"
   },
   "offset": {
    "type": "integer"
   },
   "total": {
    "description": "Total reports matching the query.",
    "type": "integer"
   }
  },
  "required": [
   "total",
   "offset",
   "limit",
   "items"
  ],
  "type": "object"
 }
}
