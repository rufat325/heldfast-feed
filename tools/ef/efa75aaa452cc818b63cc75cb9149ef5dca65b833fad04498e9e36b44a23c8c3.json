{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add a bounded progress checkpoint to an existing continuity capsule without resending the full task history.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "capsule": {
    "maxLength": 32000,
    "minLength": 40,
    "type": "string"
   },
   "completedAdd": {
    "items": {
     "maxLength": 320,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "constraintsAdd": {
    "items": {
     "maxLength": 320,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "nextAction": {
    "maxLength": 600,
    "type": "string"
   },
   "remainingAdd": {
    "items": {
     "maxLength": 320,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "remainingDoneIndices": {
    "items": {
     "maximum": 19,
     "minimum": 0,
     "type": "integer"
    },
    "maxItems": 20,
    "type": "array"
   },
   "requiredCapabilitiesAdd": {
    "items": {
     "pattern": "^[a-z0-9_:-]{2,64}$",
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "verifiedFactsAdd": {
    "items": {
     "maxLength": 320,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   }
  },
  "required": [
   "capsule"
  ],
  "type": "object"
 },
 "name": "checkpoint_agent_task",
 "title": "Checkpoint Agent Task"
}
