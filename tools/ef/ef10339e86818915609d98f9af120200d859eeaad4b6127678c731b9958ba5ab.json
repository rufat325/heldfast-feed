{"_meta":{"securitySchemes":[{"scopes":["openid"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Requires OAuth login. Uses your saved vessel, draft, air draft, speed, under-keel and bridge margins for actual chart routing. Explicit measurements override saved values. Never guesses missing required measurements.\n\nUnits: ft, kt, s, F, mi; directions FROM. Returns data and source/freshness metadata.","icons":[{"mimeType":"image/svg+xml","sizes":["64x64"],"src":"data:image/svg+xml;base64,"}],"inputSchema":{"additionalProperties":false,"properties":{"query":{"additionalProperties":false,"properties":{"airDraft":{"maximum":150,"minimum":0,"type":"number"},"beam":{"maximum":60,"minimum":1,"type":"number"},"bridgeMargin":{"maximum":20,"minimum":0,"type":"number"},"corridor":{"default":"any","description":"icw is a hard USACE/FWC published ICW channel boundary, with no ocean fallback. Unknown/missing channel or depth coverage returns no verified route.","enum":["any","icw"],"type":"string"},"draft":{"maximum":15,"minimum":0.3,"type":"number"},"from":{"maxLength":80,"minLength":1,"type":"string"},"speed":{"maximum":60,"minimum":3,"type":"number"},"time":{"format":"date-time","type":"string"},"to":{"maxLength":80,"minLength":1,"type":"string"},"ukc":{"maximum":10,"minimum":0,"type":"number"},"via":{"description":"Up to eight required stops in order: spot IDs or lat,lon separated by semicolons. Stops may snap up to 300 m; inspect reached offsets. No straight-line gaps are implied safe.","maxLength":800,"minLength":1,"type":"string"}},"required":["from","to"],"type":"object"}},"required":["query"],"type":"object"},"name":"plan_my_route","securitySchemes":[{"scopes":["openid"],"type":"oauth2"}],"title":"Plan with my saved vessel"}
