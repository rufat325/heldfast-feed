{
 "description": "Continue an NPC dialogue with the next line and response choices. Set endDialogue=true to end the conversation and return to narrative.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "endDialogue": {
    "default": false,
    "description": "If true, end the dialogue and return to the exploration scene",
    "type": "boolean"
   },
   "npcId": {
    "description": "NPC ID (must match current dialogue)",
    "type": "string"
   },
   "npcName": {
    "description": "NPC display name",
    "type": "string"
   },
   "portrait": {
    "description": "Portrait URL or emoji (optional override)",
    "type": "string"
   },
   "responses": {
    "description": "New response choices for the player",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   },
   "text": {
    "description": "NPC's next dialogue line",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "npcId",
   "npcName",
   "text"
  ],
  "type": "object"
 },
 "name": "advance_dialogue"
}
