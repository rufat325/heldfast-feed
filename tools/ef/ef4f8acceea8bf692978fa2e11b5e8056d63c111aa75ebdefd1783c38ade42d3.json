{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks \"are these references real?\", \"check my bibliography\", \"verify this citation\", \"is this DOI correct?\" or \"has this paper been retracted?\". Pass each reference as one string as written (authors, year, title, journal, DOI), or just a DOI or a title, up to 10 at a time. Looks each one up in Crossref, the DOI system and OpenAlex and returns a verdict per reference: found (a real record matches), mismatch (a real record exists but the DOI, title, authors or year differ; the real record is shown) or not_found (nothing matches, so it may be invented or garbled). Also returns the paper's retraction status (retracted, expression of concern, corrected) from Crossref. It checks bibliographic details only, not whether a paper's claims are true.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "references": {
    "description": "One string per reference, as written in the bibliography or as the user gave it: authors, year, title, journal, DOI. A bare DOI or a bare title also works. At most 10.",
    "items": {
     "maxLength": 600,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "references"
  ],
  "type": "object"
 },
 "name": "check_references",
 "outputSchema": {
  "properties": {
   "references": {
    "items": {
     "properties": {
      "authors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "differences": {
       "items": {
        "enum": [
         "doi",
         "title",
         "authors",
         "year"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "doi": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "message": {
       "type": "string"
      },
      "reference": {
       "type": "string"
      },
      "retraction": {
       "properties": {
        "notices": {
         "items": {
          "properties": {
           "date": {
            "type": [
             "string",
             "null"
            ]
           },
           "doi": {
            "type": [
             "string",
             "null"
            ]
           },
           "type": {
            "type": "string"
           }
          },
          "required": [
           "type"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "status": {
         "enum": [
          "retracted",
          "partially_retracted",
          "expression_of_concern",
          "corrected",
          "none_recorded",
          "not_checked"
         ],
         "type": "string"
        }
       },
       "required": [
        "status"
       ],
       "type": "object"
      },
      "source": {
       "enum": [
        "Crossref",
        "OpenAlex",
        "DOI.org"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "venue": {
       "type": "string"
      },
      "verdict": {
       "enum": [
        "found",
        "mismatch",
        "not_found",
        "unavailable",
        "ambiguous"
       ],
       "type": "string"
      },
      "year": {
       "type": "integer"
      }
     },
     "required": [
      "index",
      "reference",
      "verdict"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "properties": {
     "found": {
      "type": "integer"
     },
     "mismatch": {
      "type": "integer"
     },
     "not_found": {
      "type": "integer"
     },
     "retracted": {
      "type": "integer"
     },
     "unavailable": {
      "type": "integer"
     }
    },
    "required": [
     "found",
     "mismatch",
     "not_found",
     "unavailable",
     "retracted"
    ],
    "type": "object"
   }
  },
  "required": [
   "summary",
   "references"
  ],
  "type": "object"
 },
 "title": "Check references and DOIs"
}
