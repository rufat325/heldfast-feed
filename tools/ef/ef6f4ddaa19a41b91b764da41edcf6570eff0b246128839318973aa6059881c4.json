{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Every Shuttle-UM bus route in the current timetable (regular routes such as 104 College Park Metro plus event routes), with whether each runs today, from the published GTFS feed. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "transportation_list_routes",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "feed": {
    "additionalProperties": false,
    "description": "The timetable the answers come from",
    "properties": {
     "valid_from": {
      "description": "First date the timetable covers",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "type": "string"
     },
     "valid_to": {
      "description": "Last date the timetable covers",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "type": "string"
     },
     "version": {
      "description": "Feed version as the publisher labels it",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "valid_from",
     "valid_to",
     "version"
    ],
    "type": "object"
   },
   "routes": {
    "description": "Routes in id order",
    "items": {
     "additionalProperties": false,
     "properties": {
      "color": {
       "description": "Route colour as a six-digit hex string, e.g. \"93c47d\"",
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "description": "Route id, e.g. \"104\"",
       "type": "string"
      },
      "long_name": {
       "description": "Route name, e.g. \"College Park Metro Station\"",
       "type": [
        "string",
        "null"
       ]
      },
      "scheduled_today": {
       "description": "true when at least one trip runs today",
       "type": "boolean"
      },
      "short_name": {
       "description": "Number or code shown on the bus, e.g. \"104\"",
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "description": "DOTS page with the stop list and printed timetable",
       "type": "string"
      }
     },
     "required": [
      "id",
      "short_name",
      "long_name",
      "color",
      "url",
      "scheduled_today"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "feed",
   "routes"
  ],
  "type": "object"
 },
 "title": "List Shuttle-UM routes"
}
