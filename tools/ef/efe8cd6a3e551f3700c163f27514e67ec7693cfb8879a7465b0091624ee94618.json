{"annotations":{"destructiveHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"An event in an inbox\u2019s calendar. Timed: ISO 8601 times with their offset. All day: dates, `end` the last day. `attendees` records who is on it; invitations go only with `send_invites: true` (a key with send access).","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"all_day":{"type":"boolean"},"attendees":{"items":{"format":"email","pattern":"^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"maxItems":50,"type":"array"},"description":{"type":"string"},"end":{"description":"Required for a timed event; all day, the last day (default the start).","type":"string"},"inbox_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"location":{"type":"string"},"send_invites":{"type":"boolean"},"start":{"type":"string"},"title":{"maxLength":1000,"minLength":1,"type":"string"}},"required":["inbox_id","title","start"],"type":"object"},"name":"create_calendar_event","title":"Add a calendar event"}
