    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "actionPayload": {
    "additionalProperties": true,
    "type": "object"
   },
   "actionType": {
    "maxLength": 100,
    "type": "string"
   },
   "originLocation": {
    "maxLength": 255,
    "type": "string"
   },
   "originPlatform": {
    "maxLength": 100,
    "type": "string"
   },
   "originTrustedDeviceId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
