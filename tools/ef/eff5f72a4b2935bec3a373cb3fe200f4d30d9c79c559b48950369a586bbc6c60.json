{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Update a pending post"
 },
 "description": "Change the text, media or scheduled date of a post that has NOT gone out yet (state draft or ready). A published post cannot be edited through PlanVortex; if you try, the error will say so. A Pinterest pin saved without a board (error 987) is fixed here by passing destination_id.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "destination_id": {
    "description": "Pinterest: the board, an id from list_destinations.",
    "type": "string"
   },
   "files": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id_organization": {
    "description": "The PlanVortex organization id. Optional.",
    "type": "string"
   },
   "id_publication": {
    "type": "string"
   },
   "link": {
    "description": "Pinterest: the pin's destination URL.",
    "type": "string"
   },
   "publish_date": {
    "description": "ISO 8601.",
    "type": "string"
   },
   "state": {
    "enum": [
     "draft",
     "ready"
    ],
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "id_publication"
  ],
  "type": "object"
 },
 "name": "update_publication",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "publication": {
    "additionalProperties": false,
    "properties": {
     "errors": {
      "type": "number"
     },
     "id": {
      "type": "string"
     },
     "id_account": {
      "type": "string"
     },
     "publication_type": {
      "type": "string"
     },
     "publish_date": {
      "type": "string"
     },
     "social_network": {
      "type": "string"
     },
     "state": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "social_network",
     "state",
     "publication_type",
     "text",
     "id_account",
     "errors"
    ],
    "type": "object"
   }
  },
  "required": [
   "publication"
  ],
  "type": "object"
 },
 "title": "Update a pending post"
}
