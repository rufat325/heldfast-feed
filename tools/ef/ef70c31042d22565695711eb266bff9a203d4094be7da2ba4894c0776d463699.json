{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Validate walkerOS events, flow configurations, mapping rules, or data contracts. Accepts JSON strings, file paths, or URLs as input; on the hosted server only inline JSON or a saved flow id (flow_ or cfg_), no file paths or URLs. With only type and input, a flow runs every check on every flow and step, including each package's settings schema (fetched from the package CDN; offline: true skips that and says so). flow and path narrow the run; strict turns warnings and skips into failures: valid is false. Returns valid, errors and warnings with stable codes, and details.scope (what was checked), details.skipped (checks that could not run) and details.deferred (values known only at runtime).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "flow": {
    "description": "Flow name for multi-flow configs",
    "type": "string"
   },
   "input": {
    "description": "JSON string, file path, or URL to validate",
    "minLength": 1,
    "type": "string"
   },
   "offline": {
    "description": "Do not fetch package schemas: step settings are not checked against them, and details.scope says so. Only with type \"flow\" and no path.",
    "type": "boolean"
   },
   "path": {
    "description": "Entry path for package schema validation (e.g., \"destinations.snowplow\"). Only with type \"flow\": validates the entry against its package JSON Schema in every flow that has it, or only in the given flow.",
    "type": "string"
   },
   "strict": {
    "description": "Escalate: strict turns warnings and skips into failures: valid is false (the CLI exits 2), and contract example disagreements become errors. Every check runs with or without it.",
    "type": "boolean"
   },
   "type": {
    "description": "Validation type: \"event\", \"flow\", \"mapping\", or \"contract\"",
    "enum": [
     "contract",
     "event",
     "flow",
     "mapping"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "input"
  ],
  "type": "object"
 },
 "name": "flow_validate",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_hints": {
    "additionalProperties": false,
    "description": "Suggested next steps",
    "properties": {
     "next": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "warnings": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "details": {
    "additionalProperties": {},
    "description": "Additional validation details",
    "properties": {
     "deferred": {
      "description": "Values known only at runtime, not schema-checked",
      "items": {
       "additionalProperties": false,
       "properties": {
        "path": {
         "type": "string"
        },
        "reference": {
         "type": "string"
        }
       },
       "required": [
        "path",
        "reference"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "scope": {
      "additionalProperties": false,
      "description": "What the run covered",
      "properties": {
       "checks": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "entry": {
        "additionalProperties": false,
        "properties": {
         "flows": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "key": {
          "type": "string"
         },
         "searchedFlows": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "section": {
          "type": "string"
         }
        },
        "required": [
         "key",
         "flows",
         "searchedFlows"
        ],
        "type": "object"
       },
       "flows": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "offline": {
        "const": true,
        "type": "boolean"
       }
      },
      "required": [
       "flows",
       "checks"
      ],
      "type": "object"
     },
     "skipped": {
      "description": "Checks in scope that did not run, with the reason",
      "items": {
       "additionalProperties": false,
       "properties": {
        "check": {
         "type": "string"
        },
        "code": {
         "type": "string"
        },
        "path": {
         "type": "string"
        },
        "reason": {
         "type": "string"
        }
       },
       "required": [
        "path",
        "check",
        "reason",
        "code"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "errors": {
    "description": "Validation errors",
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "description": "Stable code (the documented validate code list)",
       "type": "string"
      },
      "keyword": {
       "description": "JSON Schema keyword of an ENTRY_SCHEMA finding",
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "value": {}
     },
     "required": [
      "path",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "type": {
    "anyOf": [
     {
      "enum": [
       "contract",
       "entry",
       "event",
       "flow",
       "mapping"
      ],
      "type": "string"
     },
     {
      "pattern": "^(destinations|sources|transformers)\\.\\w+$",
      "type": "string"
     }
    ],
    "description": "What was validated"
   },
   "valid": {
    "description": "Whether validation passed",
    "type": "boolean"
   },
   "warnings": {
    "description": "Validation warnings",
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "description": "Stable code (the documented validate code list)",
       "type": "string"
      },
      "keyword": {
       "description": "JSON Schema keyword of an ENTRY_SCHEMA finding",
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "suggestion": {
       "type": "string"
      },
      "value": {}
     },
     "required": [
      "path",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "valid",
   "type",
   "errors",
   "warnings",
   "details"
  ],
  "type": "object"
 },
 "title": "Validate Flow"
}
