{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Finalize an upload as an app file (create or overwrite by path) \u2014 the chunked equivalent of file_write. The upload is consumed either way; on failure, restart from file_write_begin.",
 "inputSchema": {
  "properties": {
   "command_id": {
    "description": "idempotency key (uuid); auto-generated if omitted. A retried commit with the same id returns the original receipt instead of demanding a re-upload",
    "type": "string"
   },
   "expected_version": {
    "type": "number"
   },
   "mime": {
    "type": "string"
   },
   "path": {
    "description": "logical file name, e.g. 'video.mp4' or 'exports/backup.zip'",
    "type": "string"
   },
   "upload_id": {
    "type": "string"
   }
  },
  "required": [
   "upload_id",
   "path"
  ],
  "type": "object"
 },
 "name": "file_write_commit",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "app": {
    "type": "string"
   },
   "files_version": {
    "type": "number"
   },
   "mime": {
    "type": "string"
   },
   "path": {
    "type": "string"
   },
   "sha256": {
    "type": "string"
   },
   "size": {
    "type": "number"
   },
   "version": {
    "type": "number"
   }
  },
  "required": [
   "app",
   "path",
   "size",
   "mime",
   "sha256",
   "version",
   "files_version"
  ],
  "type": "object"
 },
 "title": "Commit a chunked file write"
}
