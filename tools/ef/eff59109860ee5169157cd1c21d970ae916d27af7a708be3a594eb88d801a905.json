{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Fast glob pattern matching over the filesystem. Returns matching file paths sorted by name or mtime.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Max results (default: 1000).",
    "type": "number"
   },
   "path": {
    "description": "Root directory (default: cwd).",
    "type": "string"
   },
   "pattern": {
    "description": "Glob pattern (e.g., \"**/*.ts\", \"src/**/*.{ts,tsx}\").",
    "type": "string"
   },
   "sort": {
    "description": "\"alpha\" (default) or \"mtime\".",
    "type": "string"
   }
  },
  "required": [
   "pattern"
  ],
  "type": "object"
 },
 "name": "glob_files"
}
