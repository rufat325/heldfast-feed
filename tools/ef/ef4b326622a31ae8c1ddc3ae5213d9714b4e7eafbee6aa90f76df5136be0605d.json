    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "text": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "url",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "results"
  ],
  "type": "object"
 },
