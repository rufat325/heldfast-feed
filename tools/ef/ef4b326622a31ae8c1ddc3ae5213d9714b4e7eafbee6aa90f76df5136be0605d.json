   }
  ]
 },
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search Velven's documentation: publishing and hosting, velven.json, the CLI, the SDK (sign-in, leaderboards, saves, achievements, rooms), claiming a page, the agent API and limits. Returns the best matching sections with links.",
 "execution": {
  "taskSupport": "forbidden"
 },
