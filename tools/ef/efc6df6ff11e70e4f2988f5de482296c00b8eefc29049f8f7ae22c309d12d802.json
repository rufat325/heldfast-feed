{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Backward-compatible generic submission tool. Choose the inquiry_type that is true now: controlled_opportunity, demand_requirement, bottleneck_signal, or capability_provider. Keep first contact sanitized. Submission records the declared state only and does not create a mandate, financing commitment, endorsement, or authority to act.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agent_source": {
    "maxLength": 80,
    "type": "string"
   },
   "consent": {
    "const": true,
    "type": "boolean"
   },
   "country_location": {
    "maxLength": 220,
    "minLength": 1,
    "type": "string"
   },
   "demand_offtake": {
    "maxLength": 2200,
    "type": "string"
   },
   "estimated_value": {
    "maxLength": 120,
    "type": "string"
   },
   "idempotency_key": {
    "description": "Recommended random retry key. Reuse only for retries of the exact same submission; it also acts as the private status token.",
    "maxLength": 200,
    "minLength": 32,
    "type": "string"
   },
   "inquiry_type": {
    "enum": [
     "controlled_opportunity",
     "demand_requirement",
     "bottleneck_signal",
     "capability_provider"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "maxLength": 1800,
    "type": "string"
   },
   "opportunity_summary": {
    "maxLength": 3000,
    "minLength": 20,
    "type": "string"
   },
   "organization": {
    "maxLength": 240,
    "type": "string"
   },
   "owner_authority": {
    "maxLength": 300,
    "type": "string"
   },
   "project_name": {
    "maxLength": 220,
    "minLength": 1,
    "type": "string"
   },
   "project_stage": {
    "maxLength": 2200,
    "minLength": 2,
    "type": "string"
   },
   "rights_status": {
    "enum": [
     "owner",
     "written_mandate",
     "open_procurement",
     "private_initiative",
     "site_or_host_permission",
     "buyer_or_offtaker",
     "operator_access",
     "evidence_only",
     "capability_provider",
     "permission_pending",
     "none"
    ],
    "type": "string"
   },
   "support_needed": {
    "maxLength": 300,
    "type": "string"
   },
   "work_email": {
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   }
  },
  "required": [
   "name",
   "work_email",
   "inquiry_type",
   "project_name",
   "country_location",
   "opportunity_summary",
   "rights_status",
   "project_stage",
   "consent"
  ],
  "type": "object"
 },
 "name": "submit_project_opportunity",
 "title": "Submit a productive signal to Quiet Stance"
}
