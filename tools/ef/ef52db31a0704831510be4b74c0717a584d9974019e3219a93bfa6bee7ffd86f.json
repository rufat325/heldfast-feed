{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Log a single metric value to a run",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "key": {
    "description": "Metric name",
    "type": "string"
   },
   "runId": {
    "type": "string"
   },
   "step": {
    "description": "Step at which metric was recorded",
    "type": "number"
   },
   "timestamp": {
    "description": "Unix timestamp ms (defaults to now)",
    "type": "number"
   },
   "value": {
    "description": "Metric value",
    "type": "number"
   }
  },
  "required": [
   "runId",
   "key",
   "value"
  ],
  "type": "object"
 },
 "name": "log-metric"
}
