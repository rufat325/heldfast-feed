{
 "_meta": {
  "agents-x402/paymentRequired": true,
  "agents-x402/priceUSD": 0.02
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Turn time entries (hours x rate, with optional rounding, grouping by task and expenses) into a validated invoice JSON with totals, ready for POST /v1/invoice.pdf. Use validate_invoice (free) instead if you already have an invoice. Pure calculation: no network request, nothing is sent or stored. Costs $0.02 USDC per call via x402 (payment goes in _meta[\"x402/payment\"]); invalid input returns an error and is not charged.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "buyer": {
    "properties": {
     "address": {
      "maxLength": 400,
      "type": "string"
     },
     "email": {
      "format": "email",
      "maxLength": 254,
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "phone": {
      "maxLength": 40,
      "type": "string"
     },
     "tax_id": {
      "maxLength": 60,
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "currency": {
    "default": "USD",
    "type": "string"
   },
   "default_rate": {
    "description": "Hourly rate for entries without their own rate",
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "discount": {
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   },
   "due_date": {
    "description": "YYYY-MM-DD; or give terms instead",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "description": {
       "maxLength": 250,
       "minLength": 1,
       "type": "string"
      },
      "hours": {
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "type": "number"
      },
      "rate": {
       "maximum": 1000000,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "description",
      "hours"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   },
   "expenses": {
    "description": "Reimbursable expenses, one line each",
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "maximum": 1000000000,
       "minimum": 0,
       "type": "number"
      },
      "description": {
       "maxLength": 250,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "description",
      "amount"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "group_by": {
    "default": "entry",
    "description": "entry = one line per entry; description = merge entries with the same description and rate",
    "enum": [
     "entry",
     "description"
    ],
    "type": "string"
   },
   "invoice_number": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "issue_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "notes": {
    "maxLength": 2000,
    "type": "string"
   },
   "payment_instructions": {
    "maxLength": 1000,
    "type": "string"
   },
   "rounding": {
    "additionalProperties": false,
    "properties": {
     "increment_minutes": {
      "anyOf": [
       {
        "const": 1,
        "type": "number"
       },
       {
        "const": 5,
        "type": "number"
       },
       {
        "const": 6,
        "type": "number"
       },
       {
        "const": 10,
        "type": "number"
       },
       {
        "const": 15,
        "type": "number"
       },
       {
        "const": 30,
        "type": "number"
       },
       {
        "const": 60,
        "type": "number"
       }
      ],
      "description": "Round each entry to this many minutes"
     },
     "mode": {
      "default": "up",
      "enum": [
       "up",
       "nearest"
      ],
      "type": "string"
     }
    },
    "required": [
     "increment_minutes"
    ],
    "type": "object"
   },
   "seller": {
    "properties": {
     "address": {
      "maxLength": 400,
      "type": "string"
     },
     "email": {
      "format": "email",
      "maxLength": 254,
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "phone": {
      "maxLength": 40,
      "type": "string"
     },
     "tax_id": {
      "maxLength": 60,
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "tax_rate": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "terms": {
    "description": "e.g. \"Net 15\"; sets due_date from issue_date (early-pay discounts are not applied to the invoice)",
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "seller",
   "buyer",
   "invoice_number",
   "issue_date",
   "entries"
  ],
  "type": "object"
 },
 "name": "invoice_from_timesheet"
}
