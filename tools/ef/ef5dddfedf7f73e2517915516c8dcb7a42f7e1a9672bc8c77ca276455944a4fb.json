{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "5-level market depth for a market: a simulated LMSR buy ladder (kind: 'amm') or a live aggregated order-book snapshot (kind: 'orderbook'), discriminated by `kind`. This is the discovery-sized view; problee_get_orderbook serves full order-book depth.",
 "inputSchema": {
  "$defs": {
   "EvmAddress": {
    "description": "Checksummed or lowercase 20-byte EVM address (0x + 40 hex).",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "properties": {
   "address": {
    "$ref": "#/$defs/EvmAddress",
    "description": "Market contract address."
   },
   "chainId": {
    "description": "Chain id; probes enabled chains if omitted.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "problee_get_market_depth",
 "outputSchema": {
  "$defs": {
   "ChainId": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "DepthQuote": {
    "additionalProperties": false,
    "properties": {
     "priceAfter": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "tokensOut": {
      "$ref": "#/$defs/WeiString"
     }
    },
    "required": [
     "tokensOut",
     "priceAfter"
    ],
    "type": "object"
   },
   "DiscoverMarketDepthResponse": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "chainId": {
        "$ref": "#/$defs/ChainId"
       },
       "currentPriceOutcome1": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       },
       "kind": {
        "const": "amm",
        "default": "amm",
        "type": "string"
       },
       "levels": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "amountWei": {
           "$ref": "#/$defs/WeiString"
          },
          "outcome1": {
           "anyOf": [
            {
             "$ref": "#/$defs/DepthQuote"
            },
            {
             "type": "null"
            }
           ]
          },
          "outcome2": {
           "anyOf": [
            {
             "$ref": "#/$defs/DepthQuote"
            },
            {
             "type": "null"
            }
           ]
          },
          "size": {
           "type": "string"
          }
         },
         "required": [
          "size",
          "amountWei",
          "outcome1",
          "outcome2"
         ],
         "type": "object"
        },
        "maxItems": 5,
        "type": "array"
       },
       "marketAddress": {
        "$ref": "#/$defs/EvmAddress"
       }
      },
      "required": [
       "kind",
       "marketAddress",
       "chainId",
       "levels",
       "currentPriceOutcome1"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "asks": {
        "items": {
         "$ref": "#/$defs/OrderbookDepthLevel"
        },
        "maxItems": 5,
        "type": "array"
       },
       "bestAsk": {
        "anyOf": [
         {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "bestBid": {
        "anyOf": [
         {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "bids": {
        "items": {
         "$ref": "#/$defs/OrderbookDepthLevel"
        },
        "maxItems": 5,
        "type": "array"
       },
       "chainId": {
        "$ref": "#/$defs/ChainId"
       },
       "currentPriceOutcome1": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       },
       "feePolicyVersion": {
        "enum": [
         "notional-v1",
         "shares-v2"
        ],
        "type": "string"
       },
       "kind": {
        "const": "orderbook",
        "type": "string"
       },
       "marketAddress": {
        "$ref": "#/$defs/EvmAddress"
       },
       "mid": {
        "anyOf": [
         {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "seq": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "spread": {
        "anyOf": [
         {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "takerFeeBps": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "kind",
       "marketAddress",
       "chainId",
       "bids",
       "asks",
       "bestBid",
       "bestAsk",
       "spread",
       "mid",
       "currentPriceOutcome1",
       "seq",
       "takerFeeBps"
      ],
      "type": "object"
     }
    ]
   },
   "EvmAddress": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "OrderbookDepthLevel": {
    "additionalProperties": false,
    "properties": {
     "amountWei": {
      "$ref": "#/$defs/WeiString"
     },
     "orderCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "price": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "priceBps": {
      "pattern": "^\\d+$",
      "type": "string"
     }
    },
    "required": [
     "price",
     "priceBps",
     "amountWei",
     "orderCount"
    ],
    "type": "object"
   },
   "WeiString": {
    "pattern": "^\\d+$",
    "type": "string"
   }
  },
  "additionalProperties": false,
  "properties": {
   "result": {
    "$ref": "#/$defs/DiscoverMarketDepthResponse"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "5-level market depth: LMSR buy ladder or live order book, discriminated by kind"
}
