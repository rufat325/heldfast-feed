{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "NO-WRITE safety preview for a Project To-do create, update+reissue, assign, archive, or future-hire policy change. Provider-owned assignment previews return each masked recipient decision (first-time invite, re-invite, preserve unfinished, or preserve resolved) and exact side effects. Future-policy previews return the before/after state and a request-bound signed receipt. Use this before every employer mutation. Requires project_todos:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "enum": [
     "ACTIVE",
     "FUTURE",
     "ACTIVE_AND_FUTURE",
     "SELECTED"
    ],
    "type": "string"
   },
   "autoAssignNewHires": {
    "type": "boolean"
   },
   "categoryId": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "enabled": {
    "description": "set_future_assignment: the exact future-hire policy state to preview.",
    "type": "boolean"
   },
   "itemId": {
    "minLength": 1,
    "type": "string"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "key": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "operation": {
    "enum": [
     "create_item",
     "update_item",
     "assign",
     "archive_item",
     "set_future_assignment"
    ],
    "type": "string"
   },
   "selectedContractIds": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "version": {
    "additionalProperties": false,
    "properties": {
     "blockingMode": {
      "enum": [
       "NONE",
       "IMMEDIATE",
       "AFTER_DUE"
      ],
      "type": "string"
     },
     "blockingScope": {
      "enum": [
       "NONE",
       "PROJECT_WORK",
       "PROVIDER_ACCESS"
      ],
      "type": "string"
     },
     "completionConfig": {
      "anyOf": [
       {
        "additionalProperties": {},
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "content": {},
     "description": {
      "anyOf": [
       {
        "maxLength": 20000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "dueOffsetMinutes": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "ownerRole": {
      "enum": [
       "WORKER",
       "EMPLOYER"
      ],
      "type": "string"
     },
     "priority": {
      "enum": [
       "NORMAL",
       "HIGH",
       "URGENT"
      ],
      "type": "string"
     },
     "reminderPolicy": {},
     "required": {
      "type": "boolean"
     },
     "sourceInstructionPageId": {
      "anyOf": [
       {
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "title": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "type": {
      "enum": [
       "MANUAL_ACTION",
       "READ_ACKNOWLEDGE",
       "EXTERNAL_ACTION",
       "EMPLOYER_REVIEW",
       "QUIZ",
       "TRAINING",
       "PLATFORM_REQUIREMENT",
       "INTEGRATION_ACTION",
       "WORK_AVAILABILITY"
      ],
      "type": "string"
     }
    },
    "required": [
     "title",
     "type"
    ],
    "type": "object"
   }
  },
  "required": [
   "operation",
   "jobId"
  ],
  "type": "object"
 },
 "name": "opentrain_preflight_project_todo",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
