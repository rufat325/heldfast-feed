 "description": "Roll up precincts to a race outcome under the current simulation. Sums baseline votes for all precincts inside the district boundary, applying overrides in precedence order: a per-precinct override wins, else\u2026",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "district_id": {
    "description": "District external id (for level=president/senate/governor, the state). EM-056: accepts a resolve_geography handle in any format \u2014 the slug \"us-pa\", postal \"PA\", or FIPS \"42\" \u2014 and also reads geo_id/state as aliases.",
    "type": "string"
   },
   "level": {
    "enum": [
     "custom",
     "president",
     "senate",
     "governor",
     "attorney_general",
     "secretary_of_state",
     "treasurer",
     "house",
     "state_senate",
     "state_assembly"
    ],
    "type": "string"
   },
   "region": {
    "description": "Optional \u2014 with region_group, scope to exactly ONE region in the group (its slug), rolling up only that region's member counties.",
    "type": "string"
   },
   "region_group": {
    "description": "Optional saved county-grain workspace map region-group slug. Returns one modeled race rollup per named region.",
    "type": "string"
   },
   "simulation_id": {
    "type": "string"
   },
   "workspace_scope": {
    "description": "Optional workspace for THIS call: use an exact personal/team ID from list_workspaces. Repeat on each call; it does not change the connection default. Must agree with MCP metadata and the effective HTTP workspace selector (header, otherwise connector URL). OAuth connections can only use their granted workspace. Membership and campaign permissions still apply.",
    "maxLength": 64,
    "minLength": 3,
    "pattern": "^[uw]-[a-z0-9](?:[a-z0-9-]{0,61})$",
    "type": "string"
   }
  },
  "required": [
   "simulation_id",
   "level",
   "district_id"
  ],
  "type": "object"
 },
