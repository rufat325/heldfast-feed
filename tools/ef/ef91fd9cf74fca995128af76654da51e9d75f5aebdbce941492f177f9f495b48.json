{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Move or rename a file or folder in Nextcloud",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "destination": {
    "description": "The destination path",
    "type": "string"
   },
   "overwrite": {
    "default": false,
    "description": "Whether to overwrite if the destination already exists",
    "type": "boolean"
   },
   "source": {
    "description": "The source path of the file or folder to move",
    "type": "string"
   }
  },
  "required": [
   "source",
   "destination"
  ],
  "type": "object"
 },
 "name": "move_file",
 "title": "Move File"
}
