{
 "description": "Queue a contract for extraction. Use canonical text, an approved HTTPS content URL, or an upload id from prepare_contract_upload.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "authority_status": {
    "enum": [
     "signed",
     "unsigned",
     "unknown"
    ],
    "type": "string"
   },
   "contract_family_key": {
    "$ref": "#/properties/external_id"
   },
   "document_type": {
    "enum": [
     "base_agreement",
     "amendment",
     "attachment",
     "fee_schedule",
     "other"
    ],
    "type": "string"
   },
   "effective_from": {
    "anyOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "effective_to": {
    "anyOf": [
     {
      "$ref": "#/properties/effective_from/anyOf/0"
     },
     {
      "type": "null"
     }
    ]
   },
   "external_id": {
    "maxLength": 256,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._~:@/+-]*[A-Za-z0-9._~:@+-])?$",
    "type": "string"
   },
   "idempotency_key": {
    "description": "reuse the operation key returned by an ambiguous prior attempt; omit for a new operation",
    "maxLength": 200,
    "minLength": 8,
    "pattern": "^[\\x20-\\x7e]+$",
    "type": "string"
   },
   "source": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "upload",
        "type": "string"
       },
       "upload_id": {
        "$ref": "#/properties/supersedes_contract_id/anyOf/0"
       }
      },
      "required": [
       "kind",
       "upload_id"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "content_url": {
        "format": "uri",
        "type": "string"
       },
       "kind": {
        "const": "content_url",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "content_url"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "content": {
        "minLength": 1,
        "type": "string"
       },
       "kind": {
        "const": "canonical_text",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "content"
      ],
      "type": "object"
     }
    ]
   },
   "supersedes_contract_id": {
    "anyOf": [
     {
      "format": "uuid",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "title": {
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "external_id",
   "title",
   "document_type",
   "authority_status",
   "contract_family_key",
   "effective_from",
   "effective_to",
   "supersedes_contract_id",
   "source"
  ],
  "type": "object"
 },
 "name": "ingest_contract"
}
