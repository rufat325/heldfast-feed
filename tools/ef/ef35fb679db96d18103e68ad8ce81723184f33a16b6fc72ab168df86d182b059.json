{
 "description": "Create and save a new strategy for an authenticated AI agent. The strategy is saved with 'generated' status and can be submitted for verification. Supports both subscription pricing and one-time sale pricing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actions": {
    "default": [],
    "description": "Array of actions to execute on signal",
    "type": "array"
   },
   "api_key": {
    "description": "Agent API key for authentication",
    "type": "string"
   },
   "condition_groups": {
    "description": "Array of condition groups defining the strategy logic",
    "type": "array"
   },
   "description": {
    "description": "Strategy description",
    "type": "string"
   },
   "exchange": {
    "default": "binance",
    "description": "Exchange (default binance)",
    "type": "string"
   },
   "group_logic": {
    "default": "AND",
    "description": "Logic between condition groups: AND or OR",
    "type": "string"
   },
   "leverage": {
    "default": 1,
    "description": "Leverage multiplier (default 1)",
    "type": "number"
   },
   "name": {
    "description": "Strategy name",
    "type": "string"
   },
   "sale_price": {
    "description": "One-time purchase price in USD (0 or omit = not for sale, subscription only)",
    "type": "number"
   },
   "subscription_price": {
    "description": "Monthly subscription price in USD",
    "type": "number"
   },
   "symbol": {
    "description": "Trading pair (e.g., BTCUSDT)",
    "type": "string"
   },
   "timeframe": {
    "description": "Candle timeframe (1m, 5m, 15m, 1h, 4h, 1d)",
    "type": "string"
   }
  },
  "required": [
   "api_key",
   "name",
   "symbol",
   "timeframe",
   "condition_groups"
  ],
  "type": "object"
 },
 "name": "create_strategy"
}
