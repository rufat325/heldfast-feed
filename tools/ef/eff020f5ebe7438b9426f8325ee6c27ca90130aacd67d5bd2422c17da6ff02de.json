{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Create and assign one Project To-do pinned to an immutable published quiz version. First call opentrain_preflight_project_todo_quiz_assignment with the identical payload. Broad audiences require its preflightReceipt; SELECTED requires exact selectedContractIds. A stable idempotencyKey makes retries converge; duplicates are refused unless allowDuplicate=true. The result is immediately worker-visible. Requires project_todos:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowDuplicate": {
    "type": "boolean"
   },
   "audience": {
    "enum": [
     "ACTIVE",
     "FUTURE",
     "ACTIVE_AND_FUTURE",
     "SELECTED"
    ],
    "type": "string"
   },
   "blockingMode": {
    "enum": [
     "NONE",
     "IMMEDIATE",
     "DEADLINE"
    ],
    "type": "string"
   },
   "categoryId": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "completionPolicy": {
    "enum": [
     "ON_SUBMIT",
     "ON_PASS",
     "ON_REVIEW"
    ],
    "type": "string"
   },
   "description": {
    "anyOf": [
     {
      "maxLength": 5000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "dueOffsetMinutes": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 525600,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "formVersionId": {
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "preflightReceipt": {
    "maxLength": 8192,
    "minLength": 16,
    "type": "string"
   },
   "priority": {
    "enum": [
     "LOW",
     "NORMAL",
     "HIGH",
     "URGENT"
    ],
    "type": "string"
   },
   "required": {
    "type": "boolean"
   },
   "selectedContractIds": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "title": {
    "maxLength": 180,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "formVersionId",
   "completionPolicy",
   "audience",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_assign_project_todo_quiz",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
