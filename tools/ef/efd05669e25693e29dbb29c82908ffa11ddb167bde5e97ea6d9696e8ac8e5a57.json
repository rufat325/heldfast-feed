   },
   "domain": {
    "description": "Domain name (e.g. \"api.example.com\")",
    "examples": [
     "example.com"
    ],
    "maxLength": 253,
    "type": "string"
   }
  },
  "required": [
   "domain",
   "days_remaining"
  ],
  "type": "object"
 },
 "name": "certificate-expiry-checker",
