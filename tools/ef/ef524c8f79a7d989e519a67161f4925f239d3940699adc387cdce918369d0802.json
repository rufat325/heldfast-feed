     "string",
     "null"
    ]
   },
   "version": {
    "default": null,
    "description": "Optional ERP version or edition, for example \"2009 R2\", \"GP 2018\" or \"on-premises\".",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "erp"
  ],
  "type": "object"
 },
