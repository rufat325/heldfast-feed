{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Browse an instrument's provisions"},"description":"Use this to browse an EU instrument's article, annex or recital index, or list its provisions tagged with a topic, a starting point for a coverage question. Metadata only: each item carries the exact locator get_provision accepts. Articles and annexes by default; pass kind=recital for recitals.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"chapter":{"anyOf":[{"maxLength":256,"type":"string"},{"type":"null"}],"description":"Keep only provisions under a division whose heading contains this text, e.g. \"operational risk\". Any heading above the provision counts (Part, Title, Chapter or Section); case is ignored."},"cursor":{"anyOf":[{"maxLength":512,"pattern":"^[A-Za-z0-9_-]+$","type":"string"},{"type":"null"}]},"instrument_id":{"maxLength":64,"pattern":"^[A-Za-z0-9]+(?:[ ._-][A-Za-z0-9]+)*$","type":"string"},"kind":{"anyOf":[{"enum":["article","annex","recital"],"type":"string"},{"type":"null"}]},"limit":{"anyOf":[{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},{"type":"null"}]},"topic":{"anyOf":[{"maxLength":64,"type":"string"},{"type":"null"}],"description":"Keep only provisions carrying this topic tag. Tags are rule-derived and can miss a provision, so a filtered list is not everything on the subject."}},"required":["instrument_id"],"type":"object"},"name":"list_provisions","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"corpus_release":{"additionalProperties":false,"properties":{"built_at":{"type":"string"},"corpus_release_id":{"type":"string"},"schema_version":{"type":"string"}},"required":["corpus_release_id","schema_version","built_at"],"type":"object"},"coverage":{"additionalProperties":false,"properties":{"corpus":{"type":"string"},"exhaustive":{"type":"boolean"},