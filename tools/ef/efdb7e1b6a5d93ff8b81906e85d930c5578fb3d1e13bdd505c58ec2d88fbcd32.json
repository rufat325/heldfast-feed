{"annotations":{"openWorldHint":false,"readOnlyHint":true,"title":"Event over time"},"description":"Get event counts bucketed over time for a specific event. Useful for seeing how event frequency changes. Optional filters segment by country, browser, os, device type, UTM source, or referrer (matched against the session's page views).","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"event_name":{"description":"The event name to get timeseries for","type":"string"},"filter_browser":{"description":"Browser substring match (e.g. 'Chrome')","type":"string"},"filter_country":{"description":"2-letter country code (e.g. 'US')","type":"string"},"filter_device_type":{"description":"Device type: 'desktop' | 'mobile' | 'tablet'","type":"string"},"filter_os":{"description":"OS substring match (e.g. 'iOS')","type":"string"},"filter_referrer_contains":{"description":"Referrer substring (e.g. 'google')","type":"string"},"filter_utm_source":{"description":"Exact UTM source (e.g. 'twitter')","type":"string"},"interval":{"description":"Bucket interval","enum":["hour","day"],"type":"string"},"period":{"default":"30d","description":"Time period","type":"string"},"site":{"description":"Site domain or UUID","type":"string"}},"required":["site","event_name"],"type":"object"},"name":"get_event_timeseries","title":"Event over time"}
