 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Forward email"
 },
 "description": "Forward the original bodies and files, as stored, to recipients authorized by the human, with an optional note. Starts a new conversation.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "bcc": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "description": "Bare ASCII email address.",
       "type": "string"
      },
      "name": {
       "description": "Optional display name, at most 256 UTF-8 bytes after trimming, without control characters.",
       "type": "string"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "cc": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "description": "Bare ASCII email address.",
       "type": "string"
      },
      "name": {
       "description": "Optional display name, at most 256 UTF-8 bytes after trimming, without control characters.",
       "type": "string"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "idempotency_key": {
    "description": "Use a unique key per intended email. Retain the key, exact payload and first request time; reuse only for that attempt within 24 hours, even if the source is later deleted.",
    "pattern": "^[A-Za-z0-9_-]{1,128}$",
    "type": "string"
   },
   "inbox_id": {
    "description": "Sending inbox; must own the source message.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "include_attachments": {
    "description": "Defaults to true, including embedded images. Set false to exclude all original files; embedded images may then be unavailable. Missing or oversized included files fail rather than being silently dropped.",
    "type": "boolean"
   },
   "labels": {
    "items": {
     "description": "Case-sensitive label, trimmed; at most 128 UTF-8 bytes, without control characters.",
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "message_id": {
    "description": "Ready received or accepted sent message in this inbox. Original bodies are forwarded, not extracted reply text; generated headers exclude Bcc.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "note": {
    "description": "Plain-text note placed before the original content.",
    "type": "string"
   },
   "to": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "description": "Bare ASCII email address.",
       "type": "string"
      },
      "name": {
       "description": "Optional display name, at most 256 UTF-8 bytes after trimming, without control characters.",
       "type": "string"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "inbox_id",
   "message_id",
   "to"
  ],
  "type": "object"
 },
