{
 "description": "Retry a failed job execution, optionally only on previously failed nodes",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "execId": {
    "description": "Execution ID to retry",
    "type": "integer"
   },
   "failedNodes": {
    "description": "Only retry on nodes that failed (default false)",
    "type": "boolean"
   },
   "id": {
    "description": "Job UUID",
    "type": "string"
   },
   "options": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Override job options",
    "type": "object"
   }
  },
  "required": [
   "id",
   "execId"
  ],
  "type": "object"
 },
 "name": "rundeck_retry_job"
}
