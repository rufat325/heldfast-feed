{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an automated schedule for fleet agent upgrades with maintenance windows",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "name": {
    "description": "Name of the schedule",
    "type": "string"
   },
   "query": {
    "description": "Filter query to select target hosts",
    "type": "string"
   },
   "rule": {
    "description": "Recurrence rule for the schedule",
    "properties": {
     "daysOfWeek": {
      "description": "Days of week (e.g., ['monday', 'wednesday'])",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "maintenanceWindowDuration": {
      "description": "Duration of maintenance window in minutes",
      "type": "number"
     },
     "startMaintenanceWindow": {
      "description": "Start time of maintenance window (HH:MM format)",
      "type": "string"
     },
     "timezone": {
      "description": "Timezone (e.g., 'America/New_York')",
      "type": "string"
     }
    },
    "required": [
     "daysOfWeek",
     "maintenanceWindowDuration",
     "startMaintenanceWindow",
     "timezone"
    ],
    "type": "object"
   },
   "status": {
    "description": "Schedule status",
    "enum": [
     "active",
     "inactive"
    ],
    "type": "string"
   },
   "versionToLatest": {
    "description": "Number of versions behind latest to target (0 = latest)",
    "type": "number"
   }
  },
  "required": [
   "name",
   "query",
   "rule"
  ],
  "type": "object"
 },
 "name": "create-fleet-schedule"
}
