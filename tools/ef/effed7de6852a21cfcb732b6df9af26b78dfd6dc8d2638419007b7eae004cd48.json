{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     null
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Save only a preference, goal, constraint or context note the customer explicitly asked Doctor to remember. Corrections require the exact owned note id and expectedRevision from get_doctor_memory. note.confirmation must be save_for_future_consults. Do not silently infer mastery or save sporting results; those belong in saved betting records. A committed edit rotates inferred memory so a superseded note does not return. Keep the caller-generated commandKey (16-120 characters) stable for this action and all retries. Action and version are fixed by this tool; do not supply them.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "commandKey": {
    "maxLength": 120,
    "minLength": 16,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "note": {
    "additionalProperties": false,
    "properties": {
     "category": {
      "enum": [
       "preference",
       "goal",
       "constraint",
       "context"
      ],
      "type": "string"
     },
     "confirmation": {
      "const": "save_for_future_consults",
      "type": "string"
     },
     "expectedRevision": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "expiresAt": {
      "anyOf": [
       {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "text": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "category",
     "text",
     "confirmation"
    ],
    "type": "object"
   }
  },
  "required": [
   "commandKey",
   "note"
  ],
  "type": "object"
 },
 "name": "remember_doctor_note",
 "securitySchemes": [
  {
   "scopes": [
    null
   ],
   "type": "oauth2"
  }
 ],
 "title": "Remember or correct Doctor note"
}
