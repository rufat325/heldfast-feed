 "description": "List the custom questions an event asks at registration time (its\nregistration form), in display order.\n\nPublic data \u2014 the question text is visible to anyone. Use this before\n`event_submit_registration_answers` to know which `form_field_id`s exist\nand which are required.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "event_slug": {
    "description": "Slug of the event.",
    "minLength": 1,
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number, starting at 1.",
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "default": 20,
    "description": "Rows per page (max 100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "event_slug"
  ],
  "type": "object"
 },
 "name": "event_registration_form",
 "title": "Get an event's registration form"
