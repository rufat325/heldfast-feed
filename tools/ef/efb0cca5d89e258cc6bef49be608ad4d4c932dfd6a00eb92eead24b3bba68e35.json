  "readOnlyHint": true,
  "title": "Estimate employer cost and net wage"
 },
 "description": "Monthly and annual cost of employing a cleaner, nanny, babysitter or carer in a Swiss private household, and the worker's net wage: gross wage, vacation supplement, every employee deduction (AHV/IV/EO, unemployment, accident insurance, withholding tax, BVG) and every employer contribution (incl. the canton's family allowance fund and the compensation office's admin fee). Uses the same engine as Clino's public calculator. Picks the simplified or ordinary procedure from the annual wage. Canton = where the household lives.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "canton": {
    "description": "Swiss canton: two-letter code (ZH, BE, GE, VD, TI...) or its name in German, French, Italian or English (Z\u00fcrich, Gen\u00e8ve, Ticino, Basel-Stadt). For employer contributions this is the canton where the household lives.",
    "maxLength": 40,
    "minLength": 2,
    "type": "string"
   },
   "hourly_wage_chf": {
    "description": "Agreed hourly wage in CHF, before the vacation supplement (e.g. 30).",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "number"
   },
   "hours_per_week": {
    "description": "Average working hours per week with this household (e.g. 4).",
    "exclusiveMinimum": 0,
    "maximum": 70,
    "type": "number"
   },
   "language": {
    "default": "en",
    "description": "Language of the explanatory texts and of the clino.ch links: en, de, fr, it, es or pt. Default en.",
    "enum": [
     "en",
     "de",
     "fr",
     "it",
     "es",
     "pt"
    ],
    "type": "string"
   },
   "skill_level": {
    "description": "Qualification of the worker, which sets the federal NAV wage tier: unskilled; experienced (4+ years in household work); eba (2-year federal vocational certificate); efz (3-year federal vocational diploma).",
    "enum": [
     "unskilled",
     "experienced",
     "eba",
     "efz"
    ],
    "type": "string"
   },
   "vacation_weeks": {
    "default": 4,
    "description": "Paid vacation weeks per year: 4 (legal minimum), 5 (under age 20) or 6. Default 4.",
    "maximum": 6,
    "minimum": 4,
    "type": "integer"
   },
   "wage_is_net": {
    "default": false,
    "description": "true if the agreed hourly wage is what the worker receives in hand (net). The gross wage is then worked out from it. Default false (gross).",
    "type": "boolean"
   },
   "workplace_postcode": {
    "description": "4-digit Swiss postcode (PLZ/NPA) of the WORKPLACE. City minimum wages (e.g. Stadt Luzern) depend on it.",
    "pattern": "^\\d{4}$",
    "type": "string"
   }
  },
  "required": [
   "canton",
   "hourly_wage_chf",
   "hours_per_week"
  ],
  "type": "object"
 },
