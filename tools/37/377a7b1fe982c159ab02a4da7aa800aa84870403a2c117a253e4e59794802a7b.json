{
 "description": "Replace just the content of a lesson \u2014 URL, content_type, and optional description/duration/thumbnail. Narrower than update_lesson; safe for bulk agent writes. Does NOT change title, sort_order, or module assignment.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content_format": {
    "enum": [
     "markdown",
     "tiptap_json"
    ],
    "type": "string"
   },
   "content_json": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "content_type": {
    "enum": [
     "youtube",
     "google_drive",
     "video",
     "image",
     "document",
     "pitch"
    ],
    "type": "string"
   },
   "content_url": {
    "format": "uri",
    "type": "string"
   },
   "description": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "duration_seconds": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "thumbnail_url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "hivelearn_update_lesson_content"
}
