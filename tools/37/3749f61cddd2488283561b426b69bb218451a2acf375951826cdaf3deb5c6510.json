{
 "description": "Tokenize a card for use in DIRECT-flow create_payment. Use the returned token in the card.token field instead of raw PAN. Required for PCI scope reduction.",
 "inputSchema": {
  "properties": {
   "card_number": {
    "description": "Card PAN (digits only, no spaces)",
    "type": "string"
   },
   "country": {
    "description": "Issuing country ISO-3166 alpha-2 (optional; helps method routing)",
    "type": "string"
   },
   "cvv": {
    "description": "Card verification value",
    "type": "string"
   },
   "expiration_month": {
    "description": "1-12",
    "type": "number"
   },
   "expiration_year": {
    "description": "4-digit year (e.g. 2028)",
    "type": "number"
   },
   "holder_name": {
    "description": "Cardholder full name",
    "type": "string"
   }
  },
  "required": [
   "holder_name",
   "card_number",
   "cvv",
   "expiration_month",
   "expiration_year"
  ],
  "type": "object"
 },
 "name": "create_card_token"
}
