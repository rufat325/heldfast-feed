{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Update blog settings"
 },
 "description": "Edit blog settings: `title`, `language` (BCP-47, e.g. \"ru\"), `parentSiteUrl`, `analytics`; null clears any but `language`. Set `title` to the blog's display name, e.g. the project or person's name; otherwise the URL name is shown.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blog_id": {
    "description": "Your blog's id, as returned by signup. Optional with an API key: it defaults to the key's blog, and any id you pass must be that blog. Required when the server runs without API keys.",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Optional retry key, any unique string (e.g. a UUID). Retrying with the same key and identical arguments returns the first result instead of writing again; the same key with different arguments fails with IDEMPOTENCY_KEY_CONFLICT. Scoped to your API key and this tool.",
    "type": "string"
   },
   "patch": {
    "additionalProperties": false,
    "description": "Blog settings to change; omitted fields stay as they are.",
    "properties": {
     "analytics": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "googleAnalytics": {
          "additionalProperties": false,
          "description": "Google Analytics 4.",
          "properties": {
           "measurementId": {
            "description": "GA4 measurement id, e.g. \"G-ABC123\".",
            "pattern": "^G-[A-Z0-9]+$",
            "type": "string"
           }
          },
          "required": [
           "measurementId"
          ],
          "type": "object"
         },
         "plausible": {
          "additionalProperties": false,
          "description": "Plausible Cloud analytics.",
          "properties": {
           "domain": {
            "description": "Site domain as registered in Plausible Cloud, e.g. \"blog.example.com\".",
            "maxLength": 253,
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "domain"
          ],
          "type": "object"
         },
         "umami": {
          "additionalProperties": false,
          "description": "Umami Cloud analytics.",
          "properties": {
           "siteId": {
            "description": "Umami Cloud website id.",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "siteId"
          ],
          "type": "object"
         }
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "Analytics added to every page: any of `umami`, `plausible`, `googleAnalytics`. Replaces the whole analytics config; null removes it."
     },
     "language": {
      "description": "Default language for the blog as a BCP-47 tag, e.g. \"en\", \"ru\", \"pt-BR\".",
      "maxLength": 35,
      "type": "string"
     },
     "parentSiteUrl": {
      "anyOf": [
       {
        "format": "uri",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "URL (http/https) of the author's main site, linked from the blog. null removes it."
     },
     "title": {
      "anyOf": [
       {
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F\\u2028\\u2029]*$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Display name shown as the blog's heading and in browser tabs, feeds and link previews, e.g. the project or person's name. 1\u201380 characters, one line. null removes it and the URL name is shown again."
     }
    },
    "type": "object"
   }
  },
  "required": [
   "patch"
  ],
  "type": "object"
 },
 "name": "update_blog",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "blog": {
    "additionalProperties": {},
    "properties": {
     "analytics": {
      "additionalProperties": {},
      "description": "Absent when no analytics is configured.",
      "properties": {
       "googleAnalytics": {
        "additionalProperties": {},
        "properties": {
         "measurementId": {
          "type": "string"
         }
        },
        "required": [
         "measurementId"
        ],
        "type": "object"
       },
       "plausible": {
        "additionalProperties": {},
        "properties": {
         "domain": {
          "type": "string"
         }
        },
        "required": [
         "domain"
        ],
        "type": "object"
       },
       "umami": {
        "additionalProperties": {},
        "properties": {
         "siteId": {
          "type": "string"
         }
        },
        "required": [
         "siteId"
        ],
        "type": "object"
       }
      },
      "type": "object"
     },
     "createdAt": {
      "description": "ISO 8601.",
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "language": {
      "description": "The blog's default BCP-47 language tag.",
      "type": "string"
     },
     "name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "null for an unnamed blog."
     },
     "parentSiteUrl": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "theme": {
      "type": "string"
     },
     "title": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Display name shown on the blog. null: the blog shows its name (or id) instead."
     }
    },
    "required": [
     "id",
     "name",
     "theme",
     "createdAt",
     "parentSiteUrl",
     "language"
    ],
    "type": "object"
   },
   "blog_url": {
    "description": "The blog's public URL (its custom domain once one is verified). Posts live at {blog_url}{slug}/.",
    "type": "string"
   },
   "error": {
    "additionalProperties": {},
    "description": "Present only on failure (isError: true). Success fields are absent then.",
    "properties": {
     "code": {
      "description": "Error code, e.g. \"POST_NOT_FOUND\".",
      "type": "string"
     },
     "details": {
      "additionalProperties": {},
      "description": "Extra context. Keys depend on the code.",
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "message": {
      "description": "What went wrong and what to do next.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "details"
    ],
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Update blog settings"
}
