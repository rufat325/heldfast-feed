{
 "description": "Search live used-car listings on autoza.ie. Returns up to 20 verified-dealer listings matching the filters. Each listing includes make, model, year, price (EUR), mileage (km), county, fuel type, and a canonical autoza.ie URL.",
 "inputSchema": {
  "properties": {
   "county": {
    "description": "Irish county e.g. 'Dublin', 'Cork'",
    "type": "string"
   },
   "fuelType": {
    "enum": [
     "Petrol",
     "Diesel",
     "Hybrid",
     "Electric",
     "Plug-in Hybrid"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "type": "number"
   },
   "make": {
    "description": "Make e.g. 'BMW', 'Toyota'",
    "type": "string"
   },
   "maxPrice": {
    "description": "Maximum asking price in EUR",
    "type": "number"
   },
   "maxYear": {
    "type": "number"
   },
   "minPrice": {
    "description": "Minimum asking price in EUR",
    "type": "number"
   },
   "minYear": {
    "type": "number"
   },
   "model": {
    "description": "Model e.g. '5 Series', 'Corolla'",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_listings"
}
