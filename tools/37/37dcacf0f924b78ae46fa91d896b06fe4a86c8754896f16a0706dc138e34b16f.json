{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Who holds an ERC-20 token on one chain, largest balance first, plus the total holder count. `balance` already has decimals applied, so do not divide it again. For one wallet's tokens use getBalances.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chain": {
    "description": "Chain, from listChains aapiChains",
    "enum": [
     "arbitrum",
     "avalanche",
     "avalanche_fuji",
     "base",
     "base_sepolia",
     "bsc",
     "eth",
     "eth_sepolia",
     "fantom",
     "flare",
     "gnosis",
     "linea",
     "optimism",
     "optimism_sepolia",
     "polygon",
     "polygon_amoy",
     "rollux",
     "scroll",
     "story_aeneid_testnet",
     "story_mainnet",
     "syscoin",
     "taiko",
     "telos",
     "xai",
     "xlayer"
    ],
    "type": "string"
   },
   "contractAddress": {
    "description": "ERC-20 token contract address",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "pageSize": {
    "description": "Holders per page (default 20)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "pageToken": {
    "description": "nextPageToken from the previous page",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "contractAddress"
  ],
  "type": "object"
 },
 "name": "getTokenHolders",
 "title": "Holders of a token"
}
