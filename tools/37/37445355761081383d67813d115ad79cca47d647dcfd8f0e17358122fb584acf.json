{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Reads data from Maximo into a sheet in the work screen (replacing a sheet with the same name). Put only the columns you need in select. Agree on the range with the user using scope_options first and put it in where (do not load everything). Long loads return a jobId; wait for it with get_job.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"maxRows":{"description":"default 5000","maximum":100000,"minimum":1,"type":"integer"},"name":{"description":"Sheet name (e.g. Permits)","maxLength":64,"minLength":1,"type":"string"},"orderBy":{"description":"Prefix with - for descending order","items":{"type":"string"},"maxItems":5,"type":"array"},"os":{"minLength":1,"type":"string"},"select":{"description":"Columns. Children as EXT_WOPERMIT.EXT_PERMITDATE","items":{"minLength":1,"type":"string"},"maxItems":200,"minItems":1,"type":"array"},"where":{"description":"default []","items":{"additionalProperties":false,"properties":{"attr":{"description":"Attribute or column name. Join child attributes with a dot, e.g. EXT_WOPERMIT.EXT_PERMITDATE","minLength":1,"type":"string"},"op":{"enum":["eq","ne","gt","gte","lt","lte","in","notin","like","isnull","notnull"],"type":"string"},"value":{"anyOf":[{"type":["string","number","boolean","null"]},{"items":{"type":["string","number","boolean","null"]},"maxItems":1000,"type":"array"}]}},"required":["attr","op"],"type":"object"},"maxItems":20,"type":"array"}},"required":["name","os","select"],"type":"object"},"name":"load_sheet","title":"Load a sheet from Maximo"}
