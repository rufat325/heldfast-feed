       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Stablecoins to check, any of USDC, USDT, DAI, USDe and PYUSD (case does not matter). Omit for all five; an unknown coin is a 422 that lists the supported ones.",
    "title": "Coins"
   }
  },
