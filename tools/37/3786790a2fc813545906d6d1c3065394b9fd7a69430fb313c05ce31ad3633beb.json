{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Select or change a generated LaunchChair user-choice option, such as wedge, pricing, or feature direction. Use this instead of generic SPEC_UPDATE for user-choice buckets.",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "domain"
    ]
   },
   {
    "required": [
     "phaseKey",
     "bucketKey"
    ]
   }
  ],
  "properties": {
   "bucketKey": {
    "type": "string"
   },
   "domain": {
    "enum": [
     "wedge",
     "pricing",
     "feature"
    ],
    "type": "string"
   },
   "optionId": {
    "type": "string"
   },
   "optionQuery": {
    "type": "string"
   },
   "optionTitle": {
    "type": "string"
   },
   "phaseKey": {
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "projectName": {
    "type": "string"
   },
   "resetDownstream": {
    "description": "Defaults true. Reset downstream generated phases so the loop can rerun from the changed choice.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "launchchair_select_choice"
}
