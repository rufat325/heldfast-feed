{
 "description": "Dry-run validation for a proposed import batch (max 50 entries). Max 50 entries per bulk call\u2014split large catalogs into batches of ~50 to avoid oversized tool payloads. For full re-import: delete-entries once, then set-entries in 50-entry chunks; or replace-entries with deleteOrphans=false until the final batch (deleteOrphans=true). Checks duplicate upsert keys and unknown moduleName refs without writing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checkDuplicates": {
    "description": "Detect duplicate keys in batch (default true)",
    "type": "boolean"
   },
   "checkModuleExists": {
    "description": "Warn on unknown refs.moduleName (default true)",
    "type": "boolean"
   },
   "entries": {
    "description": "Proposed entries to validate (max 50)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "type": "string"
      },
      "payload": {
       "additionalProperties": {},
       "type": "object"
      },
      "refs": {
       "additionalProperties": false,
       "properties": {
        "entryIds": {
         "description": "Related entry ids, e.g. flow steps pointing to other entries",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "files": {
         "description": "Workspace-relative file paths where this fact lives",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "moduleName": {
         "description": "Module name from list-modules; per-entry override of batch moduleName",
         "type": "string"
        }
       },
       "type": "object"
      },
      "summary": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "kind",
      "title",
      "summary"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "projectId": {
    "description": "Required. Call list-projects first (query by workspace folder name) and pass the matching projectId. Never omit. default-project is forbidden.",
    "minLength": 1,
    "type": "string"
   },
   "upsertBy": {
    "description": "Match keys (default kind+title)",
    "items": {
     "enum": [
      "kind",
      "title",
      "id"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "projectId",
   "entries"
  ],
  "type": "object"
 },
 "name": "validate-import",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "valid": {
    "type": "boolean"
   },
   "warningCount": {
    "type": "number"
   },
   "warnings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "detail": {
       "type": "string"
      },
      "entryIndex": {
       "type": "number"
      }
     },
     "required": [
      "code",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "valid",
   "warningCount",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Validate Import"
}
