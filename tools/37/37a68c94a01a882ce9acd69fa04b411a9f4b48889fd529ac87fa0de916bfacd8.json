  "title": "Materials list for a whole job (takeoff)"
 },
 "description": "Works one whole-job takeoff, identified by its id, from the measurements given: the materials list of a job such as a slab or a deck, each line from its own calculator, with what to order, waste allowances, metric and US units, labour hours (not a price), what is not counted, a citation and the page link. It does not size structure.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "allowances": {
    "additionalProperties": {
     "anyOf": [
      {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      {
       "maxLength": 80,
       "type": "string"
      }
     ]
    },
    "description": "Row \u2192 an allowance the reader sets: a percentage (cutting waste, overlap), or the option an allowance follows (a lay pattern). Row names are the takeoff's steps (the calculator slug, or the step key where one runs twice).",
    "maxProperties": 50,
    "type": "object"
   },
   "detail": {
    "default": "full",
    "description": "full (the default): the whole answer. summary: the result lines, the citation line and the page only \u2014 fewer tokens to read.",
    "enum": [
     "full",
     "summary"
    ],
    "type": "string"
   },
   "inputUnits": {
    "description": "Send \"base\" to pass bare numbers on dimensioned inputs in base units (m, m\u00b2, L, kg \u2026), as the published test vectors are written. Without it a length, area or volume must carry its unit.",
    "enum": [
     "base"
    ],
    "type": "string"
   },
   "leaveOut": {
    "description": "Rows the reader leaves out of the job: still worked and shown, not put in the project or counted in labour.",
    "items": {
     "maxLength": 120,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "market": {
    "description": "Optional. A market whose own opening choice some inputs take (a UK reader's code, an IEC motor), and whose currency symbol prints the caller's own money figures.",
    "enum": [
     "US",
     "CA",
     "UK",
     "AU",
     "INTL"
    ],
    "type": "string"
   },
   "measurements": {
    "additionalProperties": {
     "oneOf": [
      {
       "type": "number"
      },
      {
       "maxLength": 200,
       "type": "string"
      },
      {
       "additionalProperties": false,
       "properties": {
        "unit": {
         "maxLength": 40,
         "type": "string"
        },
        "value": {
         "type": "number"
        }
       },
       "required": [
        "value"
       ],
       "type": "object"
      }
     ]
    },
    "description": "Measurement id \u2192 value, each length, area or volume with its unit (\"12 ft\", {\"value\": 3.6, \"unit\": \"m\"}); counts as numbers. Ids are those of the takeoff; any left out opens at the page's own figure.",
    "maxProperties": 50,
    "type": "object"
   },
   "selection": {
    "additionalProperties": {
     "maxLength": 80,
     "type": "string"
    },
    "description": "Build-up choice id \u2192 option id, the takeoff's own (a stud size, an insulation, a cladding). Choices left out take the page's own for the system.",
    "maxProperties": 20,
    "type": "object"
   },
   "system": {
    "default": "metric",
    "description": "The unit system inputs left out open in, and the one the page link opens in. The answer comes in both.",
    "enum": [
     "metric",
     "imperial"
    ],
    "type": "string"
   },
   "takeoff": {
    "description": "A takeoff id, such as concrete-slab.",
    "pattern": "^[a-z0-9][a-z0-9-]{1,119}$",
    "type": "string"
   }
  },
  "required": [
   "takeoff"
  ],
  "type": "object"
