{
 "description": "Deprecate a version of a package",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "description": "Deprecation message (empty string to undeprecate)",
    "type": "string"
   },
   "otp": {
    "description": "One-time password for 2FA",
    "type": "string"
   },
   "package": {
    "description": "Package@version range (e.g. pkg@<1.0.0)",
    "type": "string"
   }
  },
  "required": [
   "package",
   "message"
  ],
  "type": "object"
 },
 "name": "deprecate"
}
