     "plasma",
     "katana",
     "robinhood",
     "pharos",
     "hyperevm",
     "solana",
     "hyperliquid",
     "canton"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "gas.tracker",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "chain": {
    "description": "Blockchain queried",
    "type": "string"
   },
   "congestion": {
    "description": "Network congestion level",
    "type": "string"
   },
   "current": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "baseFee": {
        "description": "Base fee in the declared unit",
        "type": "number"
       },
       "priorityFee": {
        "description": "Priority fee in the declared unit",
        "type": "number"
       },
       "standard": {
        "type": "number"
       },
       "unit": {
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "timestamp": {
    "description": "Unix timestamp ms",
    "type": "number"
   },
   "trend": {
    "description": "Gas trend direction",
    "type": "string"
   }
  },
  "required": [
   "chain"
  ],
  "type": "object"
 },
 "title": "Gas Tracker"
}
