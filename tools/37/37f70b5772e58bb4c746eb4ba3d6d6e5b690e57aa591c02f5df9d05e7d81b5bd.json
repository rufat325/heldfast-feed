{
 "description": "Send an email to a contact. Supports HTML body, templates, attachments, CC/BCC, threading, and scheduling.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token (auto-resolved if location_id provided)",
    "type": "string"
   },
   "attachments": {
    "description": "Attachment URLs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "bcc": {
    "description": "BCC email addresses",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "cc": {
    "description": "CC email addresses",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "contact_id": {
    "description": "Contact ID to send to",
    "type": "string"
   },
   "from_email": {
    "description": "From email address",
    "type": "string"
   },
   "html": {
    "description": "HTML email body",
    "type": "string"
   },
   "location_id": {
    "description": "CRM location ID",
    "type": "string"
   },
   "message": {
    "description": "Plain text message body",
    "type": "string"
   },
   "reply_mode": {
    "description": "Reply mode: reply, reply_all",
    "type": "string"
   },
   "scheduled_timestamp": {
    "description": "Unix timestamp to schedule send",
    "type": "number"
   },
   "subject": {
    "description": "Email subject line",
    "type": "string"
   },
   "template_id": {
    "description": "CRM email template ID",
    "type": "string"
   },
   "thread_id": {
    "description": "Email thread ID for threading",
    "type": "string"
   },
   "to_email": {
    "description": "To email (overrides contact default)",
    "type": "string"
   }
  },
  "required": [
   "contact_id",
   "subject"
  ],
  "type": "object"
 },
 "name": "crm_send_email"
}
