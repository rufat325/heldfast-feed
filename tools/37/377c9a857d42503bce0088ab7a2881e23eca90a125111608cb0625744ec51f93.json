{
 "description": "Manage a checklist draft lifecycle: a CAS draft save (expectedDraftVersion-fenced update of title/required/tree), or retire/restore the definition from the live worker surface. Receipt-backed. Requires job_checklists:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "definitionId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Durable-receipt idempotency key. Same key + same payload replays the stored receipt; same key + changed payload is a 409.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "operation": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "update_draft",
        "type": "string"
       },
       "expectedDraftVersion": {
        "minimum": 0,
        "type": "integer"
       },
       "required": {
        "type": "boolean"
       },
       "title": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "tree": {
        "description": "Adaptive v2 checklist tree (see job_checklists capabilities for limits).",
        "items": {
         "additionalProperties": {},
         "type": "object"
        },
        "maxItems": 300,
        "type": "array"
       }
      },
      "required": [
       "action",
       "expectedDraftVersion",
       "required",
       "tree"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "retire",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "restore",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "definitionId",
   "operation",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_job_checklists_manage",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
