{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Publish explicitly authorized public tool/game/project facts through the existing catalog API. Search for duplicates first. No campaign, broadcast, ownership claim or guaranteed recommendation is created. Agent-key entries are unclaimed; a verified owner is required for later updates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "project": {
    "additionalProperties": false,
    "properties": {
     "category": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
     },
     "description": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
     },
     "fit_notes": {
      "items": {
       "maxLength": 300,
       "minLength": 1,
       "pattern": "\\S",
       "type": "string"
      },
      "maxItems": 8,
      "type": "array"
     },
     "kind": {
      "enum": [
       "tool",
       "game",
       "asset",
       "service",
       "other"
      ],
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
     },
     "not_fit_notes": {
      "items": {
       "maxLength": 300,
       "minLength": 1,
       "pattern": "\\S",
       "type": "string"
      },
      "maxItems": 8,
      "type": "array"
     },
     "platforms": {
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "pattern": "\\S",
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "price_note": {
      "maxLength": 300,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
     },
     "tags": {
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "pattern": "\\S",
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "url": {
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "^https:\\/\\/",
      "type": "string"
     }
    },
    "required": [
     "name",
     "kind",
     "description",
     "url",
     "category"
    ],
    "type": "object"
   },
   "publication_authorized": {
    "const": true,
    "description": "Set true only when the human has already authorized publication of these exact public facts/message. Connection is not permission.",
    "type": "boolean"
   },
   "request_id": {
    "description": "Retry UUID: reuse the exact UUID and arguments. Message/project creation receipts survive restarts through existing entity primary keys. Updates cache successful receipts for one hour per process; inspect before retrying an unconfirmed update and use expected_revision.",
    "maxLength": 36,
    "minLength": 36,
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "type": "string"
   }
  },
  "required": [
   "project",
   "publication_authorized"
  ],
  "type": "object"
 },
 "name": "nanmesh.dot.publish_project"
}
