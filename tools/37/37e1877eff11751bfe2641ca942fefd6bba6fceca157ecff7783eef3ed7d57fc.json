{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns the currently active calculation settings and preferences for a user. Read-only operation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "userId": {
    "description": "Nonblank user identifier; at most 256 UTF-8 bytes and 256 characters. Whitespace in nonblank identifiers is preserved.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "userId"
  ],
  "type": "object"
 },
 "name": "get_prayer_preferences",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "calculationMethod": {
    "enum": [
     "UmmAlQura",
     "MuslimWorldLeague",
     "Egyptian",
     "Karachi",
     "NorthAmerica",
     "Dubai",
     "Qatar",
     "Kuwait",
     "MoonsightingCommittee",
     "Singapore",
     "Turkey",
     "Tehran"
    ],
    "type": "string"
   },
   "enabled": {
    "type": "boolean"
   },
   "exactWindowMinutes": {
    "type": "number"
   },
   "fixedCity": {
    "type": "string"
   },
   "fixedCityConfigured": {
    "type": "boolean"
   },
   "fixedCoordinatesConfigured": {
    "type": "boolean"
   },
   "highLatitudeRule": {
    "enum": [
     "MiddleOfTheNight",
     "SeventhOfTheNight",
     "TwilightAngle"
    ],
    "type": "string"
   },
   "locale": {
    "enum": [
     "en",
     "ar"
    ],
    "type": "string"
   },
   "locationMode": {
    "enum": [
     "auto_travel",
     "fixed"
    ],
    "type": "string"
   },
   "madhab": {
    "enum": [
     "Shafi",
     "Hanafi"
    ],
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "minuteAdjustments": {
    "additionalProperties": false,
    "properties": {
     "asr": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "dhuhr": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "fajr": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "isha": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "maghrib": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "sunrise": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "reminderMode": {
    "enum": [
     "prayer_window",
     "exact_window",
     "persistent"
    ],
    "type": "string"
   },
   "timezone": {
    "type": "string"
   },
   "updatedAtUtc": {
    "type": "string"
   }
  },
  "required": [
   "fixedCoordinatesConfigured",
   "fixedCityConfigured"
  ],
  "type": "object"
 },
 "title": "Retrieve Stored Prayer Preferences"
}
