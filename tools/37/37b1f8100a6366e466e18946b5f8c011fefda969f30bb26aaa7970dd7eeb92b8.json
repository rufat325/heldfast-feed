{"_meta":{"ui":{"resourceUri":"ui://widget/card-mailer-51779a33fd005602.html"}},"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Fix or remove a recipient"},"description":"Corrects or removes a recipient in a saved list by row number. Supplied fields replace stored values; omitted fields remain unchanged. An unreadable row needs name, line1, city, state and zip. Rechecks required fields and US address format, plus USPS verification when configured. Format checks do not confirm deliverability. remove: true excludes the recipient. Lists belonging to paid orders cannot be changed.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"city":{"maxLength":40,"type":"string"},"line1":{"description":"Street address","maxLength":64,"type":"string"},"line2":{"description":"Apartment, suite, unit","maxLength":64,"type":"string"},"list_id":{"type":"string"},"name":{"maxLength":40,"type":"string"},"remove":{"description":"Remove this recipient from the mailing.","type":"boolean"},"row":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"state":{"maxLength":20,"type":"string"},"zip":{"maxLength":10,"type":"string"}},"required":["list_id","row"],"type":"object"},"name":"fix_address","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"corrected_by_usps":{"type":"number"},"kind":{"const":"list","type":"string"},"list_id":{"type":"string"},"needs_fixing":{"type":"number"},"problems":{"items":{"additionalProperties":false,"properties":{"given":{"type":"string"},"problem":{"type":"string"},"row":{"type":"number"}},"required":["row","given","problem"],"type":"object"},"type":"array"},"ready":{"type":"number"},"skipped_over_limit":{"type":"number"},"total":{"type":"number"},"usps_checked":{"type":"boolean"}},"required":["kind","list_id","total","ready","corrected_by_usps","needs_fixing","problems"],"type":"object"},"title":"Fix or remove a recipient"}
