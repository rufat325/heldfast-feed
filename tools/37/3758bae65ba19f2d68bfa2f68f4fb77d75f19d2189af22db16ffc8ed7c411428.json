 "description": "Read all parameters for a channel (VALUES, MASTER, or LINK). Interface is auto-resolved from the address.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Channel address (e.g. '000A1BE9A71F15:1')",
    "type": "string"
   },
   "interface": {
    "description": "Interface name override (auto-resolved if omitted)",
    "type": "string"
   },
   "paramsetKey": {
    "description": "Paramset to read",
    "enum": [
     "VALUES",
     "MASTER",
     "LINK"
    ],
    "type": "string"
   }
  },
  "required": [
   "address",
   "paramsetKey"
  ],
  "type": "object"
 },
 "name": "get_paramset",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "type": "string"
   },
   "params": {
    "description": "Map of parameter name \u2192 value"
   },
   "paramsetKey": {
    "type": "string"
   }
  },
  "required": [
   "address",
   "paramsetKey",
   "params"
  ],
  "type": "object"
 },
 "title": "Get Paramset"
}
