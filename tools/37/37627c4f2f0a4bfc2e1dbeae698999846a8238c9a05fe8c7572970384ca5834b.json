 "description": "Settings \u2192 Push \u2192 Save schedule. Needs admin. Send the interval, alarmTime as HH:MM or empty, clientPush, and every destination. Interval 0 is off; otherwise 5, 10, 15, 30, or 60. An interval or an alarm needs at least one destination. Then call push_quote_now, or push_quote when clientPush is true",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alarmTime": {
    "description": "Empty, or HH:MM such as 07:30. One push when the saved time zone hits that minute. Omit to keep the saved alarm.",
    "type": "string"
   },
   "clientPush": {
    "description": "Allow push_quote to send one line now.",
    "type": "boolean"
   },
   "mqttClearPassword": {
    "type": "boolean"
   },
   "mqttClientId": {
    "type": "string"
   },
   "mqttEnabled": {
    "type": "boolean"
   },
   "mqttPassword": {
    "description": "Omit to keep the saved password. get_settings never returns it.",
    "type": "string"
   },
   "mqttTopic": {
    "type": "string"
   },
   "mqttUrl": {
    "description": "Required when mqttEnabled is true. mqtt://host:port.",
    "type": "string"
   },
   "mqttUsername": {
    "type": "string"
   },
   "pushEvents": {
    "description": "GET /events, event name quote.",
    "type": "boolean"
   },
   "pushEveryMinutes": {
    "description": "0 is off. Otherwise the minute must match, such as :00, :05, :10.",
    "enum": [
     0,
     5,
     10,
     15,
     30,
     60
    ],
    "type": "number"
   },
   "pushHttp": {
    "description": "Open Streamable HTTP sessions.",
    "type": "boolean"
   },
   "pushSse": {
    "description": "Open legacy SSE sessions.",
    "type": "boolean"
   }
  },
  "required": [
   "pushEveryMinutes",
   "clientPush",
   "pushEvents",
   "pushSse",
   "pushHttp",
   "mqttEnabled"
  ],
  "type": "object"
 },
