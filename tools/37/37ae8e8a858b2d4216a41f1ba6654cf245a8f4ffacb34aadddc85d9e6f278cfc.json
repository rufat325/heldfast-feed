{
 "description": "Simulate a TWAP (time-weighted average price) DCA order. Splits a large order into equal-sized chunks over a configurable window, quotes every chunk at current prices, and returns the schedule + estimated average price. Read-only. Never signs or broadcasts. Use before committing to a TWAP.",
 "inputSchema": {
  "additionalProperties": false,
  "oneOf": [
   {
    "required": [
     "amount"
    ]
   },
   {
    "required": [
     "amountIn"
    ]
   }
  ],
  "properties": {
   "amount": {
    "description": "raw base units of tokenIn",
    "type": "string"
   },
   "amountIn": {
    "description": "read-only alias for amount",
    "type": "string"
   },
   "chainId": {
    "type": "number"
   },
   "slippageBps": {
    "description": "slippage cap in bps (default 100)",
    "type": "number"
   },
   "splits": {
    "description": "number of chunks (default 10, max 100)",
    "type": "number"
   },
   "taker": {
    "description": "the REAL wallet that will sign",
    "type": "string"
   },
   "tokenIn": {
    "type": "string"
   },
   "tokenOut": {
    "type": "string"
   },
   "windowHours": {
    "description": "total window in hours (default 6)",
    "type": "number"
   }
  },
  "required": [
   "chainId",
   "tokenIn",
   "tokenOut",
   "taker"
  ],
  "type": "object"
 },
 "name": "twap_simulate"
}
