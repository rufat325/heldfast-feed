    "description": "buy: USDG to spend; sell: tokens to sell",
    "type": "string"
   },
   "side": {
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "slippageBps": {
    "maximum": 1000,
    "minimum": 10,
