{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Contact (MeCard) QR payload"},"description":"Build a MeCard contact payload (MECARD:N:last,first;TEL:...;;), the compact alternative to a vCard: fewer characters, so a smaller code. Android phones read it; Apple doesn't document it for the iPhone Camera, so prefer qr_payload_vcard when the contact must reach every phone. Pass the result as `data` to generate_qr_code.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"address":{"description":"Postal address, one line","maxLength":300,"minLength":1,"type":"string"},"birthday":{"description":"Birthday, YYYY-MM-DD","maxLength":10,"minLength":1,"type":"string"},"email":{"description":"Email address","maxLength":254,"minLength":1,"type":"string"},"firstName":{"description":"Given name","maxLength":100,"minLength":1,"type":"string"},"lastName":{"description":"Family name","maxLength":100,"minLength":1,"type":"string"},"nickname":{"description":"Nickname","maxLength":100,"minLength":1,"type":"string"},"note":{"description":"Free-form note","maxLength":500,"minLength":1,"type":"string"},"phone":{"description":"Phone number, international format recommended","maxLength":30,"minLength":1,"type":"string"},"reading":{"description":"How the name is read, like kana for a Japanese name (SOUND)","maxLength":100,"minLength":1,"type":"string"},"url":{"description":"Website URL","maxLength":500,"minLength":1,"type":"string"}},"required":["firstName"],"type":"object"},"name":"qr_payload_mecard","title":"Contact (MeCard) QR payload"}
