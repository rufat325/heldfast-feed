 "description": "Replace the Uwear Shoot Board items.",
 "inputSchema": {
  "properties": {
   "board_id": {
    "description": "The open Shoot Board's board_id, from Open Shoot Board or your context.",
    "type": "string"
   },
   "board_version": {
    "description": "Pass 2 to receive board v2 state, including the board's output settings",
    "enum": [
     2
    ],
    "type": "integer"
   },
   "context_items": {
    "description": "Shoot Board items that replace the current list when context_state is omitted",
    "items": {
     "properties": {
      "description": {
       "maxLength": 500,
       "type": "string"
      },
      "gender": {
       "maxLength": 40,
       "type": "string"
      },
      "id": {
       "oneOf": [
        {
         "type": "integer"
        },
        {
         "type": "string"
        }
       ]
      },
      "intake": {
       "description": "Board v2: intake state of an item still being sorted; absent means ready",
       "properties": {
        "candidates": {
         "items": {
          "enum": [
           "clothing",
           "models",
           "outfits",
           "generations",
           "files",
           "locations",
           "art_directions",
           "automations"
          ],
          "type": "string"
         },
         "type": "array"
        },
        "source_hash": {
         "description": "sha256 hex of the source file",
         "type": [
          "string",
          "null"
         ]
        },
        "status": {
         "enum": [
          "sorting",
          "needs_answer",
          "ready"
         ],
         "type": "string"
        }
       },
       "required": [
        "status"
       ],
       "type": [
        "object",
        "null"
       ]
      },
      "isVideo": {
       "type": "boolean"
      },
      "key": {
       "type": "string"
      },
      "mediaUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "meta": {
       "description": "Short display facts, e.g. ['female', 'ID 7']",
       "items": {
        "type": [
         "string",
         "number",
         "boolean"
        ]
       },
       "maxItems": 8,
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "posterUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "refs": {
       "type": "object"
      },
      "schemaVersion": {
       "type": "integer"
      },
      "thumbnailUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "type": {
       "enum": [
        "clothing",
        "models",
        "outfits",
        "generations",
        "files",
        "locations",
        "art_directions",
        "automations"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "context_state": {
    "description": "Complete Shoot Board state to sanitize and persist; takes precedence over context_items",
    "properties": {
     "draftSelectionKeys": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "items": {
      "items": {
       "properties": {
        "description": {
         "maxLength": 500,
         "type": "string"
        },
        "gender": {
         "maxLength": 40,
         "type": "string"
        },
        "id": {
         "oneOf": [
          {
           "type": "integer"
          },
          {
           "type": "string"
          }
         ]
        },
        "intake": {
         "description": "Board v2: intake state of an item still being sorted; absent means ready",
         "properties": {
          "candidates": {
           "items": {
            "enum": [
             "clothing",
             "models",
             "outfits",
             "generations",
             "files",
             "locations",
             "art_directions",
             "automations"
            ],
            "type": "string"
           },
           "type": "array"
          },
          "source_hash": {
           "description": "sha256 hex of the source file",
           "type": [
            "string",
            "null"
           ]
          },
          "status": {
           "enum": [
            "sorting",
            "needs_answer",
            "ready"
           ],
           "type": "string"
          }
         },
         "required": [
          "status"
         ],
         "type": [
          "object",
          "null"
         ]
        },
        "isVideo": {
         "type": "boolean"
        },
        "key": {
         "type": "string"
        },
        "mediaUrl": {
         "type": [
          "string",
          "null"
         ]
        },
        "meta": {
         "description": "Short display facts, e.g. ['female', 'ID 7']",
         "items": {
          "type": [
           "string",
           "number",
           "boolean"
          ]
         },
         "maxItems": 8,
         "type": "array"
        },
        "name": {
         "type": "string"
        },
        "posterUrl": {
         "type": [
          "string",
          "null"
         ]
        },
        "refs": {
         "type": "object"
        },
        "schemaVersion": {
         "type": "integer"
        },
        "thumbnailUrl": {
         "type": [
          "string",
          "null"
         ]
        },
        "type": {
         "enum": [
          "clothing",
          "models",
          "outfits",
          "generations",
          "files",
          "locations",
          "art_directions",
          "automations"
         ],
         "type": "string"
        }
       },
       "required": [
        "id",
        "type"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "output": {
      "description": "Board v2: the shoot's output settings; omitted keys keep their current value",
      "properties": {
       "aspect_ratio": {
        "description": "e.g. \"3:4\"",
        "type": [
         "string",
         "null"
        ]
       },
       "model_slug": {
        "type": [
         "string",
         "null"
        ]
       },
       "num_images": {
        "minimum": 1,
        "type": [
         "integer",
         "null"
        ]
       },
       "resolution": {
        "description": "e.g. \"2K\"",
        "type": [
         "string",
         "null"
        ]
       }
      },
      "type": [
       "object",
       "null"
      ]
     },
     "pendingRequest": {
      "type": [
       "object",
       "null"
      ]
     },
     "revision": {
      "type": "integer"
     },
     "schemaVersion": {
      "type": "integer"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "expected_revision": {
    "description": "Board revision this write is based on; a stale revision returns a revision_conflict error with the current board instead of overwriting it",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "board_id",
   "expected_revision"
  ],
  "type": "object"
 },
