{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Normalize Reader options"
 },
 "description": "Resolves the certified Reader family and version and returns default-filled canonical decode options. Validates options only; it does not acquire or decode bytes. Returns family_id, family_version, decode_options and decode_options_json for the recipe.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "decode_options": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "family_id": {
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
    "type": "string"
   },
   "family_version": {
    "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$",
    "type": "string"
   }
  },
  "required": [
   "family_id",
   "family_version",
   "decode_options"
  ],
  "type": "object"
 },
 "name": "normalize_reader_options",
 "title": "Normalize Reader options"
}
