    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Words to search for.",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_site",
 "title": "Search the site"
}
