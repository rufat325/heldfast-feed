{
 "description": "Get a cross-chain quote: best route, output amount, calldata, gas. Use get_chains and get_tokens first to resolve chain IDs and token addresses.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Amount in smallest units (wei/smallest decimals)",
    "type": "string"
   },
   "destinationChainId": {
    "description": "Destination chain ID",
    "type": "number"
   },
   "destinationCurrency": {
    "description": "Token address on destination chain; use 0x0... for native",
    "type": "string"
   },
   "fee": {
    "description": "Fee 0\u20130.1 (only with integrator)",
    "maximum": 0.1,
    "minimum": 0,
    "type": "number"
   },
   "integrator": {
    "description": "Integrator identifier",
    "type": "string"
   },
   "originChainId": {
    "description": "Origin chain ID (e.g. 1 for Ethereum, 42161 for Arbitrum)",
    "type": "number"
   },
   "originCurrency": {
    "description": "Token address on origin chain; use 0x0... for native currency",
    "type": "string"
   },
   "receiverAddress": {
    "description": "Receiver wallet address",
    "type": "string"
   },
   "senderAddress": {
    "description": "Sender wallet address",
    "type": "string"
   },
   "slippage": {
    "description": "Slippage tolerance 0\u20131 (e.g. 0.005 for 0.5%)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "originChainId",
   "destinationChainId",
   "amount",
   "originCurrency",
   "destinationCurrency"
  ],
  "type": "object"
 },
 "name": "get_quote"
}
