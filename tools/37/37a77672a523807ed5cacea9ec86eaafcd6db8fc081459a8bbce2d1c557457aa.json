{
 "description": "Update a saved job's status or details. Requires authentication.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "excitement": {
    "description": "Excitement level from 0-5",
    "maximum": 5,
    "minimum": 0,
    "type": "number"
   },
   "id": {
    "description": "Kanban item ID",
    "type": "number"
   },
   "notes": {
    "description": "Updated notes",
    "type": "string"
   },
   "status": {
    "description": "New application status",
    "enum": [
     "seen",
     "saved",
     "applied",
     "interviewing",
     "negotiation",
     "hired",
     "archived"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_job_status"
}
