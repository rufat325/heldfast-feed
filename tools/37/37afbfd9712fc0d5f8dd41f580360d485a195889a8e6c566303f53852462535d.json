{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Open a multi-signer signature envelope over an existing company document. Name the document with source_company_id + source_document_id and the service resolves its storage location and content hash itself - do not supply document_s3_bucket/document_s3_key. Give the founder SIGNER_ROLE_COMPANY at signing_order 1 and each counterparty SIGNER_ROLE_COUNTERPARTY from 2 up. Signing links are emailed to counterparties; no tokens are returned.",
 "inputSchema": {
  "properties": {
   "documentS3Bucket": {
    "maxLength": 100,
    "minLength": 3,
    "pattern": "^[A-Za-z0-9.-]+$",
    "type": "string"
   },
   "documentS3Key": {
    "maxLength": 1024,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9._/-]+$",
    "type": "string"
   },
   "envelope": {
    "properties": {
     "certificateSha256": {
      "pattern": "^([a-f0-9]{64})?$",
      "type": "string"
     },
     "completedAt": {
      "format": "date-time",
      "type": "string"
     },
     "consentVersionId": {
      "maxLength": 64,
      "type": "string"
     },
     "createdAt": {
      "format": "date-time",
      "type": "string"
     },
     "documentSha256": {
      "pattern": "^([a-f0-9]{64})?$",
      "type": "string"
     },
     "envelopeType": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "finalArtifactSha256": {
      "pattern": "^([a-f0-9]{64})?$",
      "type": "string"
     },
     "id": {
      "maxLength": 64,
      "minLength": 4,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
     },
     "provider": {
      "enum": [
       "SIGNATURE_PROVIDER_UNSPECIFIED",
       "SIGNATURE_PROVIDER_LOVIE_SIGN",
       "SIGNATURE_PROVIDER_DOCUSIGN"
      ],
      "type": "string"
     },
     "providerEnvelopeId": {
      "maxLength": 128,
      "type": "string"
     },
     "signedDocumentSha256": {
      "pattern": "^([a-f0-9]{64})?$",
      "type": "string"
     },
     "status": {
      "enum": [
       "SIGNATURE_ENVELOPE_STATUS_UNSPECIFIED",
       "SIGNATURE_ENVELOPE_STATUS_CREATED",
       "SIGNATURE_ENVELOPE_STATUS_SENT",
       "SIGNATURE_ENVELOPE_STATUS_VIEWED",
       "SIGNATURE_ENVELOPE_STATUS_CONSENTED",
       "SIGNATURE_ENVELOPE_STATUS_SIGNED",
       "SIGNATURE_ENVELOPE_STATUS_COMPLETED",
       "SIGNATURE_ENVELOPE_STATUS_VOIDED"
      ],
      "type": "string"
     },
     "subjectRef": {
      "additionalProperties": true,
      "type": "object"
     },
     "userId": {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     "voidedAt": {
      "format": "date-time",
      "type": "string"
     }
    },
    "type": "object"
   },
   "reminderIntervalDays": {
    "maximum": 365,
    "minimum": 0,
    "type": "integer"
   },
   "signers": {
    "items": {
     "properties": {
      "actorUserId": {
       "description": "UUID value wrapper.",
       "properties": {
        "value": {
         "format": "uuid",
         "type": "string"
        }
       },
       "type": "object"
      },
      "anchor": {
       "additionalProperties": true,
       "type": "object"
      },
      "email": {
       "maxLength": 320,
       "pattern": "^([^@\\s]+@[^@\\s]+\\.[^@\\s]+)?$",
       "type": "string"
      },
      "name": {
       "description": "Human-readable name (1-255 Unicode chars).",
       "properties": {
        "value": {
         "maxLength": 255,
         "minLength": 1,
         "type": "string"
        }
       },
       "type": "object"
      },
      "role": {
       "enum": [
        "SIGNER_ROLE_COMPANY",
        "SIGNER_ROLE_INVESTOR",
        "SIGNER_ROLE_COUNTERPARTY"
       ],
       "type": "string"
      },
      "signingOrder": {
       "maximum": 100,
       "minimum": 1,
       "type": "integer"
      }
     },
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "sourceCompanyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "sourceDocumentId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "envelope"
  ],
  "type": "object"
 },
 "name": "signature_create_envelope",
 "outputSchema": {
  "properties": {
   "envelopeId": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Create Signature Envelope"
}
