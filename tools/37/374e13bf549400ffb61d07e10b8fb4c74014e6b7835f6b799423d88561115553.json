{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find GSC queries not cited by AI"
 },
 "description": "Join Google Search Console performance with am_i_cited per query. Surfaces queries where the domain ranks well in Google but is not cited in AI - the closest editorial wins. Requires GCP service account creds (credentials_path or GOOGLE_APPLICATION_CREDENTIALS env).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "credentials_path": {
    "description": "Path to GCP service account JSON. Defaults to env GOOGLE_APPLICATION_CREDENTIALS.",
    "type": "string"
   },
   "domain": {
    "description": "Domain to analyze, e.g. 'automatelab.tech'. Used both for the GSC site URL and the citation check.",
    "minLength": 1,
    "type": "string"
   },
   "end_date": {
    "description": "ISO date for GSC range end, e.g. '2026-05-01'.",
    "type": "string"
   },
   "engine": {
    "default": "auto",
    "description": "AI engine for the citation check.",
    "enum": [
     "perplexity",
     "claude",
     "openai",
     "gemini",
     "bing_serp",
     "brave_serp",
     "google_ai_mode",
     "auto"
    ],
    "type": "string"
   },
   "queries": {
    "description": "Queries to cross-reference. 1-20 per call.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "site_url": {
    "description": "Override the GSC siteUrl. Defaults to 'sc-domain:<domain>'.",
    "type": "string"
   },
   "start_date": {
    "description": "ISO date for GSC range start, e.g. '2026-04-01'.",
    "type": "string"
   }
  },
  "required": [
   "domain",
   "queries",
   "start_date",
   "end_date"
  ],
  "type": "object"
 },
 "name": "signals_gsc_gap",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "closest_wins": {
    "description": "Queries where domain ranks in Google top-10 but is not AI-cited (the editorial gap).",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   },
   "domain": {
    "description": "Domain analyzed.",
    "type": "string"
   },
   "engine": {
    "description": "Engine used for the citation check.",
    "type": "string"
   },
   "range": {
    "additionalProperties": false,
    "description": "GSC date range.",
    "properties": {
     "end": {
      "type": "string"
     },
     "start": {
      "type": "string"
     }
    },
    "required": [
     "start",
     "end"
    ],
    "type": "object"
   },
   "rows": {
    "description": "Per-query GSC + AI citation cross-reference.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "ai_cited": {
       "description": "Whether the domain was cited by the AI engine for this query.",
       "type": "boolean"
      },
      "ai_rank": {
       "type": "number"
      },
      "gsc": {
       "additionalProperties": false,
       "properties": {
        "clicks": {
         "type": "number"
        },
        "ctr": {
         "type": "number"
        },
        "impressions": {
         "type": "number"
        },
        "position": {
         "type": "number"
        }
       },
       "required": [
        "impressions",
        "clicks"
       ],
       "type": "object"
      },
      "query": {
       "type": "string"
      }
     },
     "required": [
      "query",
      "gsc",
      "ai_cited"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "site_url": {
    "description": "GSC siteUrl used.",
    "type": "string"
   }
  },
  "required": [
   "domain",
   "site_url",
   "range",
   "rows",
   "closest_wins"
  ],
  "type": "object"
 }
}
