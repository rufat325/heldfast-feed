{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Checks whether a melody can be played on a music box: notes outside the box, same note repeated too fast, off-grid notes, tempo and length. Every issue names the note and how to fix it. Saves nothing. Call it before offering a melody to the person.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "box": {
    "description": "Music box type: \"15\", \"20\", \"30\" (notes) or \"freestyle\" (digital only). See list_music_boxes.",
    "enum": [
     "15",
     "20",
     "30",
     "freestyle"
    ],
    "type": "string"
   },
   "bpm": {
    "description": "Tempo in beats per minute (30-300).",
    "maximum": 300,
    "minimum": 30,
    "type": "number"
   },
   "illegal_threshold_ticks": {
    "description": "Minimum gap between two identical notes, in ticks (default 384 = 2 beats).",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "notes": {
    "description": "Notes in any order, at most 2000. Only onsets matter: music boxes have no note durations.",
    "items": {
     "properties": {
      "beat": {
       "description": "When the note sounds, in quarter notes from 0 (e.g. 0, 1, 1.5).",
       "minimum": 0,
       "type": "number"
      },
      "pitch": {
       "anyOf": [
        {
         "maxLength": 8,
         "type": "string"
        },
        {
         "maximum": 127,
         "minimum": 0,
         "type": "integer"
        }
       ],
       "description": "Note name like \"C5\", \"F#4\", \"Bb3\", or a MIDI number (60 = C4)."
      },
      "ticks": {
       "description": "Alternative to beat: 192 ticks per quarter note.",
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "pitch"
     ],
     "type": "object"
    },
    "maxItems": 2000,
    "minItems": 1,
    "type": "array"
   },
   "snap_beats": {
    "description": "Optional grid in beats (e.g. 0.5) to warn about notes off that grid.",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "box",
   "bpm",
   "notes"
  ],
  "type": "object"
 },
 "name": "validate_melody",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "composer_link": {
    "description": "Opens the composer with the playable notes loaded, without saving. Give it to the person to listen and edit.",
    "type": "string"
   },
   "issues": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "index": {
       "description": "Index of the note in the input, when the issue is about one note.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning"
       ],
       "type": "string"
      },
      "suggestions": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "code",
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "ok": {
    "type": "boolean"
   },
   "stats": {
    "additionalProperties": false,
    "properties": {
     "duration_seconds": {
      "type": "number"
     },
     "illegal_count": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "note_count": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "strip_length_cm": {
      "type": "number"
     }
    },
    "required": [
     "note_count",
     "illegal_count",
     "duration_seconds"
    ],
    "type": "object"
   }
  },
  "required": [
   "ok",
   "issues",
   "stats"
  ],
  "type": "object"
 },
 "title": "Validate a melody for a music box"
}
