{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "project_todos:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Accept the coaching revision (action coaching_accept) \u2014 the canonical APPROVE, completing the Project To-do exactly once. expectedSubmittedAt is the exact submittedAt you reviewed (a resubmission in between rejects the stale approval); open published threads are 409 unless acknowledgeOpenThreads=true (they are kept, never hidden). Requires project_todos:write and a caller-supplied stable idempotencyKey (registry op project_todos.quizzes.coaching.manage). The response echoes its action discriminator and receipt fields.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "acknowledgeOpenThreads": {
    "type": "boolean"
   },
   "assignmentId": {
    "minLength": 1,
    "type": "string"
   },
   "expectedSubmittedAt": {
    "format": "date-time",
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   }
  },
  "required": [
   "assignmentId",
   "expectedSubmittedAt",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_quiz_coaching_accept",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "acknowledgedOpenThreadIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "action": {
      "const": "coaching_accept",
      "type": "string"
     },
     "assignmentId": {
      "type": "string"
     },
     "assignmentStatus": {
      "anyOf": [
       {
        "enum": [
         "OPEN",
         "IN_PROGRESS",
         "SUBMITTED",
         "COMPLETED",
         "RETURNED",
         "WAIVED",
         "CLOSED",
         "SUPERSEDED"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "waitingOnRole": {
      "anyOf": [
       {
        "enum": [
         "WORKER",
         "EMPLOYER",
         "NONE"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "action",
     "assignmentId",
     "assignmentStatus",
     "waitingOnRole",
     "acknowledgedOpenThreadIds"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
