{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "profile",
     "email",
     "user:org:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the state codes available for state-level geo-targeting in a country (used as the \"state\" parameter on the scrape tools). Only countries with state-level targeting are accepted.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "description": "ISO 3166-1 alpha-2 country code to list states for. Only countries with state-level targeting are supported.",
    "enum": [
     "US"
    ],
    "type": "string"
   }
  },
  "required": [
   "country"
  ],
  "type": "object"
 },
 "name": "list_states",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "states": {
    "description": "States available for state-level targeting.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "states"
  ],
  "type": "object"
 },
 "title": "List states for a country"
}
