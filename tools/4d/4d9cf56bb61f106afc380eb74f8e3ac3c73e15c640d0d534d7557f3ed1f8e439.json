{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Prepare a personalized Mubboo Flights search for one-way, round-trip or multi-city travel. Validate airports, dates, passengers, cabin, language and currency, then return a search link. The traveler opens the link to compare current options; this tool returns search details rather than quotes or reservations. Round trips require outbound and reversed inbound segments. comfort means premium economy. childAges must contain an age for every child; infants are on lap.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"adults":{"maximum":9,"minimum":1,"type":"integer"},"cabin":{"enum":["economy","comfort","business","first"],"type":"string"},"childAges":{"items":{"maximum":17,"minimum":0,"type":"integer"},"maxItems":7,"type":"array"},"children":{"maximum":7,"minimum":0,"type":"integer"},"currency":{"pattern":"^[A-Z]{3}$","type":"string"},"infants":{"maximum":7,"minimum":0,"type":"integer"},"language":{"maxLength":12,"pattern":"^[a-z]{2,3}(?:-[A-Za-z]{2,8})?$","type":"string"},"market":{"pattern":"^[a-z]{2}$","type":"string"},"segments":{"items":{"additionalProperties":false,"properties":{"date":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"destination":{"pattern":"^[A-Z]{3}$","type":"string"},"origin":{"pattern":"^[A-Z]{3}$","type":"string"}},"required":["origin","destination","date"],"type":"object"},"maxItems":6,"minItems":1,"type":"array"},"tripType":{"enum":["oneway","roundtrip","multicity"],"type":"string"}},"required":["market","language","currency","tripType","segments","adults","children","infants","childAges","cabin"],"type":"object"},"name":"prepare_flight_search","title":"Prepare a flight search link"}
