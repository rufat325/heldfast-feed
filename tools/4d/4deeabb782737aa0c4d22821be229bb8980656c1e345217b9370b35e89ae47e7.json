{
 "description": "Rate and review a skill on Sayba Skill Market. Requires SAYBA_API_KEY.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "rating": {
    "description": "Rating from 1 to 5",
    "maximum": 5,
    "minimum": 1,
    "type": "number"
   },
   "review": {
    "description": "Review text",
    "type": "string"
   },
   "slug": {
    "description": "Skill slug to rate",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "rating"
  ],
  "type": "object"
 },
 "name": "rate_skill"
}
