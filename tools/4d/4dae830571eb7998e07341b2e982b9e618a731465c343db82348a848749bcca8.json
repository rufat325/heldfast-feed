{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false,
  "title": "Update a zone record"
 },
 "description": "Update an existing DNS record. WARNING: mutates LIVE DNS \u2014 changing content/ttl takes effect for real resolution. Only the fields you provide are sent. API: PATCH /{account}/zones/{zone}/records/{record}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "content": {
    "description": "New record content.",
    "type": "string"
   },
   "name": {
    "description": "New record name (subdomain part; \"\" for apex).",
    "type": "string"
   },
   "priority": {
    "description": "New priority, for MX/SRV records.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "record": {
    "description": "Numeric record id to update.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "regions": {
    "description": "New regions list.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ttl": {
    "description": "New TTL in seconds.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "zone": {
    "description": "Zone name, e.g. example.com.",
    "type": "string"
   }
  },
  "required": [
   "zone",
   "record"
  ],
  "type": "object"
 },
 "name": "dnsimple_update_zone_record",
 "title": "Update a zone record"
}
