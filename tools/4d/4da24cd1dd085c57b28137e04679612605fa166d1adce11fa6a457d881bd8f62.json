    "default": "",
    "maxLength": 120,
    "type": "string"
   },
   "country_of_origin": {
    "description": "Valid ISO-3166 manufacturing origin, not dispatch country",
    "pattern": "^[A-Z]{2}$",
    "type": "string"
   },
   "customs_value_usd": {
    "pattern": "^[0-9]+(?:\\.[0-9]{1,2})?$",
    "type": "string"
   },
   "destination_country": {
    "const": "US",
    "default": "US",
    "type": "string"
   },
   "dispatch_country": {
    "enum": [
     "DE",
     "AT"
    ],
    "type": "string"
   },
   "gtin": {
    "default": "",
