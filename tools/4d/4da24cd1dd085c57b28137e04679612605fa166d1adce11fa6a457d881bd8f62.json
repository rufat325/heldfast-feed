    "type": "string"
   },
   "hts_code": {
    "default": "",
    "description": "Optional buyer-declared 6, 8 or 10 digit HTS code",
    "type": "string"
   },
   "importer_use": {
    "enum": [
     "personal",
     "commercial_resale",
     "business_use",
     "gift",
     "sample"
    ],
    "type": "string"
   },
   "intended_use": {
    "maxLength": 500,
    "minLength": 3,
    "type": "string"
   },
   "material_or_composition": {
    "maxLength": 1000,
    "minLength": 3,
    "type": "string"
   },
   "merchant_forwarding_policy": {
    "enum": [
     "allowed",
     "prohibited",
     "unknown"
    ],
    "type": "string"
   },
   "model": {
    "default": "",
    "maxLength": 120,
    "type": "string"
   },
   "product_description": {
    "maxLength": 2000,
    "minLength": 20,
    "type": "string"
   },
   "product_name": {
    "maxLength": 160,
    "minLength": 3,
    "type": "string"
   },
   "quantity": {
    "maximum": 10000,
    "minimum": 1,
