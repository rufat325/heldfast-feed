{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "List proposed actions for the authorized workspace and advertising account.",
 "inputSchema": {
  "properties": {
   "account_id": {
    "description": "Advertising account ID. Signals reads use the workspace Meta destination when omitted; other tools may require an ID when multiple accounts are active.",
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "enum": [
     "pending",
     "approved_without_execution",
     "rejected",
     "executing",
     "executed_pending_verification",
     "compensating",
     "measuring",
     "verified",
     "failed",
     "execution_uncertain",
     "rolled_back",
     "blocked"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_actions",
 "outputSchema": {
  "properties": {
   "data": {
    "items": {
     "properties": {
      "batch_status": {
       "enum": [
        "pending",
        "approved",
        "approved_without_execution",
        "auto_approved",
        "rejected",
        "executing",
        "executed_pending_verification",
        "compensating",
        "measuring",
        "completed",
        "failed",
        "rolled_back",
        "rollback_incomplete",
        "blocked"
       ],
       "type": "string"
      },
      "disposition": {
       "properties": {
        "compensation_reason_code": {
         "type": [
          "string",
          "null"
         ]
        },
        "late_restored": {
         "type": "boolean"
        },
        "outcome_checked_at": {
         "type": [
          "string",
          "null"
         ]
        },
        "outcome_reason_code": {
         "type": [
          "string",
          "null"
         ]
        },
        "outcome_status": {
         "enum": [
          "measurable",
          "not_measurable",
          "unavailable",
          null
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "receipt_status": {
         "enum": [
          "pending",
          "attempting",
          "reconciliation_required",
          "committed",
          "executed_pending_verification",
          "measuring",
          "verified",
          "compensating",
          "compensated",
          "compensation_failed",
          "irreversible",
          "failed",
          "reconciliation_exhausted",
          null
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "recovery_disposition": {
         "enum": [
          "no_compensation",
          "restored",
          "unrestored",
          "contradictory",
          "irreversible",
          "uncertain",
          null
         ],
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "receipt_status",
        "outcome_status",
        "outcome_reason_code",
        "outcome_checked_at",
        "compensation_reason_code",
        "recovery_disposition",
        "late_restored"
       ],
       "type": "object"
      }
     },
     "required": [
      "batch_status",
      "disposition"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "type": "object"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 },
 "title": "List Actions"
}
