{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "CMYK to RGB converter"
 },
 "description": "Convert print CMYK values (each 0 to 100) to on-screen RGB and hex, or convert RGB (each 0 to 255) the other way to CMYK. Uses the standard device-independent conversion. Source: https://hopi.co.uk/cmyk-to-rgb/",
 "inputSchema": {
  "allOf": [
   {
    "if": {
     "properties": {
      "mode": {
       "const": "cmyk_to_rgb"
      }
     }
    },
    "then": {
     "required": [
      "c",
      "m",
      "y",
      "k"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "mode": {
       "const": "rgb_to_cmyk"
      }
     }
    },
    "then": {
     "required": [
      "r",
      "g",
      "b"
     ]
    }
   }
  ],
  "properties": {
   "b": {
    "description": "Blue 0 to 255 (for rgb_to_cmyk)",
    "maximum": 255,
    "minimum": 0,
    "type": "integer"
   },
   "c": {
    "description": "Cyan 0 to 100 (for cmyk_to_rgb)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "g": {
    "description": "Green 0 to 255 (for rgb_to_cmyk)",
    "maximum": 255,
    "minimum": 0,
    "type": "integer"
   },
   "k": {
    "description": "Key/black 0 to 100 (for cmyk_to_rgb)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "m": {
    "description": "Magenta 0 to 100 (for cmyk_to_rgb)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "mode": {
    "description": "Direction of conversion",
    "enum": [
     "cmyk_to_rgb",
     "rgb_to_cmyk"
    ],
    "type": "string"
   },
   "r": {
    "description": "Red 0 to 255 (for rgb_to_cmyk)",
    "maximum": 255,
    "minimum": 0,
    "type": "integer"
   },
   "y": {
    "description": "Yellow 0 to 100 (for cmyk_to_rgb)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "mode"
  ],
  "type": "object"
 },
 "name": "hopi_cmyk_to_rgb",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "hex": {
    "type": "string"
   },
   "mode": {
    "type": "string"
   },
   "rgb": {
    "type": "array"
   },
   "rgbString": {
    "type": "string"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "mode",
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "CMYK to RGB converter"
}
