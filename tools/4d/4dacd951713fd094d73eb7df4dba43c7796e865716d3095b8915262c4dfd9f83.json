  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Maximum results (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Results to skip, for pagination (default 0)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "provenance_mode": {
    "description": "Provenance verbosity: 'concise' (default \u2014 source, url, vintage, retrieval date, citation, license) or 'detailed' (full canonical block with dataset, dimension key and notices)",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   },
   "query": {
    "description": "Keywords, matched against dataflow name and id (AND between terms)",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
