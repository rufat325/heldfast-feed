{
 "description": "Search D&D 5e SRD monsters by name, CR, type, size, or alignment. Returns full stat blocks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alignment": {
    "description": "Alignment (e.g. \"chaotic evil\", \"neutral\")",
    "type": "string"
   },
   "cr": {
    "description": "Exact challenge rating (e.g. \"1/4\", \"5\")",
    "type": "string"
   },
   "cr_max": {
    "description": "Maximum challenge rating (numeric)",
    "type": "number"
   },
   "cr_min": {
    "description": "Minimum challenge rating (numeric, e.g. 0.25 for 1/4)",
    "type": "number"
   },
   "limit": {
    "default": 10,
    "description": "Results per page (max 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Offset for pagination",
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Search term for monster name or description",
    "type": "string"
   },
   "size": {
    "description": "Size category (Tiny, Small, Medium, Large, Huge, Gargantuan)",
    "type": "string"
   },
   "type": {
    "description": "Monster type (e.g. \"beast\", \"undead\", \"dragon\")",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_monsters"
}
