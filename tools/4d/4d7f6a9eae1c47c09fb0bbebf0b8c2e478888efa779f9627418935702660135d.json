{"_meta":{"fastmcp":{"tags":[]},"securitySchemes":[{"type":"noauth"}]},"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":true,"title":"Find domain names"},"description":"Suggest domain names and check each one against public registry records.\n\nA name is only reported available when the registry clearly says it is free.\nWhen the lookup is inconclusive `availability_checked` is false and\n`available` is false, so read that as \"not confirmed free\" rather than\n\"already taken\" - some TLDs have no registry service to ask. Confirm at a\nregistrar before buying.\n\n`brandability_score` is an opinion about the string, not a claim about how\nthe name will perform; `brandability_factors` reports what it was computed\nfrom so you can weigh it yourself.","inputSchema":{"additionalProperties":false,"properties":{"keyword_or_concept":{"type":"string"},"tlds":{"anyOf":[{"items":{"examples":[".com",".ai",".app",".dev"],"pattern":"^\\.[a-z]{2,24}$","type":"string"},"maxItems":6,"type":"array"},{"type":"null"}],"default":null,"description":"Up to 6 TLDs, each written with its leading dot - \".com\", not \"com\". The upstream enforces this with a regex and rejects the request otherwise. Defaults to .com, .ai, .app and .dev."}},"required":["keyword_or_concept"],"type":"object"},"name":"nymrel_find_domain","outputSchema":{"anyOf":[{"additionalProperties":true,"properties":{"suggestions":{"items":{"additionalProperties":true,"properties":{"availability_checked":{"title":"Availability Checked","type":"boolean"},"available":{"title":"Available","type":"boolean"},"brandability_factors":{"additionalProperties":true,"properties":{"contains_digit":{"title":"Contains Digit","type":"boolean"},"contains_hyphen":{"title":"Contains Hyphen","type":"boolean"},"contains_vowel":{"title":"Contains Vowel","type":"boolean"},"label_length":{"title":"Label Length","type":"integer"}},"required":["label_length","contains_digit","contains_hyphen","contains_vowel"],"title":"BrandabilityFactors","type":"object"},"brandability_score":{"maximum":100,"minimum":0,"title":"Brandability Score","type":"number"},"domain":{"title":"Domain","type":"string"}},"required":["domain","available","availability_checked","brandability_score","brandability_factors"],"title":"DomainSuggestion","type":"object"},"title":"Suggestions","type":"array"}},"required":["suggestions"],"title":"DomainResult","type":"object"},{"additionalProperties":true,"properties":{"error":{"additionalProperties":true,"properties":{"code":{"title":"Code","type":"string"},"message":{"title":"Message","type":"string"},"retryable":{"title":"Retryable","type":"boolean"}},"required":["code","message","retryable"],"title":"ErrorDetail","type":"object"},"status":{"const":"error","title":"Status","type":"string"}},"required":["status","error"],"title":"ErrorResult","type":"object"}],"type":"object"},"securitySchemes":[{"type":"noauth"}],"title":"Find domain names"}
