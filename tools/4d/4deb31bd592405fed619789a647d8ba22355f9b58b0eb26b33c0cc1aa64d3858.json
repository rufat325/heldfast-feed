{
 "description": "Import CSV to Google Sheets with column mapping and optional deduplication. Streams data for large files.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "deduplicateBy": {
    "description": "Sheet columns for deduplication (names or indices)",
    "items": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      }
     ]
    },
    "type": "array"
   },
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "headerMap": {
    "description": "Column mappings from CSV to sheet",
    "items": {
     "properties": {
      "source": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        }
       ],
       "description": "CSV column: header name (string) or 0-based index (number)"
      },
      "target": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        }
       ],
       "description": "Sheet column: header name (string) or 0-based index (number)"
      }
     },
     "required": [
      "source",
      "target"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "sourceHasHeaders": {
    "default": true,
    "description": "Source has header row for column name mapping. Set to false for data-only sources (numeric indices required).",
    "type": "boolean"
   },
   "sourceUri": {
    "description": "CSV file URI (file://, http://, https://)",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "gid",
   "sourceUri",
   "headerMap"
  ],
  "type": "object"
 },
 "name": "rows-csv-append",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "gid": {
        "description": "Sheet ID (from URL gid={gid})",
        "type": "string"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "rowsSkipped": {
        "description": "Number of duplicate rows skipped",
        "type": "number"
       },
       "sheetTitle": {
        "description": "Sheet tab name",
        "type": "string"
       },
       "sheetUrl": {
        "description": "URL to view the sheet",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       },
       "updatedRows": {
        "description": "Number of rows appended",
        "type": "number"
       }
      },
      "required": [
       "type",
       "id",
       "gid",
       "sheetTitle",
       "updatedRows"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
