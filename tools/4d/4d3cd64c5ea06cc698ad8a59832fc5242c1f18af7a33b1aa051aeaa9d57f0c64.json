{
 "description": "Send an email message through Gmail",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "bcc": {
    "description": "BCC recipients (hidden copy). For multiple recipients, use comma-separated: \"alice@example.com, bob@example.com\" (optional)",
    "minLength": 1,
    "type": "string"
   },
   "body": {
    "description": "Email body content (plain text or HTML)",
    "minLength": 1,
    "type": "string"
   },
   "cc": {
    "description": "CC recipients. For multiple recipients, use comma-separated: \"alice@example.com, bob@example.com\" (optional)",
    "minLength": 1,
    "type": "string"
   },
   "contentType": {
    "default": "text",
    "description": "Format of the body content",
    "enum": [
     "text",
     "html"
    ],
    "type": "string"
   },
   "subject": {
    "default": "",
    "description": "Message subject",
    "type": "string"
   },
   "to": {
    "description": "Recipient email address(es). For multiple recipients, use comma-separated: \"alice@example.com, bob@example.com\"",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "to",
   "body"
  ],
  "type": "object"
 },
 "name": "message-send",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "item": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "description": "Unique ID of the sent message",
          "type": "string"
         },
         "recipientCount": {
          "description": "Total number of recipients (to + cc + bcc)",
          "type": "number"
         },
         "sentAt": {
          "description": "When the message was sent (ISO datetime)",
          "type": "string"
         },
         "size": {
          "description": "Message size in bytes",
          "type": "number"
         },
         "threadId": {
          "description": "Thread/conversation ID if applicable",
          "type": "string"
         },
         "webLink": {
          "description": "Link to view the sent message in Gmail",
          "type": "string"
         }
        },
        "required": [
         "id",
         "sentAt",
         "recipientCount"
        ],
        "type": "object"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "item"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
