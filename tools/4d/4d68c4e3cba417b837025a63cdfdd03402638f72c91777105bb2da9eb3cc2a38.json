{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Free. Calculate simple-APR returns after supplied fees and loss scenarios. Inputs are assumptions, not live quotes or recommendations.","inputSchema":{"$defs":{"DefiReviewRequest":{"properties":{"apr_percent":{"anyOf":[{"maximum":100000.0,"minimum":0.0,"type":"number"},{"pattern":"^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,19}0*$)\\d{0,12}\\.\\d{0,6}0*$)","type":"string"}],"title":"Apr Percent"},"days":{"maximum":3650,"minimum":1,"title":"Days","type":"integer"},"entry_exit_fees_usd":{"anyOf":[{"minimum":0.0,"type":"number"},{"pattern":"^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,19}0*$)\\d{0,12}\\.\\d{0,6}0*$)","type":"string"}],"title":"Entry Exit Fees Usd"},"principal_loss_percent":{"anyOf":[{"maximum":100.0,"minimum":0.0,"type":"number"},{"pattern":"^(?!^[-+.]*$)[+-]?0*(?:\\d{0,3}|(?=[\\d.]{1,10}0*$)\\d{0,3}\\.\\d{0,6}0*$)","type":"string"}],"default":0,"title":"Principal Loss Percent"},"principal_usd":{"anyOf":[{"exclusiveMinimum":0.0,"maximum":1000000000.0,"type":"number"},{"pattern":"^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,19}0*$)\\d{0,12}\\.\\d{0,6}0*$)","type":"string"}],"title":"Principal Usd"},"reward_price_drop_percent":{"anyOf":[{"maximum":100.0,"minimum":0.0,"type":"number"},{"pattern":"^(?!^[-+.]*$)[+-]?0*(?:\\d{0,3}|(?=[\\d.]{1,10}0*$)\\d{0,3}\\.\\d{0,6}0*$)","type":"string"}],"default":0,"title":"Reward Price Drop Percent"}},"required":["principal_usd","apr_percent","days","entry_exit_fees_usd"],"title":"DefiReviewRequest","type":"object"}},"properties":{"request":{"$ref":"#/$defs/DefiReviewRequest"}},"required":["request"],"title":"defi_scenario_reviewArguments","type":"object"},"name":"defi_scenario_review"}
