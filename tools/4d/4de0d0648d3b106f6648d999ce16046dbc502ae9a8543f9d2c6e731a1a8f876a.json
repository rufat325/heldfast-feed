{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Ask both Creditcoin networks (CC3 Testnet and Creditcoin Mainnet) what header hashes their attestors signed for recent Ethereum blocks, then check each three ways: against independent Ethereum endpoints, against that network's own ChainInfo digest index, and against the other network. A MISMATCH would mean attestors signed a block Ethereum does not have; NOT ON CHAIN would mean the indexer published an attestation the chain does not hold.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "audit_attestors",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "crossNetwork": {
    "additionalProperties": false,
    "properties": {
     "attestorKeys": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "mainnet": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "shared": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "testnet": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         }
        },
        "required": [
         "testnet",
         "mainnet",
         "shared"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "compared": {
      "type": "boolean"
     },
     "height": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "The Ethereum block both networks were compared at"
     },
     "identicalDigest": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "compared",
     "height",
     "identicalDigest",
     "attestorKeys",
     "note"
    ],
    "type": "object"
   },
   "networks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "attestationsIndexed": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "attestedTo": {
       "description": "Highest Ethereum block attested",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "blocks": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "digest": {
          "enum": [
           "on chain",
           "wrong height",
           "not on chain"
          ],
          "type": "string"
         },
         "ethereumAgree": {
          "description": "Of those, how many returned this hash",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "ethereumAnswered": {
          "description": "Endpoints that returned the block",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "headerHash": {
          "type": "string"
         },
         "height": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         }
        },
        "required": [
         "height",
         "headerHash",
         "ethereumAnswered",
         "ethereumAgree",
         "digest"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "chainKey": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "checkpoint": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "Last checkpointed Ethereum block; null if none yet"
      },
      "network": {
       "type": "string"
      }
     },
     "required": [
      "network",
      "chainKey",
      "attestationsIndexed",
      "attestedTo",
      "checkpoint",
      "blocks"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "networks",
   "crossNetwork"
  ],
  "type": "object"
 },
 "title": "Audit Creditcoin's attestors"
}
