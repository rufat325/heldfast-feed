{
 "description": "List contacts from Teamleader Focus with optional filtering and pagination",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "description": "Page number (default: 1)",
    "type": "number"
   },
   "page_size": {
    "description": "Page size (default: 20, max: 100)",
    "type": "number"
   },
   "tags": {
    "description": "Filter by tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "term": {
    "description": "Search term to filter contacts",
    "type": "string"
   },
   "updated_since": {
    "description": "ISO 8601 date - only contacts updated after this date",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "teamleader_list_contacts"
}
