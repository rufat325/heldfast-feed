{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Add one line to a generated estimate. `unit` must be a display code of the estimate's own measurement system \u2014 read an existing line to see which codes it uses rather than guessing. Totals are recomputed by the server.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "maxLength": 100,
    "type": "string"
   },
   "estimate_id": {
    "type": "string"
   },
   "name": {
    "maxLength": 255,
    "type": "string"
   },
   "quantity": {
    "minimum": 0,
    "type": "number"
   },
   "section": {
    "enum": [
     "materials",
     "labor"
    ],
    "type": "string"
   },
   "unit": {
    "maxLength": 20,
    "type": "string"
   },
   "unit_price": {
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "estimate_id",
   "section",
   "name",
   "quantity",
   "unit_price"
  ],
  "type": "object"
 },
 "name": "add_estimate_line",
 "title": "Add a line to an estimate"
}
