{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a case"
 },
 "description": "WRITE: open a new case (conversation) for a requester. channel MAIL sends the first message to the customer by email from the mailbox given as channel_id; channel NOTE creates it with an internal note and emails nobody. Get channel ids from kayako_list_channels and status/priority/type ids from kayako_list_case_options. Kayako: POST /api/v1/cases.json.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assigned_agent_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "assigned_team_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "cc": {
    "description": "MAIL only: CC addresses.",
    "items": {
     "format": "email",
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "channel": {
    "description": "MAIL, TWITTER, FACEBOOK or NOTE (internal, not sent).",
    "enum": [
     "MAIL",
     "TWITTER",
     "FACEBOOK",
     "NOTE"
    ],
    "type": "string"
   },
   "channel_id": {
    "description": "Channel account id (e.g. the mailbox id). Required unless channel is NOTE.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "contents": {
    "description": "Body of the first post.",
    "minLength": 1,
    "type": "string"
   },
   "field_values": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Custom field values keyed by field key, e.g. {\"order_number\": \"1234\"}. For multi-select fields pass CSV options \u2014 ALL options must be passed; omitted ones are removed.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "form_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "html": {
    "description": "MAIL/NOTE: treat contents as HTML (sanitized by Kayako).",
    "type": "boolean"
   },
   "priority_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "requester_id": {
    "description": "The requester (customer user) id (integer).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "status_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "subject": {
    "description": "Case subject.",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "description": "Comma-separated tags.",
    "maxLength": 500,
    "type": "string"
   },
   "type_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "subject",
   "contents",
   "requester_id",
   "channel"
  ],
  "type": "object"
 },
 "name": "kayako_create_case",
 "title": "Create a case"
}
