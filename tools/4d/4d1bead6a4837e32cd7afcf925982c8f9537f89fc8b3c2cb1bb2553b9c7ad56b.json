{
 "description": "List recorded API operation interactions. Requires testId and/or operationId. Defaults to REAL interactions; limit is capped at 100.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "interactionType": {
    "default": "REAL",
    "enum": [
     "REAL",
     "MOCKED"
    ],
    "type": "string"
   },
   "limit": {
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "operationId": {
    "minLength": 1,
    "type": "string"
   },
   "testId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list-api-operation-interactions"
}
