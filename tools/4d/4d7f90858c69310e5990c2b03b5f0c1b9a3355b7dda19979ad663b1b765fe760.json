{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "UCP: \u00e9\u00e9n product in detail"
 },
 "description": "E\u00e9n product (sp-p-<id> / sp-v-<id>) in UCP-vorm met kortingscode, partnerlink en permalink; bij een onbekend id een JSON-RPC-fout.",
 "inputSchema": {
  "properties": {
   "catalog": {
    "properties": {
     "attribution": {
      "additionalProperties": {
       "type": "string"
      },
      "description": "vrije string-map (utm_source, gclid, \u2026), wordt gelogd",
      "type": "object"
     },
     "context": {
      "description": "address_country (NL/BE/DE/FR/ES) of language kiest de markt; anders de markt van de site.",
      "properties": {
       "address_country": {
        "type": "string"
       },
       "currency": {
        "type": "string"
       },
       "language": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "id": {
      "type": "string"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   },
   "markt": {
    "default": "nl",
    "description": "Markt/land voor prijzen, links en codes (standaard nl).",
    "enum": [
     "nl",
     "be",
     "de",
     "fr",
     "es"
    ],
    "type": "string"
   },
   "meta": {
    "description": "meta[\"ucp-agent\"].profile = URL van het UCP-profiel van het platform (spec: verplicht; wij loggen het en weigeren niet).",
    "properties": {
     "ucp-agent": {
      "properties": {
       "profile": {
        "format": "uri",
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "catalog"
  ],
  "type": "object"
 },
 "name": "get_product",
 "outputSchema": {
  "description": "UCP get_product-antwoord, zie https://ucp.dev/2026-08-25/schemas/shopping/catalog_lookup.json#/$defs/get_product_response",
  "properties": {
   "messages": {
    "type": "array"
   },
   "options": {
    "type": "array"
   },
   "policies": {
    "type": "array"
   },
   "product": {
    "type": "object"
   },
   "selected": {
    "type": "array"
   },
   "ucp": {
    "type": "object"
   }
  },
  "required": [
   "ucp",
   "product"
  ],
  "type": "object"
 },
 "title": "UCP: \u00e9\u00e9n product in detail"
}
