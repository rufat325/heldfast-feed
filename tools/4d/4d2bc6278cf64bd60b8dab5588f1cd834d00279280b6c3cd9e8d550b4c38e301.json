{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Ask for a price on something custom. Creates a quote_request item.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contact": {
    "properties": {
     "email": {
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     "locale": {
      "maxLength": 12,
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "type": "string"
     },
     "phone": {
      "maxLength": 40,
      "type": "string"
     }
    },
    "type": "object"
   },
   "idempotency_key": {
    "description": "Same key + same request = same answer. Required for agents.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "key": {
    "description": "The person's key (sdkey1_\u2026), if that is all you have: it is exchanged once for a pass, which comes back in identity.passes \u2014 keep the pass and send it next time instead. Never stored.",
    "maxLength": 200,
    "type": "string"
   },
   "message": {
    "maxLength": 20000,
    "type": "string"
   },
   "pass": {
    "description": "The person's passes (sdpass1_\u2026), space-separated, at most 8: presented to the network that issued each, so the business recognises the customer. Or send them in the Sdi-Pass header. Never stored.",
    "maxLength": 1608,
    "type": "string"
   },
   "payload": {
    "properties": {
     "budget": {
      "properties": {
       "currency": {
        "maxLength": 3,
        "minLength": 3,
        "type": "string"
       },
       "value": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "value",
       "currency"
      ],
      "type": "object"
     },
     "deliveryAddress": {
      "properties": {
       "addressCountry": {
        "maxLength": 2,
        "minLength": 2,
        "type": "string"
       },
       "addressLocality": {
        "maxLength": 100,
        "type": "string"
       },
       "addressRegion": {
        "maxLength": 100,
        "type": "string"
       },
       "postalCode": {
        "maxLength": 20,
        "type": "string"
       },
       "streetAddress": {
        "maxLength": 200,
        "type": "string"
       }
      },
      "type": "object"
     },
     "description": {
      "maxLength": 5000,
      "minLength": 1,
      "type": "string"
     },
     "itemOffered": {
      "properties": {
       "name": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "productId": {
        "type": "string"
       },
       "serviceId": {
        "type": "string"
       },
       "sku": {
        "maxLength": 100,
        "type": "string"
       }
      },
      "required": [
       "name"
      ],
      "type": "object"
     },
     "quantity": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     },
     "requestedFor": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     }
    },
    "required": [
     "itemOffered",
     "description"
    ],
    "type": "object"
   }
  },
  "required": [
   "payload"
  ],
  "type": "object"
 },
 "name": "request_quote",
 "title": "Request a quote"
}
