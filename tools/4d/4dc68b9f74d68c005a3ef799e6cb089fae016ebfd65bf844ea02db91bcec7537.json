  "readOnlyHint": true,
  "title": "Get a Pok\u00e9mon card price and recent sales"
 },
 "description": "Use this when the user asks what a specific Pok\u00e9mon card is worth or has sold for, raw or graded (PSA 9 or PSA 10 slabs), or wants its sold comps or price trend. One card as its pokefocus.com page shows it: TCGplayer market price with 7- and 30-day change, 30-day range, and the overbought/oversold reading; for raw, PSA 9, and PSA 10 the 30-day eBay sold median and sale count and the lowest trusted eBay Buy It Now; the offers for the requested grade cheapest first with links; the PSA 10 premium over raw; the active listing count; and the verified recent eBay sales for one grade, newest first.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "64x64"
   ],
   "src": "https://pokefocus.com/static/pokefocus-icon-64.png"
  },
  {
   "mimeType": "image/png",
   "sizes": [
    "192x192"
   ],
   "src": "https://pokefocus.com/static/android-chrome-192x192.png"
  },
  {
   "mimeType": "image/png",
   "sizes": [
    "512x512"
   ],
   "src": "https://pokefocus.com/static/android-chrome-512x512.png"
  }
 ],
