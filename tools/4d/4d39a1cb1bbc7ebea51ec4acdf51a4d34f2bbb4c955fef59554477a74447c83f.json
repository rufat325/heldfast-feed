{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Full analysis of an example song: Song DNA, beat grid and sections, best moments, lyrics, scores, story and shot plan. No API key needed. Summary view by default (no per-word timings or beat arrays); set view='full' for everything.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "example_id": {
    "description": "id from list_example_songs",
    "type": "string"
   },
   "sections": {
    "description": "Only these sections (default: all)",
    "items": {
     "enum": [
      "song_dna",
      "timeline",
      "best_moments",
      "lyrics",
      "scores",
      "story",
      "shot_plan"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "view": {
    "default": "summary",
    "enum": [
     "summary",
     "full"
    ],
    "type": "string"
   }
  },
  "required": [
   "example_id"
  ],
  "type": "object"
 },
 "name": "get_example_analysis",
 "title": "Get an example analysis"
}
