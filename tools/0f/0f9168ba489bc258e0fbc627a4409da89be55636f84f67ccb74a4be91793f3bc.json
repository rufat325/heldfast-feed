{"description":"List tasks from Runrun.it. Optional filters: ids, user_id, follower_id, responsible_id, assignee_id, filter_id, board_stage_id, project_id, is_closed, is_working_on, sort, sort_dir, page, limit.","inputSchema":{"properties":{"assignee_id":{"description":"Assignee/executor principal user ID","type":"string"},"board_stage_id":{"description":"Filter by board stage (e.g. Ongoing)","type":"number"},"filter_id":{"description":"ID of a task filter (e.g. 'Minhas partes abertas')","type":"number"},"follower_id":{"description":"Follower user ID","type":"string"},"ids":{"description":"Comma-separated task IDs","type":"string"},"is_closed":{"description":"Filter by delivered tasks","type":"boolean"},"is_working_on":{"description":"Filter by in progress","type":"boolean"},"limit":{"description":"Items per page (1-100)","type":"number"},"page":{"description":"Page number (default 1)","type":"number"},"project_id":{"description":"Project ID","type":"number"},"responsible_id":{"description":"Responsible/assignee user ID (e.g. for 'Minhas partes abertas')","type":"string"},"sort":{"description":"Sort field (e.g. close_date, queue_position)","type":"string"},"sort_dir":{"description":"Sort direction","enum":["asc","desc"],"type":"string"},"user_id":{"description":"Creator user ID","type":"string"}},"required":[],"type":"object"},"name":"runrunit_list_tasks"}
