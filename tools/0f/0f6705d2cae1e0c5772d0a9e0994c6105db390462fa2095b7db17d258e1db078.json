{"description":"TRACE v0.2 conformance checks on one Trust Record, stateless, no account: schema (vendored trace-claim.json), profile, subject URI, software-only runtime rule, policy digest, public-only confirmation key, the embedded signature (EdDSA, ES256 or ES384 with the key in cnf.jwk), appraisal, delegation link shape and references. Nothing is fetched: resolvers are checked as URIs only. `record_sha256` is the RFC 8785 digest of the complete record, signature included \u2014 the value a child hop puts in delegation.parent_record_hash.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"record":{"anyOf":[{"maxLength":1048576,"type":"string"},{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"}],"description":"A TRACE v0.2 Trust Record: the file contents as a string, or the parsed object."}},"required":["record"],"type":"object"},"name":"verify_trace_record","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"checks":{"items":{"additionalProperties":false,"properties":{"detail":{"type":"string"},"name":{"enum":["parse","schema","profile","subject","runtime","policy","cnf_key","signature","appraisal","delegation","references","canonicalization"],"type":"string"},"outcome":{"enum":["ok","fail","unverifiable","skipped"],"type":"string"}},"required":["name","outcome","detail"],"type":"object"},"type":"array"},"failing_check":{"anyOf":[{"enum":["parse","schema","profile","subject","runtime","policy","cnf_key","signature","appraisal","delegation","references","canonicalization"],"type":"string"},{"type":"null"}]},"note":{"type":["string","null"]},"record_sha256":{"type":"string"},"summary":{"anyOf":[{"additionalProperties":false,"properties":{"data_class":{"type":"string"},"eat_profile":{"type":"string"},"has_delegation":{"type":"boolean"},"iat":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"key_thumbprint":{"type":"string"},"model_id":{"type":"string"},"provider":{"type":"string"},"references":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"subject":{"type":"string"},"tool_calls":{"anyOf":[{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},{"type":"null"}]}},"required":["subject","eat_profile","iat","model_id","provider","data_class","key_thumbprint","has_delegation","references","tool_calls"],"type":"object"},{"type":"null"}]},"verdict":{"enum":["valid","invalid","unverifiable"],"type":"string"}},"required":["verdict","failing_check","record_sha256","checks","summary","note"],"type":"object"},"title":"Verify a TRACE Trust Record"}
