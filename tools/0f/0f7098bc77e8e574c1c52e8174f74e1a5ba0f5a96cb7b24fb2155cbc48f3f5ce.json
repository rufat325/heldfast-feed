{
 "description": "Channel management. Actions: \"create\", \"list\", \"join\", \"leave\", \"archive\", \"update\", \"members\", \"history\".",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action to perform (see enum for options)",
    "enum": [
     "create",
     "list",
     "join",
     "leave",
     "archive",
     "update",
     "members",
     "history"
    ],
    "type": "string"
   },
   "channel": {
    "description": "Channel name (required for all actions except \"list\")",
    "type": "string"
   },
   "description": {
    "description": "[create/update] Channel description",
    "type": "string"
   },
   "include_archived": {
    "description": "[list] Include archived channels",
    "type": "boolean"
   },
   "limit": {
    "description": "[history] Max messages (default: 50, max: 500)",
    "type": "number"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "comm_channel"
}
