{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants to check whether people talk about a topic or an angle in public, such as \"is there discussion about personalised dog food?\". Pass one to five short phrases. Searches Hacker News and, if stack_site is given, one Stack Exchange site, for posts in the last year (or since_days). Returns per phrase the number of matching posts, the top three with title, link, score and comment count, and a plain signal. It is a weak signal skewed to technical and hobby topics, not a market size, and it does not search Reddit.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "queries": {
    "description": "One to 5 short phrases to look for in public discussion, such as \"personalised dog food\" or \"dog food for sensitive stomach\"",
    "items": {
     "maxLength": 80,
     "minLength": 3,
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "since_days": {
    "description": "Only posts from the last this many days (default 365)",
    "maximum": 1825,
    "minimum": 30,
    "type": "integer"
   },
   "stack_site": {
    "description": "A Stack Exchange site such as pets, diy or cooking, to search there as well. Without it only Hacker News is searched.",
    "pattern": "^[a-z0-9.]{2,40}$",
    "type": "string"
   }
  },
  "required": [
   "queries"
  ],
  "type": "object"
 },
 "name": "validate_angle_gaps",
 "outputSchema": {
  "properties": {
   "as_of": {
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "results": {
    "items": {
     "properties": {
      "query": {
       "type": "string"
      },
      "signal": {
       "enum": [
        "discussed",
        "some_discussion",
        "little_discussion",
        "unknown"
       ],
       "type": "string"
      },
      "sources": {
       "items": {
        "properties": {
         "matches": {
          "description": "Posts found in the window; for Stack Exchange only the posts returned, with more_available set when there were more",
          "type": [
           "integer",
           "null"
          ]
         },
         "more_available": {
          "type": "boolean"
         },
         "name": {
          "type": "string"
         },
         "posts": {
          "description": "The most relevant posts, at most 3",
          "items": {
           "properties": {
            "comments": {
             "type": "integer"
            },
            "date": {
             "type": [
              "string",
              "null"
             ]
            },
            "score": {
             "type": "integer"
            },
            "title": {
             "type": "string"
            },
            "url": {
             "type": "string"
            }
           },
           "required": [
            "title",
            "url",
            "score",
            "comments"
           ],
           "type": "object"
          },
          "type": "array"
         },
         "source": {
          "enum": [
           "hacker_news",
           "stack_exchange"
          ],
          "type": "string"
         },
         "status": {
          "enum": [
           "ok",
           "unavailable"
          ],
          "type": "string"
         }
        },
        "required": [
         "source",
         "name",
         "status",
         "matches",
         "more_available",
         "posts"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "query",
      "signal",
      "sources"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "window_days": {
    "type": "integer"
   }
  },
  "required": [
   "as_of",
   "window_days",
   "results",
   "notice"
  ],
  "type": "object"
 },
 "title": "Check gaps in public discussion"
}
