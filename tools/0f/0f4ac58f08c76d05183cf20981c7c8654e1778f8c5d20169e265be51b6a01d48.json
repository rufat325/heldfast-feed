{
 "description": "Create a bill (AP / money owed to a vendor). VendorRef and at least one Line (AccountBasedExpenseLineDetail or ItemBasedExpenseLineDetail) are required.",
 "inputSchema": {
  "properties": {
   "CurrencyRef": {
    "properties": {
     "value": {
      "description": "ISO-4217",
      "type": "string"
     }
    },
    "type": "object"
   },
   "DueDate": {
    "description": "Due date (YYYY-MM-DD)",
    "type": "string"
   },
   "Line": {
    "description": "Bill line items",
    "items": {
     "properties": {
      "AccountBasedExpenseLineDetail": {
       "properties": {
        "AccountRef": {
         "properties": {
          "value": {
           "description": "Expense Account.Id",
           "type": "string"
          }
         },
         "type": "object"
        }
       },
       "type": "object"
      },
      "Amount": {
       "type": "number"
      },
      "Description": {
       "type": "string"
      },
      "DetailType": {
       "description": "'AccountBasedExpenseLineDetail' or 'ItemBasedExpenseLineDetail'",
       "type": "string"
      },
      "ItemBasedExpenseLineDetail": {
       "properties": {
        "ItemRef": {
         "properties": {
          "value": {
           "description": "Item.Id",
           "type": "string"
          }
         },
         "type": "object"
        },
        "Qty": {
         "type": "number"
        },
        "UnitPrice": {
         "type": "number"
        }
       },
       "type": "object"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "PrivateNote": {
    "type": "string"
   },
   "TxnDate": {
    "description": "Bill date (YYYY-MM-DD)",
    "type": "string"
   },
   "VendorRef": {
    "properties": {
     "value": {
      "description": "Vendor.Id",
      "type": "string"
     }
    },
    "required": [
     "value"
    ],
    "type": "object"
   }
  },
  "required": [
   "VendorRef",
   "Line"
  ],
  "type": "object"
 },
 "name": "create_bill"
}
