{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Durably save goal, completed work, decisions, constraints, next actions, blockers and artifact references before a context reset or handoff. Full replacement; expected_version=0 creates a task. Reuse request_id only for identical retries. Requires an agent key; never stores credentials or calls an AI model.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "expected_version": {
    "maximum": 2147483646,
    "minimum": 0,
    "type": "integer"
   },
   "request_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "state": {
    "additionalProperties": false,
    "properties": {
     "artifacts": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "description": {
         "maxLength": 500,
         "type": "string"
        },
        "uri": {
         "maxLength": 2000,
         "type": "string"
        }
       },
       "required": [
        "uri",
        "description"
       ],
       "type": "object"
      },
      "maxItems": 30,
      "type": "array"
     },
     "blockers": {
      "default": [],
      "items": {
       "maxLength": 1200,
       "type": "string"
      },
      "maxItems": 40,
      "type": "array"
     },
     "completed": {
      "default": [],
      "items": {
       "maxLength": 1200,
       "type": "string"
      },
      "maxItems": 40,
      "type": "array"
     },
     "constraints": {
      "default": [],
      "items": {
       "maxLength": 1200,
       "type": "string"
      },
      "maxItems": 40,
      "type": "array"
     },
     "decisions": {
      "default": [],
      "items": {
       "maxLength": 1200,
       "type": "string"
      },
      "maxItems": 40,
      "type": "array"
     },
     "goal": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
     },
     "next_actions": {
      "items": {
       "maxLength": 1200,
       "type": "string"
      },
      "maxItems": 40,
      "type": "array"
     },
     "status": {
      "enum": [
       "working",
       "blocked",
       "done"
      ],
      "type": "string"
     }
    },
    "required": [
     "goal",
     "status",
     "next_actions"
    ],
    "type": "object"
   },
   "task_id": {
    "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "expected_version",
   "request_id",
   "state"
  ],
  "type": "object"
 },
 "name": "threadkeep_checkpoint",
 "title": "Save agent task state"
}
