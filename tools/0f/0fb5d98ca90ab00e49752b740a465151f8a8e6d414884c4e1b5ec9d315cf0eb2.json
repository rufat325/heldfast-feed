{
 "description": "Manage Datadog Notebooks. Actions: list (search notebooks), get (by ID with cells), create (new notebook), update (modify notebook), delete (remove notebook). Use for: runbooks, incident documentation, investigation notes, dashboards as code.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "delete"
    ],
    "type": "string"
   },
   "authorHandle": {
    "description": "Filter by author handle (email)",
    "type": "string"
   },
   "cells": {
    "description": "Notebook cells (for create/update)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {},
      "type": {
       "enum": [
        "markdown",
        "timeseries",
        "toplist",
        "heatmap",
        "distribution",
        "log_stream"
       ],
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "excludeAuthorHandle": {
    "description": "Exclude notebooks by author handle",
    "type": "string"
   },
   "id": {
    "description": "Notebook ID (required for get/update/delete actions)",
    "type": "number"
   },
   "includeCells": {
    "description": "Include cell content in response (default: true for get)",
    "type": "boolean"
   },
   "name": {
    "description": "Notebook name (for create/update)",
    "type": "string"
   },
   "pageNumber": {
    "description": "Page number for pagination",
    "type": "number"
   },
   "pageSize": {
    "description": "Number of notebooks to return",
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Search query for notebooks",
    "type": "string"
   },
   "status": {
    "description": "Notebook status",
    "enum": [
     "published"
    ],
    "type": "string"
   },
   "time": {
    "additionalProperties": false,
    "description": "Time configuration for notebook",
    "properties": {
     "end": {
      "type": "number"
     },
     "liveSpan": {
      "type": "string"
     },
     "start": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "notebooks"
}
