{
 "description": "One call: character PNG -> fully rigged .riv with cutout parts (ears/tail via polygons), 2-bone head-tilt mesh (seamless), vector eyelid blink, idle + happy animations, and a state machine with a 'happy' trigger. Returns a preview. Fine-tune afterwards with riv_edit or riv_studio.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "artboardHeight": {
    "type": "number"
   },
   "artboardWidth": {
    "type": "number"
   },
   "backgroundColor": {
    "type": "string"
   },
   "eyes": {
    "description": "Eye rects in image px coords (generates blink overlays)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "height": {
       "type": "number"
      },
      "width": {
       "type": "number"
      },
      "x": {
       "type": "number"
      },
      "y": {
       "type": "number"
      }
     },
     "required": [
      "x",
      "y",
      "width",
      "height"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "furColor": {
    "description": "Eyelid/patch color matching the fur (default #f8eee2)",
    "type": "string"
   },
   "headRatio": {
    "description": "Top fraction of the image that is 'head' (default 0.45)",
    "type": "number"
   },
   "outPath": {
    "description": "Output .riv path",
    "type": "string"
   },
   "parts": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "behindBody": {
       "description": "Draw behind the body (e.g. tail)",
       "type": "boolean"
      },
      "pivot": {
       "description": "Attachment point (default: bottom-center of bbox)",
       "items": {
        "type": "number"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      "polygon": {
       "description": "Region in image px coords",
       "items": {
        "items": {
         "type": "number"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
       },
       "minItems": 3,
       "type": "array"
      }
     },
     "required": [
      "polygon"
     ],
     "type": "object"
    },
    "description": "Named cutout parts, e.g. {earL, earR, tail}. Names containing 'ear' attach to the head",
    "type": "object"
   },
   "pngPath": {
    "description": "Character PNG (transparent background recommended)",
    "type": "string"
   }
  },
  "required": [
   "pngPath",
   "outPath"
  ],
  "type": "object"
 },
 "name": "riv_rig_character",
 "title": "Auto-rig a character PNG"
}
