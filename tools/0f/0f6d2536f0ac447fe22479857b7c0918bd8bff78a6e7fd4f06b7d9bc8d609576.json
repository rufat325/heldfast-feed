{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Dry run: fetch text, chunk semantically, score OCR quality. No writes. Full-text sources only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "minLength": 1,
    "type": "string"
   },
   "source": {
    "description": "Library source name. Run library_list_sources for the current list and descriptions.",
    "type": "string"
   }
  },
  "required": [
   "id",
   "source"
  ],
  "type": "object"
 },
 "name": "library_index",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "avgQualityScore": {
    "type": "number"
   },
   "droppedChunks": {
    "type": "number"
   },
   "estimatedTokens": {
    "type": "number"
   },
   "ingestPolicy": {
    "enum": [
     "allowed",
     "attribution",
     "timeboxed",
     "forbidden"
    ],
    "type": "string"
   },
   "sampleChunks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "embedText": {
       "type": "string"
      },
      "metadata": {
       "additionalProperties": false,
       "properties": {
        "attribution": {
         "type": "string"
        },
        "authors": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "chunkIndex": {
         "type": "number"
        },
        "cluster": {
         "type": "string"
        },
        "expiresAt": {
         "type": "string"
        },
        "language": {
         "type": "string"
        },
        "license": {
         "type": "string"
        },
        "qualityScore": {
         "type": "number"
        },
        "section": {
         "type": "string"
        },
        "source": {
         "type": "string"
        },
        "sourceId": {
         "type": "string"
        },
        "title": {
         "type": "string"
        },
        "totalChunks": {
         "type": "number"
        },
        "url": {
         "type": "string"
        },
        "year": {
         "type": "number"
        }
       },
       "required": [
        "source",
        "sourceId",
        "title",
        "authors",
        "chunkIndex",
        "totalChunks",
        "qualityScore"
       ],
       "type": "object"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "text",
      "metadata"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "type": "string"
   },
   "sourceId": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "totalChunks": {
    "type": "number"
   }
  },
  "required": [
   "sourceId",
   "source",
   "title",
   "totalChunks",
   "droppedChunks",
   "avgQualityScore",
   "sampleChunks",
   "estimatedTokens"
  ],
  "type": "object"
 },
 "title": "Preview Chunking (Dry Run)"
}
