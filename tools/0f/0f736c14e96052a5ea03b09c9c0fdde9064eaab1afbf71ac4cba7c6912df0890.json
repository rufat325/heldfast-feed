{
 "description": "Create a shape in Google Slides",
 "inputSchema": {
  "properties": {
   "account": {
    "description": "Alias of the Google account to target. Optional \u2014 defaults to the session/global default account, or the sole authenticated account. Run manage_accounts list to see available aliases.",
    "type": "string"
   },
   "backgroundColor": {
    "description": "Fill color (RGBA values 0-1)",
    "properties": {
     "alpha": {
      "type": "number"
     },
     "blue": {
      "type": "number"
     },
     "green": {
      "type": "number"
     },
     "red": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "height": {
    "description": "Height in EMU",
    "type": "number"
   },
   "pageObjectId": {
    "description": "Slide ID",
    "type": "string"
   },
   "presentationId": {
    "description": "Presentation ID",
    "type": "string"
   },
   "shapeType": {
    "description": "Shape type",
    "enum": [
     "RECTANGLE",
     "ELLIPSE",
     "DIAMOND",
     "TRIANGLE",
     "STAR",
     "ROUND_RECTANGLE",
     "ARROW"
    ],
    "type": "string"
   },
   "width": {
    "description": "Width in EMU",
    "type": "number"
   },
   "x": {
    "description": "X position in EMU",
    "type": "number"
   },
   "y": {
    "description": "Y position in EMU",
    "type": "number"
   }
  },
  "required": [
   "presentationId",
   "pageObjectId",
   "shapeType",
   "x",
   "y",
   "width",
   "height"
  ],
  "type": "object"
 },
 "name": "createGoogleSlidesShape"
}
