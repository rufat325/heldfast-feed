{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false,
  "title": "Relay Forwarded Meta-Transaction"
 },
 "description": "Relays a Biconomy forwarded meta-transaction (ERC-20 gas payment). Requires a complete ERC20ForwardRequest and domain separator signature. Returns: relay transaction data.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "configId": {
    "description": "Boson/Fermion Protocol deployment identifier. Format: '<env>-<chainId>-<index>' e.g. 'production-137-0' (Polygon mainnet), 'testing-80002-0' (Amoy testnet). Call get_config_ids to list all valid values for this server.",
    "type": "string"
   },
   "contractAddress": {
    "description": "Valid Ethereum address (e.g. '0xAbCd...' or '0xabcd...'). Mixed-case addresses are checksum-validated; all-lowercase and all-uppercase addresses are also accepted.",
    "type": "string"
   },
   "domainSeparator": {
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "request": {
    "additionalProperties": false,
    "properties": {
     "batchId": {
      "anyOf": [
       {
        "minLength": 1,
        "type": "string"
       },
       {
        "minimum": 0,
        "type": "number"
       }
      ]
     },
     "batchNonce": {
      "anyOf": [
       {
        "minLength": 1,
        "type": "string"
       },
       {
        "minimum": 0,
        "type": "number"
       }
      ]
     },
     "data": {
      "minLength": 1,
      "pattern": "^0x[a-fA-F0-9]+$",
      "type": "string"
     },
     "deadline": {
      "minimum": 0,
      "type": "number"
     },
     "from": {
      "$ref": "#/properties/contractAddress"
     },
     "to": {
      "$ref": "#/properties/contractAddress"
     },
     "token": {
      "$ref": "#/properties/contractAddress"
     },
     "tokenGasPrice": {
      "minLength": 1,
      "type": "string"
     },
     "txGas": {
      "anyOf": [
       {
        "minLength": 1,
        "type": "string"
       },
       {
        "minimum": 0,
        "type": "number"
       }
      ]
     }
    },
    "required": [
     "from",
     "to",
     "token",
     "txGas",
     "tokenGasPrice",
     "batchId",
     "batchNonce",
     "deadline",
     "data"
    ],
    "type": "object"
   },
   "signature": {
    "pattern": "^0x[a-fA-F0-9]+$",
    "type": "string"
   },
   "signerAddress": {
    "$ref": "#/properties/contractAddress",
    "description": "Ethereum address that will sign and send this transaction. Must match the wallet that will sign the returned transaction locally."
   }
  },
  "required": [
   "contractAddress",
   "request",
   "domainSeparator",
   "signature",
   "configId",
   "signerAddress"
  ],
  "type": "object"
 },
 "name": "send_forwarded_meta_transaction"
}
