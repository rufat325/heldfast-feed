 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Amount in minor units (cents)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "orderId": {
    "minLength": 1,
    "type": "string"
   },
   "provider": {
    "description": "Payment provider label, e.g. 'manual'",
    "type": "string"
   },
   "reference": {
    "description": "Payment reference / receipt id",
    "type": "string"
   }
  },
  "required": [
   "orderId",
   "amount",
   "reference",
   "provider"
  ],
  "type": "object"
 },
 "name": "mark_order_paid"
}
