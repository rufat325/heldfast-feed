 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cursor": {
    "anyOf": [
     {
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "in_force_on_date": {
    "anyOf": [
     {
      "maxLength": 32,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "ISO date; keeps hits from instruments in force on that date, on the same semantics list_instruments uses."
   },
   "instrument_id": {
    "anyOf": [
     {
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Restrict to one instrument, e.g. \"rts-sca\"."
   },
   "kind": {
    "anyOf": [
     {
      "enum": [
       "article",
       "annex",
       "recital"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Restrict to one source type. Articles, annexes and recitals are all searched by default, ranked in that order of authority."
   },
   "limit": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "query": {
    "description": "EU legislative search terms, e.g. \"strong customer authentication\", \"dynamic linking\", \"safeguarding\" or \"DORA ICT risk\". Use words expected in the legal text, not an entire advice request. Quoted phrases are honoured; AND, OR and NOT are the only operators. A citation-shaped query (\"Article 97(1) PSD2\") is resolved through the citation grammar first.",
    "type": "string"
   },
   "topic": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Keep only provisions carrying this topic."
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
