{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read one shipped reviewed NE Maps case"
 },
 "description": "Returns ONE case by exact id (f1, f2, f3, synthetic-local-core-golden) from the shipped, checksum-pinned examples/ne-maps/data/collection.json: the browser-safe Lens envelope verbatim (all limitations, unavailable/unknown states and nonClaims preserved), its source provenance and an explicit label. f1/f2/f3 are HISTORICAL reviewed exports of past public-network observations; synthetic-local-core-golden is a SYNTHETIC fixture, not a network observation. No case is live evidence.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "caseId": {
    "description": "Exact case id; no paths, no prefixes, no fuzzy matching.",
    "enum": [
     "f1",
     "f2",
     "f3",
     "synthetic-local-core-golden"
    ],
    "type": "string"
   }
  },
  "required": [
   "caseId"
  ],
  "type": "object"
 },
 "name": "get_reviewed_evidence_case",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "caseId": {
    "type": "string"
   },
   "caseProvenance": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "collectionNonClaims": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "currentAvailability": {
    "const": "unknown",
    "type": "string"
   },
   "envelope": {
    "additionalProperties": {},
    "description": "The shipped ne-maps-case/v0.1 envelope, verbatim (browser-safe Lens projection).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "evidenceClass": {
    "enum": [
     "historical-reviewed-public-network-fixture",
     "synthetic-local-fixture"
    ],
    "type": "string"
   },
   "label": {
    "type": "string"
   },
   "liveObservation": {
    "const": false,
    "type": "boolean"
   },
   "schema": {
    "const": "ne-mcp-reviewed-case/v0.1",
    "type": "string"
   },
   "serverNonClaims": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "source": {
    "additionalProperties": false,
    "properties": {
     "collectionSchemaVersion": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "pinnedBy": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "sha256": {
      "type": "string"
     },
     "validatedBy": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "path",
     "sha256",
     "pinnedBy",
     "collectionSchemaVersion",
     "validatedBy"
    ],
    "type": "object"
   }
  },
  "required": [
   "schema",
   "caseId",
   "evidenceClass",
   "label",
   "liveObservation",
   "currentAvailability",
   "source",
   "caseProvenance",
   "collectionNonClaims",
   "serverNonClaims",
   "envelope"
  ],
  "type": "object"
 },
 "title": "Read one shipped reviewed NE Maps case"
}
