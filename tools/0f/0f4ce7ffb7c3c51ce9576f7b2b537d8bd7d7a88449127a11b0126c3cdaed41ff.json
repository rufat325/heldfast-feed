{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set the default sender for an email type"
 },
 "description": "Set the default sender policy for a candidate email type.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "default_sender_type": {
    "enum": [
     "org_shared",
     "owner",
     "job_hiring_manager"
    ],
    "type": "string"
   },
   "email_type": {
    "enum": [
     "acknowledgment",
     "advancement",
     "interview_confirmation",
     "rejection",
     "offer_declined",
     "offer",
     "hired",
     "withdrawn",
     "on_hold",
     "scorecard_nudge",
     "scorecard_escalation",
     "decision_brief",
     "prospect_outreach",
     "candidate_follow_up"
    ],
    "type": "string"
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "org_shared_sender_identity_id": {
    "anyOf": [
     {
      "format": "uuid",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "email_type",
   "default_sender_type"
  ],
  "type": "object"
 },
 "name": "yardstick_email_sender_defaults_set",
 "title": "Set the default sender for an email type"
}
