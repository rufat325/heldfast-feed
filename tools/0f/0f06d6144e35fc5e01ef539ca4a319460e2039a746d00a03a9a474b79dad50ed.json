  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cik_or_name": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "rank_by": {
    "default": "conviction",
    "enum": [
     "conviction",
     "weight"
    ],
    "type": "string"
   },
   "scenario": {
    "default": "all",
    "enum": [
     "all",
     "new_only",
     "double_downs",
     "high_conviction"
    ],
    "type": "string"
   },
   "start_quarter": {
    "pattern": "^\\d{4}-Q[1-4]$",
    "type": "string"
   },
   "top_n": {
    "default": 5,
    "enum": [
     5,
     10,
     20
    ],
    "type": "number"
   }
  },
  "required": [
   "cik_or_name"
  ],
  "type": "object"
 },
