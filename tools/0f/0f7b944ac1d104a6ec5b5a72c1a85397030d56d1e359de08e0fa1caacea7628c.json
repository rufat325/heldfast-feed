{
 "description": "Declare re-identification risk for transformed or synthetic data.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assessedBy": {
    "type": "string"
   },
   "assessmentMethod": {
    "type": "string"
   },
   "mitigationsApplied": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "risk": {
    "enum": [
     "none_declared",
     "low",
     "medium",
     "high",
     "unknown",
     "mitigated"
    ],
    "type": "string"
   }
  },
  "required": [
   "risk",
   "assessedBy"
  ],
  "type": "object"
 },
 "name": "declare_reidentification_risk"
}
