{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update attachment"
 },
 "description": "Update an attachment by ID. Requires attachments:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "description": {
    "description": "Description",
    "type": "string"
   },
   "file_name": {
    "description": "File name",
    "maxLength": 500,
    "type": "string"
   },
   "file_size": {
    "description": "File size in bytes",
    "minimum": 0,
    "type": "number"
   },
   "file_type": {
    "description": "MIME type",
    "maxLength": 200,
    "type": "string"
   },
   "file_url": {
    "description": "File URL / storage path",
    "maxLength": 2000,
    "type": "string"
   },
   "id": {
    "description": "Attachment ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "pm_schedule_id": {
    "description": "PM schedule ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "pm_template_id": {
    "description": "PM template ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "uploaded_by": {
    "description": "Uploader user ID",
    "maxLength": 200,
    "type": "string"
   },
   "work_order_id": {
    "description": "Work order ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "work_request_id": {
    "description": "Work request ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_attachment",
 "title": "Update attachment"
}
