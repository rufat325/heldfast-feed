{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "UCP Catalog lookup by product or variant identifier (gid://kalicart/Product/... or gid://kalicart/ProductVariant/...). Up to 25 ids. Reads price and availability live from each merchant when possible (metadata.kalicart.source = \"live\"), otherwise returns the indexed snapshot and says so. Unknown ids are reported as not_found messages.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "catalog": {
    "additionalProperties": true,
    "properties": {
     "attribution": {
      "additionalProperties": {},
      "type": "object"
     },
     "context": {
      "additionalProperties": true,
      "properties": {
       "address_country": {
        "type": "string"
       },
       "address_region": {
        "type": "string"
       },
       "currency": {
        "type": "string"
       },
       "intent": {
        "type": "string"
       },
       "language": {
        "type": "string"
       },
       "postal_code": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "filters": {
      "additionalProperties": true,
      "properties": {
       "available": {
        "type": "boolean"
       },
       "brand": {
        "type": "string"
       },
       "categories": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "color": {
        "type": "string"
       },
       "gender": {
        "enum": [
         "female",
         "male",
         "unisex"
        ],
        "type": "string"
       },
       "price": {
        "additionalProperties": true,
        "properties": {
         "max": {
          "minimum": 0,
          "type": "integer"
         },
         "min": {
          "minimum": 0,
          "type": "integer"
         }
        },
        "type": "object"
       }
      },
      "type": "object"
     },
     "ids": {
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "signals": {
      "additionalProperties": {},
      "type": "object"
     }
    },
    "required": [
     "ids"
    ],
    "type": "object"
   },
   "meta": {
    "additionalProperties": true,
    "properties": {
     "ucp-agent": {
      "additionalProperties": true,
      "properties": {
       "profile": {
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "catalog"
  ],
  "type": "object"
 },
 "name": "lookup_catalog",
 "title": "Look up products or variants by id (UCP Catalog)"
}
