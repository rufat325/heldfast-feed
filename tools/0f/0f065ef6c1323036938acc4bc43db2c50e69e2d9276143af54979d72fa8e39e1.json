{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Token Swap"
 },
 "description": "Swap tokens using Fibrous aggregator for optimal routing. Handles ERC-20 approvals and wrap/unwrap automatically. Supported chains: Base, HyperEVM, Monad. Set simulate=true for a no-broadcast preview; a gas estimate is returned where it can be calculated safely.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Amount to swap (e.g. '0.1', '100')",
    "type": "string"
   },
   "chain": {
    "default": "base",
    "description": "Target blockchain network",
    "enum": [
     "base",
     "hyperevm",
     "monad"
    ],
    "type": "string"
   },
   "from_token": {
    "description": "Source token symbol (e.g. 'ETH', 'USDC', 'MON')",
    "type": "string"
   },
   "simulate": {
    "description": "Set true for a no-broadcast preview; gas estimates may be unavailable",
    "type": "boolean"
   },
   "slippage": {
    "default": 0.5,
    "description": "Slippage tolerance percentage (0.01-50, default: 0.5)",
    "maximum": 50,
    "minimum": 0.01,
    "type": "number"
   },
   "to_token": {
    "description": "Destination token symbol",
    "type": "string"
   }
  },
  "required": [
   "amount",
   "from_token",
   "to_token"
  ],
  "type": "object"
 },
 "name": "swap_tokens",
 "title": "Swap Tokens via Fibrous"
}
