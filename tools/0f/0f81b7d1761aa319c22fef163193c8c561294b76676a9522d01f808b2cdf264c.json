{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Preview a SkillDB skill"
 },
 "description": "Retrieve metadata and a short public excerpt for one exact public skill ID. The excerpt is limited to 203 characters and may be truncated. Returns public catalog links and preview access status, not complete instructions, account data, or private or paid content.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Exact public skill ID, such as software-skills/code-review.md.",
    "maxLength": 240,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "skilldb_get_preview",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "skill": {
    "additionalProperties": false,
    "properties": {
     "access": {
      "enum": [
       "preview"
      ],
      "type": "string"
     },
     "category": {
      "maxLength": 80,
      "type": "string"
     },
     "contentPreview": {
      "maxLength": 203,
      "type": "string"
     },
     "description": {
      "maxLength": 2000,
      "type": "string"
     },
     "id": {
      "maxLength": 240,
      "type": "string"
     },
     "lines": {
      "minimum": 0,
      "type": "integer"
     },
     "pack": {
      "maxLength": 120,
      "type": "string"
     },
     "packLabel": {
      "maxLength": 200,
      "type": "string"
     },
     "title": {
      "maxLength": 300,
      "type": "string"
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "id",
     "title",
     "description",
     "pack",
     "packLabel",
     "category",
     "lines",
     "url",
     "contentPreview",
     "access"
    ],
    "type": "object"
   }
  },
  "required": [
   "skill"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Preview a SkillDB skill"
}
