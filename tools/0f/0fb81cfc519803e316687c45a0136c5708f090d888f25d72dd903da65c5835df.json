{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Fec Candidate Search"
 },
 "description": "Search federal candidates (President, House, Senate) by name, state, office, or party using FEC data. Returns candidate IDs needed for the other FEC tools.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cycle": {
    "description": "Two-year election cycle (even year, e.g. 2024). Optional.",
    "type": "number"
   },
   "limit": {
    "description": "Maximum candidates to return (default 20, max 100).",
    "type": "number"
   },
   "office": {
    "description": "Office: 'P' (President), 'S' (Senate), or 'H' (House). Optional.",
    "type": "string"
   },
   "party": {
    "description": "Party code (e.g. 'DEM', 'REP', 'IND', 'LIB'). Optional.",
    "type": "string"
   },
   "query": {
    "description": "Candidate name fragment (e.g. 'Warren', 'Smith'). Optional.",
    "type": "string"
   },
   "state": {
    "description": "Two-letter state code to filter by (e.g. 'MA', 'TX'). Optional.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "fec_candidate_search"
}
