{
 "description": "Zero-effect repository path-metadata preflight. Never send contents, archives, URLs, callbacks, or secrets.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "file",
        "directory",
        "symlink"
       ],
       "type": "string"
      },
      "path": {
       "maxLength": 512,
       "type": "string"
      }
     },
     "required": [
      "path",
      "kind"
     ],
     "type": "object"
    },
    "maxItems": 1024,
    "type": "array"
   }
  },
  "required": [
   "entries"
  ],
  "type": "object"
 },
 "name": "repository_safety_preflight"
}
