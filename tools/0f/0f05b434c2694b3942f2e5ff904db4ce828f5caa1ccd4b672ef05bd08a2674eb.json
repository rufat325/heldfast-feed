{
 "description": "Requires a ChainHelix API key as bearer token, or 2 cents per call paid over Binance b402 in USDT, USDC, USD1 or U on BNB Smart Chain, or over x402 in USDC on the Base network. Large transfer counts and USD totals per chain, one row per transaction over 500,000 USD, with exchangeTouching = transfers from or to a known exchange hot wallet or deposit address. What is counted: ethereum, bnb, polygon, avalanche native-coin transfers (token transfers such as USDT and USDC are not included); tron TRX and TRC-20 stablecoins; xrp native XRP; sui native SUI; bitcoin since 2026-09-25, the value sent to addresses other than the sender. exchangeTouching is null on bitcoin, tron and sui (too few labelled exchange addresses). Large solana transfers are not captured: the solana row answers null. window in hours default 24 max 168",
 "inputSchema": {
  "properties": {
   "chain": {
    "enum": [
     "bitcoin",
     "ethereum",
     "bnb",
     "solana",
     "avalanche",
     "xrp",
     "tron",
     "polygon",
     "sui"
    ],
    "type": "string"
   },
   "window": {
    "type": "number"
   }
  },
  "type": "object",
  "x-lexicon": {
   "bundleSha256": "e5b4290024a229f2bdf97f8fc6a0079c3fe13b77267f41fdcffeb8b26aa1c41e",
   "name": "ChainHelix Agentic Lexicon",
   "resolve": "lexicon_resolve",
   "spec": "lexicon_spec",
   "version": "0.1.0"
  },
  "x-vocab": {
   "chain": "onchain.chain",
   "window": "market.window"
  }
 },
 "name": "whale_flows",
