{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search dashboards & folders"
 },
 "description": "Search dashboards and folders by name/tag. Use this first to find a dashboard's UID before get_dashboard. Returns title, uid, type (dash-db | dash-folder), folder and tags.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Free-text match on title. Omit to list everything.",
    "type": "string"
   },
   "tag": {
    "description": "Restrict to a dashboard tag.",
    "type": "string"
   },
   "type": {
    "description": "Restrict to dashboards or folders.",
    "enum": [
     "dash-db",
     "dash-folder"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search",
 "title": "Search dashboards & folders"
}
