{
 "description": "List redirects, newest first: { items: [{ id, from_url, to_url, type, is_regex, hits, enabled, created_at, updated_at }], total, pages }.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "enabled": {
    "description": "Only enabled (true) or disabled (false) redirects (default: all)",
    "type": "boolean"
   },
   "page": {
    "description": "Page number (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Items per page, 1-100 (default 50)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "search": {
    "description": "Substring of from_url or to_url",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "type": {
    "description": "Only redirects with this status code",
    "enum": [
     301,
     302,
     307,
     410,
     451
    ],
    "type": "number"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "seo_list_redirects"
}
