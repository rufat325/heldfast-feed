{
 "annotations": {
  "readOnlyHint": true,
  "title": "List calendar events"
 },
 "description": "List calendar events between two dates, optionally for specific calendars (use \"services\" as a calendar to include services). Elvanto: calendar/events/getAll.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "calendar": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    ],
    "description": "Calendar id(s) to read from; \"services\" for services."
   },
   "end": {
    "description": "End date (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "fields": {
    "description": "Optional extra event fields, e.g. [\"locations\"].",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "page": {
    "description": "Results page to retrieve (1-based). Default 1.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "description": "Records per page, 1-1000. Default 100 here (Elvanto's own default is 1000).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "start": {
    "description": "Start date (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "start",
   "end"
  ],
  "type": "object"
 },
 "name": "elvanto_list_calendar_events",
 "title": "List calendar events"
}
