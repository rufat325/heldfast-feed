{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get publisher info"
 },
 "description": "Get on-chain info for a specific PayPerByte publisher: status, subscriber and message counts, USDC revenue, and the registered schema (size bounds, cadence, price-per-KB).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Publisher Ethereum address (0x...)",
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "byte_get_publisher",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Publisher Ethereum address",
    "type": "string"
   },
   "lastActive": {
    "description": "Unix timestamp of last on-chain activity",
    "type": "number"
   },
   "messages": {
    "description": "Total messages published",
    "type": "number"
   },
   "registeredAt": {
    "description": "Unix timestamp of publisher registration",
    "type": "number"
   },
   "revenueUsdc": {
    "description": "Total USDC revenue (decimal string)",
    "type": "string"
   },
   "schema": {
    "description": "Registered schema (topic, sizes, cadence, price)"
   },
   "status": {
    "description": "On-chain publisher status",
    "type": "string"
   },
   "subscribers": {
    "description": "Active subscriber count",
    "type": "number"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 }
}
