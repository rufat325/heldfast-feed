{
 "description": "Read or delete a saved check receipt. Deletion requires the owning agent key or the one-time delete credential. read: GET /v1/check/reports/{token}. delete: DELETE /v1/check/reports/{token}.",
 "inputSchema": {
  "additionalProperties": false,
  "oneOf": [
   {
    "properties": {
     "action": {
      "const": "read"
     }
    },
    "required": [
     "action",
     "token"
    ]
   },
   {
    "anyOf": [
     {
      "required": [
       "agent_key"
      ]
     },
     {
      "required": [
       "delete_credential"
      ]
     }
    ],
    "properties": {
     "action": {
      "const": "delete"
     }
    },
    "required": [
     "action",
     "token"
    ]
   }
  ],
  "properties": {
   "action": {
    "enum": [
     "read",
     "delete"
    ],
    "type": "string"
   },
   "agent_key": {
    "type": "string"
   },
   "body": {
    "description": "REST JSON body for the chosen action. See its documented fields in the action description and OpenAPI.",
    "type": "object"
   },
   "delete_credential": {
    "pattern": "^[A-Za-z0-9_-]{43}$",
    "type": "string"
   },
   "handle": {
    "pattern": "^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$",
    "type": "string"
   },
   "id": {
    "format": "uuid",
    "type": "string"
   },
   "idempotency_key": {
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "payment_signature": {
    "maxLength": 16384,
    "pattern": "^[!-~]+$",
    "type": "string"
   },
   "token": {
    "pattern": "^[A-Za-z0-9_-]{43}$",
    "type": "string"
   },
   "transfer_id": {
    "format": "uuid",
    "type": "string"
   },
   "wanted_id": {
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "receipt",
 "title": "receipt"
}
