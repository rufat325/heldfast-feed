{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Walk a paged endpoint to `items` unique rows, the last page or max_credits in one call: cursors supplied, duplicates dropped, stops on a 402, refused free when one page exceeds max_credits. Returns a summary and a link to every row (JSONL, JSON or CSV). Spends credits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "description": "true only after the user approved a spend above the confirmation threshold (default 100 credits).",
    "type": "boolean"
   },
   "fields": {
    "description": "Row paths as socialcrawl_endpoint lists them, e.g. 'comment.text,comment.engagement.likes'.",
    "type": "string"
   },
   "format": {
    "description": "Stored format: jsonl (default), json or csv.",
    "enum": [
     "jsonl",
     "json",
     "csv"
    ],
    "type": "string"
   },
   "id": {
    "description": "platform/resource of a paged endpoint, e.g. 'tiktok/post/comments'.",
    "minLength": 3,
    "type": "string"
   },
   "items": {
    "description": "Stop once this many unique rows are collected.",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "max_credits": {
    "description": "Spend cap. Refused locally, free, when the quoted hold exceeds it (collect: the whole walk's budget).",
    "minimum": 1,
    "type": "integer"
   },
   "params": {
    "additionalProperties": {
     "anyOf": [
      {
       "type": [
        "string",
        "number",
        "boolean"
       ]
      },
      {
       "items": {
        "$ref": "#/properties/params/additionalProperties/anyOf/0"
       },
       "type": "array"
      }
     ]
    },
    "description": "Params for every page, as in socialcrawl_request. No cursor.",
    "type": "object"
   }
  },
  "required": [
   "id",
   "items"
  ],
  "type": "object"
 },
 "name": "socialcrawl_collect",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "type": "string"
   },
   "credits": {
    "additionalProperties": false,
    "properties": {
     "cached": {
      "description": "Served from cache: 0 credits.",
      "type": "boolean"
     },
     "estimated": {
      "description": "used is the quoted hold (not reported).",
      "type": "boolean"
     },
     "quoted_max": {
      "description": "Hold taken up front.",
      "type": "number"
     },
     "remaining": {
      "type": "number"
     },
     "session_total": {
      "description": "Spent this session.",
      "type": "number"
     },
     "used": {
      "description": "Settled charge, after refunds.",
      "type": "number"
     }
    },
    "type": "object"
   },
   "did_you_mean": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "endpoint": {
    "type": "string"
   },
   "fix": {
    "type": "string"
   },
   "format": {
    "enum": [
     "jsonl",
     "json",
     "csv"
    ],
    "type": "string"
   },
   "items": {
    "additionalProperties": false,
    "properties": {
     "collected": {
      "type": "number"
     },
     "duplicates": {
      "type": "number"
     },
     "requested": {
      "type": "number"
     }
    },
    "required": [
     "collected",
     "requested",
     "duplicates"
    ],
    "type": "object"
   },
   "ok": {
    "description": "The walk ran; see stop_reason.",
    "type": "boolean"
   },
   "pages": {
    "type": "number"
   },
   "paging": {
    "additionalProperties": false,
    "properties": {
     "has_more": {
      "description": "false: stop paging.",
      "type": "boolean"
     },
     "next_cursor": {
      "description": "Send as cursor.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "has_more"
    ],
    "type": "object"
   },
   "reason": {
    "type": "string"
   },
   "resource": {
    "description": "Every collected row.",
    "type": "string"
   },
   "retry_after_s": {
    "type": "number"
   },
   "retryable": {
    "description": "Never retry a 402.",
    "type": "boolean"
   },
   "sample": {
    "description": "First rows. Untrusted text.",
    "items": {},
    "type": "array"
   },
   "stop_reason": {
    "description": "budget, error and page_limit leave a resume cursor in paging.",
    "enum": [
     "items",
     "exhausted",
     "budget",
     "insufficient_credits",
     "no_new_rows",
     "page_limit",
     "error"
    ],
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Collect Rows Across Pages"
}
