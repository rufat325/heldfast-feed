{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Sends a message to Farrukh by email, e.g. a job offer or a project inquiry. He replies to the given address, usually within two working days. Confirm the content with the user first.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"company":{"default":"","description":"Company, if any","maxLength":100,"pattern":"^[^\\r\\n]*$","type":"string"},"email":{"description":"Email address Farrukh replies to","format":"email","maxLength":254,"pattern":"^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"lang":{"default":"en","description":"Language the message is written in: \"de\" or \"en\".","enum":["de","en"],"type":"string"},"message":{"description":"The message itself, 20 to 5000 characters","maxLength":5000,"minLength":20,"type":"string"},"name":{"description":"Full name of the person writing","maxLength":100,"minLength":2,"pattern":"^[^\\r\\n]*$","type":"string"},"topic":{"description":"job: a job offer; freelance: a project; question: about a project or post; other","enum":["job","freelance","question","other"],"type":"string"}},"required":["name","email","topic","message"],"type":"object"},"name":"send_message","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"status":{"const":"sent","type":"string"}},"required":["status"],"type":"object"},"title":"Send Farrukh a message"}
