{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Discover current public sources with up to four focused searches. Search snippets are discovery aids; open the strongest pages before citing substantive claims.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "max_results": {
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "queries": {
    "items": {
     "properties": {
      "publishedAfter": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "publishedBefore": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "query": {
       "maxLength": 500,
       "minLength": 2,
       "type": "string"
      },
      "site": {
       "maxLength": 255,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "query"
     ],
     "type": "object"
    },
    "maxItems": 4,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "queries"
  ],
  "type": "object"
 },
 "name": "search_web",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "budgetReached": {
    "type": "boolean"
   },
   "failures": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "searches": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "searches",
   "failures",
   "budgetReached"
  ],
  "type": "object"
 },
 "title": "Search the public web"
}
