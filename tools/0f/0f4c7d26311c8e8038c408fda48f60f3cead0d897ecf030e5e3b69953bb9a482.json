     "country_name",
     "category",
     "form",
     "prep_time_minutes",
     "url"
    ],
    "type": "object"
   },
   "total_matches": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "source",
   "resolved_by",
   "total_matches",
   "matches",
   "score_basis",
   "notes",
   "attribution"
  ],
  "type": "object"
 },
 "title": "Find similar dishes"
}
