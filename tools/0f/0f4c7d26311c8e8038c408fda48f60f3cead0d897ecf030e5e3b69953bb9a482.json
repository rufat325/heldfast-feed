{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find dishes from other cuisines that are equivalent to a given dish, from eatmundo's scored equivalence graph (over 10,000 edges across nearly 2,000 recipes from 26 countries). Every edge is evidence-based - shared canonical ingredients - not a language-model guess, and every edge crosses country lines. Use it for \"what is the Greek counterpart of lahmacun, and why\".",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "country": {
    "description": "Restrict matches to one cuisine, ISO 3166-1 alpha-2 (e.g. \"GR\"). 26 countries are covered.",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "dish": {
    "description": "Dish to start from: an eatmundo slug (e.g. \"lahmacun\") or a plain name (\"rice pudding\"). Names are resolved through site search; check resolved_by in the result.",
    "minLength": 2,
    "type": "string"
   },
   "lang": {
    "default": "en",
    "description": "Language for titles, ingredient names and URLs.",
    "enum": [
     "en",
     "tr",
     "de",
     "fr",
     "es",
     "it",
     "el"
    ],
    "type": "string"
   },
   "limit": {
    "default": 5,
    "description": "How many matches to return, best score first. The default of 5 is enough to see whether a cuisine has one clear counterpart or several competing ones.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "min_score": {
    "default": 0,
    "description": "Minimum match score. Defaults to 0 on purpose: 320 dishes only have below-threshold nearest matches, and a default of 50 would silently return nothing for them.",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "dish"
  ],
  "type": "object"
 },
 "name": "find_similar_dishes",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "attribution": {
    "type": "string"
   },
   "matches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "below_threshold": {
       "type": "boolean"
      },
      "category": {
       "type": "string"
      },
      "compare_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "country": {
       "type": "string"
      },
      "country_name": {
       "type": "string"
      },
      "form": {
       "type": [
        "string",
        "null"
       ]
      },
      "prep_time_minutes": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "same_form": {
       "type": "boolean"
      },
      "score": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "shared_count": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "shared_ingredients": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "title",
      "country",
      "country_name",
      "category",
      "form",
      "prep_time_minutes",
      "url",
      "score",
      "below_threshold",
      "same_form",
      "shared_ingredients",
      "shared_count",
      "compare_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "resolved_by": {
    "enum": [
     "slug",
     "slug_other_language",
     "text_search"
    ],
    "type": "string"
   },
   "score_basis": {
    "type": "string"
   },
   "source": {
    "additionalProperties": false,
    "properties": {
     "category": {
      "type": "string"
     },
     "country": {
      "type": "string"
     },
     "country_name": {
      "type": "string"
     },
     "form": {
      "type": [
       "string",
       "null"
      ]
     },
     "prep_time_minutes": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "slug": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "slug",
