{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Update one Markdown task at a zero-based line number. The optional expected line is an exact stale-read guard.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "checked": {
    "description": "New completion state.",
    "type": "boolean"
   },
   "dryRun": {
    "default": false,
    "description": "Preview the change without applying it: returns the planned action and the exact CLI command.",
    "type": "boolean"
   },
   "expected": {
    "description": "Exact current task line; rejects stale updates when it differs.",
    "type": "string"
   },
   "line": {
    "description": "Zero-based line number of the task.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "note": {
    "description": "Vault-relative note containing the task.",
    "minLength": 1,
    "type": "string"
   },
   "text": {
    "description": "New task text.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "note",
   "line"
  ],
  "type": "object"
 },
 "name": "task_update",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Optional tool-specific structured result data."
   },
   "text": {
    "description": "Human-readable result text.",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "title": "Update task"
}
