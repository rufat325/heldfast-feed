{
 "description": "Generate brandable business names with real-time domain availability. Returns names that are ACTUALLY available to register, with pricing. [Requires a free namemy.app API key \u2014 get one at https://namemy.app/app/api-keys]",
 "inputSchema": {
  "properties": {
   "count": {
    "default": 10,
    "description": "Max results",
    "type": "number"
   },
   "description": {
    "description": "What does the project/business do?",
    "type": "string"
   },
   "industry": {
    "description": "Industry context (e.g., 'saas', 'fintech', 'healthcare')",
    "type": "string"
   },
   "tlds": {
    "default": [
     ".com",
     ".io",
     ".ai",
     ".app"
    ],
    "description": "Preferred TLDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "description"
  ],
  "type": "object"
 },
 "name": "generate_names"
}
