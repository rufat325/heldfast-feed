{
 "description": "Get the top-rated AI agent tools from SkillsIndex, sorted by overall score (0-100). Optionally filter by ecosystem or category.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Filter by category",
    "enum": [
     "databases-storage",
     "browser-automation",
     "code-execution",
     "communication",
     "social-media",
     "marketing-analytics",
     "memory-knowledge",
     "file-systems",
     "finance-fintech",
     "search-data",
     "ai-llm",
     "cloud-platforms",
     "home-automation",
     "security-monitoring",
     "location-maps",
     "media-entertainment",
     "ecommerce",
     "health-biology",
     "legal",
     "other"
    ],
    "type": "string"
   },
   "ecosystem": {
    "description": "Filter by ecosystem",
    "enum": [
     "mcp_server",
     "claude_skill",
     "gpt_action",
     "openclaw_skill",
     "plugin"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Number of results (1-20, default 10)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_top_rated"
}
