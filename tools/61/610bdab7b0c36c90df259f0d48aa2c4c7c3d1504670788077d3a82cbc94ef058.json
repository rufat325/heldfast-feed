     "CASHBACK_VAT",
     "CHARGEBACK",
     "CONVERSION",
     "DISBURSEMENT",
     "FOREX_DEDUCTION",
     "FOREX_DEPOSIT",
     "IN_PERSON_PAYMENT",
     "LOAN_REPAYMENT",
     "OTHER",
     "PAYMENT",
     "REFUND",
     "REMITTANCE",
     "REMITTANCE_COLLECTION_PAYMENT",
     "REMITTANCE_PAYOUT",
     "RESERVES_HOLD",
     "RESERVES_RELEASE",
     "TOPUP",
     "TRANSFER_IN",
     "TRANSFER_OUT",
     "WITHDRAWAL"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_transactions",
 "title": "List Transactions"
}
