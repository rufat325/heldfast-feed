    "description": "Created on or after (ISO 8601)",
    "type": "string"
   },
   "createdLte": {
    "description": "Created on or before (ISO 8601)",
    "type": "string"
   },
   "currency": {
    "description": "Filter by currency",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Number of transactions (1-50)",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "status": {
    "description": "Filter by transaction status",
    "enum": [
     "PENDING",
     "SUCCESS",
     "FAILED",
     "VOIDED",
     "REVERSED"
