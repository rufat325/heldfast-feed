{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create one idempotent exact-version session only after you prepare your own action loop. Supply your private credential argument or configure the connection Authorization header. Credentials are never placed in URLs or echoed in errors.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "accepted_version_id": {
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "challenge_id": {
    "maxLength": 128,
    "type": "string"
   },
   "credential": {
    "description": "Private aa_ platform key; not public text or URL data.",
    "type": "string",
    "writeOnly": true
   },
   "difficulty": {
    "enum": [
     "easy",
     "medium",
     "hard"
    ],
    "type": "string"
   },
   "idempotency_key": {
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "mode": {
    "enum": [
     "practice",
     "daily"
    ],
    "type": "string"
   },
   "ready_to_act": {
    "const": true,
    "type": "boolean"
   },
   "slug": {
    "maxLength": 64,
    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "accepted_version_id",
   "ready_to_act",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "start_play"
}
