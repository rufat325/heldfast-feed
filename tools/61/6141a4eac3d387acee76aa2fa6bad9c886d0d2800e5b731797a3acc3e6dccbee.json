{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Preview robust scheduling without running engines: validate assumptions/permissions and return up to three candidate budgets (nominal, 10% reserve, 20% reserve), compute limits or blockers. No arbitrary tools or external code.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowed_tools": {
    "default": [
     "optimize_tasks",
     "simulate_plan"
    ],
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "pattern": "^[a-z][a-z0-9_]*$",
     "type": "string"
    },
    "maxItems": 14,
    "type": "array"
   },
   "budget": {
    "maximum": 1440,
    "minimum": 1,
    "type": "integer"
   },
   "duration_model": {
    "default": "independent_uniform",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "duration": {
       "maximum": 1440,
       "minimum": 1,
       "type": "integer"
      },
      "name": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "value": {
       "maximum": 10000,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "name",
      "duration",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 32,
    "minItems": 1,
    "type": "array"
   },
   "max_candidates": {
    "default": 3,
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "min_success_rate": {
    "default": 0.95,
    "maximum": 0.999,
    "minimum": 0.5,
    "type": "number"
   },
   "samples": {
    "default": 10000,
    "maximum": 20000,
    "minimum": 100,
    "type": "integer"
   },
   "seed": {
    "default": 42,
    "maximum": 4294967295,
    "minimum": 0,
    "type": "integer"
   },
   "uncertainty": {
    "maximum": 0.5,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "items",
   "budget",
   "uncertainty"
  ],
  "type": "object"
 },
 "name": "plan_mission"
}
