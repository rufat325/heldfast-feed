{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Minimal connection block for the preferred remote (or package) with ${SECRET} placeholders, formatted for a target client. Secrets are never accepted or returned.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "name": {
    "description": "Official reverse-DNS name",
    "minLength": 1,
    "type": "string"
   },
   "target": {
    "description": "Output format (default mcpServers)",
    "enum": [
     "mcpServers",
     "vscode",
     "cursor",
     "claude-code-cli",
     "codex-toml",
     "opencode",
     "gemini",
     "goose"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_connection",
 "title": "Get a connection block"
}
