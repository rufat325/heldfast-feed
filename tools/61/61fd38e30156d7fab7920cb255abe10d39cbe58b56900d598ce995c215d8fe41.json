 "description": "Audit one OpenAPI document for whether a client or documentation generator can actually work from it. Reports operations with no operationId or description, duplicated operationIds that no generator can resolve, parameters with no schema or no location, responses with no description, and security requirements naming a scheme the document never defines. Pay 80000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "require_descriptions": {
    "description": "Whether an operation with neither summary nor description is a finding. Defaults to true.",
    "type": "boolean"
   },
   "require_operation_ids": {
    "description": "Whether a missing operationId is a finding. Defaults to true, because a generator must otherwise invent a method name.",
    "type": "boolean"
   },
   "specification": {
    "description": "An OpenAPI 3.x document as JSON. YAML is not accepted: a YAML reader is a parser dependency and a parser is an attack surface, so convert locally first. $ref resolves inside the document only and a remote reference is reported unresolved, never fetched. Swagger 2 documents are read only as far as they share OpenAPI 3 structure, and the difference is reported.",
    "example": {
     "openapi": "3.0.3",
     "paths": {
      "/widgets": {
       "get": {
        "responses": {
         "200": {}
        }
       },
       "post": {
        "operationId": "makeWidget",
        "parameters": [
         {
          "name": "dry_run"
         }
        ],
        "responses": {}
       }
      },
      "/widgets/{id}": {
       "get": {
        "operationId": "makeWidget",
        "responses": {
         "200": {
          "description": "ok"
         }
        },
        "security": [
         {
          "undefinedScheme": []
         }
        ],
        "summary": "Fetch"
       }
      }
     }
    },
    "type": "object"
   }
  },
  "required": [
   "specification"
  ],
  "type": "object"
 },
 "name": "openapi_spec_quality_audit",
