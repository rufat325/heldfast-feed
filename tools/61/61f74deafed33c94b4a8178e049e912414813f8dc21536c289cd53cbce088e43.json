{
 "description": "Reduce the quantity of specific order lines. Quantity can only be lowered. Set to 0 to remove.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "lineIds": {
    "description": "IDs of lines to modify",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "quantity": {
    "description": "New total quantity (must be lower than current)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "token": {
    "description": "Order token",
    "type": "string"
   }
  },
  "required": [
   "token",
   "lineIds",
   "quantity"
  ],
  "type": "object"
 },
 "name": "lower_order_quantity"
}
