{
 "description": "Get the current total value of one or more depots, and optionally its history when 'from' is given. Use this for 'what is my portfolio worth (today / over time)?'.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountIds": {
    "description": "Depot ID(s) to include",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "from": {
    "description": "If set (yyyy-MM-dd), also return the valuation history since this date",
    "type": "string"
   },
   "includeCash": {
    "default": true,
    "description": "Include the cash position",
    "type": "boolean"
   },
   "interval": {
    "default": "month",
    "description": "History interval",
    "enum": [
     "day",
     "week",
     "month",
     "year"
    ],
    "type": "string"
   }
  },
  "required": [
   "accountIds"
  ],
  "type": "object"
 },
 "name": "get_portfolio_valuation"
}
