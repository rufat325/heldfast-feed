{
 "description": "Record the current package dependencies into renv.lock using renv::snapshot().",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "project_path": {
    "description": "Absolute path to the renv-managed project root.",
    "type": "string"
   },
   "type": {
    "default": "implicit",
    "description": "Snapshot type: 'implicit' (DESCRIPTION), 'explicit' (renv.lock packages), 'all' (everything installed), or 'custom' (default 'implicit').",
    "enum": [
     "implicit",
     "explicit",
     "all",
     "custom"
    ],
    "type": "string"
   }
  },
  "required": [
   "project_path"
  ],
  "type": "object"
 },
 "name": "renv_snapshot"
}
