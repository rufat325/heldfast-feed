{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Move a regular vault file to another vault-relative path with explicit collision policy.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collision": {
    "enum": [
     "increment",
     "error",
     "overwrite"
    ],
    "type": "string"
   },
   "destination": {
    "minLength": 1,
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Preview the change without applying it: returns the planned action and the exact CLI command.",
    "type": "boolean"
   },
   "path": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "path",
   "destination"
  ],
  "type": "object"
 },
 "name": "file_move",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Optional tool-specific structured result data."
   },
   "text": {
    "description": "Human-readable result text.",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "title": "Move vault file"
}
