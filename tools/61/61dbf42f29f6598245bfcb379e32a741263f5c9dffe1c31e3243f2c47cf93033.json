{
 "description": "Retrieves historical heartbeat data for ALL monitors (response times, status changes over time). Use this for analyzing patterns across multiple monitors or correlating events. Beats are returned NEWEST-FIRST. By default returns only the most recent heartbeat per monitor; set maxHeartbeats (up to 100) for historical analysis. Keep maxHeartbeats \u22645 unless user requests more. Credentials embedded in a status message URL (user:pass@host) read \"***\" unless includeSecrets is set.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "Alias for maxHeartbeats. Prefer maxHeartbeats.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "includeSecrets": {
    "description": "Return credentials in full instead of \"***\". Off by default: this output is persisted in conversation transcripts and logs. Can also be enabled globally with UPTIME_KUMA_INCLUDE_SECRETS=true.",
    "type": "boolean"
   },
   "limit": {
    "description": "Alias for maxHeartbeats. Prefer maxHeartbeats.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "maxHeartbeats": {
    "description": "If set, returns the most recent X heartbeats per monitor (up to 100). If unset, returns only the most recent heartbeat per monitor (default: 1)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "listHeartbeats",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "heartbeats": {
    "additionalProperties": {
     "items": {
      "additionalProperties": false,
      "properties": {
       "down_count": {
        "description": "Consecutive down count",
        "type": "number"
       },
       "duration": {
        "description": "Seconds since last check",
        "type": "number"
       },
       "end_time": {
        "description": "Check end time",
        "type": [
         "string",
         "null"
        ]
       },
       "id": {
        "description": "Heartbeat ID",
        "type": "number"
       },
       "important": {
        "description": "Status change flag",
        "type": [
         "boolean",
         "number"
        ]
       },
       "localDateTime": {
        "description": "Local formatted time",
        "type": "string"
       },
       "monitorID": {
        "description": "Monitor ID (camelCase)",
        "type": "number"
       },
       "monitor_id": {
        "description": "Monitor ID",
        "type": "number"
       },
       "msg": {
        "description": "Status message",
        "type": "string"
       },
       "ping": {
        "description": "Response time (ms)",
        "type": [
         "number",
         "null"
        ]
       },
       "retries": {
        "description": "Retry attempts",
        "type": "number"
       },
       "status": {
        "description": "0=DOWN 1=UP 2=PENDING 3=MAINT",
        "type": "number"
       },
       "time": {
        "description": "Timestamp, in UTC as \"YYYY-MM-DD HH:mm:ss.SSS\". Uptime Kuma sends no zone marker, so compare against the current UTC time, not local time.",
        "type": "string"
       },
       "timezone": {
        "description": "Server timezone",
        "type": "string"
       }
      },
      "required": [
       "status",
       "time",
       "msg",
       "important"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "description": "Map of monitor IDs to their heartbeat arrays",
    "type": "object"
   },
   "monitorCount": {
    "type": "number"
   },
   "totalHeartbeatCount": {
    "type": "number"
   }
  },
  "required": [
   "heartbeats",
   "monitorCount",
   "totalHeartbeatCount"
  ],
  "type": "object"
 },
 "title": "List Heartbeats"
}
