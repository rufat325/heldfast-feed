{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a safety-gated OSC command scaffold for grandMA3, ETC Eos, ChamSys, Avolites, or generic lighting consoles without sending direct DMX.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "console_family": {
    "default": "generic_osc",
    "enum": [
     "grandma3",
     "etc_eos",
     "chamsys",
     "avolites",
     "generic_osc"
    ],
    "type": "string"
   },
   "console_host": {
    "default": "127.0.0.1",
    "type": "string"
   },
   "cue_count": {
    "default": 16,
    "maximum": 512,
    "minimum": 1,
    "type": "integer"
   },
   "executor_count": {
    "default": 8,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "default": "lighting_console_osc",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the lighting-console OSC scaffold.",
    "type": "string"
   },
   "receive_port": {
    "default": 8001,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "safety_mode": {
    "default": "dry_run",
    "enum": [
     "dry_run",
     "approval_required"
    ],
    "type": "string"
   },
   "send_port": {
    "default": 8000,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_lighting_console_osc",
 "title": "Connect lighting console OSC"
}
