{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "A Hyperliquid wallet's trading record over 7, 30 or 90 days: win rate, profit factor, realized PnL, max drawdown and its best markets.",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "0x-prefixed 20-byte hex address",
    "type": "string"
   },
   "window": {
    "description": "Lookback window. Default 30d",
    "enum": [
     "7d",
     "30d",
     "90d"
    ],
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_trader_profile",
 "outputSchema": {
  "description": "One wallet's trading record",
  "properties": {
   "address": {
    "description": "Wallet address (0x\u2026)"
   },
   "liquidation_count": {
    "description": "Liquidations in the window"
   },
   "markets": {
    "description": "Best markets, ranked",
    "items": {
     "description": "One market",
     "properties": {
      "avg_notional_usd": {
       "description": "Average trade size in USD"
      },
      "last_trade_ms": {
       "description": "Last trade, Unix milliseconds"
      },
      "market": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "profit_factor": {
       "description": "Gross profit divided by gross loss"
      },
      "rank": {
       "description": "Rank among the wallet's markets"
      },
      "realized_pnl_usd": {
       "description": "Realized PnL in USD"
      },
      "trades": {
       "description": "Closed trades in the window"
      },
      "win_rate": {
       "description": "Share of closed trades that were profitable, 0 to 1"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "overall": {
    "description": "Headline stats",
    "properties": {
     "first_trade_ms": {
      "description": "First trade, Unix milliseconds"
     },
     "max_drawdown_pct": {
      "description": "Largest peak-to-trough drop of the PnL curve, 0 to 1"
     },
     "profit_factor": {
      "description": "Gross profit divided by gross loss"
     },
     "realized_pnl_usd": {
      "description": "Realized PnL in USD"
     },
     "trades": {
      "description": "Closed trades in the window"
     },
     "win_rate": {
      "description": "Share of closed trades that were profitable, 0 to 1"
     }
    },
    "type": "object"
   },
   "trades": {
    "description": "Recent round-trip trades"
   },
   "window": {
    "description": "Lookback window, e.g. \"30d\""
   }
  },
  "type": "object"
 }
}
