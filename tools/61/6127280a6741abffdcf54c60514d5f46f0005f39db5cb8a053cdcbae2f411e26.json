{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Check a DATEV-Format (EXTF) CSV file, e.g. EXTF_Buchungsstapel.csv or a Debitoren/Kreditoren export, before importing it into DATEV or after DATEV rejected it. Returns every problem with line, field and a plain-language explanation in German or English: dot instead of comma in amounts, missing leading zeros in Belegdatum, BU-Schl\u00fcssel on automatic accounts, account length, encoding, header errors and more. Pass a file path (preferred, the encoding is checked too) or the file content.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "content": {
    "description": "The file content as text, if there's no file. The encoding can't be checked this way.",
    "type": "string"
   },
   "lang": {
    "default": "de",
    "description": "Language of the messages: de (default) or en.",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "path": {
    "description": "Path to the CSV file on this machine. Relative paths resolve against the server's working directory.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "validate_datev_extf",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "buchungsstapel, debkred or other",
    "type": "string"
   },
   "countsByCode": {
    "additionalProperties": {
     "type": "number"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "disclaimer": {
    "type": "string"
   },
   "encoding": {
    "type": "string"
   },
   "errors": {
    "type": "number"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "field": {
       "type": "number"
      },
      "fieldName": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning"
       ],
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "header": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "rows": {
    "type": "number"
   },
   "truncated": {
    "type": "boolean"
   },
   "warnings": {
    "type": "number"
   }
  },
  "required": [
   "rows",
   "encoding",
   "errors",
   "warnings",
   "countsByCode",
   "findings",
   "truncated",
   "disclaimer"
  ],
  "type": "object"
 },
 "title": "Validate a DATEV EXTF file"
}
