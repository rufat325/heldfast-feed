{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Save reviewed category edits after reading it and checking its brand_id. Omitted fields stay unchanged. Do not supply an idempotency key.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "body": {
    "additionalProperties": false,
    "description": "Patch a category (only set fields are applied).\n\nExplicit ``null`` on an omit-only key\n(``PublicCategoryUpdateOmitOnlyField``: name/slug/sort_order/status)\nreturns **422**; the clearable keys\n(``PublicCategoryUpdateClearableField``: description/parent_id/icon/color)\nmay be cleared with ``null``.",
    "properties": {
     "color": {
      "anyOf": [
       {
        "pattern": "^#[0-9A-Fa-f]{6}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Color"
     },
     "description": {
      "anyOf": [
       {
        "maxLength": 500,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Description"
     },
     "icon": {
      "anyOf": [
       {
        "maxLength": 50,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Icon"
     },
     "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
     },
     "parent_id": {
      "anyOf": [
       {
        "format": "uuid",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Parent Id"
     },
     "slug": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$",
      "title": "Slug",
      "type": "string"
     },
     "sort_order": {
      "title": "Sort Order",
      "type": "integer"
     },
     "status": {
      "description": "Status for categories.",
      "enum": [
       "active",
       "archived"
      ],
      "title": "Status",
      "type": "string"
     }
    },
    "title": "PublicCategoryUpdate",
    "type": "object"
   },
   "category_id": {
    "format": "uuid",
    "title": "Category Id",
    "type": "string"
   }
  },
  "required": [
   "category_id",
   "body"
  ],
  "type": "object"
 },
 "name": "update_category"
}
