  "additionalProperties": false,
  "properties": {
   "websiteId": {
    "description": "Website ID from listWebsites.",
    "type": "string"
   }
  },
  "required": [
   "websiteId"
  ],
  "type": "object"
 },
 "name": "getMonitoringSchedule",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "schedule": {
    "anyOf": [
     {},
     {
      "type": "null"
     }
    ]
   },
   "websiteId": {
    "type": "string"
   }
  },
  "required": [
   "websiteId"
  ],
  "type": "object"
 }
}
