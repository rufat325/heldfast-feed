{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List email messages in a Nextcloud Mail mailbox. Supports pagination via cursor. Returns subject, sender, date, and message IDs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "Cursor for pagination (message ID to start after)",
    "type": "number"
   },
   "filter": {
    "description": "Filter messages (default: all)",
    "enum": [
     "all",
     "unread",
     "flagged"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Number of messages to return (default: 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "mailboxId": {
    "description": "The mailbox ID (from list_mailboxes)",
    "type": "number"
   }
  },
  "required": [
   "mailboxId"
  ],
  "type": "object"
 },
 "name": "mail_list_messages",
 "title": "List Mail Messages"
}
