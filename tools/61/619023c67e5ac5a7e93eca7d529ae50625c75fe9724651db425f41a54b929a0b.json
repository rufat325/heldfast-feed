{
 "description": "Save an agent. Then call ``route_number`` so a number answers\n        with it, or pass its id as ``agent_id`` to ``place_call``.\n\n        ``system_prompt`` is what the agent follows. ``first_message`` is\n        spoken after the AI line; omit it to let the caller speak first.\n        ``ai_disclosure_line`` replaces the workspace AI line for this\n        agent; ``{org}`` becomes the organization name. ``language`` is a\n        lowercase ISO 639-1 code. ``max_duration_seconds`` is 60..3600.\n        ``handover_max_duration_seconds`` (60..3600, default 1800) is the\n        call limit once a handover contact answers.\n        ``handover_contacts``: People the agent may hand a live call to:\n        ``[{contact_id, note}]`` (max 10; ``note`` 1-200 chars says when to\n        hand over). The contact needs a phone number. The agent never sees it.\n\n        Returns the API's ``AgentResponse`` as a dict, or\n        ``{\"error\": \"<message>\"}``.\n        ",
 "inputSchema": {
  "properties": {
   "ai_disclosure": {
    "default": true,
    "title": "Ai Disclosure",
    "type": "boolean"
   },
   "ai_disclosure_line": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Ai Disclosure Line"
   },
   "first_message": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "First Message"
   },
   "handover_contacts": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Handover Contacts"
   },
   "handover_max_duration_seconds": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Handover Max Duration Seconds"
   },
   "language": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Language"
   },
   "max_duration_seconds": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Max Duration Seconds"
   },
   "name": {
    "title": "Name",
    "type": "string"
   },
   "sms_enabled": {
    "default": true,
    "title": "Sms Enabled",
    "type": "boolean"
   },
   "system_prompt": {
    "title": "System Prompt",
    "type": "string"
   },
   "tools": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Tools"
   },
   "voice_enabled": {
    "default": true,
    "title": "Voice Enabled",
    "type": "boolean"
   },
   "voice_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Voice Id"
   }
  },
  "required": [
