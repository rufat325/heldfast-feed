 "description": "Count signed calendar days or weekdays between dates, or add and subtract calendar units with month-end clamping. (API Tool Calls, by Cowerx)",
 "inputSchema": {
  "additionalProperties": false,
  "examples": [
   {
    "amount": 1,
    "date": "2024-01-31",
    "mode": "shift",
    "unit": "months"
   }
  ],
  "oneOf": [
   {
    "properties": {
     "mode": {
      "description": "",
      "enum": [
       "between"
      ],
      "type": "string"
     }
    },
    "required": [
     "start",
     "end"
    ]
   },
   {
    "properties": {
     "mode": {
      "description": "",
      "enum": [
       "shift"
      ],
      "type": "string"
     }
    },
    "required": [
     "date",
     "amount",
     "unit"
    ]
   }
  ],
  "properties": {
   "amount": {
    "description": "Signed whole calendar units; negative subtracts",
    "maximum": 3652058,
    "minimum": -3652058,
    "type": "integer"
   },
   "date": {
    "description": "Gregorian calendar date YYYY-MM-DD, years 0001\u20139999",
    "maxLength": 10,
    "minLength": 5,
    "type": "string"
   },
   "end": {
    "description": "Gregorian calendar date YYYY-MM-DD, years 0001\u20139999",
    "maxLength": 10,
    "minLength": 5,
    "type": "string"
   },
   "inclusive": {
    "default": false,
    "description": "Count both endpoints; default excludes earlier endpoint and includes later endpoint",
    "type": "boolean"
   },
   "mode": {
    "description": "Operation",
    "enum": [
     "between",
     "shift"
    ],
    "type": "string"
   },
   "start": {
    "description": "Gregorian calendar date YYYY-MM-DD, years 0001\u20139999",
    "maxLength": 10,
    "minLength": 5,
    "type": "string"
   },
   "unit": {
    "description": "Calendar unit",
    "enum": [
     "days",
     "weeks",
     "months",
     "years"
    ],
    "type": "string"
   },
   "weekdaysOnly": {
    "default": false,
    "description": "Count Monday\u2013Friday only; holidays are included",
    "type": "boolean"
   }
  },
  "required": [
