{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List DHCP leases on a MikroTik router with optional filtering by server, status, lease type (dynamic/static), and MAC address. Supports pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "leaseType": {
    "default": "all",
    "description": "Filter by lease type (dynamic or static)",
    "enum": [
     "dynamic",
     "static",
     "all"
    ],
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Max results to return.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "macAddress": {
    "description": "Filter by MAC address (exact match, case-insensitive)",
    "type": "string"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset.",
    "minimum": 0,
    "type": "integer"
   },
   "routerId": {
    "description": "Router ID; omit to use the default router.",
    "type": "string"
   },
   "server": {
    "description": "Filter by DHCP server name",
    "type": "string"
   },
   "status": {
    "default": "all",
    "description": "Filter by lease status",
    "enum": [
     "bound",
     "waiting",
     "offered",
     "blocked",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_dhcp_leases",
 "title": "List DHCP Leases"
}
