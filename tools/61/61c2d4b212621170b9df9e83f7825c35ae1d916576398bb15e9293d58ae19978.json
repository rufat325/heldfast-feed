{
 "description": "Supersede a v2 delegation. Scope narrowing needs justification. Scope expansion also needs independent reviewer.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "expansion_reviewer": {
    "description": "Required if scope expands",
    "type": "string"
   },
   "expansion_reviewer_private_key": {
    "type": "string"
   },
   "justification": {
    "type": "string"
   },
   "new_scope_categories": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "original_delegation_id": {
    "type": "string"
   },
   "trust_epoch": {
    "default": 1,
    "type": "number"
   },
   "valid_until": {
    "type": "string"
   }
  },
  "required": [
   "original_delegation_id",
   "new_scope_categories",
   "justification",
   "valid_until"
  ],
  "type": "object"
 },
 "name": "supersede_v2_delegation"
}
