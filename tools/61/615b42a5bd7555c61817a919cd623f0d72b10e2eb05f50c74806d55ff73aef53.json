{
 "description": "Analyze measured game performance: FPS, frame times, CPU/submission work, draw calls and network latency. Pass a numeric report to analyze it without saving, or omit report to retrieve the latest explicitly shared capture in your workspace. Optional kit_id filters the capture. Returns measured findings and limitations, not a claimed optimization or GPU benchmark. 0 credits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "kit_id": {
    "description": "Kit id for the latest workspace capture (optional).",
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_.:-]+$",
    "type": "string"
   },
   "report": {
    "additionalProperties": false,
    "description": "Measured diagnostic JSON, including 1\u2013120 numeric samples. Only documented performance fields are sent.",
    "properties": {
     "game": {
      "maxLength": 80,
      "type": "string"
     },
     "samples": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "cpuMs": {
         "$ref": "#/properties/report/properties/samples/items/properties/frameMs"
        },
        "drawCalls": {
         "maximum": 1000000,
         "minimum": 0,
         "type": "integer"
        },
        "fps": {
         "maximum": 1000,
         "minimum": 0,
         "type": "number"
        },
        "frameMs": {
         "maximum": 60000,
         "minimum": 0,
         "type": "number"
        },
        "gpuMs": {
         "anyOf": [
          {
           "$ref": "#/properties/report/properties/samples/items/properties/frameMs"
          },
          {
           "type": "null"
          }
         ]
        },
        "level": {
         "maximum": 10,
         "minimum": 0,
         "type": "integer"
        },
        "networkMs": {
         "anyOf": [
          {
           "$ref": "#/properties/report/properties/samples/items/properties/frameMs"
          },
          {
           "type": "null"
          }
         ]
        },
        "p95Ms": {
         "$ref": "#/properties/report/properties/samples/items/properties/frameMs"
        },
        "pixelRatio": {
         "maximum": 8,
         "minimum": 0.01,
         "type": "number"
        },
        "quality": {
         "enum": [
          "auto",
          "high",
          "performance"
         ],
         "type": "string"
        },
        "snapshotAgeMs": {
         "$ref": "#/properties/report/properties/samples/items/properties/frameMs"
        },
        "submitMs": {
         "$ref": "#/properties/report/properties/samples/items/properties/frameMs"
        },
        "triangles": {
         "maximum": 1000000000,
         "minimum": 0,
         "type": "integer"
        }
       },
       "type": "object"
      },
      "maxItems": 120,
      "minItems": 1,
      "type": "array"
     },
     "version": {
      "maxLength": 80,
      "type": "string"
     },
     "viewport": {
      "additionalProperties": false,
      "properties": {
       "height": {
        "maximum": 32768,
        "minimum": 1,
        "type": "integer"
       },
       "width": {
        "maximum": 32768,
        "minimum": 1,
        "type": "integer"
       }
      },
      "required": [
       "width",
       "height"
      ],
      "type": "object"
     }
    },
    "required": [
     "samples"
    ],
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "gripforge_performance"
}
