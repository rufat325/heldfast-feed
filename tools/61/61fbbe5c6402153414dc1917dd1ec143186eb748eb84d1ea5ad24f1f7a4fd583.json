{
 "description": "Fetch one icon from IconsRoom as ready-to-use code. Formats: \"svg\" (markup), \"react\" (JSX component), \"url\" (CDN link), \"datauri\" (base64 CSS-ready). Optionally recolor monochrome icons.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "color": {
    "description": "Optional hex color, e.g. \"#0f172a\" \u2014 applied to monochrome icons only",
    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
    "type": "string"
   },
   "format": {
    "default": "svg",
    "enum": [
     "svg",
     "react",
     "url",
     "datauri"
    ],
    "type": "string"
   },
   "name": {
    "description": "Icon slug, e.g. \"academic-cap\"",
    "minLength": 1,
    "type": "string"
   },
   "pack": {
    "description": "Icon pack key, e.g. \"heroicons\"",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "pack",
   "name"
  ],
  "type": "object"
 },
 "name": "get_icon"
}
