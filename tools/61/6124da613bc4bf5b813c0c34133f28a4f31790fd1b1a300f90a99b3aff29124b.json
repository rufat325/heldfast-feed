{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check a citation"
 },
 "description": "Use this when you need to check a California HOA citation before relying on it: a Davis-Stirling section (current, or a former pre-2014 number like \"Civ. Code 1363\"), or a case by reporter citation or name. Returns the current authority and, for former numbers, where the provision lives now per the AB 805 recodification table. Do not use it for citations to other states or other California codes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "citation": {
    "anyOf": [
     {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    ],
    "description": "The citation as written, e.g. \"Civ. Code \u00a7 1365.5\" or \"8 Cal.4th 361\"."
   }
  },
  "required": [
   "citation"
  ],
  "type": "object"
 },
 "name": "resolve_citation",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "input": {
    "type": "string"
   },
   "matches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "authority": {
       "additionalProperties": false,
       "properties": {
        "authority_id": {
         "type": "string"
        },
        "canonical_url": {
         "type": "string"
        },
        "cite": {
         "type": "string"
        },
        "kind": {
         "enum": [
          "statute_section",
          "case"
         ],
         "type": "string"
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "authority_id",
        "kind",
        "cite",
        "title",
        "canonical_url"
       ],
       "type": "object"
      },
      "confidence": {
       "enum": [
        "high",
        "medium",
        "low"
       ],
       "type": "string"
      },
      "match": {
       "enum": [
        "exact",
        "former-section",
        "parallel-cite",
        "name"
       ],
       "type": "string"
      },
      "note": {
       "type": [
        "string",
        "null"
       ]
      },
      "pinpoint": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "authority",
      "match",
      "confidence",
      "pinpoint",
      "note"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "corpus_version": {
      "description": "Version of the compiled corpus this response was built from.",
      "type": "string"
     },
     "coverage": {
      "description": "What the corpus covers and does not cover.",
      "type": "string"
     },
     "notice": {
      "type": "string"
     }
    },
    "required": [
     "corpus_version",
     "coverage",
     "notice"
    ],
    "type": "object"
   },
   "not_found_reason": {
    "type": [
     "string",
     "null"
    ]
   },
   "suggestions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "authority_id": {
       "type": "string"
      },
      "canonical_url": {
       "type": "string"
      },
      "cite": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "statute_section",
        "case"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "authority_id",
      "kind",
      "cite",
      "title",
      "canonical_url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "input",
   "matches",
   "not_found_reason",
   "suggestions",
   "meta"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Check a citation"
}
