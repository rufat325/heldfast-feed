{
 "_meta": {
  "openai/outputTemplate": "ui://xona-dental-gateway/card.html",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://xona-dental-gateway/card.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Hold one open time and text the patient a link to it. The page the link opens shows the time and the details above a Book this appointment button. When the patient presses it the appointment is booked, or, at a practice that confirms bookings itself, sent to the practice as a request.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "date": {
    "description": "The chosen slot's date exactly as list_xona_booking_slots returned it",
    "format": "date",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "date_of_birth": {
    "description": "The patient's date of birth, as the patient gave it in this conversation",
    "format": "date",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "first_name": {
    "description": "The patient's first name, as the patient gave it in this conversation",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "guardian_name": {
    "description": "Required when the patient is under 16",
    "maxLength": 120,
    "type": "string"
   },
   "last_name": {
    "description": "The patient's last name, as the patient gave it in this conversation",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "note": {
    "maxLength": 500,
    "type": "string"
   },
   "patient_phone": {
    "description": "The patient's own Canadian or US mobile number, as the patient gave it in this conversation; the booking link is texted there",
    "maxLength": 32,
    "minLength": 7,
    "type": "string"
   },
   "practice_slug": {
    "maxLength": 140,
    "minLength": 1,
    "type": "string"
   },
   "service_id": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "slot_fingerprint": {
    "pattern": "^[0-9a-f]{32}$",
    "type": "string"
   }
  },
  "required": [
   "practice_slug",
   "service_id",
   "slot_fingerprint",
   "date",
   "patient_phone",
   "first_name",
   "last_name",
   "date_of_birth"
  ],
  "type": "object"
 },
 "name": "hold_xona_booking_slot",
 "outputSchema": {
  "properties": {
   "action_id": {
    "type": "string"
   },
   "booking_steps": {
    "items": {
     "properties": {
      "patient_does": {
       "type": "string"
      },
      "patient_provides": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "status": {
       "enum": [
        "done",
        "waiting_for_patient",
        "not_started"
       ],
       "type": "string"
      },
      "step": {
       "type": "integer"
      },
      "tool": {
       "type": "string"
      },
      "xona_sends": {
       "properties": {
        "channel": {
         "type": "string"
        },
        "contains": {
         "type": "string"
        },
        "link_expires_at": {
         "format": "date-time",
         "type": "string"
        },
        "to": {
         "type": "string"
        }
       },
       "required": [
        "channel"
       ],
       "type": "object"
      }
     },
     "required": [
      "step",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "booking_url": {
    "type": "string"
   },
   "continue_url": {
    "type": "string"
   },
   "hold_expires_at": {
    "format": "date-time",
    "type": "string"
   },
   "link_expires_at": {
    "format": "date-time",
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "outcome": {
    "type": "string"
   },
   "practice": {
    "properties": {
     "name": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     }
    },
    "required": [
     "slug",
     "name"
    ],
    "type": "object"
   },
   "reason": {
    "type": "string"
   },
   "verification": {
    "type": "string"
   }
  },
  "required": [
   "action_id",
   "practice",
   "next_step"
  ],
  "type": "object"
 },
 "title": "Hold an open time and text the patient a link"
}
