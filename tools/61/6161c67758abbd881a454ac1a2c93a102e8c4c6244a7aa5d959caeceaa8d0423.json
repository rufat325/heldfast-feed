{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "owner",
     "offline_access"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "readOnlyHint": false,
  "title": "Class timetable"
 },
 "description": "Only for business owners signed in to Awning. Set when a class runs; future classes are generated for the booking horizon.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "business_id": {
    "description": "Only needed if you manage several businesses",
    "type": "string"
   },
   "offering_id": {
    "type": "string"
   },
   "schedule": {
    "items": {
     "properties": {
      "capacity": {
       "type": "number"
      },
      "capacity_online": {
       "type": "number"
      },
      "days": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "items": {
          "maxLength": 20,
          "type": "string"
         },
         "maxItems": 14,
         "type": "array"
        }
       ],
       "description": "e.g. \"mon-sat\", \"daily\", [\"tue\",\"thu\"]"
      },
      "duration_min": {
       "type": "number"
      },
      "time": {
       "maxLength": 20,
       "type": "string"
      }
     },
     "required": [
      "days",
      "time"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "offering_id",
   "schedule"
  ],
  "type": "object"
 },
 "name": "owner_upsert_sessions",
 "title": "Class timetable"
}
