{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Clipforms"
 },
 "description": "List forms in your workspace with optional filtering. Returns paginated results (cursor-based). next_cursor is included when more results exist. To find or open a form by name, pass search with part of its title instead of paging through results. Needs a signed-in Clipform account (an anonymous session is asked to sign in).",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "Pagination cursor from previous response's next_cursor",
    "type": "string"
   },
   "limit": {
    "description": "Number of forms to return (default 25, max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "order": {
    "description": "Sort order (default: desc, newest first)",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "published": {
    "description": "Filter by publish status",
    "enum": [
     "true",
     "false"
    ],
    "type": "string"
   },
   "search": {
    "description": "Filter to forms whose title contains this text (case-insensitive substring). Use this to resolve a form by name in one call instead of paginating.",
    "type": "string"
   },
   "sort": {
    "description": "Sort field (default: created_at)",
    "enum": [
     "created_at",
     "updated_at"
    ],
    "type": "string"
   },
   "tag": {
    "description": "Filter by tag name(s), comma-separated. AND logic: only forms with ALL tags are returned.",
    "type": "string"
   },
   "workspace_id": {
    "description": "Workspace to act in (id from clipform_whoami workspaces). Omit to use the connection's default workspace.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "clipform_list_forms",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "forms": {
    "description": "Matching forms (empty if none)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "builder_url": {
       "description": "Dashboard Build tab for this form. Not present for an anonymous caller.",
       "type": "string"
      },
      "has_unpublished_changes": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      },
      "is_live": {
       "type": "boolean"
      },
      "share_id": {
       "type": "string"
      },
      "tags": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "color": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "id": {
          "type": "string"
         },
         "name": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "name",
         "color"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "viewer_url": {
       "description": "Live respondent link. Only present for a published (is_live) form, and not for an anonymous caller.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "share_id",
      "is_live",
      "has_unpublished_changes",
      "tags"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Pass as cursor to fetch the next page, or null when no more"
   }
  },
  "required": [
   "forms",
   "next_cursor"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "mcp"
   ],
   "type": "oauth2"
  }
 ],
 "title": "List Clipforms"
}
