{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Purchase History"
 },
 "description": "Search purchase history with spending summary. Filter by wine name, store, or date range (YYYY-MM-DD format). Shows total spent, average price, per-store breakdown, and recent purchases.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "date_from": {
    "description": "Start date (YYYY-MM-DD)",
    "type": "string"
   },
   "date_to": {
    "description": "End date (YYYY-MM-DD)",
    "type": "string"
   },
   "query": {
    "description": "Wine name search",
    "type": "string"
   },
   "store": {
    "description": "Store name filter",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "purchase-history",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "avgPrice": {
    "type": "number"
   },
   "bottleCount": {
    "type": "number"
   },
   "byStore": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "type": "number"
      },
      "store": {
       "type": "string"
      },
      "total": {
       "type": "number"
      }
     },
     "required": [
      "store",
      "total",
      "count"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "recent": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "type": "string"
      },
      "price": {
       "type": "number"
      },
      "quantity": {
       "type": "number"
      },
      "store": {
       "type": "string"
      },
      "vintage": {
       "type": "string"
      },
      "wine": {
       "type": "string"
      }
     },
     "required": [
      "date",
      "wine"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalSpent": {
    "type": "number"
   }
  },
  "required": [
   "totalSpent",
   "bottleCount",
   "avgPrice",
   "byStore",
   "recent"
  ],
  "type": "object"
 }
}
