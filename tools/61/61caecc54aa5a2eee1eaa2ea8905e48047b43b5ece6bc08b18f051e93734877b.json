{
 "description": "Apply formatting (colors, borders, fonts, alignment, number formats) to cell ranges without modifying data. Supports batch operations for efficiency. Colors use 0-1 RGB format. Best for creating professional, visually organized spreadsheets.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "requests": {
    "description": "Array of formatting requests. Batch multiple ranges for efficiency.",
    "items": {
     "properties": {
      "backgroundColor": {
       "description": "Cell background color",
       "properties": {
        "blue": {
         "description": "Blue component (0-1)",
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        "green": {
         "description": "Green component (0-1)",
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        "red": {
         "description": "Red component (0-1)",
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        }
       },
       "required": [
        "red",
        "green",
        "blue"
       ],
       "type": "object"
      },
      "bold": {
       "description": "Bold text",
       "type": "boolean"
      },
      "borders": {
       "description": "Cell borders",
       "properties": {
        "color": {
         "description": "Border color",
         "properties": {
          "blue": {
           "description": "Blue component (0-1)",
           "maximum": 1,
           "minimum": 0,
           "type": "number"
          },
          "green": {
           "description": "Green component (0-1)",
           "maximum": 1,
           "minimum": 0,
           "type": "number"
          },
          "red": {
           "description": "Red component (0-1)",
           "maximum": 1,
           "minimum": 0,
           "type": "number"
          }
         },
         "required": [
          "red",
          "green",
          "blue"
         ],
         "type": "object"
        },
        "style": {
         "description": "Border line style",
         "enum": [
          "SOLID",
          "DASHED",
          "DOTTED"
         ],
         "type": "string"
        }
       },
       "required": [
        "style",
        "color"
       ],
       "type": "object"
      },
      "fontSize": {
       "description": "Font size in points",
       "maximum": 36,
       "minimum": 6,
       "type": "integer"
      },
      "horizontalAlignment": {
       "description": "Horizontal text alignment",
       "enum": [
        "LEFT",
        "CENTER",
        "RIGHT"
       ],
       "type": "string"
      },
      "numberFormat": {
       "description": "Number format pattern",
       "properties": {
        "pattern": {
         "description": "Custom format pattern (e.g., \"$#,##0.00\" for currency)",
         "type": "string"
        },
        "type": {
         "description": "Number format type",
         "enum": [
          "TEXT",
          "NUMBER",
          "PERCENT",
          "CURRENCY",
          "DATE",
          "TIME"
         ],
         "type": "string"
        }
       },
       "required": [
        "type"
       ],
       "type": "object"
      },
      "range": {
       "description": "A1 notation range to format (e.g., \"A1:D10\", \"B:B\", \"5:5\")",
       "minLength": 1,
       "type": "string"
      },
      "textColor": {
       "description": "Text color",
       "properties": {
        "blue": {
         "description": "Blue component (0-1)",
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        "green": {
         "description": "Green component (0-1)",
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        "red": {
         "description": "Red component (0-1)",
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        }
       },
       "required": [
        "red",
        "green",
        "blue"
       ],
       "type": "object"
      }
     },
     "required": [
      "range"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "id",
   "gid",
   "requests"
  ],
  "type": "object"
 },
 "name": "cells-format",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "failedRanges": {
        "description": "Only populated if some ranges failed to format",
        "items": {
         "additionalProperties": false,
         "properties": {
          "error": {
           "description": "Why formatting failed for this range",
           "type": "string"
          },
          "range": {
           "description": "A1 notation of range that failed",
           "type": "string"
          }
         },
         "required": [
          "range",
          "error"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "gid": {
        "description": "Sheet ID (from URL gid={gid})",
        "type": "string"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "sheetTitle": {
        "description": "Title of the formatted sheet",
        "type": "string"
       },
       "sheetUrl": {
        "description": "URL of the formatted sheet",
        "type": "string"
       },
       "successCount": {
        "description": "Number of format requests successfully applied",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "id",
       "gid",
       "sheetTitle",
       "sheetUrl",
       "successCount"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
