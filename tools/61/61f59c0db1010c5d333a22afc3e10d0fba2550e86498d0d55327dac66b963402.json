{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a constituent"
 },
 "description": "WRITE: add a new constituent (person or organization) to the account, optionally with email addresses, phone numbers, street addresses and group memberships. LGL's schema marks first_name, last_name and email_addresses as required. Search first (lgl_search_constituents) to avoid creating a duplicate. LGL: POST /api/v1/constituents.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "addressee": {
    "description": "Addressee/label name.",
    "type": "string"
   },
   "annual_report_name": {
    "type": "string"
   },
   "birthday": {
    "description": "Birthday (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "constituent_contact_type_name": {
    "description": "Constituent contact type name, e.g. 'Primary'.",
    "type": "string"
   },
   "deceased_date": {
    "description": "Deceased date.",
    "type": "string"
   },
   "email_addresses": {
    "description": "Email addresses to add.",
    "items": {
     "properties": {
      "address": {
       "description": "Email address.",
       "type": "string"
      },
      "email_type_name": {
       "description": "Email type name, e.g. Home, Work, Other.",
       "type": "string"
      },
      "is_preferred": {
       "type": "boolean"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "external_constituent_id": {
    "description": "External constituent ID (your own system's id).",
    "type": "string"
   },
   "first_name": {
    "description": "First name.",
    "minLength": 1,
    "type": "string"
   },
   "gender": {
    "type": "string"
   },
   "groups": {
    "description": "Group memberships to add.",
    "items": {
     "properties": {
      "date_end": {
       "description": "End date (YYYY-MM-DD).",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "date_start": {
       "description": "Start date (YYYY-MM-DD).",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "group_id": {
       "description": "Group id (see lgl_list_groups).",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "is_current": {
       "type": "boolean"
      }
     },
     "required": [
      "group_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "is_anon": {
    "description": "Gives anonymously?",
    "type": "boolean"
   },
   "is_deceased": {
    "type": "boolean"
   },
   "is_org": {
    "description": "True if this constituent is an organization or company.",
    "type": "boolean"
   },
   "job_title": {
    "type": "string"
   },
   "last_name": {
    "description": "Last name.",
    "minLength": 1,
    "type": "string"
   },
   "maiden_name": {
    "type": "string"
   },
   "middle_name": {
    "type": "string"
   },
   "nick_name": {
    "type": "string"
   },
   "org_name": {
    "description": "Organization name.",
    "type": "string"
   },
   "phone_numbers": {
    "description": "Phone numbers to add.",
    "items": {
     "properties": {
      "is_preferred": {
       "type": "boolean"
      },
      "number": {
       "description": "Phone number.",
       "type": "string"
      },
      "phone_type_name": {
       "description": "Phone type name, e.g. Home, Mobile, Work.",
       "type": "string"
      }
     },
     "required": [
      "number"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "prefix": {
    "description": "Prefix, e.g. 'Dr.'.",
    "type": "string"
   },
   "salutation": {
    "type": "string"
   },
   "spouse_name": {
    "description": "Spouse/partner name.",
    "type": "string"
   },
   "street_addresses": {
    "description": "Street addresses to add.",
    "items": {
     "properties": {
      "city": {
       "type": "string"
      },
      "country": {
       "type": "string"
      },
      "county": {
       "type": "string"
      },
      "is_preferred": {
       "type": "boolean"
      },
      "postal_code": {
       "type": "string"
      },
      "state": {
       "description": "State/province.",
       "type": "string"
      },
      "street": {
       "type": "string"
      },
      "street_type_name": {
       "description": "Address type name, e.g. Home, Work.",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "suffix": {
    "type": "string"
   }
  },
  "required": [
   "first_name",
   "last_name"
  ],
  "type": "object"
 },
 "name": "lgl_create_constituent",
 "title": "Create a constituent"
}
