{
 "description": "Convert timber quantities between m3, ft3, board feet, MBF, Hoppus ft3, Hoppus m3 and Hoppus tons, and translate a price quoted in any unit into $/m3 and $/MBF (1 MBF = 2.3597 m3).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "from": {
    "description": "Source unit",
    "enum": [
     "m3",
     "ft3",
     "bf",
     "mbf",
     "hft3",
     "hm3",
     "ht"
    ],
    "type": "string"
   },
   "price": {
    "description": "Optional price per price_per unit",
    "minimum": 0,
    "type": "number"
   },
   "price_per": {
    "default": "mbf",
    "enum": [
     "m3",
     "ft3",
     "bf",
     "mbf",
     "hft3",
     "hm3",
     "ht"
    ],
    "type": "string"
   },
   "qty": {
    "default": 1,
    "description": "Multiplier (number of lots)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "value": {
    "description": "Quantity in the source unit",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "value",
   "from"
  ],
  "type": "object"
 },
 "name": "timber_unit_converter"
}
