{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List available Chutes media-generation models (image / video / music / speech), optionally filtered by kind or a free-text query. Use this to discover a model, then call describe_media_model before generate_media.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "kind": {
    "enum": [
     "image",
     "video",
     "music",
     "speech"
    ],
    "type": "string"
   },
   "limit": {
    "exclusiveMinimum": 0,
    "maximum": 200,
    "type": "integer"
   },
   "query": {
    "description": "Free-text filter on the model name.",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_media_models",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "minimum": 0,
    "type": "integer"
   },
   "models": {
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "models"
  ],
  "type": "object"
 },
 "title": "List Chutes media models"
}
