{
 "description": "Flag an open risk the next agent should know before acting.",
 "inputSchema": {
  "properties": {
   "agent": {
    "description": "acting agent identity (defaults to OCTOBOARD_AGENT)",
    "type": "string"
   },
   "severity": {
    "default": "medium",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "board_risk"
}
