{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this first when the user names a GPU, Mac, mini PC or language model and you need its id for the other tools. Matches names and common aliases in a fixed catalogue of local-LLM hardware and models. It does not return specs, fit or speed, and it does not search the web.",
 "inputSchema": {
  "properties": {
   "kind": {
    "description": "Search hardware or models. Required.",
    "enum": [
     "hardware",
     "model"
    ],
    "type": "string"
   },
   "limit": {
    "default": 5,
    "description": "Maximum matches, 1 to 10. Default 5.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Hardware or model name as the user wrote it, e.g. \"4090\", \"m4 max 64\", \"llama 3.3 70b\".",
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
    "type": "string"
   }
  },
  "required": [
   "query",
   "kind"
  ],
  "type": "object"
 },
 "name": "search_catalog",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data_as_of": {
    "description": "Date the bundled catalogue was last updated. Not the time of this call.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "kind": {
    "enum": [
     "hardware",
     "model"
    ],
    "type": "string"
   },
   "matches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "description": "A short factual line, e.g. \"24 GB, 1008 GB/s\" or \"8B dense\".",
       "maxLength": 160,
       "type": "string"
      },
      "id": {
       "description": "Pass this id to the other tools.",
       "maxLength": 80,
       "minLength": 1,
       "pattern": "^[a-z0-9][a-z0-9._-]*$",
       "type": "string"
      },
      "kind": {
       "enum": [
        "hardware",
        "model"
       ],
       "type": "string"
      },
      "name": {
       "maxLength": 120,
       "type": "string"
      },
      "url": {
       "pattern": "^https:\\/\\/llmconfigurator\\.com\\/en\\/",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "kind",
      "detail",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "description": "One or two plain-language sentences stating the answer.",
    "maxLength": 600,
    "type": "string"
   }
  },
  "required": [
   "data_as_of",
   "summary",
   "kind",
   "matches"
  ],
  "type": "object"
 },
 "title": "Find hardware or a model"
}
