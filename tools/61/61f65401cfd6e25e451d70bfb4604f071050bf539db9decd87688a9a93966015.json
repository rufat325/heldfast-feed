  "readOnlyHint": true,
  "title": "chainpeek: recent large trades on a token, who is buying and selling, on Base or Ethereum"
 },
 "description": "chainpeek: Who is buying this token? Recent large trades: big buys and sells on Base or Ethereum. For Solana use get_large_solana_token_trades; for a quote at your size use get_swap_quote. Returns who bought and sold an ERC-20 in size: the recent large buys and sells of it on Base or Ethereum from DEX swap events (Uniswap V2/V3, Aerodrome): time, side, token amount, USD size, the transaction sender as `wallet`, tx hash and pool, newest first, at most 50. Size-based only, no wallet is labelled; read from swap events of the top 3 pools, so it can miss trades elsewhere; amounts are heuristic; a bad address or a window over 60 minutes (Base) or 240 (Ethereum) is a 422 (not charged); cached 30 s. Typically 3 to 6 s (pool discovery, one log read per pool, one batch for the senders), at most 25 s. Price: USD 0.01. Free: 10 chain reads per IP per UTC day. Docs: https://tanod.dev/learn/token-large-trades-api.html",
 "inputSchema": {
  "properties": {
   "chain": {
    "default": "base",
    "description": "base (default) or ethereum.",
    "enum": [
     "base",
     "ethereum"
    ],
    "title": "Chain",
    "type": "string"
   },
   "min_usd": {
    "default": 1000,
    "description": "Smallest trade to report, in USD of the quote side (default 1000, minimum 100).",
    "maximum": 1000000000,
    "minimum": 100,
    "title": "Min Usd",
    "type": "number"
   },
   "token": {
    "description": "ERC-20 token address (0x + 40 hex).",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "title": "Token",
    "type": "string"
   },
   "window_minutes": {
    "default": 60,
    "description": "How far back to read, in minutes (default 60). At most 60 on Base and 240 on Ethereum, so that the window fits one eth_getLogs read of at most 2,000 blocks per pool.",
    "maximum": 240,
    "minimum": 1,
    "title": "Window Minutes",
    "type": "integer"
   }
  },
  "required": [
   "token"
  ],
  "title": "get_large_token_tradesArguments",
  "type": "object"
 },
 "name": "get_large_token_trades",
