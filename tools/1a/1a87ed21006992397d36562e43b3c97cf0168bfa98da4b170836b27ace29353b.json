{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false,"title":"Edit the creator profile"},"description":"Changes the creator profile: only the fields passed (null clears one). The address goes to a brand only if it ships product and has accepted, unless share_address is never. results turns on the public results page (/@page/results) and whether applications link to it.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"address":{"anyOf":[{"properties":{"city":{"maxLength":80,"minLength":1,"type":"string"},"country":{"maxLength":60,"minLength":2,"type":"string"},"line1":{"maxLength":120,"minLength":1,"type":"string"},"line2":{"anyOf":[{"maxLength":120,"type":"string"},{"type":"null"}]},"name":{"maxLength":120,"type":"string"},"postal":{"maxLength":20,"minLength":1,"type":"string"},"region":{"anyOf":[{"maxLength":80,"type":"string"},{"type":"null"}]}},"required":["name","line1","city","postal","country"],"type":"object"},{"type":"null"}]},"amazon_tag":{"anyOf":[{"pattern":"^[a-z0-9][a-z0-9-]{0,40}-[0-9]{2}$","type":"string"},{"type":"null"}],"description":"Amazon Associates tracking ID, like yourname-20: product posts and new links add it to Amazon links that have none"},"email":{"anyOf":[{"format":"email","maxLength":254,"pattern":"^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},{"type":"null"}],"description":"null: use the deals address"},"idempotency_key":{"description":"Any unique string, e.g. a UUID. A retry with the same key within 24 hours returns the first call's result instead of doing it again.","maxLength":255,"minLength":1,"type":"string"},"interests":{"items":{"enum":["beauty","skincare","fashion","fitness","outdoors","travel","food","coffee","home","tech","photography","gaming","parenting","pets","wellness","books","music","art","finance","sports"],"type":"