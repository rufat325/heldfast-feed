{
 "description": "Export markdown to a file (PDF, DOCX, or HTML). Saves a markdown document as a downloadable file in a specific format.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "description": "Output format",
    "enum": [
     "pdf",
     "docx",
     "html"
    ],
    "type": "string"
   },
   "github": {
    "additionalProperties": false,
    "properties": {
     "branch": {
      "type": "string"
     },
     "owner": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "repo": {
      "type": "string"
     }
    },
    "required": [
     "owner",
     "repo",
     "path"
    ],
    "type": "object"
   },
   "markdown": {
    "description": "The markdown content to export",
    "type": "string"
   },
   "outputPath": {
    "description": "Where to save the file. Defaults to current directory.",
    "type": "string"
   },
   "showToc": {
    "description": "Include table of contents (default: true)",
    "type": "boolean"
   },
   "theme": {
    "description": "Theme name",
    "type": "string"
   },
   "title": {
    "description": "Document title (used for filename and document header)",
    "type": "string"
   }
  },
  "required": [
   "markdown",
   "title",
   "format"
  ],
  "type": "object"
 },
 "name": "export_markdown"
}
