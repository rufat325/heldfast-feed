 "description": "Find important work you HAVEN'T saved, for a collection or topic \u2014 a 'what am I missing?' analysis. Returns two buckets: foundational_gaps (canonical citation-graph anchors in the niche, not in your library) and frontier_gaps (recent high-novelty work in the niche, not yet saved). Provide exactly one seed: collection_name OR collection_id OR topic. The backend derives the niche, runs lineage + recent-novelty search, and subtracts your saved set. Read-only. Requires SF_API_KEY (it needs your library to subtract) and is a Pro feature \u2014 free accounts receive an upgrade prompt.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collection_id": {
    "description": "Analyze gaps for a collection by UUID. Provide exactly one seed.",
    "type": "string"
   },
   "collection_name": {
    "description": "Analyze gaps for a collection by name (resolved by the backend). Provide exactly one seed.",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Max gaps per bucket (max 50). Default 10.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "scope": {
    "default": "both",
    "description": "Which gaps to surface: 'foundational' (canonical anchors you're missing), 'frontier' (recent novel work you haven't saved), or 'both' (default).",
    "enum": [
     "foundational",
     "frontier",
     "both"
    ],
    "type": "string"
   },
   "topic": {
    "description": "Analyze gaps for a free-text topic/area. Provide exactly one seed.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
