{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Plan a conversion A/B test before running it: visitors per variant needed to detect a given relative lift (same formula as R's power.prop.test, two-sided), and how many days that takes with your traffic. Or the reverse: the smallest lift detectable with the visitors you can get.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "alpha": {
    "default": 0.05,
    "exclusiveMaximum": 0.5,
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "baselineRate": {
    "description": "Control conversion rate, e.g. 0.10",
    "exclusiveMaximum": 1,
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "dailyVisitors": {
    "description": "Daily traffic, for the duration",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "power": {
    "default": 0.8,
    "exclusiveMaximum": 1,
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "relativeLift": {
    "description": "Relative lift to detect: 0.1 = +10%. Or give visitorsPerVariant",
    "exclusiveMinimum": -1,
    "type": "number"
   },
   "trafficFraction": {
    "default": 1,
    "exclusiveMinimum": 0,
    "maximum": 1,
    "type": "number"
   },
   "variants": {
    "default": 2,
    "maximum": 20,
    "minimum": 2,
    "type": "integer"
   },
   "visitorsPerVariant": {
    "description": "\u2192 minimum detectable lift instead",
    "minimum": 2,
    "type": "integer"
   }
  },
  "required": [
   "baselineRate"
  ],
  "type": "object"
 },
 "name": "abtest_sample_size"
}
