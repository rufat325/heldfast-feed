 "description": "The listings that fit one client's search in YOUR agency's CRM: your\nown listings first, then shared MLS listings your agency can sell,\nnewest first. Each listing says whether it is your own.\n\nUses the client's saved search (or, if none is saved, the search\ntheir latest debrief described), the same search the CRM runs for\nthat client. A client with no search returns an explanation rather\nthan a guess; set one up in the CRM or ask the agent for the brief\nand use search_properties instead.\n\nGet the contact_id from find_contacts. Call get_contact first if you\nneed to know what has already been sent to them.\n\nRequires a linked PropertyList account (or an agency API key); only the calling agency's\nclients that the caller may see in the CRM.\n",
 "inputSchema": {
  "properties": {
   "contact_id": {
    "description": "The client, from find_contacts or my_pipeline.",
    "type": "integer"
   },
   "language": {
    "default": "en",
    "description": "Language for listing titles and excerpts.",
    "enum": [
     "en",
     "es",
     "de",
     "fr",
     "it",
     "nl",
     "pt",
     "bg",
     "el",
     "da",
     "sv",
     "no",
     "fi",
     "pl",
     "ru"
    ],
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "contact_id"
  ],
  "type": "object"
 },
