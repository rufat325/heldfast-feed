{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a Stripe Checkout URL the user can open in a browser to upgrade their clariBI subscription. Payment cannot happen inside the LLM; this tool returns a URL.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "billing_period": {
    "default": "monthly",
    "description": "Billing cadence for the checkout. Defaults to monthly.",
    "enum": [
     "monthly",
     "yearly"
    ],
    "type": "string"
   },
   "tier": {
    "description": "Target subscription tier.",
    "enum": [
     "starter",
     "professional",
     "enterprise"
    ],
    "type": "string"
   }
  },
  "required": [
   "tier"
  ],
  "type": "object"
 },
 "name": "create_checkout_session",
 "outputSchema": {
  "properties": {
   "billing_period": {
    "description": "monthly or yearly.",
    "type": "string"
   },
   "checkout_url": {
    "description": "Stripe Checkout URL. Open in a browser to complete payment.",
    "format": "uri",
    "type": "string"
   },
   "session_id": {
    "description": "Stripe Checkout Session id.",
    "type": "string"
   },
   "tier": {
    "type": "string"
   }
  },
  "required": [
   "checkout_url",
   "session_id",
   "tier",
   "billing_period"
  ],
  "type": "object"
 }
}
