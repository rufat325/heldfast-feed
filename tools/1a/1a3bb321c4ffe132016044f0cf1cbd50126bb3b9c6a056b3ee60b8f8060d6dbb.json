{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Applied Model Tracker price changes (input, output, cached input per 1M text tokens) since an ISO 8601 time, newest first, each with model, previous and new value as stored, source URL and time. History starts 2026-10-05.",
