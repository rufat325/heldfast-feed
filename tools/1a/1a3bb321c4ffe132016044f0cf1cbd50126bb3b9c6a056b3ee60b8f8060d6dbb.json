  "properties": {
   "limit": {
    "default": 200,
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "since": {
    "format": "date-time",
    "type": "string"
   }
  },
  "required": [
   "since"
  ],
  "type": "object"
 },
 "name": "price_changes_since",
 "outputSchema": {
  "properties": {
   "attribution": {
    "type": "string"
   },
   "data": {
    "properties": {
     "changes": {
      "items": {
       "properties": {
        "at": {
         "description": "ISO 8601 time the change was applied",
         "type": "string"
        },
        "field": {
         "type": "string"
        },
        "from": {
         "description": "value before the change as stored; null = no value on record before",
         "type": [
          "string",
          "null"
         ]
        },
        "sourceUrl": {
         "type": "string"
        },
        "to": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "field",
        "from",
        "to",
        "at",
        "sourceUrl"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "since": {
      "type": "string"
     },
     "total": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "license": {
    "type": "object"
   }
  },
  "required": [
