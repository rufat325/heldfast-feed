        }
       },
       "required": [
        "externalId",
        "name"
       ],
       "type": "object"
      },
      "provider": {
       "const": "HUBSTAFF",
       "type": "string"
      },
      "sessionId": {
       "minLength": 1,
       "type": "string"
      },
      "source": {
       "additionalProperties": false,
       "properties": {
