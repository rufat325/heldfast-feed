      },
      "manual": {
       "type": "boolean"
      },
      "memo": {
       "type": "null"
      },
      "memoAvailability": {
       "const": "NOT_CAPTURED_BY_PROVIDER",
       "type": "string"
      },
      "paid": {
       "type": "boolean"
      },
      "project": {
