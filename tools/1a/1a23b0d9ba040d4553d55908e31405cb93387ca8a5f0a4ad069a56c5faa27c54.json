       ],
       "type": "object"
      },
      "startsAt": {
       "minLength": 1,
       "type": "string"
      },
      "stopsAt": {
       "minLength": 1,
       "type": "string"
      },
      "task": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "externalId": {
           "minLength": 1,
           "type": "string"
          },
          "name": {
           "type": [
            "string",
            "null"
           ]
          }
         },
         "required": [
          "externalId",
          "name"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "sessionId",
      "provider",
      "contract",
      "startsAt",
      "stopsAt",
      "durationSeconds",
