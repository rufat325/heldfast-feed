{
 "description": "List session-level provider (Hubstaff) time evidence for one employer job: masked worker identity, start/stop/duration, input activity, provider project/task, manual/billable/paid/locked state, approval period, stable source IDs, and sync freshness. Optional UTC-date range, contract, status, and cursor/limit filters. Memos are honest nulls because this provider does not capture them. Requires time:read plus provider-authorized job access; denials are non-enumerating 404s. Never returns screenshots, window titles, or raw provider payloads.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contractId": {
    "$ref": "#/properties/jobId"
   },
   "cursor": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "from": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "jobId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "enum": [
     "PAID",
     "UNPAID",
     "LOCKED",
     "UNLOCKED",
     "MANUAL",
     "AUTOMATIC",
     "BILLABLE",
     "NON_BILLABLE"
    ],
    "type": "string"
   },
   "to": {
    "$ref": "#/properties/from"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "opentrain_list_job_time_sessions",
