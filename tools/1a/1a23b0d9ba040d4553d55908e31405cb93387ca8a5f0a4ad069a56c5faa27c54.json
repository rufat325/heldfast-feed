     "lastSyncStartedAt",
     "lastSyncCompletedAt",
     "lastSyncStatus",
     "freshness"
    ],
    "type": "object"
   },
   "timezone": {
    "const": "UTC",
    "type": "string"
   },
   "to": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "provider",
   "from",
   "to",
   "timezone",
   "asOf",
   "source",
   "sessions",
   "page"
  ],
  "type": "object"
 }
}
