        {
         "additionalProperties": false,
         "properties": {
          "id": {
           "minLength": 1,
           "type": "string"
          },
          "periodStart": {
           "minLength": 1,
           "type": "string"
          },
          "periodStop": {
           "minLength": 1,
           "type": "string"
          },
          "status": {
           "minLength": 1,
           "type": "string"
          },
          "updatedAt": {
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "id",
          "status",
          "periodStart",
          "periodStop",
          "updatedAt"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "billable": {
