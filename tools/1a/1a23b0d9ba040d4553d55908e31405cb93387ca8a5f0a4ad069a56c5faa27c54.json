    "minLength": 1,
    "type": "string"
   },
   "page": {
    "additionalProperties": false,
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "limit": {
      "minimum": 1,
      "type": "integer"
     },
     "nextCursor": {
      "anyOf": [
       {
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "limit",
     "hasMore",
     "nextCursor"
    ],
    "type": "object"
   },
   "provider": {
    "const": "HUBSTAFF",
    "type": "string"
   },
   "sessions": {
