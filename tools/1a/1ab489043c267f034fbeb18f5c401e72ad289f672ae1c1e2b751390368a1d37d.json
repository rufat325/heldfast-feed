{
 "description": "Sl\u00e5 opp matrikkeleiendom enten via et geografisk punkt (lat/lon) eller via matrikkelnummer (knr/gnr/bnr, evt. festenr/seksjonsnr). Returnerer matrikkelnummer, lokalid og representasjonspunkt (WGS84).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bnr": {
    "description": "Bruksnummer for matrikkeloppslag",
    "minimum": 0,
    "type": "integer"
   },
   "fnr": {
    "description": "Festenummer (valgfritt)",
    "minimum": 0,
    "type": "integer"
   },
   "gnr": {
    "description": "G\u00e5rdsnummer for matrikkeloppslag",
    "minimum": 1,
    "type": "integer"
   },
   "knr": {
    "description": "Kommunenummer (4 sifre) for matrikkeloppslag",
    "pattern": "^\\d{4}$",
    "type": "string"
   },
   "lat": {
    "description": "Breddegrad (WGS84). Brukes med lon for punkts\u00f8k.",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "lon": {
    "description": "Lengdegrad (WGS84). Brukes med lat for punkts\u00f8k.",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "radius": {
    "description": "S\u00f8keradius i meter for punkts\u00f8k (default 0/eksakt)",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "snr": {
    "description": "Seksjonsnummer (valgfritt)",
    "minimum": 0,
    "type": "integer"
   },
   "treffPerSide": {
    "description": "Maks treff i punkts\u00f8k (default 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "sok_eiendom"
}
