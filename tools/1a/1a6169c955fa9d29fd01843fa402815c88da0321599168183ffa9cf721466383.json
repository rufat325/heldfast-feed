{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch 1-7 month ECMWF SEAS5 seasonal forecast for one Mediterranean point. Returns ensemble-mean DAILY + MONTHLY aggregates of wind, SST, temperature, precipitation, cloud cover (extend via variables[]). NO waves \u2014 chain nausika_marine_forecast for short-term wind + waves.\n\nInputs: latitude, longitude, start_date, end_date, variables.\nExample: latitude=40.12, longitude=9.01, start_date=\"2026-08-01\", end_date=\"2026-08-31\". SEAS5 forecasts forward only: a start_date in the past is clamped to today and an end_date beyond today+210d is clamped to the horizon, both reported in the response. A window that ends in the past is rejected.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "end_date": {
    "description": "Window end date (UTC, ISO YYYY-MM-DD). Must be \u2265 start_date. Dates beyond the SEAS5 horizon (today + 210 days) are clamped \u2014 the response reports the adjustment.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "include_members": {
    "default": false,
    "description": "When true, expose all 50 ECMWF SEAS5 ensemble members (`<var>_memberNN`) in the response. Default (false) collapses them into `_p10/_p50/_p90` percentile series alongside the ensemble mean \u2014 ~20\u00d7 smaller payload, same statistical signal.",
    "type": "boolean"
   },
   "latitude": {
    "description": "Latitude in decimal degrees (WGS84, -90 to 90)",
    "examples": [
     38.7,
     43.55,
     41.39
    ],
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "description": "Longitude in decimal degrees (WGS84, -180 to 180)",
    "examples": [
     9.14,
     10.32,
     2.17
    ],
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "start_date": {
    "description": "Window start date (UTC, ISO YYYY-MM-DD). Dates before today are clamped to today (SEAS5 forecasts forward only) \u2014 the response reports the adjustment.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "variables": {
    "description": "Additional variables, additive to the core set (wind_speed_10m, wind_direction_10m, sea_surface_temperature, temperature_2m, precipitation, cloud_cover). Each is expanded server-side into the appropriate daily and monthly aggregates. Defaults to core variables only.",
    "examples": [
     [
      "sunshine_duration",
      "pressure_msl"
     ],
     [
      "apparent_temperature",
      "relative_humidity_2m"
     ]
    ],
    "items": {
     "enum": [
      "wind_speed_10m",
      "wind_direction_10m",
      "sea_surface_temperature",
      "temperature_2m",
      "precipitation",
      "cloud_cover",
      "pressure_msl",
      "surface_pressure",
      "sunshine_duration",
      "shortwave_radiation",
      "apparent_temperature",
      "dew_point_2m",
      "relative_humidity_2m",
      "weather_code",
      "sunrise_sunset",
      "snowfall",
      "snow_depth"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "latitude",
   "longitude",
   "start_date",
   "end_date"
  ],
  "type": "object"
 },
 "name": "nausika_seasonal_forecast",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_attribution": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "license": {
       "type": "string"
      },
      "license_url": {
       "type": "string"
      },
      "source_url": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "text",
      "license",
      "source_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "_disclaimer": {
    "type": "string"
   },
   "coordinates_requested": {
    "additionalProperties": false,
    "properties": {
     "latitude": {
      "type": "number"
     },
     "longitude": {
      "type": "number"
     }
    },
    "required": [
     "latitude",
     "longitude"
    ],
    "type": "object"
   },
   "coordinates_resolved": {
    "additionalProperties": false,
    "properties": {
     "distance_km": {
      "type": "number"
     },
     "latitude": {
      "type": "number"
     },
     "longitude": {
      "type": "number"
     }
    },
    "required": [
     "latitude",
     "longitude",
     "distance_km"
    ],
    "type": "object"
   },
   "daily": {
    "additionalProperties": {
     "items": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "type": "array"
    },
    "properties": {
     "time": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "time"
    ],
    "type": "object"
   },
   "model": {
    "enum": [
     "seas5"
    ],
    "type": "string"
   },
   "monthly": {
    "additionalProperties": {
     "items": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "type": "array"
    },
    "properties": {
     "time": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "time"
    ],
    "type": "object"
   },
   "monthly_derived": {
    "type": "boolean"
   },
   "range": {
    "additionalProperties": false,
    "properties": {
     "end_date": {
      "type": "string"
     },
     "start_date": {
      "type": "string"
     }
    },
    "required": [
     "start_date",
     "end_date"
    ],
    "type": "object"
   },
   "timezone": {
    "enum": [
     "UTC"
    ],
    "type": "string"
   },
   "units": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "window_adjusted": {
    "type": "string"
   }
  },
  "required": [
   "coordinates_requested",
   "coordinates_resolved",
   "range",
   "model",
   "timezone",
   "daily",
   "monthly",
   "units"
  ],
  "type": "object"
 },
 "title": "Seasonal Forecast"
}
