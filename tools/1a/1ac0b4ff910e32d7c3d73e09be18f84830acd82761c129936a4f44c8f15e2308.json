{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update the Kubernetes groups and/or NKS access policies of an IAM access entry (PUT \u2014 the supplied lists replace the existing ones)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clusterUuid": {
    "description": "UUID of the cluster",
    "type": "string"
   },
   "entryUuid": {
    "description": "IAM access entry UUID",
    "type": "string"
   },
   "groups": {
    "description": "Kubernetes group names (replaces the existing list)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "policies": {
    "description": "NKS access policies (replaces the existing list)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "namespaces": {
       "description": "Target namespaces \u2014 required when scope is 'namespace'",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "scope": {
       "description": "Policy scope",
       "enum": [
        "cluster",
        "namespace"
       ],
       "type": "string"
      },
      "type": {
       "description": "NKS access policy type",
       "enum": [
        "NKSClusterAdminPolicy",
        "NKSAdminPolicy",
        "NKSEditPolicy",
        "NKSViewPolicy"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "scope"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "clusterUuid",
   "entryUuid"
  ],
  "type": "object"
 },
 "name": "ncloud_nks_update_access_entry"
}
