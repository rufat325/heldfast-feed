{
 "annotations": {
  "readOnlyHint": true,
  "title": "Check Trust Score"
 },
 "description": "Get the trust score and reliability metrics for any MCP server. Use this BEFORE calling an unknown MCP server to assess if it's reliable. Returns trust_score (0-100), latency stats, uptime, success rate, and how many agents have used it. Scores above 70 indicate reliable servers. Scores below 30 indicate risky servers.",
 "inputSchema": {
  "properties": {
   "server_url": {
    "description": "The URL of the MCP server to check (e.g., https://example.workers.dev/mcp)",
    "type": "string"
   }
  },
  "required": [
   "server_url"
  ],
  "type": "object"
 },
 "name": "check_trust",
 "outputSchema": {
  "properties": {
   "category": {
    "description": "Server category (search, code, database, etc.)",
    "type": "string"
   },
   "first_seen": {
    "description": "ISO date when first tracked",
    "type": "string"
   },
   "found": {
    "description": "Whether the server was found in the observatory",
    "type": "boolean"
   },
   "last_checked": {
    "description": "ISO date of last check",
    "type": "string"
   },
   "metrics": {
    "properties": {
     "avg_latency_ms": {
      "description": "Average latency in ms",
      "type": "number"
     },
     "p95_latency_ms": {
      "description": "95th percentile latency in ms",
      "type": "number"
     },
     "success_rate": {
      "description": "Success rate as percentage",
      "type": "number"
     },
     "total_calls": {
      "description": "Total tracked interactions",
      "type": "integer"
     },
     "uptime_30d": {
      "description": "30-day uptime percentage",
      "type": "number"
     }
    },
    "type": "object"
   },
   "name": {
    "description": "Server display name",
    "type": "string"
   },
   "recent_7d": {
    "properties": {
     "avg_latency_ms": {
      "type": "number"
     },
     "interactions": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "runtime_score": {
    "description": "Runtime behavioral score 0-100",
    "type": "number"
   },
   "server_url": {
    "description": "The queried server URL",
    "type": "string"
   },
   "static_score": {
    "description": "Static analysis score 0-100",
    "type": "number"
   },
   "trust_score": {
    "description": "Overall trust score 0-100",
    "type": "number"
   }
  },
  "type": "object"
 }
}
