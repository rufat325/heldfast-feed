{
 "description": "Get hotel and vacation-rental prices, ratings and availability from Google Hotels.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adults": {
    "description": "Number of adults. (API default: 2)",
    "type": "number"
   },
   "check_in_date": {
    "description": "Check-in date, YYYY-MM-DD.",
    "type": "string"
   },
   "check_out_date": {
    "description": "Check-out date, YYYY-MM-DD.",
    "type": "string"
   },
   "children": {
    "description": "Number of children. (API default: 0)",
    "type": "number"
   },
   "children_ages": {
    "description": "Comma-separated child ages 1-17 (e.g. '5,8,10').",
    "type": "string"
   },
   "country": {
    "description": "Two-letter ISO country code to geo-target results (e.g. us, gb, in, de). (API default: us)",
    "type": "string"
   },
   "currency": {
    "description": "Pricing currency. (API default: USD)",
    "type": "string"
   },
   "free_cancellation": {
    "description": "Only show free-cancellation options.",
    "type": "boolean"
   },
   "hotel_class": {
    "description": "Star class filter (2-5), comma-separated.",
    "type": "string"
   },
   "html": {
    "description": "Return raw HTML instead of parsed JSON. (API default: false)",
    "type": "boolean"
   },
   "language": {
    "description": "Result language code (e.g. en, es, fr, de). (API default: en)",
    "type": "string"
   },
   "max_price": {
    "description": "Maximum price filter.",
    "type": "number"
   },
   "min_price": {
    "description": "Minimum price filter.",
    "type": "number"
   },
   "next_page_token": {
    "description": "Pagination token from a previous response.",
    "type": "string"
   },
   "property_token": {
    "description": "Token for detailed property information.",
    "type": "string"
   },
   "query": {
    "description": "Hotel search query (e.g. 'hotels in Paris').",
    "type": "string"
   },
   "rating": {
    "description": "Min rating: 7=3.5+, 8=4.0+, 9=4.5+.",
    "enum": [
     "7",
     "8",
     "9"
    ],
    "type": "string"
   },
   "sort_by": {
    "description": "Sort: 3=lowest price, 8=highest rating, 13=most reviews.",
    "enum": [
     "3",
     "8",
     "13"
    ],
    "type": "string"
   },
   "vacation_rentals": {
    "description": "Search vacation rentals instead of hotels. (API default: false)",
    "type": "boolean"
   }
  },
  "required": [
   "query",
   "check_in_date",
   "check_out_date"
  ],
  "type": "object"
 },
 "name": "google_hotels",
 "title": "Google Hotels API"
}
