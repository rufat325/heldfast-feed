     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "photosLogosOrVideo": {
    "description": "Photos, logos or video, not just text (weight 15)",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "placedNearDecisionPoints": {
    "description": "Placed near decision points / CTAs (weight 15)",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
