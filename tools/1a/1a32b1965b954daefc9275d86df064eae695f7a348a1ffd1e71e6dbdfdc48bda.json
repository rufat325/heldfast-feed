{
 "description": "Edit the metadata of one of the user\u2019s own assets. The uploaded GLB can never be changed. Editing an asset that is already published does not change it: the proposal goes to the review queue and the live version keeps serving until a person approves it.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "aiGenerated": {
    "type": "boolean"
   },
   "aiModel": {
    "description": "Model ID or custom name; empty string clears attribution",
    "maxLength": 160,
    "type": "string"
   },
   "category": {
    "description": "From list_categories",
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "description": {
    "maxLength": 5000,
    "type": "string"
   },
   "slug": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "summary": {
    "maxLength": 280,
    "minLength": 10,
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "title": {
    "maxLength": 120,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "update_asset",
 "title": "Update asset"
}
