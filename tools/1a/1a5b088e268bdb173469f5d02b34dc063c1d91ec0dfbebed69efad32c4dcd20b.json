{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Create Order Payment"
 },
 "description": "Record a payment against an order (amount, type, status, paid_at). Returns {success, id}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Payment amount",
    "type": "number"
   },
   "order_external_id": {
    "description": "Order externalId (alternative to order_id)",
    "type": "string"
   },
   "order_id": {
    "description": "Order RetailCRM ID the payment belongs to",
    "type": "integer"
   },
   "paid_at": {
    "description": "Paid timestamp 'YYYY-MM-DD HH:MM:SS'",
    "type": "string"
   },
   "site": {
    "description": "Site (store) symbolic code. Required on create/edit when the API key is scoped to multiple sites (see list_sites).",
    "type": "string"
   },
   "status": {
    "description": "Payment status code (e.g. 'paid')",
    "type": "string"
   },
   "type": {
    "description": "Payment type code (see list_payment_types)",
    "type": "string"
   }
  },
  "required": [
   "amount",
   "type"
  ],
  "type": "object"
 },
 "name": "order_payment_create"
}
