{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Send a message to a Talk conversation. Supports replies and silent messages that do not trigger notifications.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "message": {
    "description": "Message text to send",
    "type": "string"
   },
   "replyTo": {
    "description": "Message ID to reply to",
    "type": "number"
   },
   "silent": {
    "description": "Send without triggering notifications (default false)",
    "type": "boolean"
   },
   "token": {
    "description": "Conversation token",
    "type": "string"
   }
  },
  "required": [
   "token",
   "message"
  ],
  "type": "object"
 },
 "name": "talk_send_message",
 "title": "Send Talk Message"
}
