{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Verify that a Korean business registration number matches the provided representative name and opening date. Use for KYB / due-diligence before transacting with a Korean company. Returns match result plus current status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Optional business address to include in the match (maps to NTS b_adr)",
    "type": "string"
   },
   "business_number": {
    "description": "10-digit Korean business registration number; hyphens/spaces allowed",
    "type": "string"
   },
   "opening_date": {
    "description": "Business opening date in YYYY-MM-DD format, e.g. \"2015-03-02\"",
    "type": "string"
   },
   "representative_name": {
    "description": "Representative (CEO) name as registered, e.g. \"\ud64d\uae38\ub3d9\"",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "business_number",
   "representative_name",
   "opening_date"
  ],
  "type": "object"
 },
 "name": "verify_korean_business",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "business_number": {
    "type": "string"
   },
   "cache": {
    "type": "boolean"
   },
   "checked_at": {
    "type": "string"
   },
   "closed_date": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "identity_match": {
    "type": "boolean"
   },
   "source": {
    "const": "Korea National Tax Service (NTS)",
    "type": "string"
   },
   "status": {
    "enum": [
     "active",
     "suspended",
     "closed",
     "not_registered"
    ],
    "type": "string"
   },
   "status_code_raw": {
    "type": "string"
   },
   "tax_type": {
    "enum": [
     "general",
     "simplified",
     "exempt",
     "non_profit",
     "unknown"
    ],
    "type": "string"
   }
  },
  "required": [
   "business_number",
   "status",
   "status_code_raw",
   "tax_type",
   "closed_date",
   "checked_at",
   "source",
   "cache",
   "identity_match"
  ],
  "type": "object"
 },
 "title": "Verify Korean business identity"
}
