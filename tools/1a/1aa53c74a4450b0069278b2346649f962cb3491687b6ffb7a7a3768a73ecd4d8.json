{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp_crm"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find contacts"
 },
 "description": "Search YOUR agency's CRM contacts by name, company, email or phone.\nUse to look a person up before logging a note or to check if they're\nalready in the CRM. Requires a linked PropertyList account (or an\nagency API key); only ever searches the calling agency's own\ncontacts.\n",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Name, company, email or phone fragment to search for.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "find_contacts",
 "outputSchema": {
  "properties": {
   "contacts": {
    "items": {
     "properties": {
      "company_name": {
       "type": "string"
      },
      "created_at": {
       "description": "ISO 8601, UTC.",
       "type": "string"
      },
      "emails": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "description": "contact_id, for log_note.",
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "phones": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "pipelines": {
       "description": "Board name to the stage this contact is in, in the agency's own stage names.",
       "type": "object"
      },
      "surname": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "count": {
    "type": "integer"
   }
  },
  "required": [
   "count",
   "contacts"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "mcp_crm"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Find contacts"
}
