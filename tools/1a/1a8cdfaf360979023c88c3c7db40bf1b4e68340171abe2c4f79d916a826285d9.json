{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Pre-Grant Publication"
 },
 "description": "The pre-grant publication (as-filed) for a US patent: publication number/date plus the as-filed abstract and claims parsed from the application XML. Useful for comparing as-filed vs as-granted claim scope. Free, public-record.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "patentNumber": {
    "description": "US patent number (e.g. US10000000B2).",
    "type": "string"
   }
  },
  "required": [
   "patentNumber"
  ],
  "type": "object"
 },
 "name": "pregrant_pub",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "asFiledAbstract": {
    "description": "As-filed abstract text.",
    "type": "string"
   },
   "asFiledClaimCount": {
    "description": "Number of as-filed claims.",
    "type": "number"
   },
   "asFiledClaims": {
    "description": "As-filed claims (number, text, independence flag).",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "patentNumber": {
    "description": "The patent number queried.",
    "type": "string"
   },
   "publicationDate": {
    "description": "Pre-grant publication date.",
    "type": "string"
   },
   "publicationNumber": {
    "description": "Pre-grant publication number.",
    "type": "string"
   }
  },
  "type": "object"
 }
}
