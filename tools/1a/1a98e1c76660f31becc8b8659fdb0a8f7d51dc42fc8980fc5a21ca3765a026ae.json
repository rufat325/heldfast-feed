  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List the FQDNs (main + aliases) bound to a web hosting site. The site responds to all of them via the same Apache vhost / DocumentRoot \u2014 adding an alias is how you serve more domains from a single WordPress install without provisioning a new site. Manager-private.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "hosting_id": {
    "description": "Web hosting id. Discover via infomaniak_list_hostings / infomaniak_find_site.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "site_id": {
    "description": "Site id on the hosting. Discover via infomaniak_find_site.",
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "hosting_id",
   "site_id"
  ],
  "type": "object"
 },
 "name": "infomaniak_list_site_aliases",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "aliases": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "can_update_dns": {
       "type": "boolean"
      },
      "domain_options": {
       "additionalProperties": true,
       "properties": {
        "has_dns_anycast": {
         "type": "boolean"
        },
        "has_domain_privacy": {
         "type": "boolean"
        },
        "has_renewal_warranty": {
         "type": "boolean"
        }
       },
       "type": "object"
      },
      "fqdn_idn": {
       "type": "string"
      },
      "is_main": {
       "type": "boolean"
      },
      "is_protected": {
       "type": "boolean"
      },
      "is_synonym": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "is_main"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "count": {
    "type": "number"
   },
   "hosting_id": {
    "type": "number"
   },
   "main_fqdn": {
    "type": "string"
   },
   "site_id": {
    "type": "number"
   }
  },
  "required": [
   "hosting_id",
   "site_id",
   "count",
   "aliases"
  ],
  "type": "object"
 }
