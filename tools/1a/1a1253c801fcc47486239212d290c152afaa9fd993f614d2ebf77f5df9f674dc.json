{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update an existing RUM application's name or type",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "RUM application ID to update",
    "type": "string"
   },
   "name": {
    "description": "New name for the RUM application",
    "type": "string"
   },
   "type": {
    "description": "New type for the RUM application",
    "enum": [
     "browser",
     "ios",
     "android",
     "react-native",
     "flutter",
     "roku",
     "electron",
     "unity",
     "kotlin-multiplatform"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update-rum-application"
}
