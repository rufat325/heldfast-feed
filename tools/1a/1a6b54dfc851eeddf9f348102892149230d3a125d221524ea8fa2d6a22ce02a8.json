  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Import a Mailbox"
 },
 "description": "Start an IMAP import from another provider into a Shipmail mailbox. The source accepts an app, device, or IMAP password. Outlook imports require the dashboard's Microsoft sign-in. Imports run in the background.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "email": {
    "description": "Address of the source mailbox",
    "maxLength": 320,
    "minLength": 3,
    "type": "string"
   },
   "host": {
    "description": "IMAP server. Required for 'imap' and 'mxroute'; optional Titan or OVHcloud server override.",
    "maxLength": 253,
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Shipmail resource ID.",
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   },
   "include_spam": {
    "description": "Also import the source spam folder",
    "type": "boolean"
   },
   "include_trash": {
    "description": "Also import the source trash folder",
    "type": "boolean"
   },
   "password": {
    "description": "App password, device password, or IMAP password for the source mailbox",
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   },
   "port": {
    "description": "IMAP port. Used for custom IMAP, MXroute, Titan, and OVHcloud overrides.",
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "provider": {
    "description": "Source provider. Outlook imports require the dashboard's Microsoft sign-in.",
    "enum": [
     "gmail",
     "yahoo",
     "aol",
     "icloud",
     "fastmail",
     "zoho",
     "titan",
     "namecheap",
     "migadu",
     "gmx",
     "mail_com",
     "mailbox_org",
     "mxroute",
     "infomaniak",
     "ovh",
     "gandi",
     "imap"
    ],
    "type": "string"
   },
   "range": {
    "description": "How far back to import. Defaults to all.",
    "enum": [
     "all",
     "12m",
     "3m",
     "1m"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "provider",
   "email",
   "password"
  ],
  "type": "object"
 },
