{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Tells whether a date is a business day in T\u00fcrkiye, which holiday falls on it and whether only the afternoon is off. T\u00fcrkiye's official calendar (Law 2429 holidays plus Diyanet's religious holidays), covering 2022-01-01 to 2035-12-31. Business days are Monday\u2013Friday minus official holidays. Eves of Republic Day and the religious holidays are half days (holiday from 13:00).","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"calendar":{"default":"standard","description":"standard: general business days. public_sector: also excludes announced administrative leave (from 2026). tcmb: days the central bank publishes exchange rates (no bulletin on eves).","enum":["standard","public_sector","tcmb"],"type":"string"},"date":{"description":"Date, YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"half_days":{"default":"working","description":"Count half-day eves as working days or as holidays.","enum":["working","holiday"],"type":"string"}},"required":["date"],"type":"object"},"name":"check_business_day","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"administrative_leave":{"items":{"additionalProperties":false,"properties":{"applies_to":{"const":"public_sector","type":"string"},"ends_at":{"type":["string","null"]},"portion":{"enum":["full","morning"],"type":"string"},"reason_en":{"type":"string"},"reason_tr":{"type":"string"},"source":{"type":"string"}},"required":["portion","ends_at","reason_tr","reason_en","source","applies_to"],"type":"object"},"type":"array"},"business_day":{"type":"boolean"},"calendar":{"enum":["standard","public_sector","tcmb"],"type":"string"},"date":{"type":"string"},"day_off":{"enum":["none","afternoon","full"],"type":"string"},"disclaimer":{"type":"string"},"half_days":{"enum":["working","holiday"],"