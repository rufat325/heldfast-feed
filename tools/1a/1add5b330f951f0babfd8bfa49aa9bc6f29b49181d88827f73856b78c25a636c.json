{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compare up to 20 candidate ideas using calculated validation scores and requested thresholds. Never mutates ideas or inflates scores; returns qualifying candidates separately.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "projectIds": {
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "validationGate": {
    "anyOf": [
     {
      "enum": [
       "very_high"
      ],
      "type": "string"
     },
     {
      "additionalProperties": false,
      "properties": {
       "maxSaturation": {
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "minOpportunity": {
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "minPain": {
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       }
      },
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "projectIds"
  ],
  "type": "object"
 },
 "name": "launchchair_compare_projects"
}
