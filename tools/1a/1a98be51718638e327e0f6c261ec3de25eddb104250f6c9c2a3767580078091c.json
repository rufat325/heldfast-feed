{
 "description": "Search grants awarded to associations by the Commune of La Possession.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "beneficiary": {
    "description": "Beneficiary name filter (substring)",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "min_amount": {
    "description": "Minimum grant amount in EUR",
    "type": "number"
   },
   "year": {
    "description": "Grant year dataset",
    "enum": [
     "2022",
     "2023"
    ],
    "type": "string"
   }
  },
  "required": [
   "year"
  ],
  "type": "object"
 },
 "name": "reunion_possession_search_association_grants"
}
