{
 "description": "Generate a paste-ready embed snippet for a widget key, in the given framework.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "framework": {
    "default": "react",
    "description": "react | web-component | html | wordpress",
    "enum": [
     "react",
     "web-component",
     "html",
     "wordpress"
    ],
    "type": "string"
   },
   "publishable_key": {
    "description": "The widget publishable key (fm_pub_\u2026).",
    "type": "string"
   },
   "type": {
    "default": "feedback",
    "enum": [
     "feedback",
     "survey",
     "annotate",
     "changelog",
     "board",
     "testimonial"
    ],
    "type": "string"
   }
  },
  "required": [
   "publishable_key"
  ],
  "type": "object"
 },
 "name": "get_embed_snippet"
}
