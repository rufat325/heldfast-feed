{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a Notion show-rundown scaffold with scene maps, property maps, approval policy, adapter source, and token-safety notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "rest_json",
    "enum": [
     "rest_json",
     "webhook_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "http://127.0.0.1:9062/notion",
    "type": "string"
   },
   "approval_required": {
    "default": true,
    "type": "boolean"
   },
   "database_id": {
    "default": "notion_show_database",
    "type": "string"
   },
   "name": {
    "default": "notion_show_rundown",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the Notion rundown scaffold.",
    "type": "string"
   },
   "property_count": {
    "default": 8,
    "maximum": 64,
    "minimum": 1,
    "type": "integer"
   },
   "rundown_label": {
    "default": "main_show",
    "type": "string"
   },
   "scene_count": {
    "default": 12,
    "maximum": 256,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_notion_show_rundown",
 "title": "Connect Notion show rundown"
}
