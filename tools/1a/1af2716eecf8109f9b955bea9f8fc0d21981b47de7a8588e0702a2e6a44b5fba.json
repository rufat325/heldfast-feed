{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "New design"
 },
 "description": "Create a design from a reference architecture, or an empty one with just the B and T runtime symbols. Returns the design_id every other tool needs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "name": {
    "description": "Name for the new design. Defaults to the preset's name.",
    "type": "string"
   },
   "preset": {
    "description": "One of: nano-sort, gpt2-small, gpt2-medium, gpt2-large, gpt2-xl, nanogpt, bloom-7b1, t5-small, flan-t5-base, llama-2-7b, mistral-7b, llama-3-8b, llama-3-70b, llama-3.1-405b, qwen2.5-7b, qwen3-8b, gemma-2-9b, gemma-3-27b, mixtral-8x7b, qwen3-30b-a3b, qwen3-235b-a22b, gpt-oss-20b, qwen3-next-80b-a3b, deepseek-v3, jamba-v0.1, nemotron-h-8b, ijepa-vit-h14, alexnet. Omit for an empty design.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tensorcad_new_design",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "design_id": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "outline": {
    "additionalProperties": false,
    "properties": {
     "blocks": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "depth": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "kind": {
         "description": "primitive, composite, container or unknown.",
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "params": {
         "description": "Trainable parameters under this path, repeats included.",
         "type": "number"
        },
        "path": {
         "description": "Slash-separated path, e.g. \"layers/block\".",
         "type": "string"
        },
        "repeat": {
         "description": "Instance count, for repeat containers.",
         "type": "number"
        },
        "type": {
         "type": "string"
        }
       },
       "required": [
        "path",
        "type",
        "kind",
        "depth",
        "params"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "edges": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "from": {
         "type": "string"
        },
        "graph": {
         "description": "Container path holding the edge; \"\" is the root graph.",
         "type": "string"
        },
        "shape": {
         "description": "Inferred shape on the wire, e.g. \"B T D\".",
         "type": "string"
        },
        "to": {
         "type": "string"
        }
       },
       "required": [
        "graph",
        "from",
        "to"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "family": {
      "type": "string"
     },
     "issues": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "name": {
      "type": "string"
     },
     "notes": {
      "type": "string"
     },
     "params_active": {
      "type": "number"
     },
     "params_total": {
      "type": "number"
     },
     "symbols": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "doc": {
         "type": "string"
        },
        "kind": {
         "enum": [
          "design",
          "runtime"
         ],
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "resolved": {
         "type": "number"
        },
        "value": {
         "description": "Literal or expression as written in the document.",
         "type": "string"
        }
       },
       "required": [
        "name",
        "kind",
        "value"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "name",
     "symbols",
     "blocks",
     "edges",
     "params_total",
     "params_active",
     "issues"
    ],
    "type": "object"
   },
   "params_total": {
    "type": "number"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "source": {
    "enum": [
     "preset",
     "file",
     "empty"
    ],
    "type": "string"
   }
  },
  "required": [
   "design_id",
   "revision",
   "name",
   "source",
   "params_total",
   "outline"
  ],
  "type": "object"
 },
 "title": "New design"
}
