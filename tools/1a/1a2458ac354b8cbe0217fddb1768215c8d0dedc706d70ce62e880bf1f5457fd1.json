{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Hyperliquid traders ranked across all markets by results over 7, 30 or 90 days: win rate, profit factor, realized PnL, max drawdown and best markets. sort=top ranks by realized PnL, lowrisk by smallest max drawdown, new by most recently first seen.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Number of traders (1-50, default 20)",
    "type": "number"
   },
   "sort": {
    "description": "Ranking. Default top",
    "enum": [
     "top",
     "lowrisk",
     "new"
    ],
    "type": "string"
   },
   "window": {
    "description": "Lookback window. Default 30d",
    "enum": [
     "7d",
     "30d",
     "90d"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "get_top_traders",
 "outputSchema": {
  "description": "Traders ranked across all markets",
  "properties": {
   "aggregate": {
    "description": "Totals",
    "properties": {
     "active_today": {
      "description": "Traders active today"
     },
     "total_pnl_usd": {
      "description": "Sum of realized PnL in USD"
     },
     "trader_count": {
      "description": "Traders ranked"
     }
    },
    "type": "object"
   },
   "sort": {
    "description": "Ranking used"
   },
   "traders": {
    "description": "Traders",
    "items": {
     "description": "One trader",
     "properties": {
      "address": {
       "description": "Wallet address (0x\u2026)"
      },
      "avg_notional_usd": {
       "description": "Average trade size in USD"
      },
      "first_trade_ms": {
       "description": "First trade, Unix milliseconds"
      },
      "last_trade_ms": {
       "description": "Last trade, Unix milliseconds"
      },
      "liquidations": {
       "description": "Liquidations in the window"
      },
      "max_drawdown_pct": {
       "description": "Largest peak-to-trough drop of the PnL curve, 0 to 1"
      },
      "profit_factor": {
       "description": "Gross profit divided by gross loss"
      },
      "realized_pnl_usd": {
       "description": "Realized PnL in USD"
      },
      "taker_share": {
       "description": "Share of volume as taker, 0 to 1"
      },
      "top_pairs": {
       "description": "Best markets with their win rates"
      },
      "trades": {
       "description": "Closed trades in the window"
      },
      "win_rate": {
       "description": "Share of closed trades that were profitable, 0 to 1"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "window": {
    "description": "Lookback window, e.g. \"30d\""
   }
  },
  "type": "object"
 }
}
