{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Show how one file or symbol reaches another through the dependency graph, with alternative paths. Use to answer 'how is this connected to that?' \u2014 an empty result means no path exists, which is itself an answer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "from": {
    "additionalProperties": false,
    "description": "Starting point.",
    "properties": {
     "kind": {
      "enum": [
       "file",
       "symbol"
      ],
      "type": "string"
     },
     "name": {
      "description": "Symbol name. Required when kind is 'symbol'.",
      "minLength": 1,
      "type": "string"
     },
     "path": {
      "description": "Workspace-relative path. Required when kind is 'file'.",
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "kind"
    ],
    "type": "object"
   },
   "maxAlternatives": {
    "description": "How many distinct routes to return.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "maxHops": {
    "description": "Maximum route length.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "to": {
    "additionalProperties": false,
    "description": "Destination.",
    "properties": {
     "kind": {
      "$ref": "#/properties/from/properties/kind"
     },
     "name": {
      "$ref": "#/properties/from/properties/name"
     },
     "path": {
      "$ref": "#/properties/from/properties/path"
     }
    },
    "required": [
     "kind"
    ],
    "type": "object"
   }
  },
  "required": [
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "dependency_route",
 "title": "Dependency route"
}
