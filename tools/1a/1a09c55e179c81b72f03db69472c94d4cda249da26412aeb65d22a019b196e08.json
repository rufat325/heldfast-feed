{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit metadata-backed bounded ADQL as an explicit TAP async job when synchronous querying is insufficient. Preserve the exact query and use starfetch_tap_query for small work.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "maxrec": {
    "description": "TAP MAXREC row limit. Defaults to 100 when omitted.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Exact metadata-backed ADQL query text. Use TOP for a query-level bound; do not use LIMIT.",
    "minLength": 1,
    "type": "string"
   },
   "requestFormat": {
    "description": "TAP RESPONSEFORMAT request value for the async job result.",
    "enum": [
     "votable",
     "csv",
     "tsv"
    ],
    "type": "string"
   },
   "runId": {
    "description": "Optional TAP RUNID request value.",
    "minLength": 1,
    "type": "string"
   },
   "service": {
    "description": "Known Starfetch TAP service preset selected for this workflow; use this or url.",
    "minLength": 1,
    "type": "string"
   },
   "uploads": {
    "description": "TAP uploads forwarded to the service; local file paths are not supported.",
    "items": {
     "anyOf": [
      {
       "properties": {
        "tableName": {
         "description": "Temporary TAP_UPLOAD table name.",
         "minLength": 1,
         "type": "string"
        },
        "uri": {
         "description": "Remote VOTable URI for TAP upload.",
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "tableName",
        "uri"
       ],
       "type": "object"
      },
      {
       "properties": {
        "filename": {
         "description": "Optional inline VOTable filename.",
         "minLength": 1,
         "type": "string"
        },
        "tableName": {
         "description": "Temporary TAP_UPLOAD table name.",
         "minLength": 1,
         "type": "string"
        },
        "votable": {
         "description": "Inline VOTable XML content.",
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "tableName",
        "votable"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "url": {
    "description": "Explicit TAP base URL selected for this workflow; use this or service.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "starfetch_tap_submit_job",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "url"
    ],
    "type": "object"
   },
   "diagnostics": {
    "additionalProperties": false,
    "properties": {
     "effectiveMaxrec": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "query": {
      "type": "string"
     },
     "requestFormat": {
      "enum": [
       "votable",
       "csv",
       "tsv"
      ],
      "type": "string"
     },
     "runId": {
      "type": "string"
     },
     "target": {
      "additionalProperties": false,
      "properties": {
       "baseUrl": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "service": {
        "type": "string"
       }
      },
      "required": [
       "baseUrl"
      ],
      "type": "object"
     },
     "uploadCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "target",
     "effectiveMaxrec",
     "query",
     "uploadCount"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "diagnostics"
  ],
  "type": "object"
 },
 "title": "Submit TAP async job"
}
