{
 "description": "Deploy an ephemeral fake MCP server to detect adversarial probing",
 "inputSchema": {
  "properties": {
   "alertOnInteraction": {
    "description": "Alert on every probe (default: true)",
    "type": "boolean"
   },
   "name": {
    "description": "Honeypot display name",
    "type": "string"
   },
   "template": {
    "description": "Honeypot template",
    "enum": [
     "fake-production-database",
     "fake-filesystem",
     "fake-github",
     "fake-slack",
     "fake-api-server",
     "fake-credentials-vault",
     "fake-admin-panel"
    ],
    "type": "string"
   },
   "ttlMinutes": {
    "description": "Auto-destroy after N minutes (default: 30)",
    "type": "number"
   }
  },
  "required": [
   "name",
   "template"
  ],
  "type": "object"
 },
 "name": "deploy_honeypot"
}
