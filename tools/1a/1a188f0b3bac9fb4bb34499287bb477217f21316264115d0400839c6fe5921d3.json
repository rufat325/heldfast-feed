{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "multilocale:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List your localization projects"
 },
 "description": "Use this when someone asks which localization projects they have in MultiLocale. Returns each project's id, name, default locale, languages and timestamps, up to 100 projects. Not for listing the strings inside a project.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "list_projects",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projectCount": {
    "minimum": 0,
    "type": "integer"
   },
   "projects": {
    "description": "Up to 100 projects; projectCount has the total",
    "items": {
     "additionalProperties": false,
     "properties": {
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "defaultLocale": {
       "anyOf": [
        {
         "maxLength": 35,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastEditTime": {
       "$ref": "#/properties/projects/items/properties/creationTime"
      },
      "locales": {
       "items": {
        "$ref": "#/properties/projects/items/properties/defaultLocale/anyOf/0"
       },
       "maxItems": 200,
       "type": "array"
      },
      "name": {
       "maxLength": 128,
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "defaultLocale",
      "locales",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "projectsTruncated": {
    "type": "boolean"
   },
   "status": {
    "enum": [
     "found",
     "empty"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "projectCount",
   "projectsTruncated",
   "projects"
  ],
  "type": "object"
 },
 "title": "List your localization projects"
}
