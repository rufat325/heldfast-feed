{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "G\u00e8re les snapshots d'une VM (create, list, restore, delete) \u26a0\ufe0f ATTENTION: Op\u00e9ration potentiellement destructive!",
 "inputSchema": {
  "properties": {
   "action": {
    "enum": [
     "create",
     "list",
     "restore",
     "delete",
     "delete-all"
    ],
    "type": "string"
   },
   "description": {
    "maxLength": 256,
    "type": "string"
   },
   "live": {
    "default": false,
    "type": "boolean"
   },
   "snapshot_name": {
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
    "type": "string"
   },
   "vm_name": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
    "type": "string"
   },
   "yes": {
    "default": false,
    "type": "boolean"
   }
  },
  "required": [
   "vm_name",
   "action"
  ],
  "type": "object"
 },
 "name": "vm_snapshot"
}
