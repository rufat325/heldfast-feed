{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "isitdone: which checks would run"
 },
 "description": "Read-only, runs nothing. The check commands isitdone_verify would run in this repository: id, command, lite or full, timeout, and where each one was detected.",
 "inputSchema": {
  "properties": {
   "cwd": {
    "description": "Absolute path of the repository, or of a directory inside it. Default: the client's first workspace root, else the directory the server was started in.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "isitdone_detect",
 "outputSchema": {
  "properties": {
   "checks": {
    "items": {
     "properties": {
      "cmd": {
       "type": "string"
      },
      "cwd": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "kind": {
       "description": "lite = typecheck/lint, full = tests/build.",
       "enum": [
        "lite",
        "full"
       ],
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "timeoutSeconds": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "cmd",
      "kind",
      "source",
      "timeoutSeconds"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "configSource": {
    "type": [
     "string",
     "null"
    ]
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "root": {
    "type": "string"
   },
   "stacks": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "root",
   "configSource",
   "stacks",
   "checks",
   "notes"
  ],
  "type": "object"
 },
 "title": "isitdone: which checks would run"
}
