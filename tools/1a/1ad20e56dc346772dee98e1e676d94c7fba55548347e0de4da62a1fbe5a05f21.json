{"description":"Update an existing task in Propstack.\n\nUse this tool to:\n- Mark a to-do as done\n- Reschedule an appointment (change starts_at/ends_at)\n- Add notes to an existing task (update body)\n- Change broker assignment\n- Update event state (took_place, cancelled)\n- Link additional contacts or properties\n\nOnly provide the fields you want to change.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"all_day":{"description":"All-day event flag","type":"boolean"},"body":{"description":"Task body (HTML allowed)","type":"string"},"broker_id":{"description":"ID of the assigned broker/agent","type":"number"},"client_ids":{"description":"Contact IDs to link this task to","items":{"type":"number"},"type":"array"},"done":{"description":"Mark to-do as completed","type":"boolean"},"due_date":{"description":"Due date (ISO 8601)","type":"string"},"ends_at":{"description":"Event end time (ISO 8601)","type":"string"},"id":{"description":"Task ID to update","type":"number"},"is_event":{"description":"Appointment flag","type":"boolean"},"is_reminder":{"description":"To-do flag","type":"boolean"},"location":{"description":"Event location","type":"string"},"note_type_id":{"description":"Activity type ID","type":"number"},"private":{"description":"Private event flag","type":"boolean"},"project_ids":{"description":"Project IDs to link this task to","items":{"type":"number"},"type":"array"},"property_ids":{"description":"Property IDs to link this task to","items":{"type":"number"},"type":"array"},"recurring":{"description":"Recurring event flag","type":"boolean"},"remind_at":{"description":"Reminder notification time (ISO 8601)","type":"string"},"reservation_reason_id":{"description":"Cancellation reason ID","type":"number"},"rrule":{"description":"iCal RRULE for recurring events","type":"string"},"starts_at":{"description":"Event start time (ISO 8601)","type":"string"},"state":{"description":"Event state (e.g. 'neutral', 'took_place', 'cancelled')","type":"string"},"title":{"description":"Task title / subject line","type":"string"}},"required":["id"],"type":"object"},"name":"update_task"}
