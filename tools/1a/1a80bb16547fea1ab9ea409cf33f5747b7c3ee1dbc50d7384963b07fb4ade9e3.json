 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Checks an app made with an AI app builder (Lovable, Bolt, v0, Replit, Cursor) for leaks and launch readiness. Use it when the user asks \"is my Lovable app secure?\", \"is my Supabase data public?\", \"which security headers is my app missing?\" or \"is my app ready to launch?\". Pass the app address. For any public app it returns 8 security headers with the exact lines for the detected host (Vercel, Netlify, nginx and more), and launchList: 20 items of a 160-item launch list read from outside (renewals, mail records, security.txt, caching, legal links), each pass, fail or warn with a fix; checklist true adds the owner-only items with how to check each. The first call also returns ownership_not_proven with a DNS TXT record or file: once the owner publishes it, the next call adds exposed files (.env, .git), masked keys in the shipped JavaScript, source maps, open Supabase or Firebase data, and backend signals. GET only; database checks read status codes and row counts, never a row's data, and never write. Do not use it on an app the user does not own beyond the public checks, for private or local addresses, or to scan many sites.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "checklist": {
    "description": "true also returns the launch list items only the owner can check, each with how to check it (about 127 lines). Default false: only their count.",
    "type": "boolean"
   },
   "url": {
    "description": "The app's address, such as https://my-app.lovable.app/ or myapp.com. Headers and the public launch items are checked for any public app; the full check needs the owner to publish a proof token on that host first.",
    "maxLength": 260,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
