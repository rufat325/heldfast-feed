{
 "description": "Drive a Preview session: select a module, lesson, or exact item/question; set answers; reset the simulation; expire it; or mint a fresh one-time real-worker-renderer link. State mutations require expectedStateRevision and fail closed on drift. Requires lms:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "select",
     "set_answers",
     "reset",
     "expire",
     "mint_link"
    ],
    "type": "string"
   },
   "answers": {
    "additionalProperties": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      },
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ]
    },
    "type": "object"
   },
   "expectedStateRevision": {
    "minimum": 1,
    "type": "integer"
   },
   "idempotencyKey": {
    "description": "Stable idempotency key. Reuse only for the identical operation.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "itemId": {
    "$ref": "#/properties/sessionId"
   },
   "lessonKey": {
    "$ref": "#/properties/sessionId"
   },
   "moduleKey": {
    "$ref": "#/properties/sessionId"
   },
   "sessionId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "action",
   "expectedStateRevision",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_manage_preview_session",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
