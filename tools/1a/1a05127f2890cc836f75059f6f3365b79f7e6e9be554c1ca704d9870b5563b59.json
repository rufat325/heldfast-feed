{
 "description": "No-write validation with the EXACT publish rule set. Stored mode validates a definition draft/published tree; inline mode validates a complete local bundle (title+required+tree) before any definition exists, optionally against a baseline definition for publish impact + base staleness. Requires job_checklists:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "request": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "definitionId": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       "mode": {
        "const": "stored",
        "type": "string"
       },
       "source": {
        "enum": [
         "draft",
         "published"
        ],
        "type": "string"
       }
      },
      "required": [
       "mode",
       "definitionId"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "baselineDefinitionId": {
        "$ref": "#/properties/request/anyOf/0/properties/definitionId"
       },
       "expectedDraftVersion": {
        "minimum": 0,
        "type": "integer"
       },
       "mode": {
        "const": "inline",
        "type": "string"
       },
       "required": {
        "type": "boolean"
       },
       "title": {
        "maxLength": 10000,
        "type": "string"
       },
       "tree": {
        "description": "Adaptive v2 checklist tree (see job_checklists capabilities for limits).",
        "items": {
         "additionalProperties": {},
         "type": "object"
        },
        "maxItems": 300,
        "type": "array"
       }
      },
      "required": [
       "mode",
       "title",
       "required",
       "tree"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "request"
  ],
  "type": "object"
 },
 "name": "opentrain_job_checklists_validate",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
