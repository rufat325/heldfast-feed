{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Batch-fetch summaries for many nodes at once. Pass the nodeIds (e.g. from a blast-radius result) and get their technical/business/security summaries in one call \u2014 far cheaper than reading each file. `include` defaults to all three.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "commitHash": {
    "type": "string"
   },
   "graphId": {
    "type": "string"
   },
   "include": {
    "items": {
     "enum": [
      "technical",
      "business",
      "security"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "nodeIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "graphId",
   "nodeIds"
  ],
  "type": "object"
 },
 "name": "get_summaries"
}
